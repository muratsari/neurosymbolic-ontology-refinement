@prefix ea:      <http://example.org/onto/assessment#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

################################################################################
# Ontology header
################################################################################

<http://example.org/onto/assessment> a owl:Ontology ;
    owl:versionInfo "2.0" ;
    owl:versionIRI <http://example.org/onto/assessment/2.0> ;
    dcterms:creator "annotator-A" ;
    rdfs:label "Educational Assessment & Evaluation Ontology"@en ;
    rdfs:comment "A manually authored OWL 2 DL reference (TBox) for educational assessment and evaluation. Two classification axes are reified (purpose, score interpretation) with equivalentClass bridge kinds; the purpose axis has the corpus's placement, formative and summative values, with DiagnosticPurpose < FormativePurpose (corpus-dominant reading). The other corpus categorizations are modelled as primitive disjoint kinds, each with verbatim corpus evidence and doc_id. Every class name is corpus-anchored; rdfs:label always equals the local-name-derived label (corpus synonym variants go to skos:altLabel, keeping strict label matching deterministic)."@en .

# Annotation properties (declared for OWL 2 DL cleanliness)
skos:definition a owl:AnnotationProperty .
skos:note a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .

################################################################################
# Root class
#
# An Assessment carries exactly one value on each of the two reified
# classification axes (purpose, score interpretation) and is related to the
# learning outcomes it measures and the items it contains. The other corpus
# categorizations (formal/informal, objective/subjective, internal/external,
# written/oral/performance-based, standardized/non-standardized, high/low
# stakes) are modelled as primitive disjoint contrast pairs directly under
# Assessment - the corpus names the KINDS, not axis values, for these.
################################################################################

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    skos:definition "A systematic process or instrument used to gather and interpret evidence about a learner's knowledge, skills, or abilities (Linn & Gronlund; AERA/APA/NCME Standards)."@en ;
    skos:note "Axis rigidity (design decision, retained for the two reified axes): purpose and score interpretation are functional properties with exactly-one qualified cardinality, so a single Assessment individual carries exactly one purpose and one score-interpretation value. Dual-use scenarios are modelled as distinct per-use Assessment individuals. Formality and format are not reified: the corpus-natural kind names (FormalAssessment, WrittenAssessment, ...) are primitive disjoint siblings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty ea:hasPurpose ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass ea:PurposeCategory ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty ea:hasScoreInterpretation ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass ea:ScoreInterpretationCategory ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty ea:hasLearningOutcome ;
                      owl:someValuesFrom ea:LearningOutcome ] .

################################################################################
# Classification axes - value partitions (the two retained reified axes)
#
# Each axis is reified as a functional object property (has...) whose range is
# a category class; the category is the DISJOINT UNION of its value classes
# (within-axis disjointness + exhaustiveness). The two axis category classes
# are deliberately NOT disjoint-unioned with each other into any abstract
# grouping class.
################################################################################

### Axis 1 - Purpose ###########################################################

ea:PurposeCategory a owl:Class ;
    rdfs:label "Purpose Category"@en ;
    skos:definition "The classification axis describing the instructional purpose for which an assessment is used (EdGlossary; Wikipedia, Educational assessment)."@en ;
    rdfs:comment "The partition follows the corpus's own type list - evidence: education:Wikipedia (en):Educational assessment#1 - 'Assessment can be divided for the sake of convenience using the following categorizations: Placement, formative, summative and diagnostic assessment'. Diagnostic is NOT a fourth coordinate member here: the corpus-dominant reading subordinates it under formative (see DiagnosticPurpose), so the disjoint union is (formative, summative, placement). The coordinate-list tension is documented, not axiomatized."@en ;
    owl:disjointUnionOf ( ea:FormativePurpose ea:SummativePurpose ea:PlacementPurpose ) .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    skos:definition "The purpose-axis value denoting that evidence is gathered during instruction to provide feedback that improves ongoing teaching and learning (EdGlossary; Wikipedia, Formative assessment)."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    skos:definition "The purpose-axis value denoting that learning is evaluated at the conclusion of an instructional period against a standard or benchmark (EdGlossary; Wikipedia, Summative assessment)."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    skos:definition "The purpose-axis value denoting that an assessment is used to place students, according to prior achievement or personal characteristics, at the most appropriate point in an instructional sequence."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#2 - 'Placement assessment – Placement evaluation may be used to place students according to prior achievement or level of knowledge, or personal characteristics, at the most appropriate point in an instructional sequence, in a unique instructional strategy, or with a suitable teacher conducted through placement testing.' The corpus's own type list is 4-fold (placement included)."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    skos:definition "The purpose-axis value denoting that an assessment is administered to identify learners' current knowledge, skills, strengths, and persistent difficulties so as to select a suitable program of learning (Wikipedia, Educational assessment; Linn & Gronlund)."@en ;
    rdfs:comment "Placement decision (corpus-dominant reading): DiagnosticPurpose is subordinated under FormativePurpose, so DiagnosticAssessment is entailed to be a FormativeAssessment. evidence: education:Wikipedia (en):Educational assessment#2 - 'A common form of formative assessment is diagnostic assessment. Diagnostic assessment measures a student's current knowledge and skills to identify a suitable program of learning.' and education:Wikipedia (en):Formative assessment#57 - 'Formative assessment ..., including diagnostic testing, is a range of formal and informal assessment procedures'. TENSION NOTE: the same corpus also lists diagnostic as a coordinate 4th category ('Placement, formative, summative and diagnostic assessment', doc #1). The reference encodes the subordinating reading and documents the coordinate reading here rather than asserting both."@en ;
    rdfs:subClassOf ea:FormativePurpose .

### Axis 2 - Score interpretation #############################################

ea:ScoreInterpretationCategory a owl:Class ;
    rdfs:label "Score Interpretation Category"@en ;
    skos:definition "The classification axis describing the frame of reference used to interpret an assessment's scores (Linn & Gronlund)."@en ;
    owl:disjointUnionOf ( ea:NormReferencedInterpretation ea:CriterionReferencedInterpretation ea:IpsativeInterpretation ) .

ea:NormReferencedInterpretation a owl:Class ;
    rdfs:label "Norm-Referenced Interpretation"@en ;
    skos:definition "The score-interpretation value in which a learner's performance is interpreted relative to the performance of a norm group (Wikipedia, Norm-referenced test; AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:ScoreInterpretationCategory .

ea:CriterionReferencedInterpretation a owl:Class ;
    rdfs:label "Criterion-Referenced Interpretation"@en ;
    skos:definition "The score-interpretation value in which performance is interpreted against a fixed set of predefined criteria or standards (Wikipedia, Criterion-referenced test)."@en ;
    rdfs:subClassOf ea:ScoreInterpretationCategory .

ea:IpsativeInterpretation a owl:Class ;
    rdfs:label "Ipsative Interpretation"@en ;
    skos:definition "The score-interpretation value in which a learner's current performance is interpreted relative to their own previous performance (EdGlossary)."@en ;
    rdfs:subClassOf ea:ScoreInterpretationCategory .

################################################################################
# Named assessment classes (DEFINED bridge classes) - the only two defined
# families, both over the axis properties.
#
# Each is EQUIVALENT to an Assessment that has the corresponding axis value.
# Because hasPurpose/hasScoreInterpretation is constrained to exactly one value
# per axis and the axis values are pairwise disjoint, the reasoner INFERS that
# the named classes within one axis are pairwise disjoint (e.g.
# FormativeAssessment vs SummativeAssessment), while leaving cross-axis
# combinations satisfiable.
################################################################################

### Purpose-axis named classes ###

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    skos:definition "An assessment whose purpose is formative: evidence is gathered during instruction to provide feedback that improves ongoing teaching and learning (EdGlossary; Wikipedia)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasPurpose ; owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ea:hasFeedbackRecipient ; owl:someValuesFrom ea:Learner ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    skos:definition "An assessment whose purpose is summative: it evaluates cumulative learning at the conclusion of an instructional period (EdGlossary; Wikipedia)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasPurpose ; owl:someValuesFrom ea:SummativePurpose ] ) ] .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment"@en ;
    skos:definition "An assessment whose purpose is diagnostic: it measures a student's current knowledge and skills to identify a suitable program of learning (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "Because DiagnosticPurpose is a subclass of FormativePurpose (corpus-dominant reading, see DiagnosticPurpose), the reasoner ENTAILS DiagnosticAssessment as a subclass of FormativeAssessment; DiagnosticAssessment is deliberately NOT a member of any coordinate disjoint set."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasPurpose ; owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    skos:definition "An assessment whose purpose is placement: it is used to place students at the most appropriate point in an instructional sequence, according to prior achievement, level of knowledge, or personal characteristics."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#1 - 'Assessment can be divided for the sake of convenience using the following categorizations: Placement, formative, summative and diagnostic assessment' and #2 - 'Placement assessment – Placement evaluation may be used to place students according to prior achievement or level of knowledge ... at the most appropriate point in an instructional sequence'."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasPurpose ; owl:someValuesFrom ea:PlacementPurpose ] ) ] .

### Score-interpretation-axis named classes ###

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-Referenced Test"@en ;
    skos:definition "An assessment whose scores are interpreted relative to a norm group (Wikipedia, Norm-referenced test; AERA/APA/NCME Standards)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasScoreInterpretation ; owl:someValuesFrom ea:NormReferencedInterpretation ] ) ] .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-Referenced Test"@en ;
    skos:definition "An assessment whose scores are interpreted against a fixed set of predefined criteria or standards (Wikipedia, Criterion-referenced test)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasScoreInterpretation ; owl:someValuesFrom ea:CriterionReferencedInterpretation ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    skos:definition "An assessment whose scores are interpreted relative to the same learner's previous performance (EdGlossary)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( ea:Assessment
        [ a owl:Restriction ; owl:onProperty ea:hasScoreInterpretation ; owl:someValuesFrom ea:IpsativeInterpretation ] ) ] .

################################################################################
# Formality pair - PRIMITIVE disjoint kinds.
################################################################################

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    skos:definition "An assessment conducted as a planned, documented measurement event that is given a numerical score or grade based on student performance (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#5 - 'Formal assessment usually implies a written document, such as a test, quiz, or paper. A formal assessment is given a numerical score or grade based on student performance, whereas an informal assessment does not contribute to a student's final grade.' The hasItem obligation below encodes the first sentence (a formal assessment implies a concrete instrument with items) and is the target of CQ-EA6."@en ;
    rdfs:subClassOf ea:Assessment ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty ea:hasItem ;
                      owl:someValuesFrom ea:AssessmentItem ] ;
    owl:disjointWith ea:InformalAssessment .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    skos:definition "An assessment that occurs casually during everyday instruction (e.g. observation, inventories, checklists) and does not contribute to a student's final grade (Wikipedia, Educational assessment; EdGlossary)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#5 - 'An informal assessment usually occurs more casually and may include observation, inventories, checklists...' NOTE: the reference deliberately does NOT subordinate FormativeAssessment under InformalAssessment - the corpus states formative assessment spans BOTH: 'Formative assessment ... is a range of formal and informal assessment procedures' (education:Wikipedia (en):Formative assessment#57)."@en ;
    rdfs:subClassOf ea:Assessment .

################################################################################
# Format triple - PRIMITIVE disjoint kinds.
# Disjointness follows the corpus's enumerated alternatives.
################################################################################

ea:WrittenAssessment a owl:Class ;
    rdfs:label "Written Assessment"@en ;
    skos:definition "An assessment in which learners respond in written form, such as an essay or written test (Linn & Gronlund)."@en ;
    rdfs:comment "Disjoint-triple evidence: education:Wikipedia (en):Standardized test#32 - 'Standardized tests can take various forms, including written, oral, or practical test.' (enumerated alternatives)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:OralAssessment a owl:Class ;
    rdfs:label "Oral Assessment"@en ;
    skos:definition "An assessment in which learners respond verbally, such as an interview, viva or oral examination (EdGlossary)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:label "Performance-Based Assessment"@en ;
    skos:definition "An assessment in which learners demonstrate competence by carrying out a task or producing a product under authentic conditions (EdGlossary; Wikipedia)."@en ;
    rdfs:subClassOf ea:Assessment .

[] a owl:AllDisjointClasses ;
   owl:members ( ea:WrittenAssessment ea:OralAssessment ea:PerformanceBasedAssessment ) .

################################################################################
# Further assessment kinds (all corpus-quoted, all primitive)
################################################################################

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    skos:definition "An assessment administered during instruction at intervals (e.g. every few weeks or months) to evaluate where students are in their learning progress; its formative-vs-summative status is contested (EdGlossary)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - summative assessment#168 - 'Some educators consider interim tests to be formative, since they are often used diagnostically to inform instructional modifications, but others may consider them to be summative. There is ongoing debate in the education community about this distinction.' DESIGN: InterimAssessment is DELIBERATELY placed under neither FormativeAssessment nor SummativeAssessment - the corpus records an open debate, so the reference keeps the class satisfiable and neutral; encoding BOTH readings simultaneously (Interim < Formative and Interim < Summative) would make it unsatisfiable under the inferred Formative/Summative disjointness."@en ;
    rdfs:subClassOf ea:Assessment .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-Stakes Test"@en ;
    skos:definition "A test with a desired reward for good performance (or an important consequence attached to the result), such as tests used for university admissions (Wikipedia, Standardized test; EdGlossary)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Standardized test#39 - 'A high-stakes test is a test with a desired reward for good performance. Some standardized tests, including many of the tests used for university admissions around the world, are high-stakes tests.' Stakes are NOT reified as an axis (no hasStakesLevel): the corpus names the kinds directly."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:LowStakesTest .

ea:LowStakesTest a owl:Class ;
    rdfs:label "Low-Stakes Test"@en ;
    skos:definition "A test with no or minor consequences attached to the result, such as an ordinary classroom quiz (Wikipedia, Standardized test)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Standardized test#39 - 'Most standardized tests, such as ordinary classroom quizzes, are low-stakes tests.' and #41 - 'This phenomenon is more common for high-stakes tests than for low-stakes tests.'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    skos:definition "A form of questioning that has a single correct answer (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#3 - 'Objective assessment is a form of questioning that has a single correct answer.' DESIGN: the single-correct-answer differentia is documented here but DELIBERATELY NOT axiomatized as a cardinality definition, because the same corpus passage immediately lists multiple-response (a select-ALL-correct-options type) among objective question types: 'Objective question types include true/false, multiple-choice, multiple-response, and matching questions'. An aggressive cardinality-1 definition plus that list makes MultipleResponseItem unsatisfiable - a genuine intra-corpus tension the reference documents instead of encoding."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:SubjectiveAssessment .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    skos:definition "A form of questioning that may have more than one correct answer, or more than one way of expressing the correct answer (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#3 - 'Subjective assessment is a form of questioning that may have more than one correct answer (or more than one way of expressing the correct answer).'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    skos:definition "An assessment set and marked by the school (i.e., teachers), with students receiving the mark and feedback regarding the assessment (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#6 - 'Internal assessment is set and marked by the school (i.e., teachers), and students get the mark and feedback regarding the assessment.'"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:ExternalAssessment .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    skos:definition "An assessment set by a governing body and marked by unbiased, non-school personnel (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#6 - 'External assessment is set by the governing body and marked by unbiased personnel; some external assessments provide much more limited feedback in their marking.'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    skos:definition "A test that is administered and scored in a consistent or standard manner, so that results are comparable across learners and settings (Wikipedia, Standardized test)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Standardized test#32 - 'A standardized test is a test that is administered and scored in a consistent or standard manner.' StandardizedTest is not subsumed under FormalAssessment: the frozen corpus never links standardized to formal, and 'Formative assessments can take the form of diagnostic, standardized tests, quizzes...' requires standardized formative assessments to stay satisfiable."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:NonStandardizedTest .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    skos:definition "A test in which significantly different tests are given to different test takers, or the same test is assigned under significantly different conditions or evaluated differently (Wikipedia, Standardized test)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Standardized test#32 - 'The opposite of standardized testing is non-standardized testing, in which either significantly different tests are given to different test takers, or the same test is assigned under significantly different conditions or evaluated differently.' Also #41 - 'High-stakes tests (whether standardized or non-standardized)...'"@en ;
    rdfs:subClassOf ea:Assessment .

################################################################################
# Further corpus-quoted kinds (all primitive)
################################################################################

ea:Portfolio a owl:Class ;
    rdfs:label "Portfolio"@en ;
    skos:definition "A compilation of academic work and other forms of educational evidence assembled for evaluating coursework quality, learning progress, and academic achievement (EdGlossary)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - portfolio#148 - 'A student portfolio is a compilation of academic work and other forms of educational evidence assembled for the purpose of (1) evaluating coursework quality, learning progress, and academic achievement; (2) determining whether students have met learning standards or other academic requirements...'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self Assessment"@en ;
    skos:definition "A form of diagnostic assessment in which students assess themselves (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#2 - 'Self-assessment is a form of diagnostic assessment in which students assess themselves.' The superclass is the verbatim corpus claim; via DiagnosticPurpose < FormativePurpose it is further entailed to be a FormativeAssessment (CQ-EA7 chain)."@en ;
    rdfs:subClassOf ea:DiagnosticAssessment .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    skos:definition "An assessment in which students use one another as learning resources, evaluating each other's work, e.g. 'workshopping' a piece of writing with classmates (EdGlossary)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - formative assessment#170 - 'Peer assessments that allow students to use one another as learning resources. For example, \"workshopping\" a piece of writing with classmates is one common form of peer assessment...' (listed among representative examples of formative assessment; the reference keeps the superclass at Assessment because the corpus presents it as a practice example, not a definitional subsumption)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    skos:definition "A brief assessment instrument, typically written, used in classrooms; an example of the concrete documents a formal assessment implies (Wikipedia, Educational assessment; Standardized test)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#5 - 'Formal assessment usually implies a written document, such as a test, quiz, or paper.' and education:Wikipedia (en):Standardized test#39 - 'Most standardized tests, such as ordinary classroom quizzes, are low-stakes tests.'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    skos:definition "A test that measures how well students have learned what they were expected to learn ('backward-looking') (EdGlossary, standardized test)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - standardized test#165 - 'Achievement tests are \"backward-looking\" in that they measure how well students have learned what they were expected to learn.' Also education:Wikipedia (en):Norm-referenced test#81 - 'most state achievement tests and high school graduation examinations, are criterion-referenced.'"@en ;
    rdfs:subClassOf ea:Assessment .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    skos:definition "A test that attempts to predict a student's ability to succeed in an intellectual or physical endeavor, e.g. by evaluating mathematical ability, language proficiency, or abstract reasoning (EdGlossary, standardized test)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - standardized test#165 - 'Aptitude tests attempt to predict a student's ability to succeed in an intellectual or physical endeavor by, for example, evaluating mathematical ability, language proficiency, abstract reasoning, motor coordination...' (No Achievement/Aptitude disjointness is asserted: the corpus contrasts but does not exclude.)"@en ;
    rdfs:subClassOf ea:Assessment .

ea:LearningStandard a owl:Class ;
    rdfs:label "Learning Standard"@en ;
    skos:definition "A concise, written description of what students are expected to know and be able to do at a specific stage of their education, against which criterion-referenced performance is measured (EdGlossary)."@en ;
    rdfs:comment "evidence: education:The Glossary of Education Reform (EdGlossary) - criterion referenced test#158 - 'Criterion-referenced tests and assessments are designed to measure student performance against a fixed set of predetermined criteria or learning standards - i.e., concise, written descriptions of what students are expected to know and be able to do at a specific stage of their education.'"@en .

################################################################################
# Measurement quality - Validity and Reliability as disjoint ROOTS.
################################################################################

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    skos:definition "The degree to which evidence and theory support the interpretations of test scores for the proposed uses of a test (AERA/APA/NCME Standards, Validity chapter)."@en ;
    owl:disjointWith ea:Reliability .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    skos:definition "The consistency or precision of assessment scores across replications of a testing procedure (AERA/APA/NCME Standards, Reliability chapter)."@en .

### Validity subtypes (primitive) #############################################

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    skos:definition "Validity evidence based on the extent to which an assessment's content adequately samples the domain it is intended to represent (AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    skos:definition "Validity evidence based on the relationship between assessment scores and an external criterion measure (AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:Validity .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    skos:definition "A form of criterion validity in which assessment scores correlate with a criterion measured at approximately the same time (Wikipedia, Validity)."@en ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:disjointWith ea:PredictiveValidity .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    skos:definition "A form of criterion validity in which assessment scores predict a criterion measured at a later time (Wikipedia, Validity)."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    skos:definition "Validity evidence based on the degree to which an assessment measures the theoretical construct it claims to measure (AERA/APA/NCME Standards)."@en ;
    rdfs:comment "Modern unified view (AERA/APA/NCME Standards, 2014): validity is a single, unitary concept, and content / criterion / construct are not distinct kinds of validity but rather sources of validity evidence. This ontology retains the pedagogical sub-type presentation for teaching and retrieval; the asserted disjointness represents a separation of evidence sources, NOT a claim that construct validity is subsumed by or superior to the other evidence types."@en ;
    rdfs:subClassOf ea:Validity .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    skos:definition "The extent to which an assessment appears, on its surface, to measure what it is intended to measure (EdGlossary)."@en ;
    rdfs:subClassOf ea:Validity .

### Reliability subtypes (primitive) ##########################################

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    skos:definition "Reliability evidence based on the consistency of scores when the same assessment is administered to the same learners on two occasions (AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:Reliability .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    skos:definition "Reliability evidence based on the degree to which the items of an assessment measure the same construct, e.g. via Cronbach's alpha (AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:Reliability .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    skos:definition "Reliability evidence based on the degree of agreement among independent raters scoring the same performances (AERA/APA/NCME Standards)."@en ;
    rdfs:subClassOf ea:Reliability .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel-Forms Reliability"@en ;
    skos:altLabel "alternate-forms reliability"@en ;
    skos:definition "Reliability evidence based on the consistency of scores across two equivalent (parallel/alternate) forms of an assessment (AERA/APA/NCME Standards; Wikipedia, Reliability (statistics))."@en ;
    rdfs:comment "Corpus-natural synonym recorded per naming-contract rule 4: the frozen corpus says 'alternate forms' (7 occurrences; 'parallel forms' 0) - evidence: education:Wikipedia (en):Reliability (statistics)#18 - 'alternate test forms that are equivalent in terms of content, response processes and statistical characteristics'. The synonym goes to skos:altLabel (not a second rdfs:label) because the scorer resolves entities label-first and multiple rdfs:labels would make strict matching non-deterministic (securities CQ-V21 stale-label lesson)."@en ;
    rdfs:subClassOf ea:Reliability .

ea:SplitHalfReliability a owl:Class ;
    rdfs:label "Split-Half Reliability"@en ;
    skos:definition "Reliability evidence obtained by splitting a test into two halves and correlating the half scores; Cronbach's alpha is usually interpreted as the mean of all possible split-half coefficients (Wikipedia, Reliability (statistics))."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Reliability (statistics)#20 - 'The most common internal consistency measure is Cronbach's alpha, which is usually interpreted as the mean of all possible split-half coefficients.' NOT added to the reliability-subtype disjoint group: the corpus presents split-half as intimately related to internal consistency, so asserting SplitHalfReliability disjointWith InternalConsistencyReliability would be corpus-contrary."@en ;
    rdfs:subClassOf ea:Reliability .

################################################################################
# Learning outcomes
################################################################################

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    skos:definition "A statement of the knowledge, skills, or competencies a learner is expected to demonstrate as a result of instruction (EdGlossary)."@en .

################################################################################
# Components and participants
################################################################################

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    skos:definition "A scoring guide that lists the criteria and performance levels used to evaluate a learner's response or product (EdGlossary)."@en .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    skos:definition "A rubric that scores each evaluation criterion separately on its own scale (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:HolisticRubric .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    skos:definition "A rubric that assigns a single overall score based on an integrated judgement of the response (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:Rubric .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    skos:definition "An individual question, task, or prompt that elicits a response contributing to an assessment (Linn & Gronlund)."@en .

ea:SelectedResponseItem a owl:Class ;
    rdfs:label "Selected-Response Item"@en ;
    skos:definition "An assessment item for which the learner selects an answer from provided options, such as a multiple-choice item (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:ConstructedResponseItem .

ea:ConstructedResponseItem a owl:Class ;
    rdfs:label "Constructed-Response Item"@en ;
    skos:definition "An assessment item for which the learner generates an original response, such as an essay or short-answer item (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:AssessmentItem .

### Item taxonomy leaves #######################################################

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    skos:definition "A selected-response item presenting a stem and several options from which the learner chooses one correct or best answer (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:SelectedResponseItem .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    skos:definition "A selected-response item requiring the learner to judge a statement as true or false (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:SelectedResponseItem .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-Response Item"@en ;
    skos:definition "A selected-response item for which the learner selects all of the several correct options from a list (Linn & Gronlund)."@en ;
    rdfs:comment "The corpus lists multiple-response among OBJECTIVE question types ('Objective question types include true/false, multiple-choice, multiple-response, and matching questions' - education:Wikipedia (en):Educational assessment#3) while defining objective assessment by a SINGLE correct answer. The reference therefore never defines objectivity by answer cardinality; MultipleResponseItem must remain satisfiable (probed by CQ-EA30)."@en ;
    rdfs:subClassOf ea:SelectedResponseItem .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    skos:definition "A selected-response item requiring the learner to pair entries from two lists (a matching question) (Wikipedia, Educational assessment)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Educational assessment#3 - 'Objective question types include true/false, multiple-choice, multiple-response, and matching questions...'"@en ;
    rdfs:subClassOf ea:SelectedResponseItem .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    skos:definition "A constructed-response item requiring an extended written composition in the learner's own words (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:ConstructedResponseItem .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short-Answer Item"@en ;
    skos:definition "A constructed-response item requiring a brief supplied word, phrase, or number rather than a selection (Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:ConstructedResponseItem .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-In-The-Blank Item"@en ;
    skos:definition "A constructed-response (completion-type) item that provides a test taker with identifying characteristics and requires the test taker to recall the correct term (Wikipedia, Exam)."@en ;
    rdfs:comment "evidence: education:Wikipedia (en):Exam#94 - 'A fill-in-the-blank item provides a test taker with identifying characteristics and requires the test taker to recall the correct term.'"@en ;
    rdfs:subClassOf ea:ConstructedResponseItem .

### Feedback, participants, results ###########################################

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    skos:definition "Information communicated to a learner about the quality of their performance relative to goals, intended to support improvement (EdGlossary)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty ea:hasFeedbackRecipient ;
                      owl:someValuesFrom ea:Learner ] .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    skos:definition "Feedback that identifies errors or gaps in a learner's response and provides information intended to correct them (EdGlossary)."@en ;
    rdfs:subClassOf ea:Feedback .

ea:Learner a owl:Class ;
    rdfs:label "Learner"@en ;
    skos:definition "A person whose knowledge, skills, or abilities are evaluated by an assessment (general domain usage)."@en .

ea:AssessmentResult a owl:Class ;
    rdfs:label "Assessment Result"@en ;
    skos:definition "The recorded outcome produced when a learner takes an assessment, typically expressed as a score (Linn & Gronlund)."@en .

ea:Grade a owl:Class ;
    rdfs:label "Grade"@en ;
    skos:definition "An assessment result expressed as a summary letter, symbol, or reported mark (e.g. A-F, pass/fail) denoting a level of achievement (EdGlossary; Linn & Gronlund)."@en ;
    rdfs:subClassOf ea:AssessmentResult .

### Measured / referenced entities ############################################

ea:Construct a owl:Class ;
    rdfs:label "Construct"@en ;
    skos:definition "The theoretical trait, ability, or attribute (e.g. reading comprehension, numeracy) that an assessment is intended to measure (AERA/APA/NCME Standards)."@en .

ea:Criterion a owl:Class ;
    rdfs:label "Criterion"@en ;
    skos:definition "A predefined standard, benchmark, or external measure against which assessment performance is judged or validated (Linn & Gronlund; AERA/APA/NCME Standards)."@en .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    skos:altLabel "norming group"@en ;
    skos:definition "A reference population of test takers whose score distribution is used to interpret an individual learner's relative standing (Wikipedia, Norm-referenced test; AERA/APA/NCME Standards)."@en ;
    rdfs:comment "Corpus-natural synonym recorded per naming-contract rule 4 - evidence: education:The Glossary of Education Reform (EdGlossary) - norm referenced test#161 - 'the comparison group is known as the \"norming group.\"' Synonym in skos:altLabel, not a second rdfs:label (scorer determinism; see ParallelFormsReliability note)."@en .

ea:TestForm a owl:Class ;
    rdfs:label "Test Form"@en ;
    skos:definition "One of two or more parallel (alternate) versions of an assessment built to the same specifications so that scores are interchangeable (AERA/APA/NCME Standards)."@en .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    skos:definition "The component of an observed score attributable to unsystematic (random) influences rather than the construct being measured; freedom from it is the core of reliability (AERA/APA/NCME Standards)."@en .

ea:Rater a owl:Class ;
    rdfs:label "Rater"@en ;
    skos:definition "A person who scores or judges a learner's response or performance; agreement across raters is the unit of inter-rater reliability (AERA/APA/NCME Standards)."@en .

################################################################################
# Disjointness groups
################################################################################

# Top level.
# The two axis categories being in one disjoint group does NOT induce any
# cross-axis disjointness between named assessment kinds (different bridge
# properties).
[] a owl:AllDisjointClasses ;
   owl:members ( ea:Assessment
                 ea:PurposeCategory
                 ea:ScoreInterpretationCategory
                 ea:Validity
                 ea:Reliability
                 ea:LearningOutcome
                 ea:Rubric
                 ea:AssessmentItem
                 ea:Feedback
                 ea:Learner
                 ea:AssessmentResult ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ea:ContentValidity
                 ea:CriterionValidity
                 ea:ConstructValidity
                 ea:FaceValidity ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ea:TestRetestReliability
                 ea:InternalConsistencyReliability
                 ea:InterRaterReliability
                 ea:ParallelFormsReliability ) .

# Item leaves: selected-response family
[] a owl:AllDisjointClasses ;
   owl:members ( ea:MultipleChoiceItem
                 ea:TrueFalseItem
                 ea:MultipleResponseItem
                 ea:MatchingItem ) .

# Item leaves: constructed-response family
[] a owl:AllDisjointClasses ;
   owl:members ( ea:EssayItem
                 ea:ShortAnswerItem
                 ea:FillInTheBlankItem ) .

# Referenced-entity separation
[] a owl:AllDisjointClasses ;
   owl:members ( ea:AssessmentItem ea:TestForm ea:Rater ) .

################################################################################
# Object properties (each with rdfs:label, definition, domain, range)
################################################################################

ea:hasPurpose a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has purpose"@en ;
    skos:definition "Relates an assessment to the single purpose value that characterises why it is administered (functional: exactly one value per assessment)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasScoreInterpretation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has score interpretation"@en ;
    skos:definition "Relates an assessment to the single score-interpretation value used to interpret its scores (functional)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoreInterpretationCategory .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    skos:definition "Relates an assessment to a learning outcome whose attainment it is intended to gather evidence about (Linn & Gronlund)."@en ;
    rdfs:comment "Naming-contract derivation has+Range=LearningOutcome; the corpus says 'learning outcome' (21 frozen occurrences) and never 'measured outcome'."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasAlignedOutcome a owl:ObjectProperty ;
    rdfs:label "has aligned outcome"@en ;
    skos:definition "Relates an assessment to a learning outcome with which it is deliberately aligned under the principle of constructive alignment (Biggs; EdGlossary)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasValidityEvidence a owl:ObjectProperty ;
    rdfs:label "has validity evidence"@en ;
    skos:definition "Relates an assessment to a form of validity evidence supporting the interpretation of its scores (AERA/APA/NCME Standards)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:hasReliabilityEvidence a owl:ObjectProperty ;
    rdfs:label "has reliability evidence"@en ;
    skos:definition "Relates an assessment to a form of reliability evidence concerning the consistency of its scores (AERA/APA/NCME Standards)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    skos:definition "Relates an assessment to a rubric used to score learners' responses (EdGlossary)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasItem a owl:ObjectProperty ;
    rdfs:label "has item"@en ;
    skos:definition "Relates an assessment to an item that forms part of it (Linn & Gronlund)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    skos:definition "Relates an assessment to feedback it generates for learners (EdGlossary)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasFeedbackRecipient a owl:ObjectProperty ;
    rdfs:label "has feedback recipient"@en ;
    skos:definition "Relates an assessment or a piece of feedback to the learner who receives it (EdGlossary)."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ea:Assessment ea:Feedback ) ] ;
    rdfs:range ea:Learner .

ea:hasAssessedLearner a owl:ObjectProperty ;
    rdfs:label "has assessed learner"@en ;
    skos:definition "Relates an assessment to a learner whose performance it evaluates (general domain usage)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Learner .

ea:hasResult a owl:ObjectProperty ;
    rdfs:label "has result"@en ;
    skos:definition "Relates an assessment to a result it yields when administered to a learner (Linn & Gronlund)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentResult .

ea:hasCriterion a owl:ObjectProperty ;
    rdfs:label "has criterion"@en ;
    skos:definition "Relates a criterion-referenced test or a rubric to a criterion used to judge performance (Linn & Gronlund)."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ea:CriterionReferencedTest ea:Rubric ) ] ;
    rdfs:range ea:Criterion .

ea:hasConstruct a owl:ObjectProperty ;
    rdfs:label "has construct"@en ;
    skos:definition "Relates an assessment to the theoretical construct it is intended to measure (AERA/APA/NCME Standards)."@en ;
    rdfs:comment "Naming-contract derivation has+Range=Construct; 'construct' has 108 frozen corpus occurrences."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Construct .

ea:hasPrerequisite a owl:ObjectProperty ;
    rdfs:label "has prerequisite"@en ;
    skos:definition "Relates a measurement property to another that is a necessary precondition for it. In particular validity has reliability as a prerequisite: an assessment cannot be valid unless it is reliable (AERA/APA/NCME Standards). This is a between-individual dependency and does not contradict the Validity/Reliability disjointness (the two remain distinct kinds)."@en ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:Reliability .

ea:achievedBy a owl:ObjectProperty ;
    rdfs:label "achieved by"@en ;
    skos:definition "Relates an assessment result to the learner who achieved it, recovering result ownership independently of the assessment that produced it (Linn & Gronlund)."@en ;
    rdfs:domain ea:AssessmentResult ;
    rdfs:range ea:Learner .

################################################################################
# Data properties (label, domain, range with xsd types)
################################################################################

ea:hasReliabilityCoefficient a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has reliability coefficient"@en ;
    skos:definition "The numeric coefficient (typically between 0 and 1) quantifying the consistency captured by a reliability estimate (functional: a reliability estimate reports one coefficient) (AERA/APA/NCME Standards)."@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasScoreValue a owl:DatatypeProperty ;
    rdfs:label "has score value"@en ;
    skos:definition "The numeric score recorded for an assessment result."@en ;
    rdfs:domain ea:AssessmentResult ;
    rdfs:range xsd:decimal .

ea:hasMaxScore a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has max score"@en ;
    skos:definition "The maximum attainable score of an assessment (functional: at most one value per assessment)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasItemCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has item count"@en ;
    skos:definition "The number of items composing an assessment."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:nonNegativeInteger .
