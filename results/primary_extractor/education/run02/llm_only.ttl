@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "TENSION: one passage ('Performance assessments may also be called authentic assessments') treats these as synonyms (encoded here via equivalentClass), while another passage ('Assessment types include: ... Performance-based assessments ... Authentic assessment') lists them as separate, coordinate named assessment types." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass ea:PerformanceBasedAssessment .

ea:CapstonePortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio .

ea:CommonAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating they have learned expected knowledge and skills." ;
    rdfs:subClassOf ea:EducationalConcept ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based learning",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and top rankers selected." ;
    rdfs:subClassOf ea:HighStakesTest,
        ea:NormReferencedTest .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; will often include some form of formative assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria (e.g. a driving test)." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio ;
    skos:altLabel "e-portfolio" .

ea:Examination a owl:Class ;
    rdfs:label "Examination" ;
    owl:equivalentClass ea:Test ;
    skos:altLabel "exam",
        "test" .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by a governing body and marked by unbiased personnel." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:ExternalSource ] ) ] .

ea:FinalExam a owl:Class ;
    rdfs:comment "A final review and assessment of topics covered, typically at course end." ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document, such as a test, quiz, or paper, given a numerical score or grade." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalFormality ] ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Occurs more casually and does not contribute to a student's final grade." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalFormality ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "benchmark assessment" .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school/teachers." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:InternalSource ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:ItemBank a owl:Class ;
    rdfs:comment "Items are stored in an item bank." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:LowStakesTest a owl:Class ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "A criterion-referenced test that uses a cutscore: the examinee passes if their score exceeds the cutscore." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:CriterionReferencedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasCutScore ;
                        owl:someValuesFrom xsd:decimal ] ) ] .

ea:MathQuestion a owl:Class ;
    rdfs:comment "'Most mathematics questions ... employ a style which does not fall into any of the above categories.'" ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:ObjectiveQuestion,
        ea:SubjectiveQuestion .

ea:MidtermExam a owl:Class ;
    rdfs:comment "An exam given near the middle of a grading term. Listed as an example of summative assessment, though another passage calls midterms 'a type of formative or summative assessment' (tension)." ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Flexible in scope and format, and variable in difficulty." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Not measured against defined criteria; relative to the student body taking it (e.g. an IQ test)." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "grading on the curve",
        "normative assessment" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseType ;
                        owl:someValuesFrom ea:ObjectiveResponseType ] ) ] .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "portfolio assessment" .

ea:PreAssessment a owl:Class ;
    owl:equivalentClass ea:PlacementAssessment .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually a formative assessment." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:Test .

ea:ScreeningAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment .

ea:SelfAssessment a owl:Class ;
    rdfs:comment "Self-assessment is a form of diagnostic assessment in which students assess themselves." ;
    rdfs:subClassOf ea:DiagnosticAssessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:SimulationTest a owl:Class ;
    rdfs:comment "Some performance tests are simulations." ;
    rdfs:subClassOf ea:PerformanceTest .

ea:StandardsBasedAssessment a owl:Class ;
    rdfs:comment "'Criterion-referenced tests have also been called standards-based assessments.'" ;
    owl:equivalentClass ea:CriterionReferencedTest .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseType ;
                        owl:someValuesFrom ea:SubjectiveResponseType ] ) ] .

ea:TestItem-ResponseSplit a owl:Class .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score to a rubric/checklist; comes close to analytic scoring methods but remains holistic at heart." ;
    rdfs:subClassOf ea:GradingApproach .

ea:WrittenTest a owl:Class ;
    rdfs:comment "A test administered on paper or on a computer." ;
    rdfs:subClassOf ea:Test .

ea:hasErrorComponent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range ea:ErrorScore .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has granularity" ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasNormGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:NormReferencedTest ;
    rdfs:range ea:NormGroup .

ea:hasPercentileRank a owl:DatatypeProperty ;
    rdfs:domain ea:NormReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasPerformanceFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:PerformanceFormatCategory .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem .

ea:hasTrueScoreComponent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range ea:TrueScore .

ea:hasWordBank a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:FillInTheBlankItem ;
    rdfs:range xsd:boolean .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AchievementTest a owl:Class ;
    rdfs:comment "Backward-looking: measures knowledge/skills students learned or academic progress made." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AimLearningOutcome a owl:Class ;
    rdfs:comment "Intended learning outcome (aim)." ;
    rdfs:subClassOf ea:LearningOutcome .

ea:AnalyticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Forward-looking: attempts to predict a student's ability to succeed in a future endeavor." ;
    rdfs:subClassOf ea:ForwardLookingAssessment,
        ea:StandardizedTest .

ea:BloomsTaxonomy a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:ClassicalTestTheory a owl:Class ;
    rdfs:subClassOf ea:MeasurementModel .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ConcurrentValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:ContentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:ValidityEvidence ;
    skos:altLabel "logical validity" .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:DIKWPyramid a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "TENSION: 'Developmental rubrics, a subset of analytical rubrics' subordinates DevelopmentalRubric under AnalyticRubric, conflicting with the disjoint three-way partition above." ;
    rdfs:subClassOf ea:AnalyticRubric,
        ea:Rubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:comment "Focuses on the whole of difficulties occurring during the learning process.",
        "TENSION: corpus also states 'a common form of formative assessment is diagnostic assessment', subordinating Diagnostic under Formative, in contradiction with the four-way coordinate partition of PurposeCategory above." ;
    rdfs:subClassOf ea:Assessment,
        ea:FormativeAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "diagnostic testing" .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:Distractor a owl:Class ;
    rdfs:subClassOf ea:AnswerOption .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveQuestion ;
    skos:altLabel "FRQ",
        "essay question",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveQuestion .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:comment "Provides identifying characteristics and requires recall of the correct term." ;
    rdfs:subClassOf ea:TestItem .

ea:FormalLearning a owl:Class ;
    rdfs:subClassOf ea:Learning .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with important consequences for the individual test taker or institution." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:HolisticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:HolisticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:InformalLearning a owl:Class ;
    rdfs:comment "Less structured than non-formal learning; learning from day-to-day experience, typically unplanned." ;
    rdfs:subClassOf ea:Learning .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:InterMethodReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "parallel-forms reliability" .

ea:InterRaterReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ItemResponseTheory a owl:Class ;
    rdfs:subClassOf ea:MeasurementModel .

ea:ItemStem a owl:Class ;
    rdfs:comment "The opening of a multiple-choice item: a problem, question, or incomplete statement." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:LearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveQuestion .

ea:ModelOfHierarchicalComplexity a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, contrasting with MultipleChoiceItem." ;
    rdfs:subClassOf ea:ObjectiveQuestion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:Key ;
                        owl:onProperty ea:hasOption ] ) ] .

ea:NonFormalLearning a owl:Class ;
    rdfs:comment "Organized learning outside the formal learning system." ;
    rdfs:subClassOf ea:Learning .

ea:NormGroup a owl:Class ;
    rdfs:comment "A sample drawn from a predefined population against which a test taker's position is estimated." ;
    rdfs:subClassOf ea:EducationalConcept ;
    skos:altLabel "norming group" .

ea:ObjectiveLearningOutcome a owl:Class ;
    rdfs:comment "Measured learning outcome (objective)." ;
    rdfs:subClassOf ea:LearningOutcome .

ea:OneBestAnswerFamilyItem a owl:Class ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:PerformanceFormatValue a owl:Class ;
    rdfs:subClassOf ea:PerformanceFormatCategory .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than answer questions about it." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "work sample" .

ea:PlacementAssessment a owl:Class ;
    rdfs:comment "Used to place students according to prior achievement or level of knowledge at the most appropriate point in an instructional sequence. Generally not graded." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "TKT",
        "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PredictiveValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductFormat a owl:Class ;
    rdfs:subClassOf ea:PerformanceFormatCategory .

ea:ProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:RaschModel a owl:Class ;
    rdfs:subClassOf ea:MeasurementModel .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:StructureOfObservedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy ;
    skos:altLabel "SOLO" .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:TestRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:TestRetestReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability" .

ea:TrueFalseFamilyItem a owl:Class ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:TrueFalseItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveQuestion .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:AnalyticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:CriterionReferencedInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretationCategory .

ea:CriterionReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:ErrorScore a owl:Class ;
    rdfs:subClassOf ea:Score .

ea:ExternalSource a owl:Class ;
    rdfs:subClassOf ea:AdministrationSourceCategory .

ea:FormalFormality a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativeAssessment a owl:Class ;
    rdfs:comment "Carried out throughout a course to modify teaching and learning; generally low-stakes and often ungraded." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation",
        "formative feedback" .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HighStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalFormality a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InternalSource a owl:Class ;
    rdfs:subClassOf ea:AdministrationSourceCategory .

ea:IpsativeReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:LowStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormReferencedInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretationCategory .

ea:NormReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:ObjectiveResponseType a owl:Class ;
    rdfs:subClassOf ea:ResponseTypeCategory .

ea:ObservedScore a owl:Class ;
    rdfs:comment "X = T + E: the observed score is composed of a true-score component and an error component." ;
    rdfs:subClassOf ea:Score .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Focuses on achievement; a well-defined task is identified and students create, produce, or do something, often involving real-world application. Performance formats are classified into products and performances." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "performance assessment" .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:Portfolio a owl:Class ;
    rdfs:comment "A compilation of academic work and other educational evidence." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:StandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveResponseType a owl:Class ;
    rdfs:subClassOf ea:ResponseTypeCategory .

ea:SummativeAssessment a owl:Class ;
    rdfs:comment "Carried out at the end of a course or project to assign a grade; typically high-stakes." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:TrueScore a owl:Class ;
    rdfs:subClassOf ea:Score .

ea:hasAdministrationSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationSourceCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:hasResponseType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ResponseTypeCategory .

ea:hasScoreInterpretation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:ScoreInterpretationCategory .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AdministrationSourceCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:InternalSource ea:ExternalSource ) .

ea:AnswerOption a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:Key ea:Distractor ) .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:comment "Measures student performance against a fixed set of criteria or learning standards." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasScoreInterpretation ;
                        owl:someValuesFrom ea:CriterionReferencedInterpretation ] ) ] ;
    skos:altLabel "CRT" .

ea:CriterionValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:ValidityEvidence .

ea:FormalityCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:FormalFormality ea:InformalFormality ) .

ea:GradingApproach a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept .

ea:Key a owl:Class ;
    rdfs:subClassOf ea:AnswerOption .

ea:Learning a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept .

ea:MeasurementModel a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept .

ea:NormReferencedTest a owl:Class ;
    rdfs:comment "Yields an estimate of the position of the tested individual in a predefined population." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasScoreInterpretation ;
                        owl:someValuesFrom ea:NormReferencedInterpretation ] ) ] ;
    skos:altLabel "NRT" .

ea:PerformanceFormatCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:ProductFormat ea:PerformanceFormatValue ) .

ea:ResponseTypeCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:ObjectiveResponseType ea:SubjectiveResponseType ) .

ea:Score a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept .

ea:ScoreInterpretationCategory a owl:Class ;
    rdfs:comment "'There are two types of test score interpretations: a norm-referenced score interpretation or a criterion-referenced score interpretation.'" ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:NormReferencedInterpretation ea:CriterionReferencedInterpretation ) .

ea:StakesCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "Statements about what students should be able to do by the end of a teaching session." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:LearningOutcomeTaxonomy a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Consists of a stem and alternatives; only one answer may be keyed as correct.",
        "TENSION: corpus states 'there are two families of multiple-choice questions ... True/False ... One-Best-Answer', subordinating True/False under MultipleChoiceItem, while elsewhere TrueFalseItem is modeled as a coordinate sibling of MultipleChoiceItem (disjoint objective question types)." ;
    rdfs:subClassOf ea:ObjectiveQuestion ;
    owl:disjointUnionOf ( ea:TrueFalseFamilyItem ea:OneBestAnswerFamilyItem ) ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onClass ea:Key ;
                        owl:onProperty ea:hasOption ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:altLabel "MCQ",
        "objective response" .

ea:ReferencingCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:Rubric a owl:Class ;
    rdfs:comment "'Rubrics can be classified as holistic, analytic, or developmental' (coordinate partition asserted here).",
        "A scoring guide used to evaluate the quality of students' constructed responses." ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:HolisticRubric ea:AnalyticRubric ea:DevelopmentalRubric ) .

ea:SubjectiveQuestion a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "TENSION: 'Construct validity ... subsumes all other types of validity' and 'construct validity is not distinct from the support for the substantive theory' implies Construct validity is the overarching superclass of Content and Criterion validity, contradicting the disjoint coordinate-sibling partition asserted above." ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:PurposeCategory a owl:Class ;
    rdfs:comment "Corpus lists placement, formative, summative, and diagnostic as four coordinate categories ('(1) Placement ... (2) Formative ... (3) Summative ... (4) Diagnostic'). Elsewhere the corpus states assessment is 'often divided into initial, formative, and summative categories' (only three), creating tension with the four-way partition asserted here." ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent or standard manner for all test takers." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] ;
    skos:altLabel "standardized assessment" .

ea:ValidityEvidence a owl:Class ;
    rdfs:comment "The degree to which evidence and theory support the interpretation of test scores." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:ObjectiveQuestion a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:GranularityLevel a owl:Class ;
    rdfs:subClassOf ea:EducationalConcept ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:TestItem a owl:Class ;
    rdfs:comment "A component part of a test; the more general term for what is colloquially called a 'question'." ;
    rdfs:subClassOf ea:EducationalConcept .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification. Most tests can be classified on multiple, independent categories simultaneously (e.g. a test can be both standardized and high-stakes); therefore the axis-based test subtypes below are NOT asserted disjoint with one another." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam" .

ea:EducationalConcept a owl:Class ;
    rdfs:label "Educational Concept" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning. Assessment is often used interchangeably with the term test but is not limited to tests." ;
    rdfs:subClassOf ea:EducationalConcept .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveQuestion ea:SubjectiveQuestion ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ExtendedResponseItem ea:EssayItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticGrading ea:AnalyticGrading ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Corpus: 'Validity ... is generally gauged through examination of evidence in the following categories: Content validity, Criterion validity, Construct validity. Others are: consequential validity, face validity' (coordinate siblings)." ;
    owl:members ( ea:ContentValidity ea:CriterionValidity ea:ConstructValidity ea:ConsequentialValidity ea:FaceValidity ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "'Criterion validity is often divided into concurrent and predictive validity based on the timing of measurement.'" ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "'Convergent and discriminant validity are the two subtypes of validity that make up construct validity.'" ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "'There are four types of reliability: student-related ... rater-related ... test administration-related ... and test-related.'" ;
    owl:members ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "'There are several general classes of reliability estimates: Inter-rater ... Test-retest ... Inter-method ... Internal consistency.'" ;
    owl:members ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueScore ea:ErrorScore ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ClassicalTestTheory ea:ItemResponseTheory ea:RaschModel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AimLearningOutcome ea:ObjectiveLearningOutcome ea:UnintendedLearningOutcome ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:BloomsTaxonomy ea:StructureOfObservedLearningOutcome ea:DIKWPyramid ea:ModelOfHierarchicalComplexity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:FormalLearning ea:NonFormalLearning ea:InformalLearning ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AchievementTest ea:AptitudeTest ea:CollegeAdmissionsTest ea:InternationalComparisonTest ea:PsychologicalTest ) .

