@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:comment """Ontology of educational assessment built from a corpus that classifies
  assessment along several independent, mostly-orthogonal axes (purpose, response format,
  referencing, formality, administering authority, standardization, stakes) and that also
  contains internally conflicting classification claims (e.g. diagnostic assessment as a
  coordinate sibling of formative assessment vs. diagnostic as a subtype of formative;
  construct validity as a coordinate category vs. construct validity subsuming all other
  validity types; performance-based assessment vs. authentic assessment as disjoint
  coordinate kinds vs. the claim that they 'may also be called' the same thing; rubrics
  classified as a 3-way coordinate partition vs. developmental rubric being a subset of
  analytic rubric; value-added measure and growth measure treated as synonyms vs. as
  distinct). Per modeling instructions, both sides of each conflict are asserted and
  flagged with rdfs:comment rather than silently resolved; this intentionally renders
  some classes jointly unsatisfiable, mirroring the source disagreement. The corpus also
  explicitly states that a single test can have multiple simultaneous qualities across
  different axes ('Most tests can be classified on multiple categories'), so classes
  belonging to DIFFERENT axes are never asserted disjoint; only classes enumerated as
  alternatives WITHIN the same axis are made disjoint.""" .

ea:CapstonePortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio .

ea:CommonAssessment a owl:Class ;
    rdfs:comment "Shares format and administration across teachers/classrooms for consistency; may be formative or summative." ;
    rdfs:subClassOf ea:Assessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading and academic reporting based on students demonstrating learned knowledge/skills; many synonymous terms are used interchangeably by the corpus." ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based learning",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and the top n are selected." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "An assessment that requires a rubric and an expert examiner, e.g. a thesis or funding proposal." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates progress throughout a course; often includes some form of formative assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio ;
    skos:altLabel "e-portfolio" .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringAuthority ;
                        owl:someValuesFrom ea:ExternalAuthorityCategory ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExamination a owl:Class ;
    rdfs:comment "A greater form of a 'unit test' given at the conclusion of a course." ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document and a numerical score or grade based on student performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:FutureOrientation ] ) ] .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with a desired reward or important consequence for performance; defined by its function (how results are used), not its form." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] ;
    skos:altLabel "high-stakes assessment" .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Does not contribute to a student's final grade; e.g. observation, checklists, rubrics used informally." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:comment "Used to monitor progress toward summative benchmarks; some educators consider it formative, others summative - corpus leaves this an open disagreement rather than resolving it." ;
    rdfs:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school/teachers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringAuthority ;
                        owl:someValuesFrom ea:InternalAuthorityCategory ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:LowStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "A criterion-referenced test involving a cutscore where the examinee passes if the score exceeds the cutscore." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CriterionReferencedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasCutScore ;
                        owl:someValuesFrom xsd:decimal ] ) ] .

ea:MathItem a owl:Class ;
    rdfs:comment "Mathematics/calculation question scored more for steps than final answer." ;
    rdfs:subClassOf ea:TestItem .

ea:Midterm a owl:Class ;
    rdfs:comment "An exam given near the middle of an academic term; the corpus states it 'is a type of formative or summative assessment' (either, not necessarily both)." ;
    rdfs:subClassOf ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Flexible in scope and format, variable in difficulty." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:NormReferencedTest a owl:Class ;
    rdfs:comment "Yields an estimate of the position of the tested individual in a predefined population." ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "NRT" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseType ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:subClassOf ea:InterMethodReliability .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually low stakes and formative." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:Test .

ea:Recast a owl:Class ;
    rdfs:comment "Subtle correction of a young child's spoken errors by a parent/caregiver (motherese)." ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ScreeningAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment .

ea:Simulation a owl:Class ;
    rdfs:subClassOf ea:PerformanceTest .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Treats two halves of a measure as alternate forms, stepped up via Spearman-Brown formula." ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:comment "TENSION: the corpus later states 'Student growth measures are a related-but-distinct method' from value-added measures, contradicting the earlier treatment of 'value-added measures' and 'growth measures' as the same term (see altLabel on ea:ValueAddedMeasure)." ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure ;
    owl:disjointWith ea:ValueAddedMeasure .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseType ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to a scoring guide covering several criteria; comes close to analytic scoring methods, yet 'remains holistic at heart' since a single final score is produced." ;
    rdfs:subClassOf ea:HolisticGrading .

ea:ValidityCategory a owl:Class ;
    rdfs:comment "Models the passage stating evidence is gauged through content validity, criterion validity, construct validity, plus consequential and face validity, treated as coordinate categories of evidence." ;
    owl:disjointUnionOf [ rdf:rest [ rdf:rest ( ea:ConstructValidity ea:ConsequentialValidity ea:FaceValidity ) ] ] .

ea:hasAssessor a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Assessor .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:comment "An incorrect option." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:TestItemOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasErrorSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:ErrorSourceCategory .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasMeasurementTiming a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ea:TimingCategory .

ea:hasOutputFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ea:OutputCategory .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasStem a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:string .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:hasValidityCoefficient a owl:DatatypeProperty ;
    rdfs:domain ea:Validity ;
    rdfs:range xsd:decimal .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AdministeringAuthorityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalAuthorityCategory ea:ExternalAuthorityCategory ) .

ea:AnalyticGrading a owl:Class ;
    rdfs:comment "Takes more factors into account separately when assigning a grade; contrasts with holistic grading." ;
    rdfs:subClassOf ea:Grading .

ea:AnalyticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Forward-looking: attempts to predict future ability to succeed." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:FutureOrientation ] ) ] .

ea:Assessor a owl:Class ;
    owl:disjointUnionOf ( ea:TeacherAssessor ea:PeerAssessor ea:LearnerAssessor ) .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ConsequentialValidity a owl:Class .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:subClassOf ea:Feedback .

ea:CourseGranularity a owl:Class .

ea:CriterionReferencedAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "standards-based assessment" .

ea:CriterionReferencedScoreInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretation .

ea:DataReportingMeasurementError a owl:Class ;
    rdfs:comment "Errors introduced when collecting and calculating data-based reports, figures and statistics about schools and students." ;
    rdfs:subClassOf ea:MeasurementError .

ea:DiagnosticPurpose a owl:Class .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity a owl:Class .

ea:ErrorSourceCategory a owl:Class ;
    rdfs:comment "TENSION: the corpus separately states 'There are four types of reliability: student-related, rater-related, test administration-related, and test-related' (an error-source classification) AND 'There are several general classes of reliability estimates: inter-rater, test-retest, inter-method, internal consistency' (a method classification). Both are modeled as independent axes of ea:Reliability, since the corpus itself calls both of them 'types of reliability' without reconciling them." ;
    owl:disjointUnionOf ( ea:StudentRelatedErrorSource ea:RaterRelatedErrorSource ea:TestAdministrationRelatedErrorSource ea:TestRelatedErrorSource ) .

ea:EssayItem a owl:Class ;
    rdfs:comment "An open-ended question requiring a prose response, graded for factual correctness, persuasiveness, style and mastery." ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "essay question",
        "free response question" .

ea:ExpertExaminer a owl:Class ;
    rdfs:subClassOf ea:Examiner .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:FaceValidity a owl:Class .

ea:Feedback a owl:Class .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation" .

ea:GranularityLevel a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:HolisticGrading a owl:Class ;
    rdfs:comment "Bases a grade on a paper's overall quality, treating the composition as a whole." ;
    rdfs:subClassOf ea:Grading ;
    owl:disjointWith ea:AnalyticGrading ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:HolisticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:InstitutionGranularity a owl:Class .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "aim" .

ea:InterRaterReliability a owl:Class ;
    rdfs:comment "Degree of agreement between two or more raters." ;
    rdfs:subClassOf ea:Reliability .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:LaterTimeTiming a owl:Class .

ea:LearnerAssessor a owl:Class ;
    rdfs:label "Learner (self) assessor" .

ea:LearnerGranularity a owl:Class .

ea:LearningCommunityGranularity a owl:Class .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "objective" .

ea:MultipleChoiceItem a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:onClass ea:TestItemOption ;
                        owl:onProperty ea:hasKey ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:altLabel "MCQ",
        "multiple choice question",
        "objective response" .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, contrasting with MultipleChoiceItem." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:TestItemOption ;
                        owl:onProperty ea:hasKey ] ) ] .

ea:NormReferencedAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "normative assessment" .

ea:NormReferencedScoreInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretation .

ea:OutputCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ProductOutput ea:PerformanceOutput ) .

ea:PastOrientation a owl:Class .

ea:PeerAssessor a owl:Class .

ea:PerformanceOutput a owl:Class .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than answer questions about it." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "work sample" .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment .

ea:ProductOutput a owl:Class .

ea:ProgramGranularity a owl:Class .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:RaterRelatedErrorSource a owl:Class .

ea:ReferencingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:SameTimeTiming a owl:Class .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:StudentRelatedErrorSource a owl:Class .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:TeacherAssessor a owl:Class .

ea:TemporalOrientationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PastOrientation ea:FutureOrientation ) .

ea:TestAdministrationRelatedErrorSource a owl:Class .

ea:TestMeasurementError a owl:Class ;
    rdfs:comment "Difference between what a test score indicates and a student's actual knowledge/abilities." ;
    rdfs:subClassOf ea:MeasurementError .

ea:TestRelatedErrorSource a owl:Class .

ea:TestRetestReliability a owl:Class ;
    rdfs:comment "Degree to which test scores are consistent from one administration to the next by a single rater." ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability" .

ea:TimingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:SameTimeTiming ea:LaterTimeTiming ) .

ea:TrueFalseItem a owl:Class ;
    rdfs:comment "TENSION: listed here as a coordinate objective item type alongside MultipleChoiceItem/MultipleResponseItem/MatchingItem. Elsewhere the corpus describes 'two families' of multiple-choice question where the 'True/False family' requires choosing ALL appropriate answers (conceptually equivalent to MultipleResponseItem) and the 'One-Best-Answer family' requires a single answer (conceptually equivalent to MultipleChoiceItem) - i.e. True/False is there treated as a family of multiple choice rather than a sibling item type." ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Initially introduced as synonymous with 'growth measure' ('Value-added measures, or growth measures'), but see ea:StudentGrowthMeasure for the corpus's later claim that these are distinct." ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure ;
    skos:altLabel "growth measure" .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasExaminer a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Examiner .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria regardless of other examinees' scores; it is possible for all, or none, to pass." ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "CRT" .

ea:Examiner a owl:Class .

ea:ExternalAuthorityCategory a owl:Class .

ea:FormalCategory a owl:Class .

ea:FormativePurpose a owl:Class .

ea:Grading a owl:Class .

ea:InformalCategory a owl:Class .

ea:InterMethodReliability a owl:Class ;
    rdfs:comment "Degree to which scores are consistent when the methods/instruments vary; termed parallel-forms reliability when dealing with forms." ;
    rdfs:subClassOf ea:Reliability .

ea:InternalAuthorityCategory a owl:Class .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:comment "Consistency of results across items within a test (e.g. Cronbach's alpha)." ;
    rdfs:subClassOf ea:Reliability .

ea:IpsativeReferencing a owl:Class .

ea:LowStakesCategory a owl:Class .

ea:MeasurementError a owl:Class ;
    owl:disjointUnionOf ( ea:TestMeasurementError ea:DataReportingMeasurementError ) .

ea:NonStandardizedCategory a owl:Class .

ea:PlacementPurpose a owl:Class .

ea:Portfolio a owl:Class ;
    rdfs:subClassOf ea:PortfolioBasedAssessment .

ea:ResponseCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:ScoreInterpretation a owl:Class ;
    owl:disjointUnionOf ( ea:NormReferencedScoreInterpretation ea:CriterionReferencedScoreInterpretation ) .

ea:StandardizedCategory a owl:Class .

ea:SummativePurpose a owl:Class .

ea:TeacherEvaluationMeasure a owl:Class .

ea:hasAdministeringAuthority a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministeringAuthorityCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasItemResponseType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:ResponseCategory .

ea:hasKey a owl:ObjectProperty ;
    rdfs:comment "The option(s) marked correct." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:TestItemOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:TestItemOption .

ea:hasResponseType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ResponseCategory .

ea:hasStandardizationStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationCategory .

ea:hasTemporalOrientation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TemporalOrientationCategory .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "Convergent and discriminant validity are the two subtypes of validity that make up construct validity.",
        "TENSION: one passage enumerates content/criterion/construct validity (plus consequential and face validity) as coordinate, disjoint categories of validity evidence (see ea:ValidityCategory). A later passage states construct validity 'subsumes all other types of validity', and that 'construct validity is not distinct from support for the substantive theory'. Both claims are modeled: the disjoint union above, and the subClassOf assertions making ContentValidity and CriterionValidity subtypes of ConstructValidity, which is logically inconsistent with the disjoint union - intentionally, per corpus conflict." ;
    rdfs:subClassOf ea:Validity ;
    owl:disjointUnionOf ( ea:ConvergentValidity ea:DiscriminantValidity ) .

ea:CriterionReferencing a owl:Class .

ea:FutureOrientation a owl:Class .

ea:HighStakesCategory a owl:Class .

ea:ObjectiveCategory a owl:Class .

ea:SubjectiveCategory a owl:Class .

ea:SubjectiveItem a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasItemResponseType ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is supposed to measure." .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory .

ea:LearningOutcome a owl:Class ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:NormReferencing a owl:Class .

ea:ObjectiveItem a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasItemResponseType ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:Rubric a owl:Class ;
    owl:disjointUnionOf [ rdf:first ea:HolisticRubric ;
            rdf:rest [ rdf:first ea:AnalyticRubric ;
                    rdf:rest [ rdf:rest () ] ] ] .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent or standard manner for all test takers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] ;
    skos:altLabel "standardized assessment" .

ea:TestItemOption a owl:Class .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; a reliable assessment consistently achieves the same results with the same/similar cohort." .

ea:TestItem a owl:Class ;
    rdfs:label "Test item" .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "An examination (exam or evaluation), or test, is an educational assessment intended to measure knowledge, skill, aptitude etc. NOTE: the corpus's top-level passage also uses 'evaluation' as a synonym of the broad Assessment class, creating a terminological tension with 'evaluation' also being used here as a synonym of the narrower Test class." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Evaluation",
        "Exam",
        "Examination" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning. Often used interchangeably with 'test' but not limited to tests." ;
    skos:altLabel "educational evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AptitudeTest ea:CollegeAdmissionsTest ea:InternationalComparisonTest ea:PsychologicalTest ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ExtendedResponseItem ea:EssayItem ea:ShortAnswerItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

