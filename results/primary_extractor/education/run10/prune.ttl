@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" .

ea:AnalyticScoring a owl:Class ;
    rdfs:comment "Involves criterion-by-criterion judgments, taking more factors into account when assigning a grade." ;
    rdfs:subClassOf ea:ScoringMethod ;
    skos:altLabel "analytic grading" .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside of the school setting." ;
    rdfs:subClassOf ea:Assessment .

ea:CommonAssessment a owl:Class ;
    rdfs:comment "Shared-format assessment used across a school or district to encourage consistent evaluation; may be formative or summative." ;
    rdfs:subClassOf ea:Assessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating they have learned expected knowledge and skills." ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based education",
        "proficiency-based learning",
        "standards-based education" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked according to grade/percentile and top rankers selected." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:NormReferencedAssessment ea:HighStakesTest ) ] .

ea:ConfoundingVariable a owl:Class ;
    rdfs:subClassOf ea:ThreatToValidity .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:comment "A principle for devising teaching/learning activities and assessment tasks that directly address intended learning outcomes." .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "An educational examination that evaluates a student's progress throughout a prescribed course, often used as an alternative to a final examination." ;
    rdfs:subClassOf ea:ExaminationTest .

ea:ConvergentValidity a owl:Class ;
    rdfs:comment "Degree to which two measures of constructs that theoretically should be related are, in fact, related." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ConstructValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasConstructRelationType ;
                        owl:someValuesFrom ea:ConvergentRelation ] ) ] .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Nonevaluative, supportive, timely, and specific feedback on a learner's understanding or performance." ;
    rdfs:subClassOf ea:Feedback .

ea:DiscriminantValidity a owl:Class ;
    rdfs:comment "Tests whether concepts or measurements that are supposed to be unrelated are, in fact, unrelated." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ConstructValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasConstructRelationType ;
                        owl:someValuesFrom ea:DiscriminantRelation ] ) ] .

ea:ExperimentalDesignBias a owl:Class ;
    rdfs:subClassOf ea:ThreatToValidity .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by a governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:ExternalSource ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:comment "Provides identifying characteristics and requires the test taker to recall the correct term to fill a blank; may or may not supply a word bank." ;
    rdfs:subClassOf ea:ObjectiveQuestionItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "A final review and assessment of topics covered, given at the conclusion of a course." ;
    rdfs:subClassOf ea:ExaminationTest .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document and is given a numerical score or grade based on student performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HypothesisGuessing a owl:Class ;
    rdfs:subClassOf ea:ThreatToValidity .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Occurs more casually and does not contribute to a student's final grade." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:comment "Used to evaluate learning progress and determine whether students are on track for future summative assessments; some educators consider these formative, others summative - contested classification noted in the corpus." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "benchmark assessment" .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school (teachers)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:InternalSource ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:KnownGroupsTechnique a owl:Class ;
    rdfs:subClassOf ea:ValidityEvaluationMethod .

ea:LowStakesTest a owl:Class ;
    rdfs:comment "A test whose results carry no significant or public consequences." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ExaminationTest [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakes ] ) ] .

ea:MidtermExam a owl:Class ;
    rdfs:comment "An exam given near the middle of an academic grading term; may be formative or summative." ;
    rdfs:subClassOf ea:ExaminationTest .

ea:MultitraitMultimethodMatrix a owl:Class ;
    rdfs:subClassOf ea:ValidityEvaluationMethod ;
    skos:altLabel "MTMM" .

ea:NomologicalNetwork a owl:Class ;
    rdfs:comment "Defines a construct by illustrating its relation to other constructs and behaviors." ;
    rdfs:subClassOf ea:ValidityEvaluationMethod .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Significantly different tests are given to different test takers, or the same test is given/graded under significantly different conditions." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ExaminationTest [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationConsistency ;
                        owl:someValuesFrom ea:NonStandardizedConsistency ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAnswerMultiplicity ;
                        owl:someValuesFrom ea:SingleCorrectAnswerCategory ] ) ] .

ea:PeerAssessment a owl:Class ;
    rdfs:comment "Peer assessments allow students to use one another as learning resources; an example of formative assessment." ;
    rdfs:subClassOf ea:FormativeAssessment .

ea:PilotStudy a owl:Class ;
    rdfs:subClassOf ea:ValidityEvaluationMethod .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment" ;
    rdfs:comment "Used to place students according to prior achievement or level of knowledge at the most appropriate point in an instructional sequence; conducted before instruction to establish a baseline." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "TKT",
        "initial assessment",
        "placement evaluation",
        "pre-assessment",
        "threshold knowledge test" .

ea:ProficiencyLevel a owl:Class ;
    rdfs:comment "A level, scale, or cut-off score on a standardized test or other assessment used to determine proficiency." .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material, often formative and low-stakes." ;
    rdfs:subClassOf ea:ExaminationTest .

ea:RandomError a owl:Class ;
    rdfs:comment "Error component assumed to behave like a random variable across large numbers of individuals." .

ea:ResearcherExpectancyEffect a owl:Class ;
    rdfs:subClassOf ea:ThreatToValidity .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Results when student scores increase without a genuine corresponding improvement in learning." .

ea:ScreeningAssessment a owl:Class ;
    rdfs:comment "Used to determine whether students need specialized assistance/services or are ready to begin a course, grade level, or program." ;
    rdfs:subClassOf ea:Assessment .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Treats the two halves of a measure as alternate forms; estimate stepped up via the Spearman-Brown formula." ;
    rdfs:subClassOf ea:ParallelFormsReliability .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAnswerMultiplicity ;
                        owl:someValuesFrom ea:MultipleCorrectAnswerCategory ] ) ] .

ea:SubjectiveQuestionItem a owl:Class ;
    rdfs:comment "Subjective questions include extended-response and essay questions." ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointUnionOf ( ea:EssayItem ea:ShortAnswerItem ) .

ea:SystematicError a owl:Class ;
    rdfs:comment "Error component representing consistent, non-random discrepancies between observed and true scores." .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a scoring guide with several criteria; comes close to analytic scoring methods but remains holistic at heart, asking raters to take all traits into account before deciding on a single final score." ;
    rdfs:subClassOf ea:HolisticScoring .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Score which an examinee must exceed to pass a mastery test; the criterion itself is the subject-matter domain, not the cutscore." ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range xsd:decimal .

ea:hasErrorValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasEvaluationMethod a owl:ObjectProperty ;
    rdfs:domain ea:ConstructValidity ;
    rdfs:range ea:ValidityEvaluationMethod .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, an academic program, the institution, or the educational system as a whole (granularity)." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityCategory .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:ExaminationTest ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasMeasurementTheory a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementTheory .

ea:hasNormGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasObservedScoreValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:AnswerOption .

ea:hasOutputFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:PerformanceOutputCategory .

ea:hasPercentileRank a owl:DatatypeProperty ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range xsd:decimal .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Ratio of true score variance to total variance of test scores; ranges from 0 (completely unreliable) to 1 (completely reliable)." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasReliabilitySource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:ReliabilitySourceCategory .

ea:hasScore a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestScore .

ea:hasScoringMethod a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringMethod .

ea:hasThreat a owl:ObjectProperty ;
    rdfs:domain ea:ConstructValidity ;
    rdfs:range ea:ThreatToValidity .

ea:hasTiming a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ea:CriterionTimingCategory .

ea:hasTrueScoreValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:hasValueAddedMeasure a owl:ObjectProperty ;
    rdfs:domain ea:TeacherEvaluation ;
    rdfs:range ea:ValueAddedMeasure .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasItem .

ea:AchievementTest a owl:Class ;
    rdfs:comment "Measures the knowledge and skills students learned in school; backward-looking." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AnalyticRubric a owl:Class ;
    rdfs:comment "Evaluates various dimensions or components of the work separately." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasEvaluationGranularity ;
                        owl:someValuesFrom ea:AnalyticGranularity ] ) ] .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Attempts to predict a student's ability to succeed in an intellectual or physical endeavor; forward-looking." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ClassicalTestTheory a owl:Class ;
    rdfs:subClassOf ea:MeasurementTheory .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "Requires a rubric and an expert examiner; example items include a thesis or funding proposal." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ConcurrentTiming a owl:Class ;
    rdfs:subClassOf ea:CriterionTimingCategory .

ea:ConsequentialEvidence a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidenceCategory .

ea:ContentEvidence a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidenceCategory .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:CriterionEvidence a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidenceCategory .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria rather than against other candidates." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "CRT",
        "criterion-referenced test",
        "mastery test",
        "standards-based assessment" .

ea:DataReportingMeasurementError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:EssayItem a owl:Class ;
    rdfs:comment "An open-ended question requiring a prose response, also graded for persuasiveness, style, and mastery." ;
    skos:altLabel "FRQ",
        "essay question",
        "extended-response question",
        "free response question" .

ea:FaceEvidence a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidenceCategory .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment" ;
    rdfs:comment "Conducted during the learning process to modify teaching and learning activities to improve student attainment." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation",
        "formative feedback" .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with a desired reward for good performance, or more generally any test used to make important decisions about students, educators, schools, or districts." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ExaminationTest [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakes ] ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:comment "Provides an overall rating for a piece of work, considering all aspects." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasEvaluationGranularity ;
                        owl:someValuesFrom ea:HolisticGranularity ] ) ] .

ea:HolisticScoring a owl:Class ;
    rdfs:comment "Bases a grade on a paper's overall quality rather than counting errors; contrasts with analytic grading." ;
    rdfs:subClassOf ea:ScoringMethod ;
    skos:altLabel "holistic grading",
        "nonreductionist grading" .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "aim" .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:comment "Assesses the consistency of results across items within a test; commonly measured with Cronbach's alpha." .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest ;
    skos:altLabel "international benchmark test" .

ea:ItemResponseTheory a owl:Class ;
    rdfs:subClassOf ea:MeasurementTheory .

ea:LearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:MatchingItem a owl:Class ;
    rdfs:comment "Objective item type requiring the test taker to match related items." .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "objective" .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group" ;
    rdfs:comment "A sample drawn from the population used to derive the estimate of relative position in norm-referenced assessment." ;
    skos:altLabel "norming group" .

ea:ObjectiveQuestionItem a owl:Class ;
    rdfs:comment "Objective question types include true/false, multiple-choice, multiple-response, and matching questions." ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointUnionOf [ rdf:rest [ rdf:first ea:MultipleChoiceItem ;
                    rdf:rest [ rdf:rest ( ea:MatchingItem ) ] ] ] .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:comment "When dealing with alternate forms, inter-method reliability may be termed parallel-forms reliability." ;
    rdfs:subClassOf ea:InterMethodReliability .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity, often with real-world application, rather than simply answering questions about it. Similar to summative assessment in that it focuses on achievement." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "performance assessment",
        "performance test" .

ea:PerformanceOutput a owl:Class ;
    rdfs:comment "E.g. a speech, athletic skill, musical recital, or reading." ;
    rdfs:subClassOf ea:PerformanceOutputCategory .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:comment "Assessment based on evaluation of a student portfolio." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasInstrument ;
                        owl:someValuesFrom ea:StudentPortfolio ] ) ] .

ea:PredictiveTiming a owl:Class ;
    rdfs:subClassOf ea:CriterionTimingCategory .

ea:ProductOutput a owl:Class ;
    rdfs:comment "E.g. a painting, portfolio, paper, or exhibition." ;
    rdfs:subClassOf ea:PerformanceOutputCategory .

ea:ProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:RaschModel a owl:Class ;
    rdfs:comment "Provides a strict correspondence between total score ordering and scale-location ordering, provided all students attempt the same items or are marked using the same rubric." ;
    rdfs:subClassOf ea:MeasurementTheory .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:comment "Includes bias and subjectivity." ;
    rdfs:subClassOf ea:ReliabilitySourceCategory .

ea:ReliabilityEstimateCategory a owl:Class ;
    rdfs:comment "Several general classes of reliability estimates." ;
    owl:disjointUnionOf ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

ea:ShortAnswerItem a owl:Class ;
    rdfs:comment "Requires a test taker to write a brief response." .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:comment "Includes personal problems, sickness, or fatigue." ;
    rdfs:subClassOf ea:ReliabilitySourceCategory .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment" ;
    rdfs:comment "Carried out at the end of a course or project to evaluate learning against a standard or benchmark." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:TeacherEvaluation a owl:Class ;
    rdfs:comment "Assessment of educational faculty by a supervisor to determine level of performance, meeting accountability needs." ;
    rdfs:subClassOf ea:SummativeAssessment .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:comment "Concerns the conditions of the test-taking process." ;
    rdfs:subClassOf ea:ReliabilitySourceCategory .

ea:TestRelatedReliability a owl:Class ;
    rdfs:comment "Related to the nature of a test." ;
    rdfs:subClassOf ea:ReliabilitySourceCategory .

ea:TestRetestReliability a owl:Class ;
    rdfs:comment "Assesses the degree to which test scores are consistent from one test administration to the next, using a single rater/instrument under the same conditions." ;
    skos:altLabel "repeatability" .

ea:TestScoreMeasurementError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:comment "Beneficial outcomes that were neither planned nor sought but are simply observed." ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Used to estimate how much of a positive or negative effect individual teachers have on student learning during a school year, using standardized-test results." ;
    skos:altLabel "growth measure" .

ea:hasEvidenceCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:ValidityEvidenceCategory .

ea:hasExaminer a owl:ObjectProperty ;
    rdfs:domain ea:ComplexAssessment ;
    rdfs:range ea:ExpertExaminer .

ea:hasInstrument a owl:ObjectProperty ;
    rdfs:domain ea:PortfolioBasedAssessment ;
    rdfs:range ea:StudentPortfolio .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestItem .

ea:hasKey a owl:ObjectProperty ;
    rdfs:comment "Only one answer may be keyed as correct in a multiple-choice item." ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:AnswerOption .

ea:hasReliabilityEstimateClass a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:ReliabilityEstimateCategory .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:AnalyticGranularity a owl:Class ;
    rdfs:subClassOf ea:EvaluationGranularityCategory .

ea:AnswerOption a owl:Class ;
    rdfs:comment "A possible answer offered within a multiple-choice item; the correct one is called the key, incorrect ones are distractors." .

ea:ConstructEvidence a owl:Class ;
    rdfs:subClassOf ea:ValidityEvidenceCategory .

ea:ConvergentRelation a owl:Class ;
    rdfs:subClassOf ea:ConstructRelationCategory .

ea:CriterionReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:DiscriminantRelation a owl:Class ;
    rdfs:subClassOf ea:ConstructRelationCategory .

ea:ExpertExaminer a owl:Class ;
    rdfs:comment "An expert examiner required to evaluate a complex assessment." .

ea:ExternalSource a owl:Class ;
    rdfs:subClassOf ea:AdministrationSourceCategory .

ea:Feedback a owl:Class ;
    rdfs:comment "Information provided to a learner about their understanding or performance." .

ea:FormalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HighStakes a owl:Class ;
    rdfs:subClassOf ea:StakesLevelCategory .

ea:HolisticGranularity a owl:Class ;
    rdfs:subClassOf ea:EvaluationGranularityCategory .

ea:InformalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterMethodReliability a owl:Class ;
    rdfs:comment "Assesses the degree to which test scores are consistent when there is a variation in the methods or instruments used." .

ea:InterRaterReliability a owl:Class ;
    rdfs:comment "Assesses the degree of agreement between two or more raters in their appraisals." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasReliabilityEstimateClass ;
                        owl:someValuesFrom ea:InterRaterReliability ] ) ] .

ea:InternalSource a owl:Class ;
    rdfs:subClassOf ea:AdministrationSourceCategory .

ea:IpsativeReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:LowStakes a owl:Class ;
    rdfs:subClassOf ea:StakesLevelCategory .

ea:MeasurementError a owl:Class ;
    rdfs:comment "Either the difference between what a test score indicates and a student's actual knowledge, or errors introduced when collecting and calculating data-based reports." ;
    owl:disjointUnionOf ( ea:TestScoreMeasurementError ea:DataReportingMeasurementError ) .

ea:MultipleCorrectAnswerCategory a owl:Class ;
    rdfs:subClassOf ea:AnswerMultiplicityCategory .

ea:NonStandardizedConsistency a owl:Class ;
    rdfs:subClassOf ea:AdministrationConsistencyCategory .

ea:NormReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:SingleCorrectAnswerCategory a owl:Class ;
    rdfs:subClassOf ea:AnswerMultiplicityCategory .

ea:StandardizedConsistency a owl:Class ;
    rdfs:subClassOf ea:AdministrationConsistencyCategory .

ea:StudentPortfolio a owl:Class ;
    rdfs:comment "A compilation of academic work and other educational evidence assembled over time." ;
    skos:altLabel "digital portfolio",
        "e-portfolio" .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:hasAdministrationConsistency a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ExaminationTest ;
    rdfs:range ea:AdministrationConsistencyCategory .

ea:hasAdministrationSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationSourceCategory .

ea:hasAnswerMultiplicity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AnswerMultiplicityCategory .

ea:hasConstructRelationType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ConstructValidity ;
    rdfs:range ea:ConstructRelationCategory .

ea:hasEvaluationGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:EvaluationGranularityCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ExaminationTest ;
    rdfs:range ea:StakesLevelCategory .

ea:AdministrationConsistencyCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedConsistency ea:NonStandardizedConsistency ) .

ea:AdministrationSourceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalSource ea:ExternalSource ) .

ea:AnswerMultiplicityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:SingleCorrectAnswerCategory ea:MultipleCorrectAnswerCategory ) .

ea:ConstructRelationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ConvergentRelation ea:DiscriminantRelation ) .

ea:CriterionTimingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ConcurrentTiming ea:PredictiveTiming ) .

ea:EvaluationGranularityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HolisticGranularity ea:AnalyticGranularity ) .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item" ;
    rdfs:comment "Consists of a stem and several alternative answers (options); the test taker selects only the correct answer." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ea:hasKey ] ;
    skos:altLabel "MCQ",
        "multiple choice question",
        "objective response" .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Yields an estimate of the position of the tested individual relative to a predefined population (norm group)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "NRT",
        "norm-referenced test",
        "normative assessment" .

ea:PerformanceOutputCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ProductOutput ea:PerformanceOutput ) .

ea:ScoringMethod a owl:Class ;
    rdfs:comment "A method used to assign a score to a constructed response." .

ea:StakesLevelCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which evidence and theory support the interpretations of test scores; the extent to which a measurement measures what it claims to measure." .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "A statement about what students should be able to do by the end of a teaching session." ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:MeasurementTheory a owl:Class ;
    rdfs:comment "Approaches drawn on in educational measurement, originally developed for the analysis of data from educational assessments." ;
    owl:disjointUnionOf ( ea:ClassicalTestTheory ea:ItemResponseTheory ea:RaschModel ) .

ea:ReferencingCategory a owl:Class ;
    rdfs:comment "Test results can be compared against an established criterion, against the performance of other students (norm), or against previous performance (ipsative)." ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:TestItem a owl:Class ;
    rdfs:comment "A component question/prompt of an assessment; the more general term preferred over 'question' since not all items are phrased as questions." .

ea:TestScore a owl:Class ;
    rdfs:comment "An observed test score, decomposable into a true score and an error component: X = T + E." .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "The extent to which operationalizations of a construct measure the construct as defined by a theory. Explicitly stated to 'subsume all other types of validity'." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasEvidenceCategory ;
                        owl:someValuesFrom ea:ConstructEvidence ] ) ] .

ea:PurposeCategory a owl:Class ;
    rdfs:comment "Value partition for assessment purpose, per the coordinate list 'placement, formative, summative and diagnostic assessment'." ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error." .

ea:ReliabilitySourceCategory a owl:Class ;
    rdfs:comment "There are four types of reliability, classified by source of inconsistency - a different classification criterion from the estimate-class scheme above, coexisting without reconciliation in the corpus." ;
    owl:disjointUnionOf ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses; contains evaluative criteria, quality definitions, and a scoring strategy." ;
    owl:disjointUnionOf [ rdf:first ea:HolisticRubric ;
            rdf:rest [ rdf:first ea:AnalyticRubric ;
                    rdf:rest [ rdf:rest () ] ] ] .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "A test that is administered and scored in a consistent or standard manner for all test takers." ;
    owl:disjointUnionOf ( ea:AchievementTest ea:AptitudeTest ea:CollegeAdmissionsTest ea:InternationalComparisonTest ea:PsychologicalTest ) ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ExaminationTest [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationConsistency ;
                        owl:someValuesFrom ea:StandardizedConsistency ] ) ] .

ea:ThreatToValidity a owl:Class ;
    rdfs:comment "A problem in hypothesis formulation or experimental design that can make apparent construct validity misleading." .

ea:ValidityEvaluationMethod a owl:Class ;
    rdfs:comment "A method used to accumulate evidence for construct validity." .

ea:ValidityEvidenceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ContentEvidence ea:CriterionEvidence ea:ConstructEvidence ea:FaceEvidence ea:ConsequentialEvidence ) .

ea:GranularityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:ExaminationTest a owl:Class ;
    rdfs:label "Examination" ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification in many other topics." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam",
        "examination",
        "test" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning." ;
    skos:altLabel "educational assessment",
        "educational evaluation",
        "evaluation" .

