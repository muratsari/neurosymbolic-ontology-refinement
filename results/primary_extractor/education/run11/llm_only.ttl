@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" ;
    rdfs:comment "Ontology modeling educational assessment classifications, validity, reliability, items, rubrics and related concepts as stated in the source corpus." .

ea:CapstoneProject a owl:Class ;
    rdfs:comment "Student work completed as part of a long-term project typically undertaken at the culmination of a program of study." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating they have learned expected knowledge and skills." ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based education",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked by grade/percentile and top rankers are selected." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:NormReferencedAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesType ] ) ] .

ea:ConcurrentValidity rdfs:comment "Comparison between the measure and an outcome assessed at the same time." ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:disjointWith ea:PredictiveValidity .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:comment "A principle for devising teaching/learning activities and assessment tasks that directly address intended learning outcomes (Biggs)." .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course, often used as an alternative to a final-examination system; will often include some form of formative assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity rdfs:comment "The degree to which two measures of constructs that theoretically should be related are, in fact, related." ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:disjointWith ea:DiscriminantValidity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Feedback on a learner's understanding or performance that, to be successful, needs to be nonevaluative, supportive, timely and specific." ;
    rdfs:subClassOf ea:Feedback .

ea:DemonstrationOfLearning a owl:Class ;
    rdfs:comment "A presentation of portfolios or other evidence of learning, publicly or privately, to parents, teachers, and community members." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment" ;
    rdfs:comment "TENSION: one passage lists Diagnostic assessment as a fourth coordinate category alongside Placement/Formative/Summative (hence disjoint via PurposeCategory), while another passage states 'a common form of formative assessment is diagnostic assessment' and the glossary defines formative assessment as 'including diagnostic testing' (hence subClassOf FormativeAssessment). Both axioms are asserted per corpus instructions, which renders this class formally unsatisfiable given the disjoint union of PurposeCategory -- this is an intentional encoding of the corpus's own conflicting classification." ;
    rdfs:subClassOf ea:FormativeAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:ErrorScore a owl:Class ;
    rdfs:comment "Composed of random error and systematic error; represents the discrepancy between observed and true scores." ;
    rdfs:subClassOf ea:Score ;
    skos:altLabel "measurement error" .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationLocus ;
                        owl:someValuesFrom ea:ExternalLocus ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:comment "Provides identifying characteristics and requires the test taker to recall the correct term; may or may not include a word bank." ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "A final review and assessment of topics covered in a course, essentially a larger unit test." ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "final" .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document and is given a numerical score or grade based on student performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalType ] ) ] .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with important consequences / desired reward for good performance." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesType ] ) ] .

ea:HolisticGrading a owl:Class ;
    rdfs:comment "Bases a grade on a paper's overall quality, treating the composition as a whole." ;
    rdfs:subClassOf ea:GradingApproach ;
    owl:disjointWith ea:AnalyticGrading ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Does not contribute to a student's final grade; may include observation, checklists, rubrics, etc." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalType ] ) ] .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school (teachers); students get the mark and feedback." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationLocus ;
                        owl:someValuesFrom ea:InternalLocus ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or compared to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:IpsativeReference ] ) ] .

ea:LowStakesTest a owl:Class ;
    rdfs:comment "Has low or no point value, e.g. ordinary classroom quizzes." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesType ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "A criterion-referenced test involving a cutscore: the examinee passes if the score exceeds the cutscore." ;
    rdfs:subClassOf ea:CriterionReferencedAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CriterionReferencedAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasCutScore ;
                        owl:someValuesFrom xsd:decimal ] ) ] .

ea:MeasurementError a owl:Class ;
    rdfs:comment "Either (1) the difference between a test score and a student's actual knowledge/abilities, or (2) errors introduced in collecting/calculating education data." .

ea:MidtermExam a owl:Class ;
    rdfs:comment "An exam given near the middle of an academic grading term; a type of formative or summative assessment." ;
    rdfs:subClassOf ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Significantly different tests given to different test takers, or same test under significantly different conditions/evaluation." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedType ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseDeterminacy ;
                        owl:someValuesFrom ea:ObjectiveResponseType ] ) ] .

ea:ObservedScore a owl:Class ;
    rdfs:comment "The actual obtained test score X. Equation: X = T + E, where T is the true score and E is the measurement error." ;
    rdfs:subClassOf ea:Score .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than answer questions about it, to ensure greater fidelity to what is being tested." ;
    rdfs:subClassOf ea:Test .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment" ;
    rdfs:comment "Used to place students according to prior achievement, conducted before instruction to establish a baseline. Generally not graded." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PortfolioAssessment a owl:Class ;
    rdfs:comment "A compilation of academic work and other evidence assembled to evaluate coursework quality, learning progress, and achievement." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment ;
    skos:altLabel "portfolio-based assessment",
        "student portfolio" .

ea:ProficiencyLevel a owl:Class ;
    rdfs:comment "A level or cut-off score on a standardized test or assessment against which student performance is judged." .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually provided as a formative assessment." ;
    rdfs:subClassOf ea:Test .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Student scores increase without genuine improvements in learning, due to flawed testing design or inadvertent/intentional inflation by educators." .

ea:ShortAnswerItem a owl:Class ;
    rdfs:comment "Requires a test taker to write a brief response to fulfil the requirements of the item." ;
    rdfs:subClassOf ea:TestItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Treats the two halves of a measure as alternate forms; a split-halves estimate is stepped up via the Spearman-Brown formula." ;
    rdfs:subClassOf ea:InterMethodReliability .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent or standard manner for all test takers." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedType ] ) ] .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer or way of expressing it." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasResponseDeterminacy ;
                        owl:someValuesFrom ea:SubjectiveResponseType ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment" ;
    rdfs:comment "Carried out at the end of a course or project to evaluate learning against a standard; typically graded." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning" .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a rubric with several criteria and levels; comes close to analytic scoring methods but 'remains holistic at heart', asking raters to take all traits into account before deciding on a single final score. Not axiomatized as subClassOf either HolisticGrading or AnalyticGrading because the corpus describes it as a hybrid." ;
    rdfs:subClassOf ea:GradingApproach .

ea:TrueScore a owl:Class ;
    rdfs:comment "The replicable feature of the concept being measured; the part of the observed score that would recur across measurement occasions absent error." ;
    rdfs:subClassOf ea:Score .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Used to estimate or quantify how much of a positive or negative effect individual teachers have on student learning during a school year, using statistical algorithms and standardized-test results." ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    rdfs:comment "Administered on paper or on a computer; the test taker responds by writing or typing." ;
    rdfs:subClassOf ea:Test .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, an academic program, the institution, or the educational system as a whole." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:comment "Learning outcomes are aligned to educational assessments via constructive alignment." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasNormGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasOutcomeType a owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:PerformanceOutcomeType .

ea:hasQualityAttribute a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:QualityAttribute .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Ranges from 0.00 (much error) to 1.00 (no error)." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasScoreValue a owl:DatatypeProperty ;
    rdfs:domain ea:Score ;
    rdfs:range xsd:decimal .

ea:hasValidityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Validity ;
    rdfs:range xsd:decimal .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AcademicProgramGranularity rdfs:subClassOf ea:GranularityLevel .

ea:AnalyticGrading a owl:Class ;
    rdfs:comment "Involves criterion-by-criterion judgments, taking more factors into account than holistic grading." ;
    rdfs:subClassOf ea:GradingApproach .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "The measurement of accomplishments within a realistic, practical context relevant outside of the school setting." ;
    rdfs:subClassOf ea:Assessment .

ea:ConsequentialValidity rdfs:subClassOf ea:Validity .

ea:ContentValidity rdfs:subClassOf ea:ConstructValidity,
        ea:Validity .

ea:CourseGranularity rdfs:subClassOf ea:GranularityLevel .

ea:DevelopmentalRubric rdfs:comment "TENSION: corpus states rubrics 'can be classified as holistic, analytic, or developmental' (coordinate, hence disjoint via the disjointUnion above) but also that developmental rubrics are 'a subset of analytical rubrics' (hence subClassOf AnalyticRubric). Both axioms are asserted; this renders DevelopmentalRubric formally unsatisfiable, reflecting the corpus's own inconsistency." ;
    rdfs:subClassOf ea:AnalyticRubric,
        ea:Rubric .

ea:DiscriminantValidity rdfs:comment "Tests whether concepts or measurements that are supposed to be unrelated are, in fact, unrelated." ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity rdfs:subClassOf ea:GranularityLevel .

ea:EssayItem a owl:Class ;
    rdfs:comment "An open-ended question requiring a prose response, graded for factual correctness and potentially persuasiveness and style." ;
    rdfs:subClassOf ea:SubjectiveQuestionType ;
    skos:altLabel "FRQ",
        "essay question",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveQuestionType .

ea:FaceValidity rdfs:subClassOf ea:ConstructValidity,
        ea:Validity .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment" ;
    rdfs:comment "Carried out throughout a course to provide feedback and modify teaching/learning; not necessarily graded." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment" .

ea:HolisticRubric rdfs:subClassOf ea:Rubric .

ea:InstitutionGranularity rdfs:subClassOf ea:GranularityLevel .

ea:IntendedLearningOutcome rdfs:subClassOf ea:LearningOutcome .

ea:InterRaterReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilityEstimationMethod .

ea:InternalConsistencyReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilityEstimationMethod .

ea:LearnerGranularity rdfs:subClassOf ea:GranularityLevel .

ea:LearningCommunityGranularity rdfs:subClassOf ea:GranularityLevel .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveQuestionType .

ea:MeasuredLearningOutcome rdfs:subClassOf ea:LearningOutcome .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Consists of a stem and alternative answers; only one answer may be keyed as correct." ;
    rdfs:subClassOf ea:ObjectiveQuestionType ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onClass ea:AnswerOption ;
                        owl:onProperty ea:hasCorrectOption ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:altLabel "MCQ",
        "multiple choice question" .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, in contrast to multiple-choice items." ;
    rdfs:subClassOf ea:ObjectiveQuestionType ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:AnswerOption ;
                        owl:onProperty ea:hasCorrectOption ] ) ] .

ea:NormGroup a owl:Class ;
    rdfs:comment "A sample drawn from a population used to derive norm-referenced score interpretations." ;
    skos:altLabel "norming group" .

ea:PerformanceOutcome rdfs:subClassOf ea:PerformanceOutcomeType .

ea:PredictiveValidity rdfs:comment "Comparison between the measure and an outcome assessed at a later time." ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductOutcome rdfs:subClassOf ea:PerformanceOutcomeType .

ea:RaterRelatedReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilitySourceType .

ea:StudentRelatedReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilitySourceType .

ea:TestAdministrationRelatedReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilitySourceType .

ea:TestRelatedReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilitySourceType .

ea:TestRetestReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilityEstimationMethod ;
    skos:altLabel "repeatability" .

ea:TrueFalseItem a owl:Class ;
    rdfs:comment "Requires a test taker to choose all answers that are appropriate (true/false family of multiple-choice questions)." ;
    rdfs:subClassOf ea:ObjectiveQuestionType .

ea:UnintendedLearningOutcome rdfs:subClassOf ea:LearningOutcome .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range xsd:decimal .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:AnalyticRubric rdfs:subClassOf ea:Rubric .

ea:CriterionReference rdfs:subClassOf ea:ReferenceTypeCategory .

ea:DiagnosticPurpose rdfs:subClassOf ea:PurposeCategory .

ea:ExternalLocus rdfs:subClassOf ea:AdministrationLocusCategory .

ea:Feedback a owl:Class ;
    rdfs:comment "Information given to a learner about their understanding or performance." .

ea:FormalType rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose rdfs:subClassOf ea:PurposeCategory .

ea:InformalType rdfs:subClassOf ea:FormalityCategory .

ea:InterMethodReliability rdfs:subClassOf ea:Reliability,
        ea:ReliabilityEstimationMethod ;
    skos:altLabel "parallel-forms reliability" .

ea:InternalLocus rdfs:subClassOf ea:AdministrationLocusCategory .

ea:IpsativeReference rdfs:subClassOf ea:ReferenceTypeCategory .

ea:LowStakesType rdfs:subClassOf ea:StakesCategory .

ea:NonStandardizedType rdfs:subClassOf ea:StandardizationCategory .

ea:NormReference rdfs:subClassOf ea:ReferenceTypeCategory .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Yields an estimate of the position of the tested individual relative to a predefined population (peers)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:NormReference ] ) ] ;
    skos:altLabel "NRT",
        "norm-referenced test",
        "normative assessment" .

ea:ObjectiveResponseType rdfs:subClassOf ea:ResponseDeterminacyCategory .

ea:PlacementPurpose rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedType rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveResponseType rdfs:subClassOf ea:ResponseDeterminacyCategory .

ea:SummativePurpose rdfs:subClassOf ea:PurposeCategory .

ea:hasAdministrationLocus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationLocusCategory .

ea:hasCorrectOption a owl:ObjectProperty ;
    rdfs:comment "Links an item to an option keyed as correct." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasResponseDeterminacy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ResponseDeterminacyCategory .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AdministrationLocusCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalLocus ea:ExternalLocus ) .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria rather than against other test takers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:CriterionReference ] ) ] ;
    skos:altLabel "CRT",
        "criterion-referenced test",
        "standards-based assessment" .

ea:CriterionValidity rdfs:subClassOf ea:ConstructValidity,
        ea:Validity .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalType ea:InformalType ) .

ea:GradingApproach a owl:Class ;
    rdfs:comment "An approach used to score constructed responses such as essays." .

ea:HighStakesType rdfs:subClassOf ea:StakesCategory .

ea:PerformanceOutcomeType a owl:Class ;
    owl:disjointUnionOf ( ea:ProductOutcome ea:PerformanceOutcome ) .

ea:QualityAttribute a owl:Class ;
    rdfs:comment "A measurable quality of an assessment, such as its reliability or validity." .

ea:ResponseDeterminacyCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveResponseType ea:SubjectiveResponseType ) .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesType ea:LowStakesType ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedType ea:NonStandardizedType ) .

ea:SubjectiveQuestionType a owl:Class ;
    rdfs:comment "Subjective questions include extended-response and essay questions." ;
    rdfs:subClassOf ea:TestItem .

ea:hasReferenceType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Note: corpus also states 'each method can be used to grade the same test paper', suggesting reference-type interpretation can vary per use even though it is modeled here as a single determining value." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferenceTypeCategory .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:AnswerOption a owl:Class ;
    rdfs:comment "A possible answer offered for a test item; the correct option is called the key, incorrect options are distractors." .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "A statement about what students should be able to do by the end of a teaching session." ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ObjectiveQuestionType a owl:Class ;
    rdfs:comment "Objective question types include true/false, multiple-choice, multiple-response, and matching questions." ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:SubjectiveQuestionType .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Similar to summative assessment in focusing on achievement; a well-defined task is identified and students create/produce/do something, often with real-world application. Performance formats are classified into products and performances." ;
    rdfs:subClassOf ea:Assessment ;
    skos:closeMatch ea:AuthenticAssessment .

ea:ReferenceTypeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReference ea:NormReference ea:IpsativeReference ) .

ea:ReliabilityEstimationMethod a owl:Class ;
    rdfs:comment "Several general classes of reliability estimates: inter-rater, test-retest, inter-method, and internal consistency." ;
    owl:disjointUnionOf ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

ea:ReliabilitySourceType a owl:Class ;
    rdfs:comment "Four types of reliability by source of error: student-related, rater-related, test-administration-related, and test-related." ;
    owl:disjointUnionOf ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses (Popham); contains evaluative criteria, quality definitions, and a scoring strategy." ;
    owl:disjointUnionOf ( ea:HolisticRubric ea:AnalyticRubric ea:DevelopmentalRubric ) .

ea:Score a owl:Class ;
    rdfs:comment "A quantified result of a test or assessment." .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Assessment is often divided into initial (placement), formative, and summative categories; diagnostic is also listed as a fourth coordinate category." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:ConstructValidity rdfs:comment "TENSION: one passage lists Content, Criterion, Construct, Face and Consequential validity as coordinate categories of evidence (encoded above as a disjoint union of Validity), while the dedicated Construct Validity passage states construct validity 'subsumes all other types of validity' (encoded here as ContentValidity, CriterionValidity and FaceValidity being subClassOf ConstructValidity). Both are asserted; combined with the disjoint union this renders those subclasses formally unsatisfiable, intentionally reflecting the corpus's own conflicting framing." ;
    rdfs:subClassOf ea:Validity .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure. Reliability does not imply validity, but a valid measure must be reliable." ;
    rdfs:subClassOf ea:QualityAttribute ;
    owl:disjointUnionOf ( ea:ContentValidity ea:CriterionValidity ea:ConstructValidity ea:FaceValidity ea:ConsequentialValidity ) .

ea:GranularityLevel a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment: a reliable assessment consistently achieves the same results with the same or similar cohort." ;
    rdfs:subClassOf ea:QualityAttribute .

ea:TestItem a owl:Class ;
    rdfs:comment "A component question, prompt, or task within a test; the more general term for what is colloquially called a 'question'." .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "Assessment is often used interchangeably with test but is not limited to tests. An examination (exam/evaluation) or test is an educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam",
        "examination" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on the knowledge, skill, attitudes, aptitude and beliefs of learners to refine programs and improve student learning." ;
    skos:altLabel "educational evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:EssayItem ea:ExtendedResponseItem ) .

