@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" .

ea:AchievementTest a owl:Class ;
    rdfs:comment "Measures knowledge/skills learned; backward-looking." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Attempts to predict future ability; forward-looking." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside the school setting. Corpus notes performance assessments 'may also be called authentic assessments'." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentContext ;
                        owl:someValuesFrom ea:RealisticContext ] ) ] .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:CompetencyBasedLearning a owl:Class ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based learning",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and only the top n candidates pass." ;
    rdfs:subClassOf ea:Examination,
        ea:HighStakesTest,
        ea:NormReferencedAssessment,
        ea:StandardizedTest .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "Requires a rubric and an expert examiner; example items include theses and funding proposals." ;
    rdfs:subClassOf ea:Assessment .

ea:ConcurrentValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:disjointWith ea:PredictiveValidity .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:comment "Principle for devising teaching/learning activities and assessment tasks that directly address intended learning outcomes." .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; often includes formative assessment, used as an alternative to final examination." ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:disjointWith ea:DiscriminantValidity .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio ;
    skos:altLabel "e-portfolio" .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "essay question",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by a governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringParty ;
                        owl:someValuesFrom ea:ExternalCategory ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "Makes a final review of topics covered and assesses each student's knowledge of the subject." ;
    rdfs:subClassOf ea:Examination,
        ea:SummativeAssessment .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document and is given a numerical score or grade." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HolisticScoring a owl:Class ;
    rdfs:subClassOf ea:ScoringMethod ;
    owl:disjointWith ea:AnalyticScoring ;
    skos:altLabel "holistic grading",
        "nonreductionist grading" .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Occurs more casually and does not contribute to a student's final grade." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterRaterReliability a owl:Class ;
    rdfs:comment "Degree of agreement between two or more raters." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasEstimationClass ;
                        owl:someValuesFrom ea:InterRaterCategory ] ) ] .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school/teachers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringParty ;
                        owl:someValuesFrom ea:InternalCategory ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest ;
    skos:altLabel "PIRLS",
        "PISA",
        "TIMSS" .

ea:IntraRaterReliability a owl:Class ;
    rdfs:comment "Explicitly included within test-retest reliability per the corpus." ;
    rdfs:subClassOf ea:TestRetestReliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time or comparative to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeCategory ] ) ] .

ea:LowStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "A criterion-referenced test with a cutscore; the examinee passes if their score exceeds the cutscore." ;
    rdfs:subClassOf ea:CriterionReferencedAssessment .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasurementError a owl:Class ;
    rdfs:comment "The difference between what a test score indicates and a student's actual knowledge and abilities, or errors introduced in data collection/reporting." .

ea:MidtermExam a owl:Class ;
    rdfs:comment "An exam given near the middle of an academic term. Corpus states midterm exams are 'a type of formative or summative assessment' -- both possibilities are noted rather than resolved." ;
    rdfs:subClassOf ea:Examination .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, in contrast with MultipleChoiceItem." ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NearTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferOfLearning ;
    owl:disjointWith ea:FarTransfer .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Flexible in scope and format, variable in difficulty." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:OralTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasFormat ;
                        owl:someValuesFrom ea:OralFormat ] ) ] .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:comment "Inter-method reliability is termed parallel-forms reliability when dealing with alternate forms." ;
    rdfs:subClassOf ea:InterMethodReliability .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than answer about it." ;
    rdfs:subClassOf ea:PracticalTest .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "placement assessment" ;
    rdfs:comment "Used to place students according to prior achievement before instruction; generally not graded." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:comment "Collections of academic work compiled by students and assessed by teachers in consistent ways." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:PositiveTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferOfLearning ;
    owl:disjointWith ea:NegativeTransfer .

ea:Proficiency a owl:Class ;
    rdfs:comment "A level of attainment determined by standards, scales, or cut-off scores." .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually provided as formative assessment." ;
    rdfs:subClassOf ea:Examination,
        ea:FormativeAssessment .

ea:RaterRelatedReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasErrorSource ;
                        owl:someValuesFrom ea:RaterRelatedCategory ] ) ] .

ea:Recast a owl:Class ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Student scores increase without genuine improvement in learning." .

ea:SelfAssessment a owl:Class ;
    rdfs:comment "Self-assessment is a form of diagnostic assessment in which students assess themselves." ;
    rdfs:subClassOf ea:DiagnosticAssessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Treats the two halves of a measure as alternate forms; estimated via the Spearman-Brown prediction formula." ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:StudentRelatedReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasErrorSource ;
                        owl:someValuesFrom ea:StudentRelatedCategory ] ) ] .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:TestAdministrationRelatedReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasErrorSource ;
                        owl:someValuesFrom ea:TestAdministrationRelatedCategory ] ) ] .

ea:TestRelatedReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasErrorSource ;
                        owl:someValuesFrom ea:TestRelatedCategory ] ) ] .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Comes close to analytic scoring methods, yet remains holistic at heart, per the corpus." ;
    rdfs:subClassOf ea:ScoringMethod .

ea:TrueFalseItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Estimates how much effect individual teachers have on student learning during a school year, using standardized-test results and statistical algorithms." ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasFormat ;
                        owl:someValuesFrom ea:WrittenFormat ] ) ] .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:AnswerOption .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem ;
    owl:inverseOf ea:isItemOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasPerformanceFormat a owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:PerformanceFormat .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasScoringMethod a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringMethod .

ea:hasStem a owl:DatatypeProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range xsd:string .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:AdministeringPartyCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalCategory ea:ExternalCategory ) .

ea:AnalyticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:AnalyticScoring a owl:Class ;
    rdfs:subClassOf ea:ScoringMethod ;
    skos:altLabel "analytic grading" .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "logical validity" .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:subClassOf ea:Feedback .

ea:CourseGranularity a owl:Class .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "RESOLVED TENSION: rubrics are classified as holistic, analytic, or developmental (coordinate, pairwise-disjoint partition). The subordinating axiom to AnalyticRubric was removed to keep the partition consistent." ;
    rdfs:subClassOf ea:Rubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:comment "RESOLVED TENSION: one passage lists placement, formative, summative and diagnostic assessment as four coordinate (and here disjoint-by-purpose) categories; the subordinating axiom to FormativeAssessment was removed to keep the purpose partition consistent." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity a owl:Class .

ea:ErrorSourceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StudentRelatedCategory ea:RaterRelatedCategory ea:TestAdministrationRelatedCategory ea:TestRelatedCategory ) .

ea:EstimationClassCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InterRaterCategory ea:TestRetestCategory ea:InterMethodCategory ea:InternalConsistencyCategory ) .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:FarTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:Feedback a owl:Class .

ea:FormalLearning a owl:Class ;
    rdfs:subClassOf ea:Learning .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:FormatCategory a owl:Class ;
    owl:disjointUnionOf ( ea:WrittenFormat ea:OralFormat ea:PracticalFormat ) .

ea:FormativeAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment" .

ea:GranularityLevel a owl:Class ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, an academic program, the institution, or the educational system as a whole." ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with a desired reward for good performance or important negative consequences." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:InformalLearning a owl:Class ;
    rdfs:subClassOf ea:Learning .

ea:InstitutionGranularity a owl:Class .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:InterMethodReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasEstimationClass ;
                        owl:someValuesFrom ea:InterMethodCategory ] ) ] .

ea:InternalConsistencyReliability a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasEstimationClass ;
                        owl:someValuesFrom ea:InternalConsistencyCategory ] ) ] .

ea:LearnerGranularity a owl:Class .

ea:LearningCommunityGranularity a owl:Class .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:NegativeTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:NonFormalLearning a owl:Class ;
    rdfs:subClassOf ea:Learning .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Yields an estimate of the position of the tested individual relative to a predefined population (grading on the curve)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] ) ] ;
    skos:altLabel "NRT",
        "norm-referenced test",
        "normative assessment" .

ea:ObjectivityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:PerformanceFormat a owl:Class ;
    rdfs:comment "Performance formats are further classified into products and performances." ;
    owl:disjointUnionOf ( ea:ProductFormat ea:PerformanceFormatType ) .

ea:PerformanceFormatType a owl:Class .

ea:Portfolio a owl:Class ;
    skos:altLabel "student portfolio" .

ea:PracticalTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasFormat ;
                        owl:someValuesFrom ea:PracticalFormat ] ) ] .

ea:PredictiveValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductFormat a owl:Class .

ea:ProgramGranularity a owl:Class .

ea:PurposeCategory a owl:Class ;
    rdfs:comment "Value partition for the purpose/timing axis of assessment." ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:RealisticContext a owl:Class ;
    rdfs:subClassOf ea:AssessmentContext .

ea:ReferencingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencedCategory ea:NormReferencedCategory ea:IpsativeCategory ) .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SummativeAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning" .

ea:TestRetestReliability a owl:Class ;
    rdfs:comment "Assesses the degree to which test scores are consistent from one administration to the next; includes intra-rater reliability." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Reliability [ a owl:Restriction ;
                        owl:onProperty ea:hasEstimationClass ;
                        owl:someValuesFrom ea:TestRetestCategory ] ) ] ;
    skos:altLabel "repeatability" .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasAssessmentContext a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentContext .

ea:hasKey a owl:ObjectProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:AnswerOption .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test .

ea:AnswerOption a owl:Class .

ea:AssessmentContext a owl:Class .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, explicit criteria, independent of other candidates' performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencedCategory ] ) ] ;
    skos:altLabel "CRT",
        "criterion-referenced test" .

ea:CriterionReferencedCategory a owl:Class .

ea:DiagnosticPurpose a owl:Class .

ea:ExternalCategory a owl:Class .

ea:FormalCategory a owl:Class .

ea:FormativePurpose a owl:Class .

ea:HighStakesCategory a owl:Class .

ea:InformalCategory a owl:Class .

ea:InterMethodCategory a owl:Class .

ea:InterRaterCategory a owl:Class .

ea:InternalCategory a owl:Class .

ea:InternalConsistencyCategory a owl:Class .

ea:IpsativeCategory a owl:Class .

ea:LowStakesCategory a owl:Class .

ea:NonStandardizedCategory a owl:Class .

ea:NormReferencedCategory a owl:Class .

ea:ObjectiveCategory a owl:Class .

ea:OralFormat a owl:Class .

ea:PlacementPurpose a owl:Class .

ea:PracticalFormat a owl:Class .

ea:RaterRelatedCategory a owl:Class .

ea:StandardizedCategory a owl:Class .

ea:StudentRelatedCategory a owl:Class .

ea:SubjectiveCategory a owl:Class .

ea:SummativePurpose a owl:Class .

ea:TestAdministrationRelatedCategory a owl:Class .

ea:TestRelatedCategory a owl:Class .

ea:TestRetestCategory a owl:Class .

ea:WrittenFormat a owl:Class .

ea:hasAdministeringParty a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministeringPartyCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "RESOLVED TENSION: construct validity is modeled as a coordinate category of validity evidence, pairwise disjoint from content, criterion, face and consequential validity. The subsumption axioms that previously made ContentValidity, CriterionValidity and FaceValidity subclasses of ConstructValidity were removed to keep the disjoint partition consistent." ;
    rdfs:subClassOf ea:Validity .

ea:CriterionValidity a owl:Class ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "criterion-related validity" .

ea:Learning a owl:Class .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Consists of a stem and several alternative answers; the correct answer is the key, incorrect answers are distractors; only one answer may be keyed as correct." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ea:hasKey ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ",
        "multiple choice question" .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Similar to summative assessment in focusing on achievement; requires students to create, produce, or do something in real-world settings." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "performance assessment" .

ea:SubjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:hasFormat a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:FormatCategory .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:Examination a owl:Class ;
    rdfs:label "examination" ;
    owl:equivalentClass ea:Test ;
    skos:altLabel "exam" .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "A statement about what students should be able to do by the end of a teaching session." .

ea:ObjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses (Popham)." .

ea:ScoringMethod a owl:Class .

ea:TransferOfLearning a owl:Class .

ea:hasErrorSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:ErrorSourceCategory .

ea:hasEstimationClass a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:EstimationClassCategory .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent or standard manner for all test takers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] .

ea:TestItem a owl:Class .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure." .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment. Corpus gives two independent typologies of reliability: by error source ('four types of reliability') and by estimation class ('several general classes of reliability estimates'); both are modeled as separate orthogonal axes on Reliability." .

ea:Test a owl:Class ;
    rdfs:comment "Assessment is often used interchangeably with 'test' but assessment is not limited to tests; Test is therefore modeled as a subclass of Assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:Assessment a owl:Class ;
    rdfs:label "assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning. A single assessment instance can simultaneously belong to several independent classification axes (purpose, objectivity, referencing, formality, administering party, standardization, stakes, format, granularity)." ;
    skos:altLabel "educational evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ContentValidity ea:CriterionValidity ea:ConstructValidity ea:FaceValidity ea:ConsequentialValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticRubric ea:AnalyticRubric ea:DevelopmentalRubric ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:FormalLearning ea:NonFormalLearning ea:InformalLearning ) .

