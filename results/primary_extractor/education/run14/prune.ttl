@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" ;
    rdfs:comment "Ontology modeling classification of educational assessment, test items, reliability and validity, built strictly from a corpus on educational assessment. Several passages present conflicting classification claims (e.g. coordinate lists vs. subordination); both are encoded with explanatory comments as required." .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment" ;
    rdfs:comment "The measurement of accomplishments within a realistic, practical context that is relevant outside of the school setting." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasContext ;
                        owl:someValuesFrom ea:AuthenticContext ] ) ] .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating learning." ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination" ;
    rdfs:comment "Competitive exams are norm-referenced, high-stakes tests in which candidates are ranked and top rankers are selected." ;
    rdfs:subClassOf ea:HighStakesTest,
        ea:NormReferencedTest .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; 'Continuous assessment will often include some form of formative assessment.'" ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:CriterionReference ] ) ] .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "Developmental rubrics are a subset of analytical rubrics." ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment" ;
    rdfs:comment "TENSION: one passage lists diagnostic assessment as a 4th coordinate category alongside placement, formative and summative (modeled via the disjoint PurposeCategory partition above); another passage states 'A common form of formative assessment is diagnostic assessment', modeled here as rdfs:subClassOf FormativeAssessment. Both claims are retained as required." ;
    rdfs:subClassOf ea:FormativeAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "divergent validity" .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment" ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:ExternalScope ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExamination a owl:Class ;
    rdfs:comment "A final review of topics covered; a greater form of a 'unit test'." ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:FormalType ] ) ] .

ea:HolisticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach ;
    owl:disjointWith ea:AnalyticGrading ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:HolisticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:InformalType ] ) ] .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment" ;
    rdfs:comment "Set and marked by the school." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:InternalScope ] ) ] .

ea:IntraRaterReliability a owl:Class ;
    rdfs:comment "Test-retest reliability 'includes intra-rater reliability'." ;
    rdfs:subClassOf ea:TestRetestReliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment" ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:IpsativeReference ] ) ] .

ea:LowStakesTest a owl:Class ;
    rdfs:label "Low-Stakes Test" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:LowStakesType ] ) ] .

ea:Midterm a owl:Class ;
    rdfs:comment "'Midterm exams are a type of formative or summative assessment.' TENSION: asserted subclass of both FormativeAssessment and SummativeAssessment below, even though hasPurpose is not functional this is logically consistent, but it conflicts with the AllDisjointClasses-style coordinate reading of placement/formative/summative/diagnostic as strictly mutually exclusive alternatives found elsewhere in the corpus." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:SummativeAssessment,
        ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:NonStandardizedType ] ) ] .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:NormReference ] ) ] ;
    skos:altLabel "normative assessment" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment" ;
    rdfs:comment "Objective assessment is a form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAnswerCorrectness ;
                        owl:someValuesFrom ea:SingleCorrectAnswerType ] ) ] .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:comment "Second family of multiple-choice question: requires choosing only one answer from a list." ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:comment "When dealing with forms, inter-method reliability may be termed parallel-forms reliability." ;
    rdfs:subClassOf ea:InterMethodReliability ;
    skos:altLabel "alternate-forms reliability" .

ea:PerformanceDeliveryAssessment a owl:Class ;
    rdfs:comment "E.g. a speech, athletic skill, musical recital, or reading." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:PerformanceBasedAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryFormat ;
                        owl:someValuesFrom ea:PerformanceFormat ] ) ] .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than simply answering questions." ;
    rdfs:subClassOf ea:Test .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:Portfolio a owl:Class ;
    rdfs:comment "A compilation of academic work and other educational evidence assembled to evaluate learning progress and achievement." ;
    rdfs:subClassOf ea:EducationalAssessment ;
    skos:altLabel "digital portfolio",
        "e-portfolio",
        "student portfolio" .

ea:ProductBasedAssessment a owl:Class ;
    rdfs:comment "E.g. a painting, portfolio, paper, or exhibition." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:PerformanceBasedAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryFormat ;
                        owl:someValuesFrom ea:ProductFormat ] ) ] .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material, usually a formative assessment." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:Test .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Student scores increase without genuine improvements in learning." .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Split-half reliability treats the two halves of a measure as alternate forms, yet is used, via the Spearman-Brown formula, to estimate internal-consistency reliability; both affinities are noted." ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment" ;
    rdfs:comment "Subjective assessment is a form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAnswerCorrectness ;
                        owl:someValuesFrom ea:MultipleCorrectAnswerType ] ) ] .

ea:TeachingToTheTest a owl:Class ;
    rdfs:comment "Deliberately narrowing instruction to focus only on material that will be measured on a test." .

ea:TestAnxiety a owl:Class ;
    rdfs:comment "Anxiety experienced when a person believes they are being judged and may receive an unfavorable evaluation." .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Used to estimate how much effect individual teachers have on student learning during a school year." ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    rdfs:comment "Administered on paper or computer, responded to by writing or typing." ;
    rdfs:subClassOf ea:Test .

ea:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:EducationalAssessment .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs:label "has cut score" ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor" ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Distractor ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has granularity" ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, an academic program, the institution, or the educational system as a whole." ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:GranularityCategory .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has item count" ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:LearningOutcome .

ea:hasMeasurementError a owl:ObjectProperty ;
    rdfs:label "has measurement error" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:MeasurementError .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient" ;
    rdfs:comment "Ranges between 0.00 (much error) and 1.00 (no error)." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:Rubric .

ea:hasStemText a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has stem text" ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range xsd:string .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:Validity .

ea:hasValidityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has validity coefficient" ;
    rdfs:domain ea:Validity ;
    rdfs:range xsd:decimal .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of" ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AchievementTest a owl:Class ;
    rdfs:comment "Measures knowledge/skills learned in school; 'backward-looking'." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AnalyticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Attempts to predict ability to succeed; 'forward-looking'." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:CourseLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-Referenced Test" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:CriterionReference ] ) ] ;
    skos:altLabel "CRT",
        "standards-based assessment" .

ea:EducationalSystemLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-Stakes Test" ;
    rdfs:comment "A test with a desired reward for good performance, or used to make important decisions about students, educators, schools, or districts." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:HighStakesType ] ) ] .

ea:InstitutionLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:InterRaterReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "inter-rater agreement" .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:Key a owl:Class ;
    rdfs:subClassOf ea:AnswerOption ;
    owl:disjointWith ea:Distractor .

ea:LearnerLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:LearningCommunityLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome" ;
    rdfs:comment "Statements about what students should be able to do by the end of a teaching session." .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasurementError a owl:Class ;
    rdfs:comment "Difference between what a test score indicates and a student's actual knowledge/abilities, or errors introduced in data collection/reporting." .

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-Referenced Test" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferenceType ;
                        owl:someValuesFrom ea:NormReference ] ) ] ;
    skos:altLabel "NRT" .

ea:ProgramLevel a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:RaterRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:StudentRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:TestAdministrationRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:TestRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:hasContext a owl:ObjectProperty ;
    rdfs:label "has context" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AuthenticContext .

ea:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasKey a owl:ObjectProperty ;
    rdfs:label "has key" ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Key ;
    rdfs:subPropertyOf ea:hasOption .

ea:AnalyticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:AuthenticContext a owl:Class .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:Distractor a owl:Class ;
    rdfs:subClassOf ea:AnswerOption .

ea:ExternalScope a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:FormalType a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:GradingApproach a owl:Class .

ea:HighStakesType a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalType a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterMethodReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternalScope a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:IpsativeReference a owl:Class ;
    rdfs:subClassOf ea:ReferenceCategory .

ea:LowStakesType a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:MultipleCorrectAnswerType a owl:Class ;
    rdfs:subClassOf ea:AnswerCorrectnessCategory .

ea:NonStandardizedType a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:PerformanceFormat a owl:Class ;
    rdfs:subClassOf ea:DeliveryFormatCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:ProductFormat a owl:Class ;
    rdfs:subClassOf ea:DeliveryFormatCategory .

ea:SingleCorrectAnswerType a owl:Class ;
    rdfs:subClassOf ea:AnswerCorrectnessCategory .

ea:StandardizedType a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning" .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:TestRetestReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability" .

ea:hasAdministrationScope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has administration scope" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AdministrationScopeCategory .

ea:hasAnswerCorrectness a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has answer correctness" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AnswerCorrectnessCategory .

ea:hasDeliveryFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has delivery format" ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:DeliveryFormatCategory .

ea:hasFormalityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality type" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:FormalityCategory .

ea:hasOption a owl:ObjectProperty ;
    rdfs:label "has option" ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:AnswerOption .

ea:hasStakesType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes type" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:StakesCategory .

ea:hasStandardizationType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization type" ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AdministrationScopeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalScope ea:ExternalScope ) .

ea:AnswerCorrectnessCategory a owl:Class ;
    owl:disjointUnionOf ( ea:SingleCorrectAnswerType ea:MultipleCorrectAnswerType ) .

ea:AnswerOption a owl:Class .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "TENSION: a passage presents content validity, criterion validity, construct validity, face validity, and consequential validity as a coordinate, mutually exclusive list of validity-evidence categories (modeled above via owl:AllDisjointClasses). Another passage states construct validity 'subsumes all other types of validity' / is 'the overarching concern of validity research, subsuming all other types of validity evidence such as content validity and criterion validity', modeled via explicit rdfs:subClassOf axioms. Both claims are retained even though jointly they force the subsumed classes to be empty." ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReference a owl:Class ;
    rdfs:subClassOf ea:ReferenceCategory .

ea:DeliveryFormatCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ProductFormat ea:PerformanceFormat ) .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalType ea:InformalType ) .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment" .

ea:NormReference a owl:Class ;
    rdfs:subClassOf ea:ReferenceCategory .

ea:ObjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Requires students to solve real-world problems or produce something with real-world application; similar to summative assessment in focusing on achievement." ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric" ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses." ;
    skos:altLabel "scoring guide" .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesType ea:LowStakesType ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedType ea:NonStandardizedType ) .

ea:ReferenceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReference ea:NormReference ea:IpsativeReference ) .

ea:ReliabilityFactor a owl:Class ;
    rdfs:comment "TENSION: the corpus separately states 'There are four types of reliability: student-related, rater-related, test administration-related, and test-related', naming a different four-part partition than the 'general classes of reliability estimates' (InterRater, TestRetest, InterMethod, InternalConsistency) modeled above on ea:Reliability. Both are retained as distinct classes/partitions." ;
    owl:disjointUnionOf ( ea:StudentRelatedFactor ea:RaterRelatedFactor ea:TestAdministrationRelatedFactor ea:TestRelatedFactor ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:Validity a owl:Class ;
    rdfs:label "Validity" ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure." ;
    skos:altLabel "test validity" .

ea:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    rdfs:comment "Not declared functional: the corpus states diagnostic assessment is simultaneously a coordinate 4th purpose AND a form of formative assessment, requiring an individual assessment to be able to instantiate more than one purpose value without contradiction." ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:PurposeCategory .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test" ;
    rdfs:comment "A test that is administered and scored in a consistent or standard manner." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:StandardizedType ] ) ] .

ea:TestItem a owl:Class ;
    rdfs:label "Test Item" ;
    rdfs:comment "Component of a test consisting of a prompt and, in closed formats, response options. 'Item' is preferred since many items are not phrased as questions." ;
    skos:altLabel "item",
        "question" .

ea:hasReferenceType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has reference type" ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:ReferenceCategory .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Only one answer may be keyed as correct (exactly one Key)." ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ea:hasKey ] ) ] ;
    skos:altLabel "MCQ",
        "multiple choice question",
        "objective response" .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability" ;
    rdfs:comment "The freedom of a measure from measurement error; consistency of an assessment." ;
    owl:disjointUnionOf ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) ;
    skos:altLabel "test reliability" .

ea:GranularityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerLevel ea:LearningCommunityLevel ea:CourseLevel ea:ProgramLevel ea:InstitutionLevel ea:EducationalSystemLevel ) .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification in other topics. 'An examination (exam) is a test.'" ;
    rdfs:subClassOf ea:EducationalAssessment ;
    skos:altLabel "exam",
        "examination" .

ea:EducationalAssessment a owl:Class ;
    rdfs:label "Educational Assessment" ;
    rdfs:comment "Most tests can be classified on multiple categories simultaneously (e.g. standardized AND high-stakes AND multiple-choice); the axes above (purpose, answer-correctness, reference type, formality, administration scope, standardization, stakes) are therefore modeled as independent, cross-cutting, non-mutually-exclusive dimensions, consistent with the corpus statement that 'a test can be both standardized and also a high-stakes test'.",
        "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning. Often used interchangeably with 'test' but not limited to tests." ;
    skos:altLabel "assessment",
        "educational evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:MultipleChoiceItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConstructValidity ea:ConsequentialValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AchievementTest ea:AptitudeTest ea:CollegeAdmissionsTest ea:InternationalComparisonTest ea:PsychologicalTest ) .

