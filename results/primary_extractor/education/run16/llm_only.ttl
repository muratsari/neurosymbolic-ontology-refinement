@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:comment "An OWL ontology of educational assessment, derived strictly from a corpus describing assessment types, validity, reliability, scoring, and related testing concepts. Where the corpus presents conflicting classification claims (e.g. coordinate lists vs. subsumption statements for the same pair of concepts), both axioms are encoded and the tension is documented in rdfs:comment, per modeling instructions." .

ea:AchievementTest a owl:Class ;
    rdfs:comment "'Backward-looking': measures knowledge/skills already learned." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTestFunction ;
                        owl:someValuesFrom ea:AchievementFunction ] ) ] .

ea:AllDisjointErrors a owl:AllDisjointClasses ;
    owl:members ( ea:RandomError ea:SystematicError ) .

ea:AllDisjointGradingApproaches a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticGrading ea:AnalyticGrading ) .

ea:AllDisjointMCFamilies a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseFamilyItem ea:OneBestAnswerFamilyItem ) .

ea:AllDisjointOptions a owl:AllDisjointClasses ;
    owl:members ( ea:KeyOption ea:DistractorOption ) .

ea:AllDisjointPortfolios a owl:AllDisjointClasses ;
    owl:members ( ea:DigitalPortfolio ea:PhysicalPortfolio ) .

ea:AllDisjointScores a owl:AllDisjointClasses ;
    owl:members ( ea:TrueScore ea:ObservedScore ) .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "'Forward-looking': attempts to predict ability to succeed in a future endeavor." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTestFunction ;
                        owl:someValuesFrom ea:AptitudeFunction ] ) ] .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "'The measurement of accomplishments within a realistic, practical context that is relevant outside of the school setting.'" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasApplicationContext ;
                        owl:someValuesFrom ea:RealWorldContext ] ) ] .

ea:CollegeAdmissionsTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTestFunction ;
                        owl:someValuesFrom ea:CollegeAdmissionsFunction ] ) ] .

ea:CompetencyBasedEducation a owl:Class ;
    rdfs:label "Competency-Based Education" ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating learned knowledge/skills. Terminologically overlaps with, but is conceptually distinct from, ea:PerformanceAssessment." ;
    skos:altLabel "mastery-based learning",
        "outcome-based education",
        "performance-based education",
        "proficiency-based learning",
        "standards-based education" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "'Competitive exams are norm-referenced, high-stakes tests in which candidates are ranked.' Illustrates that a single test instance can simultaneously belong to several independent axes ('Most tests can be classified on multiple categories')." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencingValue ] [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesValue ] ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "'A complex assessment is the one that requires a rubric and an expert examiner.' Examples: thesis, funding proposal." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] ) ] .

ea:ConcurrentValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CriterionValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityTiming ;
                        owl:someValuesFrom ea:ConcurrentTimingValue ] ) ] .

ea:ConsequentialValidity a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityEvidenceType ;
                        owl:someValuesFrom ea:ConsequentialValidityValue ] ) ] .

ea:ContentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityEvidenceType ;
                        owl:someValuesFrom ea:ContentValidityValue ] ) ] ;
    skos:altLabel "logical validity",
        "subject-matter validity" .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "'A form of educational examination that evaluates a student's progress throughout a prescribed course.' Often includes formative-assessment components." ;
    rdfs:subClassOf ea:Test .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ConstructValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasConstructRelation ;
                        owl:someValuesFrom ea:ConvergentRelationValue ] ) ] .

ea:CriterionReferencedInterpretation a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestScoreInterpretation [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencingValue ] ) ] .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "TENSION: 'Developmental rubrics, a subset of analytical rubrics' subordinates Developmental under Analytic, while the preceding sentence lists Holistic/Analytic/Developmental as three coordinate (and, per modeling convention, disjoint) classifications. Both are encoded." ;
    rdfs:subClassOf ea:AnalyticRubric ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasRubricType ;
                        owl:someValuesFrom ea:DevelopmentalRubricValue ] ) ] .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:ConstructValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasConstructRelation ;
                        owl:someValuesFrom ea:DiscriminantRelationValue ] ) ] .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringParty ;
                        owl:someValuesFrom ea:ExternalValue ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:comment "An estimate of whether a test appears, superficially, to measure what it claims to measure; does not guarantee the test actually does so." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityEvidenceType ;
                        owl:someValuesFrom ea:FaceValidityValue ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "A final review and assessment of knowledge at course conclusion." ;
    rdfs:subClassOf ea:Test .

ea:FormalAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalValue ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with a desired reward (or important consequence) for good/poor performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesValue ] ) ] .

ea:HolisticRubric a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasRubricType ;
                        owl:someValuesFrom ea:HolisticRubricValue ] ) ] .

ea:InformalAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalValue ] ) ] .

ea:IntendedLearningOutcome a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:LearningOutcome [ a owl:Restriction ;
                        owl:onProperty ea:hasOutcomeType ;
                        owl:someValuesFrom ea:IntendedOutcomeValue ] ) ] ;
    skos:altLabel "aim" .

ea:InterimAssessment a owl:Class ;
    rdfs:comment "Used to evaluate progress toward future (summative) assessments. Debated classification: 'Some educators consider interim tests to be formative ... but others may consider them to be summative.' Left unsubordinated to either, reflecting the unresolved debate." ;
    rdfs:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school (i.e., teachers)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministeringParty ;
                        owl:someValuesFrom ea:InternalValue ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTestFunction ;
                        owl:someValuesFrom ea:InternationalComparisonFunction ] ) ] .

ea:IntraRaterReliability a owl:Class ;
    rdfs:comment "Test-retest reliability 'includes intra-rater reliability.'" ;
    rdfs:subClassOf ea:TestRetestReliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Individual's performance compared only to their own previous performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeReferencingValue ] ) ] .

ea:KuderRichardsonFormula20 a owl:Class ;
    rdfs:comment "'Cronbach's alpha is a generalization of an earlier form of estimating internal consistency, Kuder-Richardson Formula 20.'" ;
    rdfs:subClassOf ea:CronbachAlpha ;
    skos:altLabel "KR-20" .

ea:LearningOutcomeTaxonomy a owl:Class ;
    rdfs:comment "'Types of learning outcomes taxonomy include: Bloom's taxonomy, SOLO, DIKW pyramid, Model of hierarchical complexity.'" ;
    owl:disjointUnionOf ( ea:BloomsTaxonomy ea:StructureOfObservedLearningOutcome ea:DIKWPyramid ea:ModelOfHierarchicalComplexity ) .

ea:LowStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesValue ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "Many, but not all, criterion-referenced tests involve a cutscore; such tests are often called mastery tests." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CriterionReferencedAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasCutScore ;
                        owl:someValuesFrom xsd:decimal ] ) ] ;
    skos:altLabel "mastery test" .

ea:MeasuredLearningOutcome a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:LearningOutcome [ a owl:Restriction ;
                        owl:onProperty ea:hasOutcomeType ;
                        owl:someValuesFrom ea:MeasuredOutcomeValue ] ) ] ;
    skos:altLabel "objective" .

ea:MidtermExam a owl:Class ;
    rdfs:comment "Given near the middle of an academic term; 'a type of formative or summative assessment.'" ;
    rdfs:subClassOf ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Flexible in scope and format, variable in difficulty." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedValue ] ) ] .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencingValue ] ) ] ;
    skos:altLabel "NRT",
        "curved grading",
        "grading on a curve",
        "norm-referenced test",
        "normative assessment" .

ea:NormReferencedInterpretation a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestScoreInterpretation [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencingValue ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveValue ] ) ] .

ea:PeerAssessment a owl:Class ;
    rdfs:comment "Listed as a representative example/technique of formative assessment." ;
    rdfs:subClassOf ea:FormativeAssessment .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment" ;
    rdfs:comment "'Similar to summative assessment in that it focuses on achievement'; requires students to create, produce, or do something, often in real-world-application settings." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPerformanceFormat ;
                        owl:someValuesFrom ea:PerformanceFormatCategory ] ) ] ;
    skos:altLabel "performance test",
        "performance-based assessment",
        "work sample" .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "An assessment that requires an examinee to actually perform a task or activity rather than simply answer questions about it (e.g. behind-the-wheel driving test); also called a work sample in employment contexts." ;
    rdfs:subClassOf ea:PracticalModalityTest,
        ea:Test .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PredictiveValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CriterionValidity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityTiming ;
                        owl:someValuesFrom ea:PredictiveTimingValue ] ) ] .

ea:PsychologicalTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:StandardizedTest [ a owl:Restriction ;
                        owl:onProperty ea:hasTestFunction ;
                        owl:someValuesFrom ea:PsychologicalFunction ] ) ] .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually low-stakes and formative." ;
    rdfs:subClassOf ea:Test .

ea:Recast a owl:Class ;
    rdfs:comment "Subtle correction of a young child's spoken errors by a caregiver." ;
    rdfs:subClassOf ea:VerbalFeedback .

ea:ReliabilityEstimationMethod a owl:Class ;
    rdfs:comment "'There are several general classes of reliability estimates: Inter-rater, Test-retest, Inter-method, Internal consistency.'" ;
    rdfs:subClassOf ea:Reliability ;
    owl:disjointUnionOf ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

ea:SelfAssessment a owl:Class ;
    rdfs:comment "'Self-assessment is a form of diagnostic assessment in which students assess themselves.' Elsewhere self-assessment is also given as an example of formative assessment conducted by the learner, illustrating overlap between the Diagnostic and Formative branches." ;
    rdfs:subClassOf ea:DiagnosticAssessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:comment "Mentioned alongside essay items as requiring written prose responses; not placed in the exhaustive Subjective-item partition above because the corpus enumerates only extended-response and essay items there." ;
    rdfs:subClassOf ea:OpenEndedItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "'This method treats the two halves of a measure as alternate forms.'" ;
    rdfs:subClassOf ea:ParallelFormsReliability .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:comment "'A related -- but distinct -- method of using student test scores to quantify academic achievement and growth'; may also be used in teacher evaluation, overlapping with ea:ValueAddedMeasure without being subsumed by it." ;
    rdfs:subClassOf ea:Assessment .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "Corpus notes a critique that the objective/subjective distinction is 'neither useful nor accurate' since all assessments carry inherent bias; the distinction is nonetheless modeled because the corpus uses it extensively." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveValue ] ) ] .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a scoring guide with multiple traits; 'comes close to analytic scoring methods' yet 'remains holistic at heart' -- i.e. it is not cleanly disjoint from Holistic or Analytic grading, unlike the strict dichotomy above." ;
    rdfs:subClassOf ea:GradingApproach .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:comment "Beneficial outcomes that were neither planned nor sought but are simply observed." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:LearningOutcome [ a owl:Restriction ;
                        owl:onProperty ea:hasOutcomeType ;
                        owl:someValuesFrom ea:UnintendedOutcomeValue ] ) ] .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Statistical estimate of a teacher's effect on student learning using standardized-test results." ;
    rdfs:subClassOf ea:TeacherPerformanceEvaluation ;
    skos:altLabel "growth measure" .

ea:WrittenFeedback a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CorrectiveFeedback [ a owl:Restriction ;
                        owl:onProperty ea:hasFeedbackMedium ;
                        owl:someValuesFrom ea:WrittenMediumValue ] ) ] .

ea:WrittenTest a owl:Class ;
    rdfs:comment "Administered on paper or on a computer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasModality ;
                        owl:someValuesFrom ea:WrittenValue ] ) ] .

ea:containsItem a owl:ObjectProperty ;
    rdfs:domain ea:ItemBank ;
    rdfs:range ea:TestItem .

ea:hasCriterion a owl:DatatypeProperty ;
    rdfs:domain ea:Rubric ;
    rdfs:range xsd:string .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:range ea:DistractorOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasErrorSource a owl:ObjectProperty ;
    rdfs:domain ea:MeasurementError ;
    rdfs:range ea:ReliabilitySourceCategory .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityCategory .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasItemDifficulty a owl:DatatypeProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:decimal .

ea:hasItemDiscriminationIndex a owl:DatatypeProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:decimal .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasPortfolio a owl:ObjectProperty ;
    rdfs:domain ea:PortfolioAssessment ;
    rdfs:range ea:StudentPortfolio .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRepeatabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The repeatability coefficient represents the value below which the absolute difference between two repeated test results may be expected to lie with 95% probability." ;
    rdfs:domain ea:TestRetestReliability ;
    rdfs:range xsd:decimal .

ea:hasStem a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:string .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AdministrationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalValue ea:ExternalValue ) .

ea:AnalyticGrading a owl:Class ;
    rdfs:comment "Takes more factors into account when assigning a grade; criterion-by-criterion judgments." ;
    rdfs:subClassOf ea:GradingApproach .

ea:AnalyticRubric a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasRubricType ;
                        owl:someValuesFrom ea:AnalyticRubricValue ] ) ] .

ea:ApplicationContextCategory a owl:Class ;
    owl:disjointUnionOf ( ea:RealWorldContext ea:ClassroomContext ) .

ea:ClosedEndedItem a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasOpenness ;
                        owl:someValuesFrom ea:ClosedEndedValue ] ) ] .

ea:ConstructValidityRelationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ConvergentRelationValue ea:DiscriminantRelationValue ) .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment" ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencingValue ] ) ] ;
    skos:altLabel "CRT",
        "criterion-referenced test",
        "standards-based assessment" .

ea:CriterionValidityTimingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ConcurrentTimingValue ea:PredictiveTimingValue ) .

ea:CronbachAlpha a owl:Class ;
    rdfs:subClassOf ea:InternalConsistencyReliability ;
    skos:altLabel "Cronbach's alpha" .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment" ;
    rdfs:comment "TENSION: One passage lists Placement/Formative/Summative/Diagnostic as four coordinate, mutually exclusive categories (modeled above via the disjoint PurposeCategory partition and the functional hasPurpose property). Another passage states 'A common form of formative assessment is diagnostic assessment', subordinating Diagnostic under Formative (modeled here as rdfs:subClassOf). Both claims are encoded even though, combined with the functional/disjoint purpose axis, they render DiagnosticAssessment logically unsatisfiable; this is intentional and not resolved." ;
    rdfs:subClassOf ea:Assessment,
        ea:FormativeAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:StudentPortfolio ;
    skos:altLabel "e-portfolio" .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:OpenEndedItem,
        ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:Feedback a owl:Class .

ea:FeedbackMediumCategory a owl:Class ;
    owl:disjointUnionOf ( ea:VerbalMediumValue ea:WrittenMediumValue ) .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalValue ea:InformalValue ) .

ea:GranularityCategory a owl:Class ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, an academic program, the institution, or the educational system as a whole." ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:HolisticGrading a owl:Class ;
    rdfs:comment "Bases a grade on a paper's overall quality, treating the composition as a whole." ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:ItemBank a owl:Class ;
    rdfs:comment "Items are stored in an item bank." .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:ModalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:WrittenValue ea:OralValue ea:PracticalValue ) .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ea:KeyOption ;
            owl:onProperty ea:hasKey ],
        ea:ObjectiveItem .

ea:ObjectivityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveValue ea:SubjectiveValue ) .

ea:ObservedScore a owl:Class ;
    rdfs:subClassOf ea:Score .

ea:OneBestAnswerFamilyItem a owl:Class ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:OpennessCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ClosedEndedValue ea:OpenEndedValue ) .

ea:OutcomeTypeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:IntendedOutcomeValue ea:MeasuredOutcomeValue ea:UnintendedOutcomeValue ) .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:comment "'When dealing with forms, it may be termed parallel-forms reliability.'" ;
    rdfs:subClassOf ea:InterMethodReliability ;
    skos:altLabel "alternate-forms reliability",
        "equivalent-forms reliability" .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:subClassOf ea:StudentPortfolio .

ea:PortfolioAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "portfolio-based assessment" .

ea:PracticalModalityTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasModality ;
                        owl:someValuesFrom ea:PracticalValue ] ) ] .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:RandomError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:ReferencingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencingValue ea:NormReferencingValue ea:IpsativeReferencingValue ) .

ea:ReliabilitySourceCategory a owl:Class ;
    rdfs:comment "'There are four types of reliability: student-related ... rater-related ... test administration-related ... and test-related.'" ;
    owl:disjointUnionOf ( ea:StudentRelatedSource ea:RaterRelatedSource ea:TestAdministrationRelatedSource ea:TestRelatedSource ) .

ea:RubricTypeCategory a owl:Class ;
    rdfs:comment "'Rubrics can be classified as holistic, analytic, or developmental' -- coordinate, mutually exclusive classification." ;
    owl:disjointUnionOf ( ea:HolisticRubricValue ea:AnalyticRubricValue ea:DevelopmentalRubricValue ) .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesValue ea:LowStakesValue ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedValue ea:NonStandardizedValue ) .

ea:StructureOfObservedLearningOutcome skos:altLabel "SOLO" .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:SystematicError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:TeacherPerformanceEvaluation a owl:Class ;
    rdfs:comment "'Summative assessment can be used to refer to assessment of educational faculty by their respective supervisor.'" ;
    rdfs:subClassOf ea:SummativeAssessment .

ea:TestFunctionCategory a owl:Class ;
    owl:disjointUnionOf ( ea:AchievementFunction ea:AptitudeFunction ea:CollegeAdmissionsFunction ea:InternationalComparisonFunction ea:PsychologicalFunction ) .

ea:TrueFalseFamilyItem a owl:Class ;
    rdfs:comment "TENSION: elsewhere True/False is listed as a sibling item type coordinate with (and disjoint from) MultipleChoiceItem; here, the corpus instead states there are 'two families of multiple-choice questions', the first being the 'True/False' family, i.e. a subclass of MultipleChoiceItem." ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:TrueFalseItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:TrueScore a owl:Class ;
    rdfs:comment "'The replicable feature of the concept being measured' -- the part of the observed score recurring across occasions absent error." ;
    rdfs:subClassOf ea:Score .

ea:ValidityEvidenceCategory a owl:Class ;
    rdfs:comment "'Validity ... is generally gauged through examination of evidence in the following categories: Content, Criterion, Construct. Others are: consequential validity, face validity.' Modeled as a coordinate, mutually exclusive partition." ;
    owl:disjointUnionOf ( ea:ContentValidityValue ea:CriterionValidityValue ea:ConstructValidityValue ea:ConsequentialValidityValue ea:FaceValidityValue ) .

ea:VerbalFeedback a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:CorrectiveFeedback [ a owl:Restriction ;
                        owl:onProperty ea:hasFeedbackMedium ;
                        owl:someValuesFrom ea:VerbalMediumValue ] ) ] .

ea:hasApplicationContext a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ApplicationContextCategory .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:decimal .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasPerformanceFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PerformanceFormatCategory .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:DistractorOption a owl:Class ;
    rdfs:subClassOf ea:Option .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation" .

ea:OpenEndedItem a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasOpenness ;
                        owl:someValuesFrom ea:OpenEndedValue ] ) ] .

ea:PerformanceFormatCategory a owl:Class ;
    rdfs:comment "'Performance formats are further classified into products and performances.'" ;
    owl:disjointUnionOf ( ea:ProductOutcome ea:PerformanceOutcome ) .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error." .

ea:Score a owl:Class .

ea:SubjectiveItem a owl:Class ;
    owl:disjointUnionOf ( ea:ExtendedResponseItem ea:EssayItem ) ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveValue ] ) ] .

ea:hasAdministeringParty a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationCategory .

ea:hasConstructRelation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:ConstructValidity ;
    rdfs:range ea:ConstructValidityRelationCategory .

ea:hasFeedbackMedium a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:CorrectiveFeedback ;
    rdfs:range ea:FeedbackMediumCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasKey a owl:ObjectProperty ;
    rdfs:range ea:KeyOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasModality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:ModalityCategory .

ea:hasOpenness a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:OpennessCategory .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Option .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:hasValidityTiming a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:CriterionValidity ;
    rdfs:range ea:CriterionValidityTimingCategory .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Formal or informal feedback on understanding/performance; must be nonevaluative, supportive, timely, specific." ;
    rdfs:subClassOf ea:Feedback .

ea:GradingApproach a owl:Class .

ea:MeasurementError a owl:Class ;
    rdfs:comment "Discrepancy between an observed score and the corresponding true score (X = T + E)." .

ea:Option a owl:Class .

ea:StudentPortfolio a owl:Class ;
    rdfs:comment "A compilation of academic work and other educational evidence assembled over time." .

ea:TestScoreInterpretation a owl:Class ;
    rdfs:comment "There are two types of test score interpretations: norm-referenced or criterion-referenced." .

ea:hasOutcomeType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:OutcomeTypeCategory .

ea:hasRubricType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:RubricTypeCategory .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:KeyOption a owl:Class ;
    rdfs:subClassOf ea:Option .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item" ;
    rdfs:comment "Only one answer may be keyed as correct (exactly one key), contrasting with MultipleResponseItem." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:KeyOption ;
            owl:onProperty ea:hasKey ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ea:ClosedEndedItem,
        ea:ObjectiveItem ;
    skos:altLabel "MCQ" .

ea:ObjectiveItem a owl:Class ;
    owl:disjointUnionOf ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveValue ] ) ] .

ea:hasObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( ea:Assessment ea:TestItem ) ] ;
    rdfs:range ea:ObjectivityCategory .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:CriterionValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityEvidenceType ;
                        owl:someValuesFrom ea:CriterionValidityValue ] ) ] ;
    skos:altLabel "criterion-related validity" .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "Statements about what students should be able to do by the end of a teaching session." .

ea:hasTestFunction a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:StandardizedTest ;
    rdfs:range ea:TestFunctionCategory .

ea:hasValidityEvidenceType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:ValidityEvidenceCategory .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent/standard manner for all test takers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedValue ] ) ] .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure." .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( ea:Assessment ea:TestScoreInterpretation ) ] ;
    rdfs:range ea:ReferencingCategory .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "'It subsumes all other types of validity' / 'the overarching concern of validity research'. See subsumption axioms below, which conflict with the disjoint ValidityEvidenceCategory partition above -- both are intentionally retained as a modeled tension." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Validity [ a owl:Restriction ;
                        owl:onProperty ea:hasValidityEvidenceType ;
                        owl:someValuesFrom ea:ConstructValidityValue ] ) ] .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses (Popham)." .

ea:TestItem a owl:Class ;
    rdfs:label "Test Item" ;
    rdfs:comment "A component question/prompt of a Test; the general term for what is colloquially called a 'question', since many items are not phrased as questions." .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "Corpus: 'Assessment is often used interchangeably with test but is not limited to tests.' Modeled as a subclass of Assessment rather than a synonym, since Assessment is explicitly broader." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam",
        "examination" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning." ;
    skos:altLabel "educational assessment",
        "educational evaluation",
        "evaluation" .

