@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" ;
    rdfs:comment "Models classification claims about educational assessment, testing, validity and reliability as stated in the source corpus. Where the corpus disagrees with itself (coordinate vs. subordinate classifications), both axioms are asserted and the tension is noted in rdfs:comment." .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside school. NOTE: one passage lists AuthenticAssessment as a coordinate sibling of PerformanceBasedAssessment, while another source states 'performance assessments may also be called authentic assessments' (synonymy). No disjointness is asserted between the two because the corpus explicitly states overlap." ;
    rdfs:subClassOf ea:Assessment .

ea:CommonAssessment a owl:Class ;
    rdfs:comment "Used across a school/district to ensure consistent evaluation; may be formative or summative." ;
    rdfs:subClassOf ea:Assessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading and reporting based on students demonstrating learned knowledge/skills." ;
    rdfs:subClassOf ea:EducationalApproach ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based education",
        "proficiency-based learning",
        "standards-based education" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and top rankers are selected." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ea:HighStakesAssessment ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "Requires a rubric and an expert examiner, e.g. thesis, funding proposal." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:comment "Principle of devising learning activities and assessment tasks that directly address intended learning outcomes (Biggs)." .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; used as an alternative to the final-examination system; often includes formative assessment." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasComponent ;
                        owl:someValuesFrom ea:FormativeAssessment ] ) ] .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Feedback on a learner's understanding or performance that is nonevaluative, supportive, timely and specific." .

ea:EssayItem a owl:Class ;
    rdfs:comment "An open-ended item requiring a prose response; also called a free response question." ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "extended-response item",
        "free response question" .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:ExternalScope ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:comment "Provides identifying characteristics and requires recall of the correct term; may or may not include a word bank." ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "A final review and assessment of each student's knowledge, administered at the end of a course." ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document given a numerical score or grade." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HighStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:HighStakesAssessment ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Occurs more casually and does not contribute to a student's final grade." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:comment "Used to evaluate learning progress periodically and determine track to future summative assessments. Some educators consider interim assessments formative, others summative (disputed classification, noted but not resolved)." ;
    rdfs:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school (teachers)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:InternalScope ] ) ] .

ea:LowStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:LowStakesAssessment ) ] .

ea:MeasurementError a owl:Class ;
    rdfs:comment "Difference between what a test score indicates and a student's actual knowledge/ability, or errors in data collection/reporting." ;
    rdfs:subClassOf ea:AssessmentQualityIssue .

ea:MidtermExam a owl:Class ;
    rdfs:comment "Given near the middle of an academic term; a type of formative or summative assessment." ;
    rdfs:subClassOf ea:Test .

ea:MultipleChoiceTest a owl:Class ;
    rdfs:comment "A test composed primarily of multiple-choice items." ;
    rdfs:subClassOf ea:Test .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Significantly different tests are given to different test takers, or conditions/scoring differ." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:NormReferencedTest a owl:Class ;
    rdfs:comment "Robert Glaser coined the terms norm-referenced test and criterion-referenced test." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ) ] ;
    skos:altLabel "NRT" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:OneBestAnswerFamilyItem a owl:Class ;
    rdfs:comment "The second family: requires choosing only one answer from a list." ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:PeerAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessor ;
                        owl:someValuesFrom ea:PeerAssessor ] ) ] .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task/activity rather than answer about it, e.g. a behind-the-wheel driving test." ;
    rdfs:subClassOf ea:Test .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:comment "Compilations of academic work compiled by students and assessed by teachers to evaluate a body of knowledge over time." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasComponent ;
                        owl:someValuesFrom ea:Assessment ] ) ] .

ea:Proficiency a owl:Class ;
    rdfs:comment "Determination, based on standards or a measurement system, of whether a student/teacher meets a defined performance level." .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material, usually a formative, low-stakes assessment." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:Test .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Scores increase without genuine improvement in learning." ;
    rdfs:subClassOf ea:AssessmentQualityIssue .

ea:ScreeningAssessment a owl:Class ;
    rdfs:comment "Determines whether students need specialized assistance/services or readiness to begin a course or program." ;
    rdfs:subClassOf ea:Assessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:comment "Treats the two halves of a measure as alternate forms." ;
    rdfs:subClassOf ea:InterMethodReliability .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent, standard manner for all test takers." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] .

ea:StandardsBasedAssessment a owl:Class ;
    rdfs:comment "Criterion-referenced tests have also been called standards-based assessments." ;
    owl:equivalentClass ea:CriterionReferencedAssessment .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a rubric with multiple criteria; comes close to analytic scoring but 'remains holistic at heart', a hybrid between HolisticGrading and AnalyticGrading." ;
    rdfs:subClassOf ea:GradingApproach .

ea:TrueFalseFamilyItem a owl:Class ;
    rdfs:comment "One of the 'two families' of multiple-choice questions: requires choosing all appropriate answers. TENSION: this family is described as allowing multiple correct answers, which conflicts with the cardinality-1 definition of MultipleChoiceItem given elsewhere in the corpus (contrasted with MultipleResponseItem)." ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Statistical estimate of a teacher's effect on student learning during a school year." ;
    rdfs:subClassOf ea:TeacherEvaluationMethod ;
    owl:disjointWith ea:StudentGrowthMeasure ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    rdfs:comment "Administered on paper or computer." ;
    rdfs:subClassOf ea:Test .

ea:hasCutScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The minimum score needed to pass a mastery (criterion-referenced) test." ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:comment "An incorrect answer option, called a distractor." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption ;
    rdfs:subPropertyOf ea:hasAnswerOption .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Assessment can focus on the individual learner, the learning community, a course, a program, the institution, or the educational system as a whole (granularity)." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Ranges from 0.00 (much error) to 1.00 (no error)." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:ItemStem .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasLearningOutcome .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasRubric .

ea:AnalyticGrading a owl:Class ;
    rdfs:comment "Takes more factors into account, judging criterion by criterion." ;
    rdfs:subClassOf ea:GradingApproach .

ea:AnalyticRubric a owl:Class ;
    rdfs:comment "Evaluates various dimensions or components separately." ;
    rdfs:subClassOf ea:Rubric .

ea:BloomsTaxonomy a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:ConvergentValidity a owl:Class ;
    rdfs:comment "Degree to which two measures of theoretically related constructs are in fact related." ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:CriterionReferencedTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:CriterionReferencedAssessment ) ] ;
    skos:altLabel "CRT" .

ea:DIKWPyramid a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio ;
    skos:altLabel "e-portfolio" .

ea:DiscriminantValidity a owl:Class ;
    rdfs:comment "Tests whether concepts that should be unrelated are, in fact, unrelated." ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalApproach a owl:Class .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:ExpertExaminer a owl:Class ;
    rdfs:subClassOf ea:Examiner .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:FarTransfer a owl:Class ;
    rdfs:comment "Application of skill to a novel problem in a different context." ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:FormalLearning a owl:Class ;
    rdfs:subClassOf ea:LearningMode .

ea:HolisticGrading a owl:Class ;
    rdfs:comment "Bases a grade on a paper's overall quality, treating the composition as a whole." ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:HolisticRubric a owl:Class ;
    rdfs:comment "Provides an overall rating for a piece of work, considering all aspects." ;
    rdfs:subClassOf ea:Rubric .

ea:InformalLearning a owl:Class ;
    rdfs:comment "Less structured than non-formal learning; occurs through day-to-day experience." ;
    rdfs:subClassOf ea:LearningMode .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "aim" .

ea:InterRaterReliability a owl:Class ;
    rdfs:comment "Degree of agreement between two or more raters in their appraisals." ;
    rdfs:subClassOf ea:Reliability .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:comment "Consistency of results across items within a test, commonly measured with Cronbach's alpha." ;
    rdfs:subClassOf ea:Reliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time or across domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:ItemStem a owl:Class ;
    rdfs:comment "The opening of an item - a problem, question, or incomplete statement to be completed." .

ea:LearnerAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:LearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:LivePerformanceAssessment a owl:Class ;
    rdfs:comment "The performance consists of a performance event, e.g. speech, athletic skill, musical recital, reading." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:LowStakesAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "objective" .

ea:ModelOfHierarchicalComplexity a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct." ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:AnswerOption ;
                        owl:onProperty ea:hasKey ] ) ] .

ea:NearTransfer a owl:Class ;
    rdfs:comment "Application of skill to a novel problem in a similar context." ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:NegativeTransfer a owl:Class ;
    rdfs:comment "Prior learning inhibits performance on correlated tasks." ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:NonFormalLearning a owl:Class ;
    rdfs:comment "Organized learning outside the formal learning system, e.g. clubs and workshops." ;
    rdfs:subClassOf ea:LearningMode .

ea:NormGroup a owl:Class ;
    rdfs:comment "A comparison group used in the norming process from which a norm-referenced test's scores are derived." ;
    skos:altLabel "norming group" .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:subClassOf ea:Portfolio .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment" ;
    rdfs:comment "Used to place students according to prior achievement, knowledge level, or personal characteristics, conducted before instruction to establish a baseline." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PositiveTransfer a owl:Class ;
    rdfs:comment "Learning supports novel problem solving." ;
    rdfs:subClassOf ea:TransferOfLearning .

ea:ProductBasedPerformanceAssessment a owl:Class ;
    rdfs:comment "The performance results in a product, e.g. painting, portfolio, paper, or exhibition." ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:ProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:comment "Includes bias and subjectivity of the rater." ;
    rdfs:subClassOf ea:Reliability .

ea:StructureOfObservedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy ;
    skos:altLabel "SOLO" .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:comment "A related but distinct method of using student test scores to quantify academic growth." ;
    rdfs:subClassOf ea:TeacherEvaluationMethod .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:comment "Includes personal problems, sickness, or fatigue of the student." ;
    rdfs:subClassOf ea:Reliability .

ea:TeacherAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:comment "Concerns the conditions of the test-taking process." ;
    rdfs:subClassOf ea:Reliability .

ea:TestRelatedReliability a owl:Class ;
    rdfs:comment "Related to the nature of the test itself." ;
    rdfs:subClassOf ea:Reliability .

ea:TestRetestReliability a owl:Class ;
    rdfs:comment "Degree to which test scores are consistent from one test administration to the next for a single rater/instrument." ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability" .

ea:TrueFalseItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasAssessor a owl:ObjectProperty ;
    rdfs:comment "A formative assessment might be conducted by a teacher (or peer) or by the learner." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessorCategory .

ea:hasExaminer a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Examiner .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:AssessmentQualityIssue a owl:Class .

ea:CriterionReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:Examiner a owl:Class .

ea:ExternalScope a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:FormalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HighStakesAssessment a owl:Class ;
    rdfs:comment "A test with a desired reward for good performance / important consequences for the test taker." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:HighStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterMethodReliability a owl:Class ;
    rdfs:comment "Degree to which test scores are consistent when there is variation in methods/instruments used." ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "alternate-forms reliability",
        "parallel-forms reliability" .

ea:InternalScope a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:IpsativeReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:LowStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormReferencing a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:ObjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:PeerAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Similar to summative assessment, focuses on achievement; a well-defined task requires an extended response, often in real-world application settings." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "performance assessment" .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:Portfolio a owl:Class ;
    rdfs:label "Student Portfolio" .

ea:StandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment" ;
    rdfs:comment "Carried out at the end of a course/project to assign a grade and summarize learning." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:TeacherEvaluationMethod a owl:Class .

ea:hasAdministrationScope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationScopeCategory .

ea:hasAnswerOption a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:hasComponent a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Assessment .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasKey a owl:ObjectProperty ;
    rdfs:comment "The correct answer option, called the key." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption ;
    rdfs:subPropertyOf ea:hasAnswerOption .

ea:hasObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AdministrationScopeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalScope ea:ExternalScope ) .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "TENSION: Content, criterion, construct, face and consequential validity are presented as coordinate (disjoint) categories of validity evidence in one passage. Another passage states construct validity 'subsumes all other types of validity' including content and criterion validity, which is modeled here as ContentValidity/CriterionValidity being subClassOf ConstructValidity, directly in tension with the disjointness above." ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria. Also called standards-based assessment." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "standards-based assessment" .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment" ;
    rdfs:comment "Carried out during the course to provide feedback and modify teaching/learning; not necessarily graded." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation" .

ea:GradingApproach a owl:Class .

ea:LearningMode a owl:Class ;
    owl:disjointUnionOf ( ea:FormalLearning ea:NonFormalLearning ea:InformalLearning ) .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Only one answer may be keyed as correct, contrasted with multiple-response items." ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onClass ea:AnswerOption ;
                        owl:onProperty ea:hasKey ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:altLabel "MCQ" .

ea:ObjectivityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:comment "Subjective questions include extended-response and essay questions." ;
    rdfs:subClassOf ea:TestItem .

ea:hasPurpose a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasReferencing a owl:ObjectProperty ;
    rdfs:comment "Each referencing method can be used to grade the same test paper, so hasReferencing is not declared functional." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:AssessorCategory a owl:Class ;
    owl:disjointUnionOf ( ea:TeacherAssessor ea:PeerAssessor ea:LearnerAssessor ) .

ea:LearningOutcomeTaxonomy a owl:Class .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Relative to the student body taking the test; compares students to each other ('grading on the curve')." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "normative assessment" .

ea:ReferencingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:TransferOfLearning a owl:Class ;
    rdfs:comment "Application of skill, knowledge or understanding to resolve a novel problem or situation." .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which a test measures what it is supposed to measure." .

ea:AnswerOption a owl:Class .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "Statements about what students should be able to do by the end of a teaching session." ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:comment "Objective question types include true/false, multiple-choice, multiple-response, and matching questions." ;
    rdfs:subClassOf ea:TestItem .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses (Popham)." ;
    skos:altLabel "scoring guide" .

ea:GranularityLevel a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error." .

ea:TestItem a owl:Class ;
    rdfs:label "Test Item" ;
    rdfs:comment "The general term for a unit of a test; colloquially called a 'question' though not all items are phrased as questions." .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "A test (examination) is an assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness or classification. Every test is an assessment, but assessment is not limited to tests." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam",
        "examination" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "Systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve learning. Assessment is often used interchangeably with 'test' but is not limited to tests." ;
    skos:altLabel "educational evaluation",
        "evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ProductBasedPerformanceAssessment ea:LivePerformanceAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:PhysicalPortfolio ea:DigitalPortfolio ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveItem ea:SubjectiveItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticRubric ea:AnalyticRubric ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticGrading ea:AnalyticGrading ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConstructValidity ea:FaceValidity ea:ConsequentialValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:BloomsTaxonomy ea:StructureOfObservedLearningOutcome ea:DIKWPyramid ea:ModelOfHierarchicalComplexity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:NearTransfer ea:FarTransfer ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:PositiveTransfer ea:NegativeTransfer ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:PlacementAssessment ea:FormativeAssessment ea:SummativeAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:CriterionReferencedAssessment ea:NormReferencedAssessment ea:IpsativeAssessment ) .

