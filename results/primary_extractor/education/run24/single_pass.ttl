@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology" ;
    rdfs:comment "Models classification of educational assessment as described in the source corpus, including coordinate taxonomies, axis-based definitions, and explicitly noted tensions between coordinate and subordinate classifications." .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "AuthenticAssessment" ;
    rdfs:comment "TENSION: A glossary passage states 'Performance assessments may also be called authentic assessments' (modeled as owl:equivalentClass with ea:PerformanceBasedAssessment). However, an earlier passage lists 'Performance-based assessments' and 'Authentic assessment' as separate, coordinate entries under 'Assessment types include', treating them as distinct named kinds." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass ea:PerformanceBasedAssessment .

ea:CommonAssessment a owl:Class ;
    rdfs:comment "Used across a school/department for consistency; may be formative or summative." ;
    rdfs:subClassOf ea:Assessment .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading, and academic reporting based on students demonstrating learned knowledge and skills." ;
    rdfs:subClassOf ea:AssessmentSystem ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based learning",
        "proficiency-based learning",
        "standards-based education" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and only the top n pass; e.g. civil service exams." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; often includes formative assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Nonevaluative, supportive, timely, specific feedback on understanding or performance." ;
    rdfs:subClassOf ea:Feedback .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "TENSION: One passage lists holistic, analytic, and developmental rubrics as three coordinate kinds. The same passage immediately clarifies that 'Developmental rubrics [are] a subset of analytical rubrics', modeled here as rdfs:subClassOf ea:AnalyticRubric. To keep the ontology consistent, only the subclass relation is retained; DevelopmentalRubric has been removed from the coordinate AllDisjointClasses axiom below." ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:ExternalCategory ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExamination a owl:Class ;
    rdfs:subClassOf ea:SummativeAssessment,
        ea:Test ;
    skos:altLabel "final",
        "final exam" .

ea:FormalAssessment a owl:Class ;
    rdfs:comment "Usually implies a written document and a numerical score or grade." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with a desired reward/consequence for performance." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:comment "Does not contribute to a student's final grade." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:comment "Used to evaluate whether students are on track toward summative assessments; the corpus notes ongoing debate over whether interim assessment should be classified as formative or summative." ;
    rdfs:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school/teachers." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationScope ;
                        owl:someValuesFrom ea:InternalCategory ] ) ] .

ea:IntraRaterReliability a owl:Class ;
    rdfs:subClassOf ea:TestRetestReliability .

ea:LowStakesTest a owl:Class ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MasteryTest a owl:Class ;
    rdfs:comment "A criterion-referenced test that uses a cutscore: pass if score exceeds cutscore." ;
    rdfs:subClassOf ea:CriterionReferencedTest .

ea:MidtermExamination a owl:Class ;
    rdfs:comment "An exam given near the middle of an academic grading term; stated to be 'a type of formative or summative assessment'." ;
    rdfs:subClassOf [ owl:unionOf ( ea:FormativeAssessment ea:SummativeAssessment ) ],
        ea:Test ;
    skos:altLabel "midterm exam" .

ea:NonStandardizedTest a owl:Class ;
    rdfs:comment "Flexible in scope and format, and variable in difficulty." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:NormReferencedTest a owl:Class ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test ;
    skos:altLabel "NRT" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:subClassOf ea:InterMethodReliability ;
    skos:altLabel "alternate-forms reliability" .

ea:PerformanceTest a owl:Class ;
    rdfs:comment "Requires an examinee to actually perform a task or activity rather than simply answering questions about it." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:PerformanceBasedAssessment ) ] ;
    skos:altLabel "work sample" .

ea:PortfolioAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "digital portfolio",
        "e-portfolio",
        "student portfolio" .

ea:Proficiency a owl:Class ;
    rdfs:comment "Used in reference to proficiency levels/cutoffs on tests, students achieving proficiency, demonstrating proficiency against standards, or teachers being rated proficient." ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment, usually provided as a formative assessment." ;
    rdfs:subClassOf ea:FormativeAssessment,
        ea:Test .

ea:ScoreInflation a owl:Class ;
    rdfs:comment "Occurs when assessment scores rise without a genuine underlying improvement in learning." ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:ScreeningAssessment a owl:Class ;
    rdfs:subClassOf ea:Assessment .

ea:SelfAssessment a owl:Class ;
    rdfs:label "SelfAssessment" ;
    rdfs:comment "Self-assessment is a form of diagnostic assessment in which students assess themselves." ;
    rdfs:subClassOf ea:DiagnosticAssessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:comment "A related but distinct method of using student test scores to quantify academic growth." ;
    rdfs:subClassOf ea:MeasurementTechnique .

ea:SubjectMatterValidity a owl:Class ;
    rdfs:comment "Predicts the score a student would get on a similar test with different questions; contrasted with predictive validity, which predicts workplace performance." ;
    rdfs:subClassOf ea:Validity .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a rubric with multiple traits; 'comes close to' analytic scoring but 'remains holistic at heart'." ;
    rdfs:subClassOf ea:GradingApproach .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:comment "Statistical estimate of a teacher's effect on student learning based on standardized-test results." ;
    rdfs:subClassOf ea:MeasurementTechnique ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:hasCriterion a owl:ObjectProperty ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range ea:Criterion .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:comment "An incorrect option." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasPerformanceFormat a owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:PerformanceFormatCategory .

ea:hasRater a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rater .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:comment "Ranges from 0.00 (much error) to 1.00 (no error)." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasScoreInterpretation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:ScoreInterpretation .

ea:hasScoreValue a owl:DatatypeProperty ;
    rdfs:domain ea:Score ;
    rdfs:range xsd:decimal .

ea:hasStemText a owl:DatatypeProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:string .

ea:hasTestTaker a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestTaker .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:hasValidityCoefficient a owl:DatatypeProperty ;
    rdfs:domain ea:Validity ;
    rdfs:range xsd:decimal .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AchievementTest a owl:Class ;
    rdfs:comment "Backward-looking; measures knowledge/skills already learned." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AnalyticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "analytic grading" .

ea:AptitudeTest a owl:Class ;
    rdfs:comment "Forward-looking; attempts to predict ability to succeed." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AssessmentSystem a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:ClassicalTestTheory a owl:Class ;
    rdfs:subClassOf ea:PsychometricModel .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ConcurrentValidity a owl:Class ;
    rdfs:comment "Compares the test to an outcome measured at the same time." ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:Validity ;
    skos:altLabel "logical validity" .

ea:ConvergentValidity a owl:Class ;
    rdfs:comment "Degree to which two measures of theoretically related constructs are in fact related." ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:Criterion a owl:Class ;
    rdfs:comment "The domain of subject matter that a criterion-referenced test is designed to assess (not the cutscore)." ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:CriterionReferencedScoreInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretation .

ea:DiscriminantValidity a owl:Class ;
    rdfs:comment "Tests whether concepts/measurements that should be unrelated are in fact unrelated." ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "divergent validity" .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ",
        "essay question",
        "free response question" .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:Validity .

ea:HolisticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "holistic scoring" .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "aim" .

ea:InterRaterReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:comment "E.g., PISA, PIRLS, TIMSS." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeCategory ] ) ] .

ea:ItemResponseTheory a owl:Class ;
    rdfs:subClassOf ea:PsychometricModel .

ea:LearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "objective" .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, contrasting with MultipleChoiceItem." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ea:AnswerOption ;
            owl:onProperty ea:hasKey ],
        ea:ObjectiveItem ;
    owl:disjointWith ea:MultipleChoiceItem .

ea:NormReferencedScoreInterpretation a owl:Class ;
    rdfs:subClassOf ea:ScoreInterpretation .

ea:ObservedScore a owl:Class ;
    rdfs:comment "X = T + E (Classical Test Theory)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ea:hasScoreComponent ;
            owl:someValuesFrom ea:TrueScore ],
        [ a owl:Restriction ;
            owl:onProperty ea:hasScoreComponent ;
            owl:someValuesFrom ea:MeasurementError ],
        ea:Score .

ea:PerformanceEventFormat a owl:Class ;
    rdfs:comment "E.g. speech, athletic skill, musical recital, reading." ;
    rdfs:subClassOf ea:PerformanceFormatCategory .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "PlacementAssessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "TKT",
        "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:PredictiveValidity a owl:Class ;
    rdfs:comment "Compares the test to an outcome measured at a later time. Also used, in a distinct sense ('predictive' vs 'subject-matter' validity), to mean validity for predicting workplace performance." ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductFormat a owl:Class ;
    rdfs:comment "E.g. painting, portfolio, paper, exhibition." ;
    rdfs:subClassOf ea:PerformanceFormatCategory .

ea:ProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityLevel .

ea:PsychologicalTest a owl:Class ;
    rdfs:comment "E.g., IQ tests, MMPI." ;
    rdfs:subClassOf ea:StandardizedTest .

ea:RandomError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:RaschModel a owl:Class ;
    rdfs:subClassOf ea:PsychometricModel .

ea:Rater a owl:Class ;
    rdfs:label "Rater" ;
    rdfs:subClassOf ea:EducationalConstruct ;
    skos:altLabel "Examiner",
        "Grader",
        "Scorer" .

ea:RaterRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactorType .

ea:StudentRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactorType .

ea:SystematicError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:TestAccommodation a owl:Class ;
    rdfs:comment "Changes testing conditions to improve fairness without undermining the point of the assessment." ;
    rdfs:subClassOf ea:TestAdministrationChange .

ea:TestAdministrationRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactorType .

ea:TestModification a owl:Class ;
    rdfs:comment "A change to testing conditions that undermines the purpose of the test (no longer standardized)." ;
    rdfs:subClassOf ea:TestAdministrationChange .

ea:TestRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactorType .

ea:TestTaker a owl:Class ;
    rdfs:label "TestTaker" ;
    rdfs:subClassOf ea:EducationalConstruct ;
    skos:altLabel "Candidate",
        "Examinee" .

ea:TrueFalseItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:TrueScore a owl:Class ;
    rdfs:comment "The replicable feature of the concept being measured." ;
    rdfs:subClassOf ea:Score,
        ea:ScoreComponent .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:comment "Candidates are measured against defined, objective criteria." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencedCategory ] ) ] ;
    skos:altLabel "standards-based assessment" .

ea:CriterionReferencedCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "DiagnosticAssessment" ;
    rdfs:comment "TENSION: One passage enumerates Placement, Formative, Summative and Diagnostic as four coordinate, pairwise-disjoint categories of assessment (hence the AllDisjointClasses axiom below). Another passage states 'A common form of formative assessment is diagnostic assessment'. Asserting DiagnosticAssessment as a subclass of FormativeAssessment would conflict with the functional hasPurpose property (whose fillers DiagnosticPurpose and FormativePurpose are disjoint), making the class unsatisfiable; therefore only the purpose-based equivalentClass definition is retained, and the direct rdfs:subClassOf ea:FormativeAssessment assertion has been removed to preserve consistency." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "diagnostic testing" .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:ExternalCategory a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:Feedback a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:FormalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HolisticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:InformalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterMethodReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternalCategory a owl:Class ;
    rdfs:subClassOf ea:AdministrationScopeCategory .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:IpsativeCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory ;
    skos:altLabel "forced-choice" .

ea:LowStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Only one answer may be keyed as correct." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:AnswerOption ;
            owl:onProperty ea:hasKey ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ" .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:comment "Compares each test taker against other test takers; colloquially 'grading on the curve'." ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] ) ] ;
    skos:altLabel "normative assessment" .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:TestAdministrationChange a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:TestRetestReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability" .

ea:hasAdministrationScope a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationScopeCategory .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasItemObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:ObjectivityCategory .

ea:hasKey a owl:ObjectProperty ;
    rdfs:comment "The option that is the correct answer." ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption ;
    rdfs:subPropertyOf ea:hasOption .

ea:hasObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory .

ea:hasOption a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:hasScoreComponent a owl:ObjectProperty ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range ea:ScoreComponent .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AdministrationScopeCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:InternalCategory ea:ExternalCategory ) .

ea:AnalyticRubric a owl:Class ;
    rdfs:subClassOf ea:Rubric .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:comment "Most everyday quizzes and most state achievement/graduation tests are criterion-referenced." ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test ;
    skos:altLabel "CRT" .

ea:CriterionValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity,
        ea:Validity ;
    skos:altLabel "criterion-related validity" .

ea:FormalityCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "FormativeAssessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation",
        "formative feedback" .

ea:GradingApproach a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:HolisticGrading ea:AnalyticGrading ) .

ea:HighStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:MeasurementError a owl:Class ;
    rdfs:subClassOf ea:ScoreComponent ;
    owl:disjointUnionOf ( ea:RandomError ea:SystematicError ) .

ea:MeasurementTechnique a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:NormReferencedCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:ObjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:label "PerformanceBasedAssessment" ;
    rdfs:comment "Similar to summative assessment in that it focuses on achievement; requires students to solve real-world problems or produce something with real-world application." ;
    rdfs:subClassOf ea:Assessment .

ea:PerformanceFormatCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:ProductFormat ea:PerformanceEventFormat ) .

ea:PsychometricModel a owl:Class ;
    rdfs:subClassOf ea:MeasurementTechnique ;
    owl:disjointUnionOf ( ea:ClassicalTestTheory ea:ItemResponseTheory ea:RaschModel ) .

ea:Rubric a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:HolisticRubric ea:AnalyticRubric ) ;
    skos:altLabel "scoring guide" .

ea:Score a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:ScoreComponent a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:ScoreInterpretation a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:NormReferencedScoreInterpretation ea:CriterionReferencedScoreInterpretation ) .

ea:StakesCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SubjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "SummativeAssessment" ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "A statement about what students should be able to do by the end of a teaching session." ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ObjectivityCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:ReferencingCategory a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:CriterionReferencedCategory ea:NormReferencedCategory ea:IpsativeCategory ) .

ea:ReliabilityFactorType a owl:Class ;
    rdfs:comment "The corpus's 'four types of reliability', here distinguished as factors rather than estimation methods to avoid clash with ea:Reliability subclasses above." ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:StudentRelatedFactor ea:RaterRelatedFactor ea:TestAdministrationRelatedFactor ea:TestRelatedFactor ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasItemObjectivity ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:AnswerOption a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:ObjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:TestItem [ a owl:Restriction ;
                        owl:onProperty ea:hasItemObjectivity ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:PurposeCategory a owl:Class ;
    rdfs:label "PurposeCategory" ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent or standard manner for all test takers." ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "TENSION: One passage ('Validity of an assessment is generally gauged through examination of evidence in the following categories: Content validity, Criterion validity, Construct validity... Others are: consequential validity, face validity') presents these as a coordinate, disjoint list. Another passage states construct validity 'subsumes all other types of validity', modeled by making Content, Criterion, Consequential and Face validity all rdfs:subClassOf ea:ConstructValidity. To preserve consistency, ConstructValidity itself has been removed from the coordinate AllDisjointClasses axiom below (its subclasses remain pairwise disjoint there), since asserting it disjoint from its own subclasses is contradictory." ;
    rdfs:subClassOf ea:Validity .

ea:Reliability a owl:Class ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error." ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:GranularityLevel a owl:Class ;
    rdfs:label "GranularityLevel" ;
    rdfs:subClassOf ea:EducationalConstruct ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure." ;
    rdfs:subClassOf ea:EducationalConstruct .

ea:TestItem a owl:Class ;
    rdfs:subClassOf ea:EducationalConstruct ;
    skos:altLabel "question" .

ea:Test a owl:Class ;
    rdfs:label "Test" ;
    rdfs:comment "Assessment is often used interchangeably with test but is not limited to tests; a test/examination is an educational assessment intended to measure knowledge, skill, aptitude, physical fitness or classification.",
        "The corpus explicitly states that a single test can have multiple qualities simultaneously (e.g. 'a test can be both standardized and also a high-stakes test'; the bar exam is 'a norm-referenced, standardized, summative assessment'). Therefore bridge classes defined on different axes (purpose, objectivity, referencing, formality, administration scope, standardization, stakes) are NOT asserted disjoint from one another; disjointness is only asserted within a single axis." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Evaluation",
        "Exam",
        "Examination" .

ea:EducationalConstruct a owl:Class ;
    rdfs:label "EducationalConstruct" ;
    rdfs:comment "Root class unifying all concepts in the educational assessment domain." .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning." ;
    rdfs:subClassOf ea:EducationalConstruct .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveItem ea:SubjectiveItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ExtendedResponseItem ea:EssayItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticRubric ea:AnalyticRubric ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ContentValidity ea:CriterionValidity ea:ConsequentialValidity ea:FaceValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:PlacementAssessment ea:FormativeAssessment ea:SummativeAssessment ea:DiagnosticAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:CriterionReferencedAssessment ea:NormReferencedAssessment ea:IpsativeAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TestAccommodation ea:TestModification ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AchievementTest ea:AptitudeTest ea:CollegeAdmissionsTest ea:InternationalComparisonTest ea:PsychologicalTest ) .

