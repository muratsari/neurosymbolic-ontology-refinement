@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:comment "Ontology of educational assessment modeled from corpus passages. Where passages disagree on classification (e.g. diagnostic as coordinate vs. subordinate to formative assessment, or reliability 'types' enumerated two different ways), both claims are encoded as axioms and the resulting tension is documented in rdfs:comment, per modeling instructions." .

ea:AuthenticAssessment a owl:Class ;
    rdfs:comment "TENSION: listed as a coordinate sibling of PerformanceBasedAssessment in the enumerated 'assessment types' list, yet another passage states 'performance assessments may also be called authentic assessments', i.e. treats them as synonymous. Both the coordinate listing and the synonym claim are preserved without forcing equivalence or disjointness." ;
    rdfs:subClassOf ea:Assessment .

ea:Cheating a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:CompetencyBasedLearning a owl:Class ;
    rdfs:comment "Systems of instruction, assessment, grading and academic reporting based on students demonstrating learned knowledge and skills." ;
    rdfs:subClassOf ea:AssessmentPhenomenon ;
    skos:altLabel "mastery-based learning",
        "outcome-based learning",
        "performance-based learning",
        "proficiency-based learning",
        "standards-based learning" .

ea:CompetitiveExamination a owl:Class ;
    rdfs:comment "Norm-referenced, high-stakes tests in which candidates are ranked and top rankers selected." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:comment "Requires a rubric and an expert examiner; example items include a thesis or funding proposal." ;
    rdfs:subClassOf ea:Assessment .

ea:ComputerBasedAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationMode ;
                        owl:someValuesFrom ea:ComputerMode ] ) ] ;
    skos:altLabel "computerized assessment",
        "online assessment" .

ea:ContinuousAssessment a owl:Class ;
    rdfs:comment "Evaluates a student's progress throughout a prescribed course; often includes formative assessment." ;
    rdfs:subClassOf ea:Assessment .

ea:CriterionReferencedAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencedCategory ] ) ] .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:comment "A subset of analytical rubrics; facilitates assessment, instructional design, and transformative learning through multiple dimensions of developmental successions." ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:comment "TENSION: another passage states 'Subjective questions include extended-response and essay questions' as two coordinate types, conflicting with the FRQ/essay equivalence noted on EssayItem." ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:comment "Set by the governing body and marked by unbiased personnel." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocus ;
                        owl:someValuesFrom ea:ExternalCategory ] ) ] .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:comment "Provides identifying characteristics and requires the test taker to recall the correct term; may or may not supply a word bank." ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExam a owl:Class ;
    rdfs:comment "Technically a larger form of a unit test, given at the conclusion of a course." ;
    rdfs:subClassOf ea:Test .

ea:FormalAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:FormativeAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "assessment for learning",
        "classroom assessment",
        "educative assessment",
        "formative evaluation",
        "formative feedback" .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:comment "Asks those being assessed to consider themselves in hypothetical future situations." ;
    rdfs:subClassOf ea:Assessment .

ea:FreeResponseItem a owl:Class ;
    rdfs:comment "Per the corpus, 'a free response question (FRQ) or essay question is a type of open-ended question', treated as the same kind; EssayItem and FreeResponseItem are modeled as equivalent." ;
    owl:equivalentClass ea:EssayItem ;
    skos:altLabel "FRQ",
        "free response question" .

ea:HighStakesTest a owl:Class ;
    rdfs:comment "A test with important consequences/a desired reward for good performance." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] .

ea:InformalAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InternalAssessment a owl:Class ;
    rdfs:comment "Set and marked by the school (teachers)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocus ;
                        owl:someValuesFrom ea:InternalCategory ] ) ] .

ea:IntraRaterReliability a owl:Class ;
    rdfs:subClassOf ea:TestRetestReliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:comment "Self-comparison either in the same domain over time, or comparative to other domains within the same student." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:IpsativeCategory ] ) ] ;
    skos:altLabel "forced-choice assessment" .

ea:LowStakesTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] .

ea:MatchingItem a owl:Class ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasurementError a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:MidtermExam a owl:Class ;
    rdfs:comment "Given near the middle of an academic term; a type of formative or summative assessment." ;
    rdfs:subClassOf ea:Test .

ea:MultipleChoiceTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasItem ;
                        owl:someValuesFrom ea:MultipleChoiceItem ] ) ] .

ea:MultipleResponseItem a owl:Class ;
    rdfs:comment "More than one answer may be keyed as correct, contrasting with multiple-choice items." ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NonStandardizedTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] .

ea:NormReferencedAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] ) ] ;
    skos:altLabel "normative assessment" .

ea:NormReferencedTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:NormReferencedCategory ] ) ] ;
    skos:altLabel "NRT" .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that has a single correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:OralTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationMode ;
                        owl:someValuesFrom ea:OralMode ] ) ] .

ea:PlacementAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "initial assessment",
        "pre-assessment",
        "threshold knowledge test" .

ea:Proficiency a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:Quiz a owl:Class ;
    rdfs:comment "A brief assessment covering a small amount of material; usually a formative assessment." ;
    rdfs:subClassOf ea:Test .

ea:Recast a owl:Class ;
    rdfs:comment "A subtle correction of a young child's spoken errors by a parent or caregiver, often leading to imitation." ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ScoreInflation a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:StandardizedTest a owl:Class ;
    rdfs:comment "Administered and scored in a consistent/standard manner for all test takers. Most standardized tests are summative assessments (stated as a tendency, not a strict subclass axiom)." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] .

ea:StudentPortfolio a owl:Class ;
    rdfs:comment "A compilation of academic work and other evidence assembled to evaluate coursework quality, learning progress, and achievement." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "digital portfolio",
        "e-portfolio",
        "portfolio",
        "portfolio-based assessment" .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:comment "A form of questioning that may have more than one correct answer." ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:SummativeAssessment a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "assessment of learning",
        "summative evaluation" .

ea:TeachingToTheTest a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:TestAnxiety a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:TraitInformedScoring a owl:Class ;
    rdfs:comment "Trains raters to score against a scoring guide with multiple criteria; 'comes close to' analytic scoring methods but 'remains holistic at heart', a hybrid not cleanly placed in the holistic/analytic partition." ;
    rdfs:subClassOf ea:GradingApproach .

ea:TrueFalseItem a owl:Class ;
    rdfs:comment "TENSION: one passage lists true/false as a coordinate objective item type alongside multiple-choice; another passage describes true/false as one of 'two families of multiple-choice questions', i.e. a subtype of MultipleChoiceItem. Both the sibling (ObjectiveItem) and subordinate (MultipleChoiceItem) placements are asserted, even though MultipleChoiceItem requires exactly one key while true/false 'requires choosing all answers that are appropriate', an unresolved conflict." ;
    rdfs:subClassOf ea:MultipleChoiceItem,
        ea:ObjectiveItem .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:subClassOf ea:AssessmentPhenomenon ;
    skos:altLabel "growth measure" .

ea:WrittenTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationMode ;
                        owl:someValuesFrom ea:WrittenMode ] ) ] .

ea:hasAssessor a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessorCategory .

ea:hasCriterion a owl:ObjectProperty ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Criterion .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs:comment "Many, though not all, criterion-referenced tests involve a cutscore; the criterion itself is the domain of subject matter assessed, not the cutscore." ;
    rdfs:domain ea:CriterionReferencedTest ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityCategory .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasMeasurementErrorValue a owl:DatatypeProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasObservedScore a owl:DatatypeProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasOutputFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:PerformanceBasedAssessment ;
    rdfs:range ea:OutputFormatCategory .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:comment "Ranges from 0.00 (much error) to 1.00 (no error); defined as ratio of true-score variance to total variance." ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasScoringApproach a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GradingApproach .

ea:hasStem a owl:DatatypeProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range xsd:string .

ea:hasTiming a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:range ea:TimingCategory .

ea:hasTransferDistance a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TransferOfLearning ;
    rdfs:range ea:TransferDistanceCategory .

ea:hasTransferValence a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:TransferOfLearning ;
    rdfs:range ea:TransferValenceCategory .

ea:hasTrueScore a owl:DatatypeProperty ;
    rdfs:domain ea:TestScore ;
    rdfs:range xsd:decimal .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasItem .

ea:AnalyticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach .

ea:ConcurrentTiming a owl:Class ;
    rdfs:subClassOf ea:TimingCategory .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:ConvergentValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:comment "Formal or informal feedback on understanding or performance; must be nonevaluative, supportive, timely and specific to succeed." ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:Criterion a owl:Class .

ea:CriterionReferencedTest a owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencing ;
                        owl:someValuesFrom ea:CriterionReferencedCategory ] ) ] ;
    skos:altLabel "CRT",
        "standards-based assessment" .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:DiscriminantValidity a owl:Class ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "essay question" .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:FarTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferDistanceCategory .

ea:HolisticGrading a owl:Class ;
    rdfs:subClassOf ea:GradingApproach ;
    skos:altLabel "holistic scoring",
        "nonreductionist grading" .

ea:HolisticRubric a owl:Class ;
    rdfs:comment "Provides an overall rating for a piece of work, considering all aspects." ;
    rdfs:subClassOf ea:Rubric .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "aim" .

ea:InterMethodReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "form equivalence",
        "parallel-forms reliability" .

ea:InterRaterReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:LearnerAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:LearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "objective" .

ea:NearTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferDistanceCategory .

ea:NegativeTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferValenceCategory .

ea:PaperMode a owl:Class ;
    rdfs:subClassOf ea:AdministrationModeCategory,
        ea:WrittenMode .

ea:PeerAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:comment "Similar to summative assessment, focuses on achievement via a well-defined task requiring an extended response; performance formats are classified into products and performances. Also described elsewhere as requiring the examinee to actually perform a task or activity (e.g. a behind-the-wheel driving test)." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "performance test",
        "practical test" .

ea:PerformanceOutput a owl:Class ;
    rdfs:subClassOf ea:OutputFormatCategory .

ea:PositiveTransfer a owl:Class ;
    rdfs:subClassOf ea:TransferValenceCategory .

ea:PracticalMode a owl:Class ;
    rdfs:subClassOf ea:AdministrationModeCategory .

ea:PredictiveTiming a owl:Class ;
    rdfs:subClassOf ea:TimingCategory .

ea:ProductOutput a owl:Class ;
    rdfs:subClassOf ea:OutputFormatCategory .

ea:ProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:GranularityCategory .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:TeacherAssessor a owl:Class ;
    rdfs:subClassOf ea:AssessorCategory .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:TestRelatedReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasKey a owl:ObjectProperty ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:AnswerOption .

ea:AnalyticRubric a owl:Class ;
    rdfs:comment "Evaluates various dimensions or components separately." ;
    rdfs:subClassOf ea:Rubric .

ea:ComputerMode a owl:Class ;
    rdfs:subClassOf ea:AdministrationModeCategory,
        ea:WrittenMode ;
    skos:altLabel "on-screen mode" .

ea:ExternalCategory a owl:Class ;
    rdfs:subClassOf ea:LocusCategory .

ea:FormalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:InformalCategory a owl:Class ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InternalCategory a owl:Class ;
    rdfs:subClassOf ea:LocusCategory .

ea:IpsativeCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:LowStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:comment "Consists of a stem and alternative answers; only one answer may be keyed as correct." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:AnswerOption ;
            owl:onProperty ea:hasKey ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ" .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:ObjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:OralMode a owl:Class ;
    rdfs:subClassOf ea:AdministrationModeCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedCategory a owl:Class ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveCategory a owl:Class ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:PurposeCategory .

ea:TestRetestReliability a owl:Class ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "repeatability",
        "temporal stability" .

ea:TransferOfLearning a owl:Class ;
    rdfs:comment "Application of skill, knowledge or understanding to resolve a novel problem or situation." ;
    rdfs:subClassOf ea:AssessmentPhenomenon .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasItem a owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:hasLocus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LocusCategory .

ea:hasObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory .

ea:hasStandardization a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StandardizationCategory .

ea:AnswerOption a owl:Class .

ea:ConstructValidity a owl:Class ;
    rdfs:comment "Corpus: 'Convergent and discriminant validity are the two subtypes of validity that make up construct validity.' NOTE: this disjointUnionOf (exhaustively partitioning ConstructValidity into exactly these two) coexists with ConstructValidity also having ContentValidity and CriterionValidity as subclasses per the subsumption claim above -- another facet of the same unresolved tension.",
        "TENSION: one passage lists content, criterion, construct, consequential and face validity as coordinate categories of validity evidence (asserted pairwise disjoint above); another passage states construct validity 'subsumes all other types of validity' and that modern validity theory treats it as 'the overarching concern...subsuming all other types of validity evidence such as content validity and criterion validity' (asserted here as subClassOf). Both claims are preserved, producing an unresolved tension (disjoint siblings that are also subsumed)." ;
    rdfs:subClassOf ea:Validity ;
    owl:disjointUnionOf ( ea:ConvergentValidity ea:DiscriminantValidity ) .

ea:CriterionReferencedCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:FormalityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:HighStakesCategory a owl:Class ;
    rdfs:subClassOf ea:StakesCategory .

ea:LocusCategory a owl:Class ;
    owl:disjointUnionOf ( ea:InternalCategory ea:ExternalCategory ) .

ea:ObjectivityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:OutputFormatCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ProductOutput ea:PerformanceOutput ) .

ea:StakesCategory a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:TestScore a owl:Class ;
    rdfs:comment "An observed test score, decomposed as X = T + E (observed = true score + measurement error)." .

ea:TimingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:ConcurrentTiming ea:PredictiveTiming ) .

ea:TransferDistanceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:NearTransfer ea:FarTransfer ) .

ea:TransferValenceCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PositiveTransfer ea:NegativeTransfer ) .

ea:WrittenMode a owl:Class ;
    rdfs:comment "Grouping class for paper and computer modes; a written test is administered on paper or on a computer." .

ea:hasAdministrationMode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:AdministrationModeCategory .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:hasStakes a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain ea:Test ;
    rdfs:range ea:StakesCategory .

ea:AssessorCategory a owl:Class ;
    owl:disjointUnionOf ( ea:TeacherAssessor ea:PeerAssessor ea:LearnerAssessor ) .

ea:GradingApproach a owl:Class ;
    owl:disjointUnionOf ( ea:HolisticGrading ea:AnalyticGrading ) .

ea:LearningOutcome a owl:Class ;
    rdfs:comment "Statements about what students should be able to do by the end of a teaching session." ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:NormReferencedCategory a owl:Class ;
    rdfs:subClassOf ea:ReferencingCategory .

ea:ReferencingCategory a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencedCategory ea:NormReferencedCategory ea:IpsativeCategory ) .

ea:Rubric a owl:Class ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses; contains evaluative criteria, quality definitions, and a scoring strategy." ;
    owl:disjointUnionOf ( ea:HolisticRubric ea:AnalyticRubric ) .

ea:Validity a owl:Class ;
    rdfs:comment "The degree to which an assessment measures what it is intended to measure." .

ea:AdministrationModeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:OralMode ea:PaperMode ea:ComputerMode ea:PracticalMode ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:subClassOf ea:TestItem .

ea:PurposeCategory a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ) .

ea:hasReferencing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Functional per primary use; corpus notes each referencing method 'can be used to grade the same test paper', i.e. the same artifact could in principle be scored under a different referencing scheme on a separate occasion." ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingCategory .

ea:GranularityCategory a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:ProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:TestItem a owl:Class ;
    rdfs:comment "The more general term for what is colloquially called a 'question'; items are stored in an item bank." ;
    owl:disjointUnionOf ( ea:ObjectiveItem ea:SubjectiveItem ) .

ea:AssessmentPhenomenon a owl:Class ;
    rdfs:comment "Umbrella class for assessment-related phenomena, practices and side-effects discussed in the corpus that are not themselves kinds of assessment (e.g. score inflation, measurement error)." .

ea:Reliability a owl:Class ;
    rdfs:comment "TENSION: the corpus gives two different exhaustive four-way classifications both called 'types/classes of reliability': (1) inter-rater, test-retest, inter-method, internal-consistency ('several general classes of reliability estimates'); and (2) student-related, rater-related, test-administration-related, test-related ('There are four types of reliability'). Both disjoint unions of the Reliability class are asserted rather than choosing one.",
        "The consistency of an assessment; freedom of a measure from measurement error." ;
    owl:disjointUnionOf ( ea:InterRaterReliability ea:TestRetestReliability ea:InterMethodReliability ea:InternalConsistencyReliability ),
        ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

ea:Test a owl:Class ;
    rdfs:comment "Assessment is often used interchangeably with test but is not limited to tests; a test is a kind of assessment, typically a set of questions/tasks administered to measure knowledge, skill, aptitude, or ability." ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "exam",
        "examination" .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "Systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning." ;
    skos:altLabel "educational evaluation",
        "evaluation" .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConstructValidity ea:FaceValidity ea:ConsequentialValidity ) .

