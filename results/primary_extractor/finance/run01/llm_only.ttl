@prefix fis: <http://example.org/onto/securities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/securities> a owl:Ontology ;
    rdfs:label "Securities and Financial Instruments Ontology" ;
    rdfs:comment "An ontology of securities, debt, equity, hybrid, derivative and fund instruments, modeled from a corpus on securities, bonds, stocks, derivatives and funds." .

fis:AsianOption a owl:Class ;
    rdfs:comment "Payoff determined by the average underlying price over some preset time period." ;
    rdfs:subClassOf fis:Option .

fis:BarrierOption a owl:Class ;
    rdfs:comment "The underlying security's price must pass a certain barrier before it can be exercised." ;
    rdfs:subClassOf fis:Option .

fis:BinaryOption a owl:Class ;
    rdfs:comment "All-or-nothing payoff profile." ;
    rdfs:subClassOf fis:Option .

fis:BondFund a owl:Class ;
    rdfs:label "income fund" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasHolding ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:Bondholder a owl:Class ;
    rdfs:comment "The holder of a debt security, entitled to payment of principal and interest." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Investor [ a owl:Restriction ;
                        owl:onProperty fis:hasHolding ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:BulletBond a owl:Class ;
    rdfs:comment "A straight bond that is neither callable nor putable." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue false ;
                        owl:onProperty fis:isCallable ] [ a owl:Restriction ;
                        owl:hasValue false ;
                        owl:onProperty fis:isPutable ] ) ] .

fis:CallableBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty fis:isCallable ] ) ] .

fis:CollateralizedDebtObligation a owl:Class ;
    rdfs:label "CDO" ;
    rdfs:comment "Structured ABS backed by a pool of bonds or other debt obligations, sliced into tranches." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:CollateralizedMortgageObligation a owl:Class ;
    rdfs:label "CMO",
        "pay-through bond" ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:ContingentConvertible a owl:Class ;
    rdfs:label "CoCo" ;
    rdfs:comment "Automatically converts into equity if a pre-specified trigger event occurs." ;
    rdfs:subClassOf fis:MandatoryConvertible .

fis:ConvertiblePreferredStock a owl:Class ;
    rdfs:comment "Preferred stock that includes the ability to convert into a fixed number of common shares." ;
    rdfs:subClassOf fis:ConvertibleSecurity,
        fis:PreferredStock .

fis:Debenture a owl:Class ;
    rdfs:comment "Debentures are unsecured debt securities with long maturity (typically >= 10 years)." ;
    owl:equivalentClass fis:UnsecuredBond .

fis:Deposit a owl:Class ;
    rdfs:subClassOf fis:CashInstrument .

fis:EquityFund a owl:Class ;
    rdfs:label "stock fund" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasHolding ;
                        owl:someValuesFrom fis:EquitySecurity ] ) ] .

fis:EquityWarrant a owl:Class ;
    rdfs:comment "Option issued by the company allowing the holder to purchase a specific number of shares at a specified price within a specified time. NOTE: elsewhere the corpus also lists 'warrants' among derivative contract variants (long-dated options); to avoid inconsistency with the disjointness of CashInstrument and DerivativeInstrument, EquityWarrant is classified here per the dedicated Hybrid Securities passage." ;
    rdfs:subClassOf fis:HybridSecurity .

fis:ExchangeableBond a owl:Class ;
    rdfs:comment "Allows exchange into shares of a corporation other than the issuer." ;
    rdfs:subClassOf fis:ConvertibleBond .

fis:ExoticOption a owl:Class ;
    rdfs:comment "Any of a broad category of options with complex financial structures." ;
    rdfs:subClassOf fis:Option .

fis:FixedRateBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "fixed" ;
                        owl:onProperty fis:hasCouponType ] ) ] .

fis:FloatingRateNote a owl:Class ;
    rdfs:label "FRN",
        "floater" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "floating" ;
                        owl:onProperty fis:hasCouponType ] ) ] .

fis:GeneralObligationBond a owl:Class ;
    rdfs:comment "Principal and interest secured by the full faith and credit of the issuer's taxing power." ;
    rdfs:subClassOf fis:MunicipalBond .

fis:HighYieldBond a owl:Class ;
    rdfs:label "junk bond" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCreditRating ;
                        owl:someValuesFrom fis:HighYieldRating ] ) ] .

fis:InflationIndexedBond a owl:Class ;
    rdfs:label "linker" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "inflation-indexed" ;
                        owl:onProperty fis:hasCouponType ] ) ] .

fis:InvestmentGradeBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCreditRating ;
                        owl:someValuesFrom fis:InvestmentGradeRating ] ) ] .

fis:MoneyMarketFund a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasHolding ;
                        owl:someValuesFrom fis:MoneyMarketInstrument ] ) ] .

fis:PackagedConvertible a owl:Class ;
    rdfs:comment "A straight bond and a call option/warrant wrapped together, tradeable as separate legs." ;
    rdfs:subClassOf fis:ConvertibleSecurity .

fis:PutableBond a owl:Class ;
    rdfs:label "retractable bond" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty fis:isPutable ] ) ] .

fis:RepurchaseAgreement a owl:Class ;
    rdfs:comment "Defies categorization as purely cash or derivative instrument, per corpus ('Some instruments defy categorization into the above matrix, for example repurchase agreements')." ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:RevenueBond a owl:Class ;
    rdfs:comment "Repayment guaranteed solely from revenues generated by a specified revenue-generating entity." ;
    rdfs:subClassOf fis:MunicipalBond .

fis:SecuredBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:FinancialInstrument ] ) ] .

fis:SeniorBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "senior" ;
                        owl:onProperty fis:hasSeniority ] ) ] .

fis:Shareholder a owl:Class ;
    rdfs:comment "An individual or company that owns one or more shares of stock." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Investor [ a owl:Restriction ;
                        owl:onProperty fis:hasHolding ;
                        owl:someValuesFrom fis:EquitySecurity ] ) ] .

fis:StockExchange a owl:Class ;
    rdfs:comment "An organized and officially recognized market on which securities can be bought and sold." ;
    rdfs:subClassOf fis:Market .

fis:StockFuture a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Future [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:EquitySecurity ] ) ] .

fis:StockOption a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:EquitySecurity ] ) ] .

fis:SubordinatedBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "subordinated" ;
                        owl:onProperty fis:hasSeniority ] ) ] .

fis:SyntheticConvertible a owl:Class ;
    rdfs:comment "Issued by an investment bank to replicate a convertible payoff on a specific underlying equity, settled in cash, no equity produced." ;
    rdfs:subClassOf fis:ConvertibleSecurity .

fis:Warrant a owl:Class ;
    rdfs:comment "A long-dated option, generally traded over the counter." ;
    rdfs:subClassOf fis:Option .

fis:ZeroCouponBond a owl:Class ;
    rdfs:label "deep discount bond",
        "discount bond" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "zero" ;
                        owl:onProperty fis:hasCouponType ] ) ] .

fis:hasCouponRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:decimal .

fis:hasExpirationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:DerivativeInstrument ;
    rdfs:range xsd:dateTime .

fis:hasFaceValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "nominal amount",
        "par value",
        "principal" ;
    rdfs:comment "The amount on which the issuer pays interest and which must be repaid at maturity (nominal, principal, par, or face amount)." ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasNotionalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Swap ;
    rdfs:range xsd:decimal .

fis:hasStrikePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:decimal .

fis:hasYield a owl:DatatypeProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:decimal .

fis:isCollateralOf a owl:ObjectProperty ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Security ;
    owl:inverseOf fis:hasCollateral .

fis:isConversionTargetOf a owl:ObjectProperty ;
    rdfs:domain fis:EquitySecurity ;
    rdfs:range fis:ConvertibleSecurity ;
    owl:inverseOf fis:hasConversionTarget .

fis:isCreditRatingOf a owl:ObjectProperty ;
    rdfs:domain fis:CreditRatingCategory ;
    rdfs:range fis:Bond ;
    owl:inverseOf fis:hasCreditRating .

fis:isHoldingOf a owl:ObjectProperty ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:PortfolioHolder ;
    owl:inverseOf fis:hasHolding .

fis:isIssuerOf a owl:ObjectProperty ;
    rdfs:domain fis:Issuer ;
    rdfs:range fis:Security ;
    owl:inverseOf fis:hasIssuer .

fis:isTrackedIndexOf a owl:ObjectProperty ;
    rdfs:domain fis:MarketIndex ;
    rdfs:range fis:IndexFund ;
    owl:inverseOf fis:hasTrackedIndex .

fis:isTradingVenueOf a owl:ObjectProperty ;
    rdfs:domain fis:Market ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:hasTradingVenue .

fis:isUnderlyingOf a owl:ObjectProperty ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:DerivativeInstrument ;
    owl:inverseOf fis:hasUnderlying .

fis:AmericanDepositaryReceipt a owl:Class ;
    rdfs:label "ADR" ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:AmericanOption a owl:Class ;
    rdfs:comment "May be exercised on any trading day on or before expiration." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:hasValue "american" ;
                        owl:onProperty fis:hasExerciseStyle ] ) ] .

fis:BankersAcceptance a owl:Class ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:BearerBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "bearer" ;
                        owl:onProperty fis:hasHoldingForm ] ) ] .

fis:BermudanOption a owl:Class ;
    rdfs:comment "May be exercised only on specified dates on or before expiration." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:hasValue "bermudan" ;
                        owl:onProperty fis:hasExerciseStyle ] ) ] .

fis:BookEntryBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "book-entry" ;
                        owl:onProperty fis:hasHoldingForm ] ) ] .

fis:CallOption a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:hasValue "buy" ;
                        owl:onProperty fis:hasOptionRight ] ) ] .

fis:CapitalMarket a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:CertificateOfDeposit a owl:Class ;
    rdfs:label "CD",
        "time deposit" ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:ClosedEndFund a owl:Class ;
    rdfs:subClassOf fis:MutualFund .

fis:CommercialMortgageBackedSecurity a owl:Class ;
    rdfs:label "CMBS" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MortgageBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:CommercialMortgage ] ) ] .

fis:CommercialPaper a owl:Class ;
    rdfs:comment "Unsecured promissory note with a fixed maturity of usually less than 270 days." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument [ a owl:Restriction ;
                        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty fis:hasCollateral ] ) ] .

fis:ConvertibleBond a owl:Class ;
    rdfs:label "convertible debenture",
        "convertible note" ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:ConvertibleSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasConversionTarget ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:CorporateBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:CreditDefaultSwap a owl:Class ;
    rdfs:label "CDS" ;
    rdfs:comment "Seller compensates buyer in the event of a loan default or other credit event on the underlying debt." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:CurrencySwap a owl:Class ;
    rdfs:label "cross-currency swap" ;
    rdfs:subClassOf fis:Swap .

fis:DerivativesExchange a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:EuropeanDepositaryReceipt a owl:Class ;
    rdfs:label "EDR" ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:EuropeanOption a owl:Class ;
    rdfs:comment "May only be exercised on expiry." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:hasValue "european" ;
                        owl:onProperty fis:hasExerciseStyle ] ) ] .

fis:ExchangeTradedDerivative a owl:Class ;
    rdfs:label "ETD" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:DerivativeInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:DerivativesExchange ] ) ] .

fis:ExchangeTradedFund a owl:Class ;
    rdfs:label "ETF" ;
    rdfs:comment "Investors buy and sell ETF shares on national securities exchanges at market prices, which may differ from net asset value." ;
    rdfs:subClassOf fis:InvestmentFund .

fis:Forward a owl:Class ;
    rdfs:comment "Non-standardized, customized contract between two parties, typically OTC." ;
    rdfs:subClassOf fis:LockProduct .

fis:GlobalDepositaryReceipt a owl:Class ;
    rdfs:label "GDR" ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:GovernmentBond a owl:Class ;
    rdfs:label "gilt",
        "sovereign bond",
        "treasury bond" ;
    rdfs:comment "US federal government bonds are called treasuries; UK equivalents are called gilts." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:HedgeFund a owl:Class ;
    rdfs:comment "Pools money like a mutual fund but with fewer investor-protection regulations; available only to high-net-worth individuals." ;
    rdfs:subClassOf fis:InvestmentFund .

fis:InstitutionalInvestor a owl:Class ;
    rdfs:comment "Financial institutions acting on their own account or on behalf of clients." ;
    rdfs:subClassOf fis:Investor .

fis:InterestRateSwap a owl:Class ;
    rdfs:subClassOf fis:Swap .

fis:LongTermBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasTermLength ;
                        owl:someValuesFrom fis:LongTermRange ] ) ] .

fis:LongTermRange a rdfs:Datatype ;
    rdfs:comment "Term to maturity over 15 years ('long bond')." ;
    owl:onDatatype xsd:decimal ;
    owl:withRestrictions ( [ xsd:minExclusive 15.0 ] ) .

fis:MandatoryConvertible a owl:Class ;
    rdfs:comment "Forces the holder to convert into shares at maturity." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:ConvertibleSecurity [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty fis:isConversionMandatory ] ) ] .

fis:MediumTermBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasTermLength ;
                        owl:someValuesFrom fis:MediumTermRange ] ) ] .

fis:MediumTermRange a rdfs:Datatype ;
    rdfs:comment "Term to maturity of 5 to 15 years ('medium bond')." ;
    owl:onDatatype xsd:decimal ;
    owl:withRestrictions ( [ xsd:minInclusive 5.0 ] [ xsd:maxInclusive 15.0 ] ) .

fis:MoneyMarket a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:MoneyMarketRange a rdfs:Datatype ;
    rdfs:comment "Original maturity of one year or less, characteristic of money market instruments." ;
    owl:onDatatype xsd:decimal ;
    owl:withRestrictions ( [ xsd:maxInclusive 1.0 ] ) .

fis:OpenEndFund a owl:Class ;
    rdfs:comment "Purchased from/sold to the issuer at net asset value." ;
    rdfs:subClassOf fis:MutualFund .

fis:OverTheCounterDerivative a owl:Class ;
    rdfs:label "OTC derivative" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:DerivativeInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:OverTheCounterMarket ] ) ] .

fis:OverTheCounterMarket a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:PerpetualBond a owl:Class ;
    rdfs:label "irredeemable bond",
        "perpetuity" ;
    rdfs:comment "A bond with no maturity date." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty fis:hasMaturityDate ] ) ] .

fis:PrimaryMarket a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:PutOption a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:hasValue "sell" ;
                        owl:onProperty fis:hasOptionRight ] ) ] .

fis:RegisteredBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue "registered" ;
                        owl:onProperty fis:hasHoldingForm ] ) ] .

fis:ResidentialMortgageBackedSecurity a owl:Class ;
    rdfs:label "RMBS" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MortgageBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:ResidentialMortgage ] ) ] .

fis:RetailInvestor a owl:Class ;
    rdfs:comment "Members of the public investing personally, other than by way of business." ;
    rdfs:subClassOf fis:Investor .

fis:SecondaryMarket a owl:Class ;
    rdfs:subClassOf fis:Market .

fis:ShortTermBond a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasTermLength ;
                        owl:someValuesFrom fis:ShortTermRange ] ) ] .

fis:ShortTermRange a rdfs:Datatype ;
    rdfs:comment "Term to maturity under 5 years ('short bond')." ;
    owl:onDatatype xsd:decimal ;
    owl:withRestrictions ( [ xsd:maxExclusive 5.0 ] ) .

fis:SupranationalBond a owl:Class ;
    rdfs:label "supra" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SupranationalOrganization ] ) ] .

fis:TreasuryBill a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] [ a owl:Restriction ;
                        owl:hasValue "zero" ;
                        owl:onProperty fis:hasCouponType ] ) ] .

fis:UnsecuredBond a owl:Class ;
    rdfs:label "debenture" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty fis:hasCollateral ] ) ] .

fis:hasMaturityDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:dateTime .

fis:isConversionMandatory a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:ConvertibleSecurity ;
    rdfs:range xsd:boolean .

fis:AssetBackedSecurity a owl:Class ;
    rdfs:label "ABS" ;
    rdfs:comment "Umbrella term for a security backed by a pool of assets; also used narrowly for consumer-loan-backed securities distinct from MBS and CDO." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:DebtSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Loan ] ) ] .

fis:CommercialMortgage a owl:Class ;
    rdfs:subClassOf fis:Mortgage .

fis:CommonStock a owl:Class ;
    rdfs:label "ordinary share",
        "voting share" ;
    rdfs:comment "Carries voting rights and lowest priority in dividends/liquidation." ;
    rdfs:subClassOf fis:EquitySecurity .

fis:Corporation a owl:Class ;
    rdfs:subClassOf fis:Issuer .

fis:Future a owl:Class ;
    rdfs:comment "Standardized contract written by a clearing house and traded on an exchange." ;
    rdfs:subClassOf fis:LockProduct .

fis:HighYieldRating a owl:Class ;
    rdfs:subClassOf fis:CreditRatingCategory .

fis:IndexFund a owl:Class ;
    rdfs:comment "A passively managed fund that tracks the performance of an index." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasTrackedIndex ;
                        owl:someValuesFrom fis:MarketIndex ] ) ] .

fis:InvestmentGradeRating a owl:Class ;
    rdfs:subClassOf fis:CreditRatingCategory .

fis:Loan a owl:Class ;
    rdfs:comment "A cash instrument such as a loan, requiring agreement between borrower and lender to transfer." ;
    rdfs:subClassOf fis:CashInstrument .

fis:Municipality a owl:Class ;
    rdfs:subClassOf fis:Issuer .

fis:OptionProduct a owl:Class ;
    rdfs:comment "Provides the buyer the right, but not the obligation, to enter the contract under the terms specified." ;
    rdfs:subClassOf fis:DerivativeInstrument .

fis:PreferredStock a owl:Class ;
    rdfs:label "preference shares",
        "preferred shares" ;
    rdfs:comment "CONFLICT: one corpus passage calls preferred equity 'a form of capital stock'/equity, while the dedicated Hybrid Securities passage explicitly classifies preferred stock as a hybrid instrument with both debt and equity features. The hybrid classification is modeled here as the more detailed/authoritative statement; priority over common stock in dividends and liquidation, usually no voting rights." ;
    rdfs:subClassOf fis:HybridSecurity .

fis:ResidentialMortgage a owl:Class ;
    rdfs:subClassOf fis:Mortgage .

fis:SupranationalOrganization a owl:Class ;
    rdfs:subClassOf fis:Issuer .

fis:hasConversionTarget a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The equity into which a convertible security may be converted." ;
    rdfs:domain fis:ConvertibleSecurity ;
    rdfs:range fis:EquitySecurity .

fis:hasOptionRight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of 'buy' (call) or 'sell' (put)." ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:string .

fis:hasSeniority a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of 'senior', 'subordinated'." ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:string .

fis:hasTrackedIndex a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain fis:IndexFund ;
    rdfs:range fis:MarketIndex .

fis:isCallable a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:boolean .

fis:isPutable a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:boolean .

fis:DepositaryReceipt a owl:Class ;
    rdfs:comment "A negotiable financial instrument issued by a bank to represent a foreign company's publicly traded securities." ;
    rdfs:subClassOf fis:Security .

fis:MarketIndex a owl:Class ;
    rdfs:comment "A price index, e.g. a stock market index or bond market index." .

fis:Mortgage a owl:Class ;
    rdfs:subClassOf fis:Loan .

fis:MortgageBackedSecurity a owl:Class ;
    rdfs:label "MBS" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Mortgage ] ) ] .

fis:MunicipalBond a owl:Class ;
    rdfs:label "muni" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Municipality ] ) ] .

fis:MutualFund a owl:Class ;
    rdfs:subClassOf fis:InvestmentFund .

fis:SovereignGovernment a owl:Class ;
    rdfs:subClassOf fis:Issuer .

fis:hasCreditRating a owl:ObjectProperty ;
    rdfs:domain fis:Bond ;
    rdfs:range fis:CreditRatingCategory .

fis:hasExerciseStyle a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of 'american', 'european', 'bermudan'." ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:string .

fis:hasHoldingForm a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of 'bearer', 'registered', 'book-entry'." ;
    rdfs:domain fis:Security ;
    rdfs:range xsd:string .

fis:hasTradingVenue a owl:ObjectProperty ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Market .

fis:CashInstrument a owl:Class ;
    rdfs:comment "An instrument whose value is determined directly by the markets." ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:CreditRatingCategory a owl:Class .

fis:HybridSecurity a owl:Class ;
    rdfs:comment "Combines characteristics of both debt and equity securities." ;
    rdfs:subClassOf fis:Security .

fis:Investor a owl:Class ;
    rdfs:subClassOf fis:PortfolioHolder .

fis:LockProduct a owl:Class ;
    rdfs:comment "Obligates the contractual parties to the terms over the life of the contract." ;
    rdfs:subClassOf fis:DerivativeInstrument .

fis:PortfolioHolder a owl:Class ;
    rdfs:comment "An entity that holds financial instruments in a portfolio." .

fis:Swap a owl:Class ;
    rdfs:comment "Two counterparties exchange cash flows of one party's financial instrument for those of another's." ;
    rdfs:subClassOf fis:LockProduct .

fis:hasTermLength a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Term to maturity expressed in years." ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasUnderlying a owl:ObjectProperty ;
    rdfs:comment "The item (underlier) that can or must be bought or sold under the derivative." ;
    rdfs:domain fis:DerivativeInstrument ;
    rdfs:range fis:FinancialInstrument .

fis:MoneyMarketInstrument a owl:Class ;
    rdfs:comment "Short term debt instruments with original maturities of one year or less." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:DebtSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasTermLength ;
                        owl:someValuesFrom fis:MoneyMarketRange ] ) ] .

fis:hasCouponType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of 'fixed', 'floating', 'zero', 'inflation-indexed'." ;
    rdfs:domain fis:Bond ;
    rdfs:range xsd:string .

fis:Issuer a owl:Class ;
    rdfs:comment "The company or other entity issuing the security." .

fis:hasHolding a owl:ObjectProperty ;
    rdfs:comment "A financial instrument held in a portfolio holder's portfolio." ;
    rdfs:domain fis:PortfolioHolder ;
    rdfs:range fis:FinancialInstrument .

fis:hasIssuer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain fis:Security ;
    rdfs:range fis:Issuer .

fis:InvestmentFund a owl:Class ;
    rdfs:comment "An investment fund that pools money from many investors to purchase securities." ;
    rdfs:subClassOf fis:PortfolioHolder,
        fis:Security .

fis:ConvertibleSecurity a owl:Class ;
    rdfs:comment "A hybrid security convertible, at the holder's election, into the ordinary shares of the issuer." ;
    rdfs:subClassOf fis:HybridSecurity .

fis:DerivativeInstrument a owl:Class ;
    rdfs:label "derivative" ;
    rdfs:comment "A contract whose value derives from the value and characteristics of one or more underlying entities." ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:EquitySecurity a owl:Class ;
    rdfs:comment "A share of equity interest in an entity; residual claim after creditors are paid." ;
    rdfs:subClassOf fis:Security .

fis:Market a owl:Class .

fis:hasCollateral a owl:ObjectProperty ;
    rdfs:comment "The asset(s) backing/securing a security, e.g. mortgages backing an MBS." ;
    rdfs:domain fis:Security ;
    rdfs:range fis:FinancialInstrument .

fis:DebtSecurity a owl:Class ;
    rdfs:comment "Holder entitled to payment of principal and interest; issued for a fixed term." ;
    rdfs:subClassOf fis:Security .

fis:Security a owl:Class ;
    rdfs:comment "A tradable financial asset; readily transferable, unlike loans/deposits which require bilateral agreement to transfer." ;
    rdfs:subClassOf fis:CashInstrument .

fis:FinancialInstrument a owl:Class ;
    rdfs:label "financial instrument" ;
    rdfs:comment "A monetary contract between parties that can be created, traded, modified and settled." .

fis:Option a owl:Class ;
    rdfs:comment "Gives the buyer the right, but not the obligation, to buy or sell an underlying asset at a strike price on or before a specified date." ;
    rdfs:subClassOf fis:OptionProduct .

fis:Bond a owl:Class ;
    rdfs:comment "Issuer owes holder a debt and is obliged to repay principal at maturity plus interest (coupon)." ;
    rdfs:subClassOf fis:DebtSecurity .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CashInstrument fis:DerivativeInstrument ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:ShortTermBond fis:MediumTermBond fis:LongTermBond fis:PerpetualBond ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:ResidentialMortgage fis:CommercialMortgage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:BearerBond fis:RegisteredBond fis:BookEntryBond ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:SovereignGovernment fis:Municipality fis:Corporation fis:SupranationalOrganization ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CommercialPaper fis:CertificateOfDeposit fis:TreasuryBill fis:BankersAcceptance ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:ResidentialMortgageBackedSecurity fis:CommercialMortgageBackedSecurity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CommonStock fis:PreferredStock ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:AmericanDepositaryReceipt fis:EuropeanDepositaryReceipt fis:GlobalDepositaryReceipt ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:OpenEndFund fis:ClosedEndFund ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:MutualFund fis:ExchangeTradedFund fis:HedgeFund ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:RetailInvestor fis:InstitutionalInvestor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:LockProduct fis:OptionProduct ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:ExchangeTradedDerivative fis:OverTheCounterDerivative ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Forward fis:Future ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:InterestRateSwap fis:CurrencySwap fis:CreditDefaultSwap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CallOption fis:PutOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:AmericanOption fis:EuropeanOption fis:BermudanOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:PrimaryMarket fis:SecondaryMarket ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:MoneyMarket fis:CapitalMarket ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:InvestmentGradeRating fis:HighYieldRating ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:DebtSecurity fis:EquitySecurity fis:HybridSecurity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:GovernmentBond fis:MunicipalBond fis:CorporateBond fis:SupranationalBond ) .

