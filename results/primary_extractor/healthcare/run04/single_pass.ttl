@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ht: a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    skos:definition "An ontology modeling the classification, etiology, measurement, treatment, risk factors and target-organ damage of hypertension, based on ACC/AHA 2017 and related clinical corpus passages."@en .

ht:AllTopKindsDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:SecondaryCause ht:TargetOrganDamage ht:Antihypertensive ht:RiskFactor ) .

ht:AntihypertensiveClassesDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:CalciumChannelBlocker ht:BetaBlocker ) .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "A congenital narrowing of the aorta that is a vascular cause of secondary hypertension, typically affecting younger patients."@en .

ht:BandsDisjoint a owl:AllDisjointClasses ;
    rdfs:comment "Bands are asserted pairwise disjoint as positive, mutually exclusive alternatives per ACC/AHA 2017. The corpus notes that when systolic and diastolic values fall into different bands, convention assigns the reading to the higher-stage category; this may create readings that formally satisfy more than one band's differentia, a tension the corpus itself resolves by convention rather than by strict logical partition."@en ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

ht:CCBSubtypesDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:Dihydropyridine ht:NonDihydropyridine ) .

ht:CrisisDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

ht:EndocrineCausesDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryAldosteronism ht:Pheochromocytoma ht:CushingSyndrome ht:ThyroidDisease ht:PrimaryHyperparathyroidism ) .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:comment "Traditional threshold is systolic >140 mmHg with diastolic <90 mmHg; under the 2017 ACC/AHA guideline a systolic pressure of 130 mmHg is considered hypertensive at all ages, shifting this threshold downward."@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A pattern of hypertension characterized by a disproportionate rise in systolic pressure with a normal or low diastolic pressure, traditionally defined as systolic pressure above 140 mmHg with diastolic below 90 mmHg, producing a widened pulse pressure; predominant in older adults due to arterial stiffening."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "LVH"@en ;
    skos:definition "Compensatory thickening of the left ventricular wall in response to chronic pressure overload; the hallmark structural manifestation of hypertensive heart disease."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "MH"@en ;
    skos:definition "A phenotype in which office or clinic blood pressure is normal while out-of-office blood pressure, measured ambulatorily or at home, is elevated; the inverse pattern to white coat hypertension."@en .

ht:ModifiableChildrenDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ExcessSaltIntake ht:Obesity ht:Smoking ht:PhysicalInactivity ht:AlcoholUse ) .

ht:ModifiableVsNonModifiableDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

ht:Nephrosclerosis a owl:Class ;
    rdfs:label "Nephrosclerosis"@en ;
    rdfs:subClassOf ht:HypertensiveKidneyDisease ;
    skos:definition "Hardening and thickening of renal small vessels, glomeruli, tubules, and interstitial tissue due to chronic hypertension, reducing blood and oxygen supply and causing tissue ischemia; the characteristic lesion of hypertensive kidney disease."@en .

ht:NonModifiableChildrenDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:AdvancingAge ht:FamilyHistory ht:Race ht:Sex ) .

ht:PrimaryVsSecondaryDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of the renal artery, the characteristic lesion of renovascular disease, including atherosclerotic renal artery stenosis."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Renal cause of hypertension encompassing diabetic nephropathy, glomerulonephritis, interstitial disorders, and polycystic kidney disease."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality 3 ;
            owl:onClass ht:Antihypertensive ;
            owl:onProperty ht:hasAntihypertensive ],
        ht:Hypertension ;
    skos:definition "Blood pressure that remains uncontrolled to goal despite adherence to three suitably dosed antihypertensive medications of different classes, one of which is a diuretic, after confirmation of adherence and exclusion of the white-coat effect; or blood pressure controlled only with four or more agents."@en .

ht:RetinalFindingsDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

ht:SecondaryCauseBranchesDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

ht:SettingsDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeBloodPressureMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

ht:TargetOrganDamageDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveKidneyDisease ) .

ht:TechniquesDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "WCH"@en,
        "WHT"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A phenotype of labile hypertension in which office or clinic blood pressure is consistently elevated while out-of-office blood pressure is normal."@en .

ht:hasBloodPressureCategory a owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    owl:inverseOf ht:isBloodPressureCategoryOf ;
    skos:definition "Relates a blood pressure reading to the ACC/AHA 2017 category band that it falls into."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "The corpus documents a genuine, unresolved conflict: the 2017 ACC/AHA guideline sets this threshold at 130 mmHg, whereas ESC/ESH (2018, 2023), JNC 7, WHO, and ISH (2020) guidelines set it at 140 mmHg. This single functional property is modeled honestly with both competing values noted here rather than split into per-guideline subclasses."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic value, in mmHg, at or above which hypertension is diagnosed under a given guideline."@en .

ht:hasMeasurementSetting a owl:ObjectProperty ;
    rdfs:label "has measurement setting"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementSetting ;
    skos:definition "Relates a blood pressure reading to the setting in which it was obtained."@en .

ht:hasMeasurementTechnique a owl:ObjectProperty ;
    rdfs:label "has measurement technique"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementTechnique ;
    skos:definition "Relates a blood pressure reading to the physical technique used to obtain it."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    owl:inverseOf ht:isRetinalFindingOf ;
    skos:definition "Relates hypertensive retinopathy to a specific retinal sign observed on fundoscopic examination."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    owl:inverseOf ht:isRiskFactorOf ;
    skos:definition "Relates hypertension to a modifiable or non-modifiable factor that increases the likelihood of developing it."@en .

ht:AdvancingAge a owl:Class ;
    rdfs:label "Advancing Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A non-modifiable risk factor; blood pressure and hypertension prevalence rise markedly with age, affecting approximately 60% of individuals above age 60."@en .

ht:AlcoholUse a owl:Class ;
    rdfs:label "Alcohol Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A modifiable risk factor; increased alcohol intake is associated with higher blood pressure."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure measurement taken at regular intervals throughout the day and night, regarded as the reference standard for distinguishing white coat and masked hypertension."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits angiotensin-converting enzyme, reducing angiotensin II production and increasing bradykinin, producing vasodilation and decreased peripheral vascular resistance; preferred in diabetes, chronic kidney disease, and heart failure; contraindicated in pregnancy."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks the binding of angiotensin II to the AT1 receptor, with efficacy comparable to ACE inhibitors but fewer adverse effects such as cough and angioedema; generally not combined with ACE inhibitors."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Vascular Attenuation"@en ;
    skos:definition "Generalized or focal narrowing of the retinal arterioles, an early sign of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en ;
    skos:definition "Compression of a retinal vein where it is crossed by an arteriole, a sign of hypertensive retinopathy."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementTechnique ;
    skos:definition "A blood pressure measurement technique using a stethoscope and sphygmomanometer, in which Korotkoff sounds mark the systolic and diastolic pressures as cuff pressure is released."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive drug class that inhibits catecholamines from binding to beta-adrenergic receptors, reducing heart rate, myocardial contractility, and renin release; no longer recommended as first-line therapy for uncomplicated hypertension except when a compelling cardiac indication is present."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A white, fluffy retinal lesion representing ischemic infarction of the nerve fiber layer, seen in advanced hypertensive retinopathy."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine cause of hypertension due to excess glucocorticoid production or administration."@en .

ht:Dihydropyridine a owl:Class ;
    rdfs:label "Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker that acts predominantly on vascular smooth muscle to cause peripheral vasodilation, preferred for the treatment of hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "Secondary hypertension induced by a medication or substance, including NSAIDs, sympathomimetic decongestants, stimulants, certain antidepressants, corticosteroids, licorice, carbenoxolone, oral contraceptives, estrogens, cyclosporine, cocaine, and methamphetamine."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "A blood pressure reading with a systolic pressure of 120 to 129 mmHg and a diastolic pressure less than 80 mmHg; previously termed prehypertension under JNC 7."@en .

ht:ExcessSaltIntake a owl:Class ;
    rdfs:label "Excess Salt Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A modifiable risk factor; excess dietary salt intake increases the risk of developing hypertension, with 50-60% of patients demonstrating salt-sensitive physiology."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A non-modifiable risk factor; a family history of hypertension increases individual risk, reflecting genetic predisposition."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A lipid deposit in the retina resulting from leakage through a damaged blood-retinal barrier, seen in hypertensive retinopathy."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Out-of-office blood pressure measurement taken by the patient using a home monitoring device, found to be comparable in accuracy to 24-hour ambulatory monitoring."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis accompanied by acute hypertension-mediated target-organ damage, requiring immediate, controlled reduction of blood pressure, typically with intravenous agents in a monitored setting."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis without evidence of acute target-organ damage, typically managed with gradual blood pressure reduction using oral medication over 24 to 48 hours."@en .

ht:NonDihydropyridine a owl:Class ;
    rdfs:label "Non Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker, including verapamil and diltiazem, that primarily affects cardiac contractility and atrioventricular conduction, better suited to the management of arrhythmias."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 120 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure less than 120 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A modifiable risk factor; excess body weight increases the risk of developing hypertension, and weight reduction can lower systolic blood pressure by 5 to 20 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep-related breathing disorder that is one of the most common secondary causes of hypertension and of resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement taken in a clinical setting such as a doctor's office, subject to the white coat effect."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementTechnique ;
    skos:definition "An automated blood pressure measurement technique that calculates systolic, diastolic, and mean arterial pressures from oscillations in cuff pressure, requiring less operator skill than auscultation."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding, indicating malignant hypertensive retinopathy."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine cause of hypertension due to a tumor producing excess norepinephrine and epinephrine, causing vasoconstriction and raised blood pressure."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A modifiable risk factor; lack of regular exercise increases the risk of developing hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "An endocrine cause of hypertension due to autonomous overproduction of aldosterone by the adrenal glands, most often from a solitary adrenal adenoma or bilateral adrenal hyperplasia; accounts for most endocrine-related secondary hypertension and for as many as one in five cases of resistant hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine cause of secondary hypertension due to excess parathyroid hormone secretion."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable cause, arising from a complex interaction of genetic predisposition and environmental and lifestyle factors; accounts for approximately 85-95% of hypertension cases."@en .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A non-modifiable risk factor that influences both hypertension risk and first-line treatment selection, with guidelines recommending different approaches for Black and non-Black populations."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:altLabel "Renovascular Hypertension"@en ;
    skos:definition "A renal cause of hypertension arising from obstruction or narrowing of a renal artery."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Bleeding into the retinal tissue, including flame-shaped and blot hemorrhages, seen in more advanced hypertensive retinopathy."@en .

ht:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A non-modifiable risk factor contributing to variation in hypertension risk."@en .

ht:Smoking a owl:Class ;
    rdfs:label "Smoking"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A modifiable risk factor; tobacco use increases the risk of developing hypertension."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 130 to 139 mmHg or a diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 140 mmHg or greater or a diastolic pressure of 90 mmHg or greater."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "A first-line antihypertensive drug class that blocks sodium reabsorption in the distal convoluted tubule, promoting natriuresis and diuresis and producing modest vasodilation; includes thiazide-like agents such as chlorthalidone and indapamide."@en .

ht:ThyroidDisease a owl:Class ;
    rdfs:label "Thyroid Disease"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine cause of hypertension, including hyperthyroidism and hypothyroidism."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    owl:inverseOf ht:isAntihypertensiveOf ;
    skos:definition "Relates hypertension to a class of medication used in its pharmacological management."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    owl:inverseOf ht:isSecondaryCauseOf ;
    skos:definition "Relates an instance of secondary hypertension to the identifiable underlying condition, medication, or substance responsible for it."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    owl:inverseOf ht:isTargetOrganDamageOf ;
    skos:definition "Relates hypertension to a form of structural or functional damage it has caused in a target organ."@en .

ht:isAntihypertensiveOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive of"@en ;
    rdfs:domain ht:Antihypertensive ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a class of medication to the hypertension it is used to manage."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    skos:definition "Relates an ACC/AHA 2017 category band to a blood pressure reading that it classifies."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    skos:definition "Relates a specific retinal sign to the hypertensive retinopathy in which it was observed."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a risk factor to the hypertension whose likelihood it increases."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:SecondaryHypertension ;
    skos:definition "Relates an identifiable underlying cause to the instance of secondary hypertension it produces."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a form of target-organ damage to the hypertension that caused it."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the left ventricle, left atrium, and coronary arteries resulting from chronic blood pressure elevation, including remodeling, myocyte apoptosis, interstitial fibrosis, and progression to heart failure or coronary microvascular dysfunction."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Nephropathy"@en ;
    skos:definition "Damage to the kidney, including small blood vessels, glomeruli, tubules, and interstitium, due to chronic high blood pressure, clinically manifesting as nephrosclerosis and potentially progressing to kidney failure."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural vascular abnormality, typically affecting younger patients."@en .

ht:BloodPressureMeasurementTechnique a owl:Class ;
    rdfs:label "Blood Pressure Measurement Technique"@en ;
    skos:definition "A physical technique used to obtain a blood pressure measurement."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits calcium entry through L-type voltage-gated channels in cardiac and vascular smooth muscle, comprising dihydropyridine and non-dihydropyridine subtypes."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation of blood pressure, conventionally a systolic pressure of 180 mmHg or more or a diastolic pressure of 120 mmHg or more, classified according to the presence or absence of acute target-organ damage."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to the retina and retinal circulation caused by sustained or abrupt elevation of blood pressure, observable directly on ophthalmoscopy and correlating with systemic microvascular damage."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from kidney disease, the most common category of secondary cause overall."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that is secondary to an identifiable, often correctable, underlying cause; accounts for a minority of cases, roughly 5-17% depending on age group."@en .

ht:BloodPressureMeasurementSetting a owl:Class ;
    rdfs:label "Blood Pressure Measurement Setting"@en ;
    skos:definition "The setting in which a blood pressure measurement is obtained, affecting whether white coat or masked effects may occur."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be changed, such as age, sex, race, or family history."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A factor, modifiable or non-modifiable, that increases the likelihood of developing hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure, in mmHg, between heartbeats, carried by a blood pressure reading."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure, in mmHg, during one heartbeat, carried by a blood pressure reading."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "Competing guideline schemes exist: ESC/ESH 2018/2023 use optimal/normal/high-normal/grade 1-3 with a 140/90 mmHg diagnostic threshold; JNC 7 uses normal/prehypertension/stage 1/stage 2 with a 140/90 mmHg threshold; WHO and ISH also use the 140/90 mmHg threshold; NICE NG136 adds stage 3 (severe). Only the ACC/AHA 2017 band scheme is modeled as classes here; other schemes are noted for conflict awareness only."@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "A defined band of systolic and/or diastolic values, as established by the American College of Cardiology/American Heart Association in 2017 for adults aged 20 years and older."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from an endocrine disturbance."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be changed through behavior or intervention."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "Hypertension Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to an organ system resulting from chronic or acute elevation of blood pressure."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific vascular or tissue sign observed on dilated fundoscopic examination of the retina in the setting of hypertension."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:definition "A class of medication used to lower elevated blood pressure."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable condition, medication, or substance that produces secondary hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic values, expressed in millimetres of mercury, representing arterial pressure at the time of measurement."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    skos:altLabel "HTN"@en,
        "High Blood Pressure"@en ;
    skos:definition "A chronic medical condition characterized by sustained elevation of arterial blood pressure, diagnosed by repeated measurement rather than by symptoms."@en .

