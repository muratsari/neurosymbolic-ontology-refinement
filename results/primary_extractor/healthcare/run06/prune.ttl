@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ht: a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    skos:definition "An ontology modeling the classification, etiology, measurement, treatment, risk factors, and target-organ damage of hypertension as described in the corpus."@en .

ht:Acromegaly a owl:Class ;
    rdfs:label "Acromegaly"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A disorder of excess growth hormone recognized as an endocrine cause of secondary hypertension."@en .

ht:AdvancedAge a owl:Class ;
    rdfs:label "Advanced Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Increasing age, a non-modifiable risk factor; prevalence of hypertension rises to approximately 60% of individuals above age 60."@en .

ht:AlcoholConsumption a owl:Class ;
    rdfs:label "Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Alcohol intake, a modifiable risk factor positively associated with higher blood pressure."@en .

ht:AllTopKindsDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:SecondaryCause ht:TargetOrganDamage ht:Antihypertensive ht:RiskFactor ht:MeasurementMethod ) .

ht:AntihypertensiveDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:CalciumChannelBlocker ht:BetaBlocker ht:MineralocorticoidReceptorAntagonist ) .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "A congenital narrowing of the aorta that typically causes secondary hypertension in younger patients."@en .

ht:BloodPressureBandsDisjoint a owl:AllDisjointClasses ;
    rdfs:comment "The corpus notes that when systolic and diastolic values fall into different categories, the higher category is used to classify the reading; boundary readings that numerically satisfy more than one band's disjuncts are resolved by this convention rather than by the ontology."@en ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

ht:CongenitalAdrenalHyperplasia a owl:Class ;
    rdfs:label "Congenital Adrenal Hyperplasia"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A congenital adrenal enzyme disorder recognized as a less common endocrine cause of secondary hypertension."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A disorder of excess glucocorticoid secretion that is a recognized endocrine cause of secondary hypertension."@en .

ht:Depression a owl:Class ;
    rdfs:label "Depression"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A psychological condition associated with increased risk of hypertension."@en .

ht:DihydropyridineNonDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:Dihydropyridine ht:NonDihydropyridine ) .

ht:ExcessSaltIntake a owl:Class ;
    rdfs:label "Excess Salt Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "High dietary sodium consumption, a central modifiable risk factor; approximately 50-60% of hypertensive patients are salt-sensitive."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A family history of hypertension, a non-modifiable risk factor reflecting heritable predisposition."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Inherited genetic variation, including more than 2,000 identified common variants with small individual effects, contributing to individual susceptibility to hypertension."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Inflammation of the renal glomeruli that is a recognized cause of secondary hypertension."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:ThyroidDisease ;
    skos:definition "Excess thyroid hormone production, a recognized cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:ThyroidDisease ;
    skos:definition "Deficient thyroid hormone production, a recognized cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:comment "Traditionally defined as systolic pressure above 140 mmHg with diastolic below 90 mmHg; under the 2017 ACC/AHA guideline a systolic pressure of 130 mmHg qualifies as hypertensive at all ages."@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A pattern of hypertension characterized by an elevated systolic pressure with a normal or low diastolic pressure, producing a widened pulse pressure; it is the predominant form of hypertension in older adults and chiefly results from age-related arterial stiffening."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Thickening of the left ventricular wall in compensatory response to chronic pressure overload, the hallmark structural manifestation of hypertensive heart disease."@en .

ht:Loneliness a owl:Class ;
    rdfs:label "Loneliness"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A psychosocial state associated with increased risk of hypertension."@en .

ht:MeasurementMethodDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ht:OfficeBloodPressureMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

ht:ModifiableNonModifiableDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excess Body Weight"@en ;
    skos:definition "Excess body weight, a modifiable risk factor for hypertension; weight reduction alone can lower systolic blood pressure by 5 to 20 mmHg."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A catecholamine-secreting tumor that causes vasoconstriction and secondary hypertension through excess norepinephrine and epinephrine secretion."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Lack of regular physical exercise, a modifiable risk factor for hypertension."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A hereditary cystic kidney disorder that is a recognized cause of secondary hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en ;
    skos:definition "Autonomous adrenal overproduction of aldosterone, most often from an aldosterone-producing adenoma or bilateral adrenal hyperplasia, accounting for most endocrine causes of secondary hypertension and found in as many as one in five patients with resistant hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excess parathyroid hormone secretion, a recognized endocrine cause of secondary hypertension."@en .

ht:PrimarySecondaryDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Race or ethnicity, a non-modifiable factor influencing hypertension risk and guideline-recommended treatment selection."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of the renal artery that produces secondary (renovascular) hypertension through reduced renal perfusion and activation of the renin-angiotensin system."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:minQualifiedCardinality 3 ;
                        owl:onClass ht:Antihypertensive ;
                        owl:onProperty ht:hasAntihypertensive ] ) ] ;
    skos:definition "Blood pressure that remains above goal despite adherence to three suitably dosed antihypertensive drugs of different classes, one of which is a diuretic, or blood pressure controlled only with four or more agents, after exclusion of the white coat effect and confirmation of adherence."@en .

ht:RetinalFindingDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

ht:SecondaryCauseTopDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

ht:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Biological sex, a non-modifiable risk factor influencing hypertension prevalence and treatment selection."@en .

ht:TargetOrganDamageDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveKidneyDisease ht:HypertensiveEncephalopathy ht:Stroke ht:CoronaryArteryDisease ht:MyocardialInfarction ht:HeartFailure ht:AtrialFibrillation ht:AorticAneurysm ht:PeripheralArterialDisease ht:ChronicKidneyDisease ) .

ht:TobaccoSmoking a owl:Class ;
    rdfs:label "Tobacco Smoking"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Use of tobacco, a modifiable risk factor for hypertension and cardiovascular disease."@en .

ht:UrgencyEmergencyDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

ht:WhiteCoatMaskedDisjoint a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

ht:hasBloodPressureCategory a owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    skos:definition "Relates a blood pressure reading to the ACC/AHA-2017 classification band it falls into."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:MeasurementMethod ;
    skos:definition "Relates a blood pressure reading to the method or setting used to obtain it."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    skos:definition "Relates hypertensive retinopathy to a specific retinal finding observed on fundoscopic examination."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    skos:definition "Relates hypertension to a modifiable or non-modifiable risk factor associated with its development."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Blood pressure measurement taken at regular intervals over a full day-night cycle outside the clinical setting, the reference standard for distinguishing white coat and masked hypertension."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits the angiotensin-converting enzyme, reducing angiotensin II production and increasing bradykinin levels to cause vasodilation."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks the binding of angiotensin II to its AT1 receptor, rather than inhibiting its production."@en .

ht:AorticAneurysm a owl:Class ;
    rdfs:label "Aortic Aneurysm"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Abnormal dilation of the aorta recognized as a complication of sustained hypertension."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalized or focal narrowing of the retinal arterioles, an early finding of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en ;
    skos:definition "Compression of a retinal vein where it is crossed by a sclerotic arteriole, a finding of hypertensive retinopathy."@en .

ht:AtrialFibrillation a owl:Class ;
    rdfs:label "Atrial Fibrillation"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "An irregular cardiac arrhythmia recognized as a complication of sustained hypertension."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "A blood pressure measurement technique using a stethoscope and sphygmomanometer to detect Korotkoff sounds as cuff pressure is released."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive drug class that inhibits catecholamine binding to beta-adrenergic receptors, decreasing heart rate, contractility, and renin release; no longer recommended as first-line therapy for uncomplicated hypertension except with a compelling cardiac indication."@en .

ht:ChronicKidneyDisease a owl:Class ;
    rdfs:label "Chronic Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Progressive loss of renal filtering capacity recognized as a complication of sustained hypertension."@en .

ht:CoronaryArteryDisease a owl:Class ;
    rdfs:label "Coronary Artery Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Accelerated atherosclerosis of the coronary arteries resulting from chronic hypertensive vascular damage."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A retinal ischemic lesion appearing as a fluffy white patch, a finding of more advanced hypertensive retinopathy."@en .

ht:Dihydropyridine a owl:Class ;
    rdfs:label "Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker acting predominantly on vascular smooth muscle to cause peripheral vasodilation, preferred for the treatment of hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "Secondary hypertension caused by a medication or substance, including NSAIDs, sympathomimetic decongestants, stimulants, certain antidepressants, corticosteroids, licorice or carbenoxolone, oral contraceptives and estrogens, cyclosporine, and recreational substances such as cocaine and methamphetamine."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:comment "This range was previously termed 'prehypertension' under JNC 7, though JNC 7's prehypertension range (120-139/80-89 mmHg) was wider, spanning both this band and Stage1Hypertension under the later ACC/AHA scheme."@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 79 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "A blood pressure reading with a systolic pressure of 120 to 129 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Lipid deposition in the retina resulting from leakage through damaged retinal vessels in hypertensive retinopathy."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Impairment of the heart's pumping ability, occurring with reduced or preserved ejection fraction, resulting from chronic pressure overload and remodeling of the left ventricle."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Patient self-measurement of blood pressure at home, found to be as accurate as ambulatory monitoring in determining blood pressure levels."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis accompanied by acute hypertension-mediated target-organ damage, requiring immediate, monitored, parenteral blood pressure reduction."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute brain swelling and dysfunction caused by severely elevated blood pressure, presenting with headache, confusion, or visual disturbance."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Nephropathy"@en,
        "Hypertensive Nephrosclerosis"@en,
        "Nephrosclerosis"@en ;
    skos:definition "Damage to kidney tissue, including small blood vessels, glomeruli, tubules, and interstitium, caused by chronic high blood pressure, characterized pathologically by nephrosclerosis and capable of progressing to end-stage kidney disease."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis without evidence of acute target-organ damage, typically managed with gradual oral blood pressure reduction over 24 to 48 hours."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "MH"@en ;
    skos:definition "A phenotype in which office blood pressure is normal while out-of-office blood pressure is consistently elevated, the inverse pattern of white coat hypertension."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "MRA"@en ;
    skos:definition "A drug class, including spironolactone, that antagonizes mineralocorticoid receptors and is added for management of resistant hypertension and primary aldosteronism."@en .

ht:MyocardialInfarction a owl:Class ;
    rdfs:label "Myocardial Infarction"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute damage to heart muscle caused by blockage of a coronary artery, a recognized complication of hypertension."@en .

ht:NonDihydropyridine a owl:Class ;
    rdfs:label "Non Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker, such as verapamil and diltiazem, that primarily affects cardiac contractility and atrioventricular conduction, better suited to management of arrhythmias."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 119 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 79 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure less than 120 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep-related breathing disorder that is one of the most common causes of secondary hypertension and is also a prominent modifiable contributor to resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement performed in a clinical office setting, subject to the white coat effect."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "An automated blood pressure measurement technique that calculates systolic, diastolic, and mean arterial pressures from oscillations in cuff pressure."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding, indicating malignant hypertensive retinopathy."@en .

ht:PeripheralArterialDisease a owl:Class ;
    rdfs:label "Peripheral Arterial Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Atherosclerotic disease of the peripheral arteries recognized as a complication of sustained hypertension."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable secondary cause, accounting for approximately 85-95% of cases and arising from an interaction of genetic and environmental/lifestyle factors."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Disease of the renal arterial vasculature that produces hypertension through renal artery narrowing and reduced renal perfusion."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Bleeding into the retinal tissue, including flame-shaped and blot hemorrhages, resulting from breakdown of the blood-retinal barrier in hypertensive retinopathy."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 130 to 139 mmHg or a diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 140 mmHg or greater or a diastolic pressure of 90 mmHg or greater."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:comment "The corpus refers to both ischemic stroke and hemorrhagic/intracerebral hemorrhage as hypertensive complications; both are treated here as forms of this single class rather than as separate sibling classes."@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute ischemic or hemorrhagic cerebrovascular injury resulting from sustained or severely elevated blood pressure."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "Thiazide-Type Diuretic"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks sodium reabsorption in the distal convoluted tubule, promoting natriuresis, diuresis, and a modest vasodilatory effect."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "WHT"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A phenotype of labile hypertension in which office blood pressure is consistently elevated while out-of-office blood pressure is normal."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    skos:definition "Relates hypertension to an antihypertensive drug class used in its management."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The single systolic blood pressure value, in mmHg, at or above which hypertension is diagnosed under a given clinical standard."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    skos:definition "Relates secondary hypertension to the identifiable underlying cause responsible for it."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    skos:definition "Relates hypertension to a form of target-organ damage it has produced."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the left ventricle, left atrium, and coronary arteries resulting from chronic blood pressure elevation, whose hallmark manifestation is left ventricular hypertrophy."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to the retina and retinal circulation caused by sustained or abrupt elevations of blood pressure, visible on direct examination of the retinal vessels."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Disease intrinsic to kidney tissue, including diabetic nephropathy, glomerulonephritis, interstitial disorders, and polycystic kidney disease, that causes secondary hypertension."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that is secondary to an identifiable underlying cause, accounting for approximately 5-15% of cases."@en .

ht:ThyroidDisease a owl:Class ;
    rdfs:label "Thyroid Disease"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine disorder of the thyroid gland recognized as a cause of secondary hypertension, encompassing both hyperthyroidism and hypothyroidism."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural vascular abnormality."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits calcium entry through L-type voltage-gated calcium channels in cardiac and vascular smooth muscle."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation of blood pressure, conventionally a systolic pressure of 180 mmHg or more or a diastolic pressure of 120 mmHg or more, classified according to the presence or absence of acute target-organ damage."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from kidney disease, the most common category of secondary hypertension."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A modifiable or non-modifiable attribute or exposure that increases the likelihood of developing hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The diastolic pressure, in mmHg, recorded in a blood pressure reading."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic pressure, in mmHg, recorded in a blood pressure reading."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "The corpus documents competing guideline schemes (ESC/ESH 2018/2023 grades 1-3 with a 140/90 mmHg threshold; JNC 7 with prehypertension and a 140/90 mmHg threshold; WHO and ISH at 140/90 mmHg; NICE NG136 stages). Only the 2017 ACC/AHA four-band scheme is modeled as classes; competing thresholds are noted here rather than modeled as parallel class trees."@en ;
    skos:definition "A named band of the 2017 ACC/AHA office blood pressure classification scheme."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be altered, such as age, sex, race, or family history."@en .

ht:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    skos:definition "A technique or setting used to obtain a blood pressure reading."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific retinal abnormality observed on fundoscopic examination as a manifestation of hypertensive retinopathy."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a hormonal disorder."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be altered through behavioral or lifestyle change."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable underlying medical condition, medication, or substance responsible for secondary hypertension."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:definition "A class of medication used to lower blood pressure in the treatment of hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    skos:definition "A measured pair of systolic and diastolic values obtained at one measurement occasion."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "The corpus documents a genuine guideline conflict on the diagnostic systolic threshold: the 2017 ACC/AHA guideline diagnoses hypertension at a systolic pressure of 130 mmHg or more (and/or diastolic over 80 mmHg), whereas ESC/ESH, JNC 7, WHO, and ISH guidelines use a threshold of 140 mmHg systolic (and/or 90 mmHg diastolic). Both values are recorded here rather than being scattered across per-guideline subclasses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiagnosticSystolicThreshold ;
            owl:qualifiedCardinality 1 ] ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic medical condition characterized by sustained elevation of arterial blood pressure."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to the heart, brain, kidneys, eyes, or vasculature resulting from sustained or acute hypertension."@en .

