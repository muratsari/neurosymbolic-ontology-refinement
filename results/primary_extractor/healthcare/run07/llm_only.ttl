@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ht: a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    rdfs:comment "An ontology modeling hypertension classification, etiology, measurement, treatment, risk factors and target-organ damage, based on the ACC/AHA 2017 classification scheme with competing guideline thresholds noted in comments."@en .

ht:AdvancedAge a owl:Class ;
    rdfs:label "Advanced Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Increasing age, a non-modifiable risk factor; prevalence of hypertension rises to approximately 60% of individuals above age 60."@en .

ht:AlcoholUse a owl:Class ;
    rdfs:label "Alcohol Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Excessive alcohol consumption, a modifiable risk factor associated with higher blood pressure."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "A congenital narrowing of the aorta that typically produces hypertension in younger patients."@en .

ht:ExcessSodiumIntake a owl:Class ;
    rdfs:label "Excess Sodium Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Dietary salt intake above recommended levels, which increases blood pressure, particularly in the 50-60% of patients who are salt-sensitive."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A family history of hypertension, a non-modifiable risk factor reflecting familial clustering of the condition."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Inherited genetic variants, including more than 2,000 identified common variants with small effects, that predispose an individual to hypertension."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Progressive decline in cardiac contractility and ejection fraction representing the end stage of hypertensive heart disease, or arising with preserved ejection fraction from a stiff, hypertrophied ventricle."@en .

ht:HypertensiveNephropathy a owl:Class ;
    rdfs:label "Hypertensive Nephropathy"@en ;
    rdfs:subClassOf ht:HypertensiveKidneyDisease ;
    skos:definition "Kidney failure attributable to a history of hypertension, a chronic condition and serious risk factor for end-stage kidney disease, underpinned by progressive nephrosclerosis."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "ISH"@en ;
    skos:definition "Hypertension characterized by elevated systolic pressure (traditionally above 140 mmHg, or 130 mmHg under ACC/AHA 2017) with preserved or low diastolic pressure (below 90 mmHg), producing a widened pulse pressure; the predominant hypertension pattern in older adults due to reduced arterial compliance."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "LVH"@en ;
    skos:definition "Thickening of the left ventricular wall in compensatory response to chronic pressure overload; the hallmark structural manifestation of hypertensive heart disease."@en .

ht:Nephrosclerosis a owl:Class ;
    rdfs:label "Nephrosclerosis"@en ;
    rdfs:subClassOf ht:HypertensiveKidneyDisease ;
    skos:definition "Hardening and thickening of small renal blood vessels and glomeruli caused by chronic hypertension, reducing blood and oxygen supply to kidney tissue; the characteristic lesion of hypertensive kidney disease."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Excess body weight, a modifiable risk factor for hypertension; weight reduction can lower systolic blood pressure by 5-20 mmHg."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Lack of regular exercise, a modifiable risk factor for hypertension."@en .

ht:PsychosocialStress a owl:Class ;
    rdfs:label "Psychosocial Stress"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Psychological and social factors, including chronic stress, depression, and loneliness, associated with increased risk of hypertension."@en .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Race, a non-modifiable risk factor that also influences antihypertensive treatment selection."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of the renal artery that produces hypertension through activation of the renin-angiotensin system; the characteristic form of renovascular disease."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:minQualifiedCardinality 3 ;
                        owl:onClass ht:Antihypertensive ;
                        owl:onProperty ht:hasAntihypertensive ] ) ] ;
    skos:definition "Hypertension not controlled to goal despite adherence to at least three suitably dosed antihypertensive medications of different classes, one of which is a diuretic, after exclusion of the white-coat effect; or hypertension controlled only with four or more agents."@en .

ht:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Biological sex, a non-modifiable risk factor for hypertension."@en .

ht:TobaccoUse a owl:Class ;
    rdfs:label "Tobacco Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Smoking or other tobacco use, a modifiable risk factor for hypertension and cardiovascular disease."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "ACC/AHA 2017 uses 130 mmHg; ESC/ESH, JNC 7, WHO, and ISH use 140 mmHg."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure value, in mmHg, at or above which a guideline diagnoses hypertension."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementMethod ;
    skos:definition "Relates a blood pressure reading to the technique used to obtain it."@en .

ht:hasMeasurementSetting a owl:ObjectProperty ;
    rdfs:label "has measurement setting"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementSetting ;
    skos:definition "Relates a blood pressure reading to the context (office or out-of-office) in which it was obtained."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    skos:definition "Relates hypertensive retinopathy to a specific finding observed on fundoscopic examination."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    skos:definition "Relates hypertension to a factor that increases the likelihood of its development."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasBloodPressureCategory ;
    skos:definition "Inverse of has blood pressure category."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasSecondaryCause ;
    skos:definition "Inverse of has secondary cause."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasTargetOrganDamage ;
    skos:definition "Inverse of has target organ damage."@en .

ht:Acromegaly a owl:Class ;
    rdfs:label "Acromegaly"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to excess growth hormone."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure measurement at regular intervals over a full sleep-wake cycle, used as a reference standard for diagnosing hypertension and its phenotypes."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits the angiotensin-converting enzyme, reducing angiotensin II production and increasing bradykinin, thereby causing vasodilation; preferred in diabetes, chronic kidney disease, and heart failure."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks the binding of angiotensin II to its AT1 receptor rather than inhibiting its formation; causes less cough and angioedema than ACE inhibitors and is generally not combined with ACE inhibitors."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalized or focal narrowing of the retinal arterioles, an early sign of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en ;
    skos:definition "Compression of a retinal vein where it is crossed by a sclerotic arteriole, a sign of hypertensive retinopathy."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "A blood pressure measurement technique using a cuff, sphygmomanometer, and stethoscope to listen for Korotkoff sounds."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive drug class that inhibits catecholamines from binding to beta-adrenergic receptors, reducing heart rate, contractility, and renin release; no longer recommended as first-line therapy for uncomplicated hypertension except with a compelling cardiac indication."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A retinal ischemic lesion appearing as a fluffy white patch, seen in more advanced hypertensive retinopathy."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to excess glucocorticoids."@en .

ht:DihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A calcium channel blocker subtype that acts predominantly on vascular smooth muscle to cause peripheral vasodilation; preferred for treating hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "Hypertension caused by a medication or recreational substance, including NSAIDs, sympathomimetic decongestants, stimulants, certain antidepressants, systemic corticosteroids, licorice, carbenoxolone, oral contraceptives, estrogens, cyclosporine, cocaine, and methamphetamine; may resolve upon discontinuation of the offending agent."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:comment "JNC 7 labels this range, together with diastolic 80-89, as 'prehypertension'. ESC 2024 defines an overlapping but wider 'Elevated Blood Pressure' category of 120-139/70-89 mmHg."@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "A blood pressure reading with systolic pressure of 120 to 129 mmHg and diastolic pressure below 80 mmHg."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A deposit of lipid and protein leaking from damaged retinal vessels, seen in advanced hypertensive retinopathy."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Out-of-office blood pressure measurement performed by the patient using a home monitoring device, complementary to ambulatory monitoring."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis accompanied by acute hypertension-mediated organ damage, requiring prompt, controlled, parenteral blood pressure reduction."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute brain swelling and dysfunction caused by severely elevated blood pressure, presenting with headache, confusion, or visual disturbance; a form of cerebral hypertensive target-organ damage and a defining feature of hypertensive emergency."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis involving severe blood pressure elevation without evidence of acute target-organ damage, managed by gradual oral blood pressure reduction over hours to days."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to excess thyroid hormone."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to deficient thyroid hormone."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "MH"@en ;
    skos:definition "A blood pressure phenotype in which office blood pressure is normal but out-of-office blood pressure is consistently elevated."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive drug class, such as spironolactone, that blocks the mineralocorticoid receptor; commonly added as a fourth agent in resistant hypertension."@en .

ht:NonDihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Non Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A calcium channel blocker subtype, such as verapamil and diltiazem, that primarily affects cardiac contractility and atrioventricular conduction; better suited to arrhythmia management."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:comment "European Society of Cardiology sets the normal diastolic threshold under 70 mmHg rather than under 80 mmHg."@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 120 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure below 120 mmHg and diastolic pressure below 80 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep-related breathing disorder recognized as one of the most common causes of secondary hypertension and resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementSetting ;
    skos:definition "A blood pressure reading taken in a clinic or office setting."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "An automated blood pressure measurement technique that calculates systolic, diastolic, and mean arterial pressure from oscillations in cuff pressure."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding, indicating malignant hypertensive retinopathy and present in hypertensive emergency."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to a tumor causing excessive secretion of norepinephrine and epinephrine, promoting vasoconstriction."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "Endocrine cause of hypertension due to autonomous overproduction of aldosterone by an adrenal adenoma or bilateral adrenal hyperplasia, promoting sodium retention and potassium excretion; accounts for most endocrine secondary hypertension and is found in up to one in five patients with resistant hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Endocrine cause of hypertension due to excess parathyroid hormone."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable cause, arising from a complex interaction of genetic predisposition and environmental/lifestyle factors; accounts for approximately 85-95% of cases."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Renal cause of hypertension arising from intrinsic kidney tissue disease, including diabetic nephropathy, glomerulonephritis, interstitial disorders, polycystic kidney disease, and lupus nephritis."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Flame Hemorrhage"@en ;
    skos:definition "Bleeding into the retinal tissue, including flame-shaped and blot hemorrhages, occurring as the blood-retinal barrier breaks down in more advanced hypertensive retinopathy."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that is secondary to an identifiable underlying cause, accounting for approximately 5-15% of cases overall, with a much higher proportion in children."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:comment "ESC/ESH designates this same numeric range 'high-normal' (130-139/85-89) rather than a hypertensive stage; this is the central 130/80 vs 140/90 guideline conflict."@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure of 130 to 139 mmHg or diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:comment "ESC/ESH, JNC 7, WHO, and ISH all agree that 140/90 mmHg or above constitutes hypertension (labelled grade 1-3 or stage 1-2 under those systems), consistent with ACC/AHA Stage 2."@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure of 140 mmHg or greater or diastolic pressure of 90 mmHg or greater."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "A first-line antihypertensive drug class that blocks sodium reabsorption in the distal convoluted tubule, promoting natriuresis and diuresis and causing modest vasodilation; includes thiazide-like agents such as chlorthalidone and indapamide."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "WHT"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A form of labile hypertension in which office blood pressure is consistently elevated but out-of-office blood pressure is normal."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    skos:definition "Relates a case of hypertension to a class of antihypertensive medication used in its treatment."@en .

ht:hasBloodPressureCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    skos:definition "Relates a blood pressure reading to the single ACC/AHA 2017 category it falls into."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to the retina and retinal circulation resulting from sustained or abrupt elevations in blood pressure, visible on dilated eye examination and correlating with the severity and chronicity of hypertension."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Renal cause of hypertension arising from obstruction of the renal artery."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural vascular abnormality."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:SecondaryCause ;
    skos:definition "Relates a case of hypertension to an identifiable underlying condition, substance, or medication responsible for the elevated blood pressure."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    skos:definition "Relates a case of hypertension to a form of structural or functional organ injury it has caused."@en .

ht:BloodPressureMeasurementMethod a owl:Class ;
    rdfs:label "Blood Pressure Measurement Method"@en ;
    rdfs:comment "Placeholder taxonomy root for measurement technique."@en ;
    rdfs:subClassOf [ a owl:Restriction ] ;
    skos:definition "A technique used to obtain a blood pressure reading."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits calcium entry through L-type voltage-gated calcium channels in cardiac and vascular smooth muscle."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation in blood pressure, commonly defined as systolic pressure over 180 mmHg or diastolic pressure over 120 mmHg, classified according to the presence or absence of acute target-organ damage."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the left ventricle, left atrium, and coronary arteries resulting from chronic blood pressure elevation."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to kidney tissue, including small blood vessels, glomeruli, tubules, and interstitium, caused by chronic high blood pressure."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension originating in the kidney or its blood supply; the most common category of secondary hypertension."@en .

ht:BloodPressureMeasurementSetting a owl:Class ;
    rdfs:label "Blood Pressure Measurement Setting"@en ;
    skos:definition "The context in which a blood pressure reading is obtained."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A factor, modifiable or non-modifiable, that increases the likelihood of developing hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure between heartbeats, in mmHg."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure during one heartbeat, in mmHg."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "Competing guidelines use different band schemes (ESC/ESH 2018/2023 grades 1-3 at a 140/90 threshold, JNC 7 prehypertension/stage1/stage2, WHO and ISH 140/90 threshold, NICE NG136 out-of-office thresholds). Only the ACC/AHA 2017 scheme is modeled as classes; competing thresholds are noted here rather than modeled as parallel class trees."@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "An ACC/AHA 2017 classification band (Normal, Elevated, Stage 1, Stage 2) into which a blood pressure reading is realized by its numeric values."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be altered, such as age, sex, race, or genetic predisposition."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be changed through behavior or lifestyle intervention."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a hormonal disturbance."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific ophthalmoscopically observed sign of hypertensive vascular injury to the retina."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:definition "Structural or functional injury to the heart, kidneys, retina, or brain resulting from chronic or acute hypertension."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:definition "A class of medication used to lower blood pressure."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable underlying condition, vascular abnormality, endocrine disorder, or substance that directly produces elevated blood pressure."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic values representing the force of circulating blood against arterial walls at a point in time."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Guideline conflict: ACC/AHA 2017 diagnoses hypertension at a systolic threshold of 130 mmHg (and/or diastolic 80 mmHg), whereas ESC/ESH, JNC 7, WHO, and ISH diagnose hypertension at the older threshold of 140 mmHg systolic (and/or 90 mmHg diastolic). Both values are documented via hasDiagnosticSystolicThreshold, which is functional per-assertion but whose value differs by guideline."@en ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic medical condition characterized by sustained elevation of arterial pressure, diagnosed when systolic and/or diastolic pressure persistently meets or exceeds the diagnostic threshold."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:Antihypertensive ht:SecondaryCause ht:TargetOrganDamage ht:RiskFactor ht:RetinalFinding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalParenchymalDisease ht:RenovascularDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryAldosteronism ht:Pheochromocytoma ht:CushingSyndrome ht:Hyperthyroidism ht:Hypothyroidism ht:Acromegaly ht:PrimaryHyperparathyroidism ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DihydropyridineCalciumChannelBlocker ht:NonDihydropyridineCalciumChannelBlocker ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:CalciumChannelBlocker ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:BetaBlocker ht:MineralocorticoidReceptorAntagonist ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveKidneyDisease ht:HypertensiveEncephalopathy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeBloodPressureMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

