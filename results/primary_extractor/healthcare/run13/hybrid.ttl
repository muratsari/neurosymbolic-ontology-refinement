@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ht: a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    rdfs:comment "An ontology modelling the classification, etiology, measurement, treatment, risk factors and target-organ damage of hypertension, as stated in the source corpus."@en .

ht:AdvancedAge a owl:Class ;
    rdfs:label "Advanced Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Increasing age, a non-modifiable risk factor for hypertension; prevalence rises to about 60% of individuals above age 60."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "A congenital narrowing of the aorta that is a vascular cause of secondary hypertension, typically affecting younger patients."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Cushing's Syndrome"@en ;
    skos:definition "An endocrine disorder of excess glucocorticoids that is a recognized cause of secondary hypertension."@en .

ht:ExcessiveAlcoholConsumption a owl:Class ;
    rdfs:label "Excessive Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Alcohol intake above recommended levels, associated with higher blood pressure and a modifiable risk factor for hypertension."@en .

ht:ExcessiveSaltIntake a owl:Class ;
    rdfs:label "Excessive Salt Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Consumption of dietary salt above recommended levels; approximately 50-60% of hypertensive patients are salt sensitive, and this is a central modifiable risk factor for hypertension."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A hereditary and genetic predisposition toward hypertension, a non-modifiable risk factor."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Inflammatory disease of the renal glomeruli that is a recognized renal parenchymal cause of secondary hypertension."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excess thyroid hormone secretion recognized as an endocrine cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Deficient thyroid hormone secretion recognized as an endocrine cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:comment "Threshold conflict: traditional criterion is systolic >140 mmHg with diastolic <90 mmHg, whereas the 2017 ACC/AHA guideline classifies systolic >=130 mmHg as hypertensive at any age. About 15-30% of persons 60 years and older have isolated systolic hypertension, versus 6% at 40-50 years and 1.8% at 18-39 years."@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "The predominant form of hypertension in older adults, traditionally a systolic pressure above 140 mmHg with a diastolic pressure below 90 mmHg, caused chiefly by age-related arterial stiffening producing a widened pulse pressure."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Thickening of the left ventricular wall in compensatory response to sustained pressure overload, the hallmark structural manifestation of hypertensive heart disease and a strong predictor of cardiovascular events."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Excess body weight, a modifiable risk factor for hypertension; weight reduction alone can lower systolic pressure by 5 to 20 mmHg."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A tumor causing excessive secretion of norepinephrine and epinephrine, promoting vasoconstriction and secondary hypertension."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Lack of regular exercise, a modifiable risk factor that contributes to the development of hypertension."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A hereditary renal parenchymal disorder characterized by multiple kidney cysts that is a recognized cause of secondary hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "Autonomous overproduction of aldosterone by the adrenal glands, most often from a solitary adenoma or bilateral hyperplasia, accounting for most endocrine-related secondary hypertension and found in as many as one in five patients with resistant hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An endocrine disorder of excess parathyroid hormone recognized as a secondary cause of hypertension."@en .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Racial background, a non-modifiable risk factor that also influences first-line treatment selection, notably for Black versus non-Black populations."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of the renal artery that produces hypertension through renovascular mechanisms; may be atherosclerotic in older patients."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:comment "Common secondary causes found in resistant hypertension include primary aldosteronism (present in up to one in five patients), obstructive sleep apnea, and renal artery stenosis."@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Blood pressure that remains uncontrolled to goal despite adherence to three suitably dosed antihypertensive medications of different classes, one of which is a diuretic, or that requires four or more agents, after the white-coat effect has been excluded."@en .

ht:Smoking a owl:Class ;
    rdfs:label "Smoking"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Tobacco use, a modifiable risk factor for hypertension and for cardiovascular disease."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Competing values are documented in the corpus: the 2017 ACC/AHA guideline sets this threshold at 130 mmHg, whereas ESC/ESH (2018, 2023, 2024), JNC 7, WHO, and ISH (2020) set it at 140 mmHg. This single functional property is modelled honestly with both candidate values noted here rather than split into per-guideline subclasses."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure value, in mmHg, at or above which hypertension is diagnosed under a given guideline."@en .

ht:isAntihypertensiveOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive of"@en ;
    rdfs:domain ht:Antihypertensive ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasAntihypertensive ;
    skos:definition "Inverse of has antihypertensive."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasBloodPressureCategory ;
    skos:definition "Inverse of has blood pressure category."@en .

ht:isBloodPressureMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure measurement method of"@en ;
    rdfs:domain ht:BloodPressureMeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasBloodPressureMeasurementMethod ;
    skos:definition "Inverse of has blood pressure measurement method."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    owl:inverseOf ht:hasRetinalFinding ;
    skos:definition "Inverse of has retinal finding."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasRiskFactor ;
    skos:definition "Inverse of has risk factor."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasSecondaryCause ;
    skos:definition "Inverse of has secondary cause."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasTargetOrganDamage ;
    skos:definition "Inverse of has target organ damage."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure measurement at regular intervals over a full 24-hour sleep-wake cycle, the reference standard for distinguishing white coat and masked hypertension."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:comment "Characteristic adverse effects include dry cough (bradykinin-mediated) and angioedema; contraindicated in pregnancy; generally not combined with ARBs."@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive class that inhibits the angiotensin-converting enzyme, decreasing angiotensin II production and increasing bradykinin, causing vasodilation; preferred for patients with diabetes, chronic kidney disease, or heart failure."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:comment "Favoured for patients with left ventricular failure or diabetic nephropathy; contraindicated in pregnancy; generally not combined with ACE inhibitors."@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en ;
    skos:definition "A first-line antihypertensive class that blocks the binding of angiotensin II to its AT1 receptor rather than affecting its production, with efficacy similar to ACE inhibitors but fewer adverse effects such as cough and angioedema."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalized or focal narrowing of retinal arterioles, an early finding of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en ;
    skos:definition "Compression of a retinal vein where it is crossed by a sclerotic arteriole, a finding of hypertensive retinopathy."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "A blood pressure measurement technique using a stethoscope and sphygmomanometer, in which Korotkoff sounds mark the systolic and diastolic pressures as cuff pressure is released."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive class that inhibits catecholamine binding to beta-adrenergic receptors, reducing heart rate, contractility, and renin release; no longer recommended as first-line therapy for uncomplicated hypertension except with a compelling cardiac indication."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A white, fluffy retinal lesion representing localized retinal ischemia, a finding of advanced hypertensive retinopathy."@en .

ht:Dihydropyridine a owl:Class ;
    rdfs:label "Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker that acts predominantly on vascular smooth muscle to cause peripheral vasodilation, preferred for the treatment of hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "Elevated blood pressure caused by a medication or substance, including NSAIDs, sympathomimetic decongestants, stimulants, corticosteroids, licorice, oral contraceptives, cyclosporine, cocaine, and methamphetamine; discontinuing the agent may resolve the hypertension."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 120 to 129 mmHg and a diastolic pressure less than 80 mmHg; previously termed prehypertension."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A sharply demarcated yellow-white retinal deposit of lipid resulting from leakage through a damaged blood-retinal barrier."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Out-of-office blood pressure self-measurement using a home device, used as an alternative to ambulatory monitoring to confirm hypertension diagnosis and detect white coat or masked hypertension."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis accompanied by acute hypertension-mediated target-organ damage, representing a life-threatening condition requiring immediate, controlled, usually intravenous, blood pressure reduction."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute brain swelling and dysfunction caused by severely elevated blood pressure, presenting with headache, confusion, or visual disturbance, and a defining feature of hypertensive emergency."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Nephropathy"@en,
        "Hypertensive Nephrosclerosis"@en ;
    skos:definition "Damage to kidney tissue, including small blood vessels, glomeruli, tubules, and interstitium, due to chronic high blood pressure, causing hardening and thickening of renal tissue (nephrosclerosis) and progressive loss of filtering capacity that can culminate in kidney failure."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis without evidence of acute target-organ damage, typically managed by gradual oral reduction of blood pressure over 24 to 48 hours."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "MH"@en ;
    skos:definition "A blood pressure phenotype, the inverse of white coat hypertension, in which office readings are normal but out-of-office readings are consistently elevated."@en .

ht:NonDihydropyridine a owl:Class ;
    rdfs:label "Non Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker, such as verapamil and diltiazem, that primarily affects cardiac contractility and atrioventricular conduction and is better suited to managing arrhythmias."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 120 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure less than 120 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep-related breathing disorder that is one of the most common causes of secondary hypertension and is frequently implicated in resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "Blood pressure measurement taken in a clinical setting, the conventional entry point for hypertension diagnosis but subject to the white coat effect."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "An automated blood pressure measurement technique that calculates systolic, diastolic, and mean arterial pressures from oscillations in cuff pressure, requiring less operator skill than auscultation."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding of hypertensive retinopathy and a defining feature of malignant hypertension."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable cause, accounting for approximately 85-95 percent of cases, arising from an interaction of genetic predisposition with environmental and lifestyle factors."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "A secondary cause of hypertension produced by obstruction or narrowing of the blood vessels supplying the kidney."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Flame-Shaped Hemorrhage"@en ;
    skos:definition "Bleeding into the retinal tissue from damaged vessels, a finding of more advanced hypertensive retinopathy."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:comment "Prevalence of secondary hypertension is strongly age-dependent: roughly 70-85% in children under 12, 10-15% in adolescents, lowest at 19-39 years, and about 17% in adults 65 and older."@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that is elevated blood pressure secondary to a specific, identifiable, and often correctable underlying cause, accounting for approximately 5 to 15 percent of cases overall."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 130 to 139 mmHg or a diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 140 mmHg or higher or a diastolic pressure of 90 mmHg or higher."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:comment "Chlorthalidone and indapamide are often preferred over hydrochlorothiazide for greater potency and duration; initial volume depletion recovers within weeks while blood pressure control is maintained."@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "A first-line antihypertensive class that blocks sodium reabsorption in the distal convoluted tubule, promoting natriuresis and diuresis and producing modest vasodilation."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "WHT"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A form of labile hypertension in which blood pressure is consistently elevated in a clinical setting but normal out of office, believed to be due to visit-related anxiety."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    skos:definition "Relates an instance of hypertension to a class of antihypertensive medication used in its management."@en .

ht:hasBloodPressureCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    skos:definition "Relates a blood pressure reading to the ACC/AHA 2017 category band that its systolic and/or diastolic values realize."@en .

ht:hasBloodPressureMeasurementMethod a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has blood pressure measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementMethod ;
    skos:definition "Relates a blood pressure reading to the technique or setting used to obtain it."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    skos:definition "Relates hypertensive retinopathy to a specific retinal finding observed on fundoscopic examination."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    skos:definition "Relates an instance of hypertension to a factor that increases the likelihood of its development."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the left ventricle, left atrium, and coronary arteries resulting from chronic blood pressure elevation, including compensatory remodeling, myocyte apoptosis, interstitial fibrosis, and eventual heart failure."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Disease of the kidney tissue itself, including diabetic nephropathy and interstitial disorders, that causes secondary hypertension."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural abnormality of a major blood vessel, typically affecting younger patients."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:SecondaryCause ;
    skos:definition "Relates an instance of hypertension to an identifiable underlying condition, medication, or substance responsible for the elevated blood pressure."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    skos:definition "Relates an instance of hypertension to a form of structural or functional organ injury resulting from chronic or acute blood pressure elevation."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive class that inhibits calcium entry through L-type voltage-gated channels in cardiac and vascular smooth muscle, lowering blood pressure by vasodilation or by reducing cardiac contractility and conduction."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation of blood pressure, conventionally a systolic pressure of 180 mmHg or higher or a diastolic pressure of 120 mmHg or higher; the numerical threshold is conventional rather than independently predictive of outcome."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:comment "The Keith-Wagener-Barker system grades severity from Grade 1 (arteriolar narrowing) to Grade 4 (papilledema, malignant hypertensive retinopathy); per scope this ontology models the named retinal findings rather than the numbered grades."@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to the retina and retinal circulation due to sustained or abrupt elevations in blood pressure, visible on fundoscopic examination and correlated with systemic microvascular damage."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from kidney disease, the most common category of secondary hypertension."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be changed, such as age, sex, race, or family history."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure, in mmHg, between heartbeats, carried by a blood pressure reading."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure, in mmHg, during one heartbeat, carried by a blood pressure reading."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A factor, modifiable or non-modifiable, that increases the likelihood of developing hypertension."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "Competing guideline thresholds exist (ESC/ESH and JNC use grade 1/2/3 and a 140/90 mmHg threshold; JNC 7 used 'prehypertension' for 120-139/80-89 mmHg; ESC 2024 uses a 120-139/70-89 mmHg 'Elevated' band; ISH 2020 uses 140/90 mmHg). This ontology models the single ACC/AHA 2017 scheme as the positive band hierarchy and notes the alternatives here rather than as parallel classes."@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "One of the ACC/AHA 2017 bands (Normal, Elevated, Stage 1, Stage 2) into which a blood pressure reading for adults aged 20 and older is classified."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be changed through behavior or treatment, such as salt intake, weight, smoking, inactivity, or alcohol use."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a hormonal disorder."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:definition "A class of medication used to lower blood pressure in the treatment of hypertension."@en .

ht:BloodPressureMeasurementMethod a owl:Class ;
    rdfs:label "Blood Pressure Measurement Method"@en ;
    skos:definition "A technique or setting used to obtain a blood pressure reading."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to the heart, retina, kidney, or brain resulting from chronic or acute hypertension."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific sign of retinal vascular injury observable on ophthalmoscopy in hypertensive retinopathy."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable underlying condition, medication, or substance that directly produces elevated blood pressure, as distinguished from primary hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    skos:definition "A measured pair of systolic and diastolic values representing the force of circulating blood against arterial walls."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Hypertension is usually asymptomatic ('silent disease') and is a major risk factor for stroke, myocardial infarction, heart failure and renal disease. NICE NG136 additionally requires out-of-office confirmation (ABPM/HBPM average >= 135/85 mmHg) alongside a clinic reading of >=140/90 mmHg."@en ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A long-term medical condition in which arterial blood pressure is persistently elevated, commonly a systolic pressure of 130 mmHg or more and/or a diastolic pressure of 80 mmHg or more under ACC/AHA 2017, or 140/90 mmHg or more under ESC/ESH, JNC and WHO definitions."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:Antihypertensive ht:SecondaryCause ht:TargetOrganDamage ht:RiskFactor ht:RetinalFinding ht:BloodPressureMeasurementMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:Dihydropyridine ht:NonDihydropyridine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:CalciumChannelBlocker ht:BetaBlocker ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeBloodPressureMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveKidneyDisease ht:HypertensiveEncephalopathy ) .

