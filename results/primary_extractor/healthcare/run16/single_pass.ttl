@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ht: a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    rdfs:comment "An ontology modelling the classification, etiology, measurement, treatment, risk factors and target-organ damage of hypertension as described in the supplied corpus."@en .

ht:AdvancedAge a owl:Class ;
    rdfs:label "Advanced Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Older age, a non-modifiable risk factor; prevalence of hypertension rises to approximately 60% of individuals above age 60."@en .

ht:AlcoholUse a owl:Class ;
    rdfs:label "Alcohol Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Consumption of alcohol; increased intake is associated with higher blood pressure and is a modifiable risk factor for hypertension."@en .

ht:CoarctationOfAorta a owl:Class ;
    rdfs:label "Coarctation Of Aorta"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:definition "A congenital narrowing of the aorta that produces secondary hypertension, typically presenting in younger patients."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A condition of excess glucocorticoids that can cause secondary hypertension."@en .

ht:DiabeticNephropathy a owl:Class ;
    rdfs:label "Diabetic Nephropathy"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Kidney damage resulting from diabetes mellitus that can cause secondary hypertension."@en .

ht:ExcessSaltIntake a owl:Class ;
    rdfs:label "Excess Salt Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Dietary sodium intake above recommended levels; a central modifiable risk factor, with 50 to 60% of hypertensive patients demonstrating salt-sensitive physiology."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A family history of hypertension, a non-modifiable risk factor reflecting heritable predisposition."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Inherited genetic variants, more than 2,000 of which have been identified with small individual effects on blood pressure, contributing to primary hypertension risk."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Inflammatory disease of the renal glomeruli that can cause secondary hypertension."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:CerebrovascularDamage ;
    skos:definition "Brain swelling and dysfunction caused by severely elevated blood pressure, presenting with headache, confusion, or visual disturbance, and a defining feature of hypertensive emergency."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excess thyroid hormone activity recognized as a cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Deficient thyroid hormone activity recognized as a cause of secondary hypertension and of isolated systolic hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A pattern of hypertension, predominant among older adults, defined by a disproportionately elevated systolic pressure with a preserved, normal, or low diastolic pressure, producing a widened pulse pressure; chiefly caused by age-related arterial stiffening."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Thickening of the left ventricular wall in compensatory response to chronic pressure overload; the hallmark structural manifestation of hypertensive heart disease."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Excess body weight, a modifiable risk factor for hypertension; weight reduction alone can lower systolic pressure by 5 to 20 mmHg."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A tumor that causes excessive secretion of norepinephrine and epinephrine, promoting vasoconstriction and secondary hypertension."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Lack of regular exercise, a modifiable risk factor for the development of hypertension."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A hereditary renal parenchymal disorder characterized by multiple kidney cysts that can cause secondary hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en ;
    skos:definition "Autonomous adrenal overproduction of aldosterone, due to an aldosterone-producing adenoma or bilateral adrenal hyperplasia, that raises blood pressure and sometimes causes hypokalemia; present in up to one in five patients with resistant hypertension."@en .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Race or ethnicity, a non-modifiable risk factor that also influences selection of first-line antihypertensive therapy."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of a renal artery, often atherosclerotic, that produces renovascular hypertension and is a recognized cause of isolated systolic hypertension."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Hypertension that remains uncontrolled to goal despite adherence to three suitably dosed antihypertensive medications of different classes, one of which is a diuretic, with the white-coat effect excluded; or that is controlled only with four or more agents."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:subClassOf ht:CerebrovascularDamage ;
    skos:definition "Ischemic or hemorrhagic cerebrovascular injury resulting from bursting or blockage of arteries supplying the brain, a major complication of hypertension."@en .

ht:TobaccoUse a owl:Class ;
    rdfs:label "Tobacco Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Smoking"@en ;
    skos:definition "Use of tobacco products, a modifiable risk factor for hypertension and cardiovascular disease."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    owl:inverseOf ht:isAntihypertensiveOf ;
    skos:definition "Relates hypertension to a class of antihypertensive medication used in its treatment."@en .

ht:hasBloodPressureCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    owl:inverseOf ht:isBloodPressureCategoryOf ;
    skos:definition "Relates a blood pressure reading to the ACC/AHA 2017 category band into which it falls."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Competing values documented in the corpus: 130 (2017 ACC/AHA) versus 140 (JNC 7, WHO, 2018/2023 ESC/ESH, 2020 ISH)."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure value, in mmHg, at or above which hypertension is diagnosed under a given clinical guideline."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:MeasurementMethod ;
    owl:inverseOf ht:isMeasurementMethodOf ;
    skos:definition "Relates a blood pressure reading to the technique or setting used to obtain it."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    owl:inverseOf ht:isRiskFactorOf ;
    skos:definition "Relates hypertension to a factor, modifiable or non-modifiable, that increases the likelihood of its development."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure measurement taken at regular intervals over a full 24-hour sleep-wake cycle; the reference standard for distinguishing white coat and masked hypertension."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits angiotensin-converting enzyme, reducing angiotensin II production and increasing bradykinin levels, thereby promoting vasodilation; preferred in patients with diabetes, chronic kidney disease, or heart failure, and contraindicated in pregnancy."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks the binding of angiotensin II to the AT1 receptor, with efficacy similar to ACE inhibitors but a much lower incidence of cough and angioedema."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalized or focal narrowing of retinal arterioles, the earliest sign of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nipping"@en ;
    skos:definition "Compression of a retinal vein where it is crossed by a sclerotic arteriole."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "A blood pressure measurement technique using a stethoscope and sphygmomanometer in which systolic and diastolic pressures are identified from the onset and disappearance of Korotkoff sounds."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "An antihypertensive drug class that inhibits catecholamine binding to beta-adrenergic receptors, reducing heart rate, cardiac contractility, and renin release; no longer recommended as first-line therapy for uncomplicated hypertension but reserved for patients with a compelling cardiac indication."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A retinal ischemic lesion appearing as a fluffy white patch, seen in moderate to severe hypertensive retinopathy."@en .

ht:Dihydropyridine a owl:Class ;
    rdfs:label "Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker that acts predominantly on vascular smooth muscle to cause peripheral vasodilation; preferred for the treatment of hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension produced by a medication or recreational substance, including NSAIDs, sympathomimetic decongestants, stimulants, corticosteroids, oral contraceptives, cyclosporine, licorice, cocaine, and methamphetamine."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "A blood pressure reading with systolic pressure of 120 to 129 mmHg and diastolic pressure below 80 mmHg; previously termed prehypertension."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A lipid deposit in the retina resulting from leakage through damaged retinal vessels in hypertensive retinopathy."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Out-of-office blood pressure self-measurement performed by the patient under standard conditions, found to be as accurate as 24-hour ambulatory monitoring for detecting white coat and masked hypertension."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "Severe blood pressure elevation accompanied by acute hypertension-mediated target-organ damage, requiring immediate, controlled, usually intravenous reduction of blood pressure."@en .

ht:HypertensiveNephropathy a owl:Class ;
    rdfs:label "Hypertensive Nephropathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Kidney Disease"@en,
        "Nephrosclerosis"@en ;
    skos:definition "Kidney damage attributable to chronic hypertension, in which the small blood vessels, glomeruli, tubules, and interstitial tissue harden and thicken (nephrosclerosis), reducing blood and oxygen supply and progressively lowering filtering capacity, a serious risk factor for end-stage kidney disease."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "Severe blood pressure elevation without evidence of acute target-organ damage, typically managed by gradual oral blood pressure reduction over 24 to 48 hours."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A blood pressure phenotype in which office/clinic blood pressure is normal while out-of-office blood pressure is consistently elevated, carrying cardiovascular risk similar to sustained hypertension."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "Spironolactone Class"@en ;
    skos:definition "An antihypertensive drug class, exemplified by spironolactone, that is frequently added for resistant hypertension and for primary aldosteronism."@en .

ht:NonDihydropyridine a owl:Class ;
    rdfs:label "Non Dihydropyridine"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A subtype of calcium channel blocker, exemplified by verapamil and diltiazem, that primarily affects cardiac contractility and atrioventricular conduction, making it better suited to arrhythmia management."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 120 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure below 120 mmHg and diastolic pressure below 80 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep-related breathing disorder that is one of the most common causes of secondary hypertension and resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement taken in a clinical setting, subject to the white coat effect and requiring repeated readings on separate occasions for diagnosis."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "An automated blood pressure measurement technique that calculates systolic, diastolic, and mean arterial pressures from oscillations in cuff pressure, requiring less operator skill than auscultation."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding, indicating malignant hypertensive retinopathy."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable cause, arising from an interaction of genetic predisposition and environmental factors such as dietary sodium intake; accounts for approximately 85-95% of cases."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Disease of the renal arterial blood supply that produces hypertension through narrowing of the renal artery."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Bleeding into the retinal tissue, including flame-shaped and blot hemorrhages, resulting from breakdown of the blood-retinal barrier under sustained hypertension."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that is secondary to a specific, identifiable, and often treatable underlying cause; accounts for roughly 5-15% of adult cases but a majority of cases in children."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure of 130 to 139 mmHg or diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with systolic pressure of 140 mmHg or greater or diastolic pressure of 90 mmHg or greater."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:definition "A first-line antihypertensive drug class that blocks sodium reabsorption at the sodium-chloride cotransporter in the distal convoluted tubule, promoting natriuresis and diuresis and causing modest vasodilation; includes thiazide-like agents such as chlorthalidone and indapamide."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "White Coat Effect"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A blood pressure phenotype in which office/clinic blood pressure is consistently elevated while out-of-office blood pressure is normal."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    owl:inverseOf ht:isRetinalFindingOf ;
    skos:definition "Relates hypertensive retinopathy to a specific retinal finding observed on examination."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:SecondaryCause ;
    owl:inverseOf ht:isSecondaryCauseOf ;
    skos:definition "Relates an instance of secondary hypertension to the identifiable underlying condition, medication, or substance responsible for the elevated blood pressure."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    owl:inverseOf ht:isTargetOrganDamageOf ;
    skos:definition "Relates hypertension to a form of structural or functional organ injury it has caused."@en .

ht:isAntihypertensiveOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive of"@en ;
    rdfs:domain ht:Antihypertensive ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a class of antihypertensive medication to the hypertension it is used to treat."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    skos:definition "Relates a blood pressure category band to a reading classified under it."@en .

ht:isMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is measurement method of"@en ;
    rdfs:domain ht:MeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    skos:definition "Relates a measurement method to a blood pressure reading obtained using it."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    skos:definition "Relates a retinal finding to the instance of hypertensive retinopathy in which it was observed."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a risk factor to the hypertension whose likelihood it increases."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates an identifiable underlying condition to the secondary hypertension it causes."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a form of organ injury to the hypertension that caused it."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "A constellation of structural and functional changes in the left ventricle, left atrium, and coronary arteries resulting from chronic blood pressure elevation."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural vascular anomaly, such as coarctation of the aorta, typically affecting younger patients."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits calcium entry through L-type voltage-gated calcium channels in cardiac and vascular smooth muscle, lowering blood pressure by reducing peripheral vascular resistance or cardiac contractility depending on subtype."@en .

ht:CerebrovascularDamage a owl:Class ;
    rdfs:label "Cerebrovascular Damage"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Injury to the brain and its vasculature resulting from hypertension, including stroke and hypertensive encephalopathy."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation of blood pressure, conventionally a systolic pressure of 180 mmHg or more or a diastolic pressure of 120 mmHg or more, classified into urgency or emergency according to the presence or absence of acute target-organ damage."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    owl:equivalentClass [ owl:intersectionOf ( ht:TargetOrganDamage [ a owl:Restriction ;
                        owl:onProperty ht:hasRetinalFinding ;
                        owl:someValuesFrom ht:RetinalFinding ] ) ] ;
    skos:definition "Damage to the retina and retinal circulation caused by sustained or abrupt elevation of blood pressure, directly visible on ophthalmoscopy."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from kidney structure, parenchyma, or blood supply; the most common category of secondary cause overall."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Disease of the kidney tissue itself, encompassing diabetic nephropathy, glomerulonephritis, polycystic kidney disease, and interstitial disorders, that causes secondary hypertension."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be changed, such as age, family history, race, or genetic predisposition."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A factor associated with increased likelihood of developing hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure, in mmHg, measured between heartbeats (relaxation)."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure, in mmHg, measured during one heartbeat (contraction)."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "Only the 2017 ACC/AHA four-category scheme is modelled as classes. Competing guideline thresholds (ESC/ESH grade 1 at 140/90 mmHg; ESH high-normal 130-139/85-89 mmHg; JNC 7 prehypertension 120-139/80-89 mmHg with hypertension starting at 140/90 mmHg; ISH normal <130/85, high-normal 130-139/85-89, grade1 140-159/90-99) are noted here rather than modelled as separate class trees."@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "A classification band assigned to a blood pressure reading under the 2017 ACC/AHA scheme for adults aged 20 years and older."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a hormonal disturbance, including primary aldosteronism, pheochromocytoma, Cushing syndrome, hyperthyroidism, and hypothyroidism."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be changed through behavior or treatment, such as salt intake, obesity, physical inactivity, smoking, or alcohol use."@en .

ht:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    skos:definition "A technique or setting used to obtain a blood pressure reading."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:definition "A class of medication used to lower blood pressure in the treatment of hypertension."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific ophthalmoscopically observable sign of hypertensive damage to the retinal vasculature."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable underlying condition, medication, or substance responsible for secondary hypertension."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to the heart, retina, kidney, or brain caused by chronically or acutely elevated blood pressure."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic blood pressure values, expressed in millimetres of mercury."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "The diagnostic systolic threshold is contested across guidelines: the 2017 ACC/AHA guideline sets it at 130 mmHg, while JNC 7, the WHO, the 2018/2023 ESC/ESH guidelines and the 2020 ISH guideline retain 140 mmHg. Both values are modelled on the single functional property hasDiagnosticSystolicThreshold rather than as separate per-guideline classes."@en ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic medical condition characterized by sustained elevation of arterial blood pressure, diagnosed by repeated measurement."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:Antihypertensive ht:SecondaryCause ht:TargetOrganDamage ht:RiskFactor ht:MeasurementMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveNephropathy ht:CerebrovascularDamage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:Dihydropyridine ht:NonDihydropyridine ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:CalciumChannelBlocker ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:BetaBlocker ht:MineralocorticoidReceptorAntagonist ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ht:OfficeBloodPressureMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

