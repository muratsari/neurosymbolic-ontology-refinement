@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/hypertension> a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    rdfs:comment "An ontology of hypertension classification, etiology, measurement, treatment, risk factors and target-organ damage, modelled from clinical-guideline corpus text (ACC/AHA 2017 scheme adopted as the single blood-pressure category scheme; competing ESC/ESH, JNC7/8, WHO and ISH thresholds noted in comments)."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:definition "A congenital narrowing of the aorta that produces hypertension, typically presenting in younger patients."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Hypertension characterised by an elevated systolic pressure (traditionally above 140 mmHg, or 130 mmHg under the 2017 ACC/AHA guideline) together with a normal or low diastolic pressure (below 90 mmHg), producing a widened pulse pressure; the predominant form of hypertension in older adults, chiefly caused by age-related arterial stiffening."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "LVH"@en ;
    skos:definition "Thickening of the left ventricular wall occurring as a compensatory response to increased afterload in chronic hypertension; the hallmark structural manifestation of hypertensive cardiac target-organ damage."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of the renal artery that produces hypertension through reduced renal perfusion and activation of the renin-angiotensin-aldosterone system."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Blood pressure that remains uncontrolled to goal despite adherence to three suitably dosed antihypertensive medications of different classes, one of which is a diuretic (or control that requires four or more agents), after exclusion of the white-coat effect and confirmation of adherence."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Competing values documented in the corpus: 130 (ACC/AHA 2017) vs 140 (ESC/ESH 2018/2023, JNC7, WHO, ISH 2020)."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure value, in mmHg, at or above which a guideline diagnoses hypertension."@en .

ht:isAntihypertensiveOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive of"@en ;
    rdfs:domain ht:AntihypertensiveDrug ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasAntihypertensive ;
    skos:definition "Relates an antihypertensive drug class to the hypertension it is used to treat."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasBloodPressureCategory ;
    skos:definition "Relates a blood pressure category to a reading classified under it."@en .

ht:isMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is measurement method of"@en ;
    rdfs:domain ht:BloodPressureMeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasMeasurementMethod ;
    skos:definition "Relates a measurement method to a blood pressure reading obtained using it."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    owl:inverseOf ht:hasRetinalFinding ;
    skos:definition "Relates a retinal finding to the hypertensive retinopathy in which it is observed."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasRiskFactor ;
    skos:definition "Relates a risk factor to the hypertension it contributes to."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:SecondaryHypertension ;
    owl:inverseOf ht:hasSecondaryCause ;
    skos:definition "Relates a secondary cause to the secondary hypertension it produces."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasTargetOrganDamage ;
    skos:definition "Relates an instance of organ damage to the hypertension that caused it."@en .

owl:AllDisjointClasses_1 a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

owl:AllDisjointClasses_10 a owl:AllDisjointClasses ;
    owl:members ( ht:DihydropyridineCalciumChannelBlocker ht:NonDihydropyridineCalciumChannelBlocker ) .

owl:AllDisjointClasses_11 a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:CalciumChannelBlocker ht:BetaBlocker ) .

owl:AllDisjointClasses_12 a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

owl:AllDisjointClasses_13 a owl:AllDisjointClasses ;
    owl:members ( ht:IschemicStroke ht:HemorrhagicStroke ) .

owl:AllDisjointClasses_14 a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveHeartDisease ht:HypertensiveRetinopathy ht:HypertensiveKidneyDisease ht:HypertensiveEncephalopathy ht:Stroke ht:MyocardialInfarction ht:HeartFailure ht:PeripheralArterialDisease ht:AtrialFibrillation ht:AorticAneurysm ) .

owl:AllDisjointClasses_15 a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

owl:AllDisjointClasses_16 a owl:AllDisjointClasses ;
    owl:members ( ht:ExcessSaltIntake ht:Obesity ht:PhysicalInactivity ht:TobaccoUse ht:ExcessAlcoholConsumption ) .

owl:AllDisjointClasses_17 a owl:AllDisjointClasses ;
    owl:members ( ht:AdvancedAge ht:Sex ht:Race ht:FamilyHistoryOfHypertension ht:GeneticPredisposition ) .

owl:AllDisjointClasses_18 a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:AntihypertensiveDrug ht:SecondaryCause ht:TargetOrganDamage ht:RiskFactor ht:BloodPressureMeasurementMethod ht:RetinalFinding ) .

owl:AllDisjointClasses_2 a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeBloodPressureMeasurement ht:HomeBloodPressureMonitoring ht:AmbulatoryBloodPressureMonitoring ) .

owl:AllDisjointClasses_3 a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

owl:AllDisjointClasses_4 a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

owl:AllDisjointClasses_5 a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

owl:AllDisjointClasses_6 a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

owl:AllDisjointClasses_7 a owl:AllDisjointClasses ;
    owl:members ( ht:RenalParenchymalDisease ht:RenovascularDisease ) .

owl:AllDisjointClasses_8 a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryAldosteronism ht:Pheochromocytoma ht:CushingSyndrome ht:Hyperthyroidism ht:Hypothyroidism ht:PrimaryHyperparathyroidism ht:CongenitalAdrenalHyperplasia ) .

owl:AllDisjointClasses_9 a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

ht:AdvancedAge a owl:Class ;
    rdfs:label "Advanced Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Age above 60 years, a non-modifiable risk factor; prevalence of hypertension rises to approximately 60% of individuals above age 60."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure measurement taken at regular intervals over a full 24-hour sleep-wake cycle, regarded as the reference standard for distinguishing white coat and masked hypertension."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:AntihypertensiveDrug ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits angiotensin-converting enzyme, reducing angiotensin II formation and increasing bradykinin levels, producing vasodilation; preferred in patients with heart failure, chronic kidney disease or diabetes, and contraindicated in pregnancy."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveDrug ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks binding of angiotensin II to the AT1 receptor rather than reducing its production; efficacy similar to ACE inhibitors with fewer adverse effects such as cough and angioedema, and generally not combined with an ACE inhibitor."@en .

ht:AorticAneurysm a owl:Class ;
    rdfs:label "Aortic Aneurysm"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Abnormal dilation of the aorta, a recognised complication of sustained hypertension."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalised or focal narrowing of the retinal arterioles, the earliest sign of hypertensive retinopathy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nipping"@en ;
    skos:definition "Apparent compression of a retinal vein where it is crossed by a sclerotic arteriole."@en .

ht:AtrialFibrillation a owl:Class ;
    rdfs:label "Atrial Fibrillation"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "An irregular heart rhythm arising as a complication of sustained hypertension and hypertensive heart disease."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "Blood pressure measurement using a cuff, sphygmomanometer and stethoscope, in which the systolic pressure is identified by the onset of Korotkoff sounds and the diastolic pressure by their disappearance."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveDrug ;
    skos:definition "An antihypertensive drug class that inhibits catecholamine binding to beta-adrenergic receptors, reducing heart rate, myocardial contractility and renin release; no longer recommended as first-line treatment for uncomplicated hypertension but retained for patients with a compelling cardiac indication."@en .

ht:CongenitalAdrenalHyperplasia a owl:Class ;
    rdfs:label "Congenital Adrenal Hyperplasia"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "An inherited adrenal steroidogenesis disorder recognised as a less common endocrine cause of secondary hypertension."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A white, fluffy retinal lesion representing localised retinal nerve fibre layer ischemia in hypertensive retinopathy."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Hypertension caused by excess glucocorticoid secretion or exposure."@en .

ht:DihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A calcium channel blocker subtype acting predominantly on vascular smooth muscle to cause peripheral vasodilation, preferred for the treatment of hypertension."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "Drug-Induced Hypertension"@en ;
    skos:definition "Hypertension precipitated by a medication or substance, including NSAIDs, sympathomimetic decongestants, stimulants, antidepressants, corticosteroids, mineralocorticoid-like substances such as licorice, oral contraceptives, cyclosporine, cocaine and methamphetamine; identification and discontinuation of the offending agent may resolve the hypertension."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "A blood pressure reading with a systolic pressure of 120 to 129 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:ExcessAlcoholConsumption a owl:Class ;
    rdfs:label "Excess Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Consumption of alcohol above recommended levels, a modifiable risk factor associated with higher blood pressure."@en .

ht:ExcessSaltIntake a owl:Class ;
    rdfs:label "Excess Salt Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Elevated dietary sodium intake, a central modifiable risk factor; approximately 50-60% of hypertensive patients are salt sensitive."@en .

ht:FamilyHistoryOfHypertension a owl:Class ;
    rdfs:label "Family History Of Hypertension"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A family history of hypertension, a non-modifiable risk factor reflecting heritable predisposition."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Inherited genetic variation, including more than 2,000 common variants with small individual effects, contributing to individual hypertension risk and salt sensitivity."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "A deposit of lipid leaked from damaged retinal vessels, seen in more advanced hypertensive retinopathy."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Inability of the heart to pump sufficient blood, arising as an end-stage consequence of hypertensive heart disease, with or without reduced ejection fraction."@en .

ht:HemorrhagicStroke a owl:Class ;
    rdfs:label "Hemorrhagic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:altLabel "Intracerebral Hemorrhage"@en ;
    skos:definition "Stroke resulting from bleeding into the brain tissue."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Out-of-office blood pressure measurement performed by the patient at home under standardised conditions, used to confirm diagnosis and detect white coat or masked hypertension."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis accompanied by acute hypertension-mediated target-organ damage, requiring immediate but controlled blood pressure reduction, typically with intravenous agents in a monitored setting."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute brain swelling and dysfunction caused by severely elevated blood pressure, presenting with headache, confusion or visual disturbance; a defining finding of hypertensive emergency."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Nephropathy"@en ;
    skos:definition "Damage to kidney tissue, including small blood vessels, glomeruli, tubules and interstitium, caused by chronic high blood pressure, producing nephrosclerosis, reduced blood and oxygen supply, and progressive loss of renal function that may culminate in kidney failure."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis without evidence of acute target-organ damage, typically managed with gradual blood pressure reduction over 24 to 48 hours using oral medication."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excess thyroid hormone secretion recognised as a cause of secondary hypertension, including isolated systolic hypertension."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Deficient thyroid hormone secretion recognised as a cause of secondary hypertension, including isolated systolic hypertension."@en .

ht:IschemicStroke a owl:Class ;
    rdfs:label "Ischemic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:definition "Stroke resulting from obstruction of blood supply to the brain."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "MH"@en ;
    skos:definition "A blood pressure phenotype in which office/clinic blood pressure is normal while out-of-office (home or ambulatory) blood pressure is consistently elevated."@en .

ht:MyocardialInfarction a owl:Class ;
    rdfs:label "Myocardial Infarction"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Death of heart muscle tissue due to interrupted blood supply, a cardiovascular complication of sustained or acute hypertension."@en .

ht:NonDihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Non Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:definition "A calcium channel blocker subtype, such as verapamil or diltiazem, acting predominantly on cardiac contractility and atrioventricular conduction, better suited to the management of arrhythmias."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 120 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ht:hasDiastolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxExclusive 80 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure less than 120 mmHg and a diastolic pressure less than 80 mmHg."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excess Body Weight"@en ;
    skos:definition "Excess body weight, a modifiable risk factor for hypertension; weight reduction alone can lower systolic blood pressure by 5 to 20 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "Repeated upper airway obstruction during sleep, one of the most common causes of secondary hypertension and a frequent secondary cause found in resistant hypertension."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement performed in a clinical setting such as a doctor's office, used as the conventional entry point for diagnosis."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:BloodPressureMeasurementMethod ;
    skos:definition "Automated blood pressure measurement that derives systolic, diastolic and mean arterial pressure from oscillations in cuff pressure during inflation and deflation, without requiring auscultation."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic disc, the most severe retinal finding, indicating malignant hypertensive retinopathy."@en .

ht:PeripheralArterialDisease a owl:Class ;
    rdfs:label "Peripheral Arterial Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Atherosclerotic narrowing of peripheral arteries, a recognised complication of sustained hypertension."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A tumour causing excessive secretion of norepinephrine and epinephrine, promoting vasoconstriction and raising blood pressure."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Lack of regular exercise, a modifiable risk factor for hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn's Syndrome"@en ;
    skos:definition "Autonomous overproduction of aldosterone by the adrenal glands, due to an aldosterone-producing adenoma or bilateral adrenal hyperplasia, causing sodium and water retention, potassium excretion and hypertension; the most common endocrine cause of secondary hypertension and present in up to one in five patients with resistant hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excess parathyroid hormone secretion recognised as a contributor to secondary hypertension."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension with no single identifiable cause, arising from a complex interaction of genetic predisposition (e.g. salt sensitivity) and environmental/lifestyle factors; accounts for roughly 85-95% of hypertension cases."@en .

ht:Race a owl:Class ;
    rdfs:label "Race"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Race or ethnicity, a non-modifiable risk factor that also influences first-line treatment selection, as guidelines recommend different initial drug classes for Black and non-Black populations."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Intrinsic kidney tissue disease causing secondary hypertension, including diabetic nephropathy, glomerulonephritis, interstitial disorders, polycystic kidney disease and chronic kidney disease."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Flame Hemorrhage"@en ;
    skos:definition "Bleeding into the retinal tissue resulting from breakdown of the blood-retinal barrier in advanced hypertensive retinopathy."@en .

ht:Sex a owl:Class ;
    rdfs:label "Sex"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Biological sex, a recognised non-modifiable risk factor influencing hypertension risk."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 80 ] [ xsd:maxInclusive 89 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 130 to 139 mmHg or a diastolic pressure of 80 to 89 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:BloodPressureReading [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ht:hasSystolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] [ a owl:Restriction ;
                                    owl:onProperty ht:hasDiastolicValue ;
                                    owl:someValuesFrom [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] ) ] ;
    skos:definition "A blood pressure reading with a systolic pressure of 140 mmHg or greater or a diastolic pressure of 90 mmHg or greater."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:AntihypertensiveDrug ;
    skos:altLabel "Thiazide-Type Diuretic"@en ;
    skos:definition "A first-line antihypertensive drug class that blocks sodium reabsorption at the sodium-chloride cotransporter in the distal convoluted tubule, promoting natriuresis and diuresis and reducing intravascular volume, with modest additional vasodilatory effect."@en .

ht:TobaccoUse a owl:Class ;
    rdfs:label "Tobacco Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Smoking"@en ;
    skos:definition "Use of tobacco products, a modifiable risk factor for hypertension."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "WHT"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A blood pressure phenotype in which office/clinic blood pressure is consistently elevated while out-of-office (home or ambulatory) blood pressure is normal."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:AntihypertensiveDrug ;
    skos:definition "Relates hypertension to an antihypertensive drug class used or indicated for its treatment."@en .

ht:hasBloodPressureCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    skos:definition "Relates a blood pressure reading to the single ACC/AHA-2017 category it falls into."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureMeasurementMethod ;
    skos:definition "Relates a blood pressure reading to the method or setting by which it was obtained."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    skos:definition "Relates hypertensive retinopathy to a specific retinal finding observed on examination."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    skos:definition "Relates hypertension to a modifiable or non-modifiable risk factor contributing to its development."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the left ventricle, left atrium and coronary arteries resulting from chronic blood pressure elevation, including compensatory hypertrophy, myocyte apoptosis, interstitial fibrosis, coronary microvascular dysfunction and progression to heart failure."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Secondary hypertension arising from disease of the renal blood vessels."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a structural vascular abnormality, typically affecting younger patients."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    skos:definition "Relates an instance of secondary hypertension to its identifiable underlying cause."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    skos:definition "Relates hypertension (or a hypertensive crisis) to an instance of organ damage it has caused."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveDrug ;
    skos:altLabel "CCB"@en ;
    skos:definition "A first-line antihypertensive drug class that inhibits calcium entry through L-type voltage-gated calcium channels in cardiac and vascular smooth muscle."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation of blood pressure, conventionally a systolic pressure of 180 mmHg or higher and/or a diastolic pressure of 120 mmHg or higher, classified into urgency and emergency according to the presence or absence of acute target-organ damage rather than the absolute pressure value."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to the retina and retinal circulation caused by sustained or abrupt blood pressure elevation, visible on dilated fundoscopic examination and correlated with the severity and chronicity of hypertension."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from kidney disease, the most common category of secondary hypertension."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension that has a specific, identifiable and often treatable underlying cause; accounts for roughly 5-15% of adult hypertension cases, with markedly higher prevalence in children and lower prevalence in older adults."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute cerebrovascular injury, ischemic or hemorrhagic, caused by damage to cerebral vessels from sustained or acute hypertension."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A modifiable or non-modifiable factor associated with increased risk of developing hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure, in mmHg, occurring between heartbeats (ventricular relaxation)."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure, in mmHg, occurring during one heartbeat (ventricular contraction)."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:comment "This ontology models a single ACC/AHA-2017 band scheme. Competing guidelines place different boundaries over the same numeric ranges: ESC/ESH (2018/2023) and WHO/JNC7/ISH diagnose hypertension only at 140/90 mmHg and above, calling 130-139/85-89 mmHg 'high-normal' rather than stage 1 hypertension; JNC7 called 120-139/80-89 mmHg 'prehypertension'; the 2024 ESC guideline groups 120-139/70-89 mmHg as 'Elevated Blood Pressure'. Each BloodPressureCategory subclass here is realized as a subclass of ht:BloodPressureReading via its differentia, and is therefore excluded from the top-level kind-disjointness axiom below."@en ;
    skos:definition "An ACC/AHA (2017) classification band assigned to a blood pressure reading on the basis of its systolic and/or diastolic value."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that can be changed through lifestyle intervention."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A risk factor for hypertension that cannot be changed by the individual."@en .

ht:AntihypertensiveDrug a owl:Class ;
    rdfs:label "Antihypertensive Drug"@en ;
    skos:definition "A class of medication used to lower blood pressure in the treatment of hypertension."@en .

ht:BloodPressureMeasurementMethod a owl:Class ;
    rdfs:label "Blood Pressure Measurement Method"@en ;
    skos:definition "A technique or setting used to obtain a blood pressure reading."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from a hormone-secreting disorder."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A specific ophthalmoscopic sign of hypertensive retinal vascular damage."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable, specific underlying condition, substance or medication responsible for elevated blood pressure in secondary hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic blood pressure values, expressed in millimetres of mercury."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to the heart, brain, kidneys, retina or vasculature caused by chronic or acutely elevated blood pressure."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Diagnostic systolic threshold is contested: the 2017 ACC/AHA guideline sets it at 130 mmHg, whereas ESC/ESH, JNC7, WHO, JNC8 and ISH guidelines use 140 mmHg. Modelled with a single functional property, hasDiagnosticSystolicThreshold, rather than per-guideline subclasses."@en ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic medical condition in which arterial blood pressure is persistently elevated above a guideline-specific diagnostic threshold, a major risk factor for stroke, myocardial infarction, heart failure and renal disease, and frequently asymptomatic ('silent')."@en .

