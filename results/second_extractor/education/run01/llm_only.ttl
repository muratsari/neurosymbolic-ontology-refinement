            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:LowStakes ] ) ] .

ea:NonStandardizedAssessment a owl:Class ;
    rdfs:label "Non-standardized assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardization ;
                        owl:someValuesFrom ea:NonStandardized ] ) ] .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective item"@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    skos:altLabel "Subjective question"@en .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative purpose"@en ;
    rdfs:subClassOf ea:Purpose ;
    skos:altLabel "Assessment of learning purpose"@en,
        "Evaluative purpose"@en .

ea:hasDeliveryMode a owl:ObjectProperty ;
    rdfs:label "has delivery mode"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:DeliveryMode ;
    owl:inverseOf ea:isDeliveryModeOf .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework ;
    owl:inverseOf ea:isReferencingFrameworkOf .

ea:isItemOptionOf a owl:ObjectProperty ;
    rdfs:label "is item option of"@en ;
    rdfs:domain ea:ItemOption ;
    rdfs:range ea:MultipleChoiceItem .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment item"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    skos:altLabel "Question"@en,
        "Test item"@en .

ea:AssessmentSource a owl:Class ;
    rdfs:label "Assessment source"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:InternalSource ea:ExternalSource ) .

ea:CutScore a owl:Class ;
    rdfs:label "Cut score"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    skos:altLabel "Cut-off score"@en,
        "Passing score"@en .

ea:Examiner a owl:Class ;
    rdfs:label "Examiner"@en ;
    rdfs:subClassOf ea:EducationalContextEntity ;
    skos:altLabel "Evaluator"@en,
        "Grader"@en,
        "Rater"@en,
        "Scorer"@en .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:subClassOf ea:EducationalContextEntity .

ea:Formality a owl:Class ;
    rdfs:label "Formality"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:Formal ea:Informal ) .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-stakes assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:LowStakesAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakes ;
                        owl:someValuesFrom ea:HighStakes ] ) ] .

ea:ItemOption a owl:Class ;
    rdfs:label "Item option"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    skos:altLabel "Alternative answer"@en .

ea:LearningOutcomeTaxonomy a owl:Class ;
    rdfs:label "Learning outcome taxonomy"@en ;
    rdfs:subClassOf ea:EducationalContextEntity .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement error"@en ;
    rdfs:subClassOf ea:MeasurementScore ;
    skos:altLabel "Error score"@en .

ea:MeasurementFactor a owl:Class ;
    rdfs:label "Measurement factor"@en ;
    rdfs:subClassOf ea:PsychometricEntity .

ea:Objectivity a owl:Class ;
    rdfs:label "Objectivity"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:Objective ea:Subjective ) .

ea:PerformanceFormat a owl:Class ;
    rdfs:label "Performance format"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:ProductFormat ea:DemonstrationFormat ) .

ea:PsychometricEntity a owl:Class ;
    rdfs:label "Psychometric entity"@en ;
    rdfs:subClassOf ea:AssessmentDomainEntity .

ea:ScoringMethod a owl:Class ;
    rdfs:label "Scoring method"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    skos:altLabel "Grading method"@en .

ea:Stakes a owl:Class ;
    rdfs:label "Stakes"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:Standardization a owl:Class ;
    rdfs:label "Standardization"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:Standardized ea:NonStandardized ) .

ea:TemporalOrientation a owl:Class ;
    rdfs:label "Temporal orientation"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:BackwardLookingOrientation ea:ForwardLookingOrientation ) .

ea:AssessmentDomainEntity a owl:Class ;
    rdfs:label "Assessment domain entity"@en ;
    rdfs:subClassOf owl:Thing .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-referenced assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Standards-based assessment"@en,
        "Standards-referenced assessment"@en .

ea:EducationalPhenomenon a owl:Class ;
    rdfs:label "Educational phenomenon"@en ;
    rdfs:subClassOf ea:EducationalContextEntity .

ea:EvaluationStandard a owl:Class ;
    rdfs:label "Evaluation standard"@en ;
    rdfs:subClassOf ea:EducationalContextEntity .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning outcome"@en ;
    rdfs:subClassOf ea:EducationalContextEntity ;
    skos:altLabel "Learning standard"@en,
        "Student learning outcome"@en .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective item"@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:SubjectiveItem ;
    skos:altLabel "Objective question"@en,
        "Objective response"@en .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing framework"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:DeliveryMode a owl:Class ;
    rdfs:label "Delivery mode"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:WrittenDeliveryMode ea:OralDeliveryMode ea:PracticalDeliveryMode ea:ComputerDeliveryMode ) .

ea:MeasurementScore a owl:Class ;
    rdfs:label "Measurement score"@en ;
    rdfs:subClassOf ea:PsychometricEntity ;
    skos:altLabel "Test score"@en .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:subClassOf ea:PsychometricEntity ;
    skos:altLabel "Measurement precision"@en .

ea:StandardCategory a owl:Class ;
    rdfs:label "Standard category"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:UtilityCategory ea:FeasibilityCategory ea:ProprietyCategory ea:AccuracyCategory ) .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student portfolio"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    skos:altLabel "Portfolio"@en .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Purpose ;
    owl:inverseOf ea:isPurposeOf .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-referenced assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Normative assessment"@en .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:subClassOf ea:PsychometricEntity ;
    skos:altLabel "Assessment validity"@en,
        "Scientific validity"@en,
        "Test validity"@en .

ea:EducationalContextEntity a owl:Class ;
    rdfs:label "Educational context entity"@en ;
    rdfs:subClassOf ea:AssessmentDomainEntity .

ea:GranularityLevel a owl:Class ;
    rdfs:label "Granularity level"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Purpose a owl:Class ;
    rdfs:label "Purpose"@en ;
    rdfs:subClassOf ea:AssessmentDimension ;
    skos:altLabel "Assessment purpose"@en .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-choice item"@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Multiple-choice question"@en .

ea:AssessmentComponent a owl:Class ;
    rdfs:label "Assessment component"@en ;
    rdfs:subClassOf ea:AssessmentDomainEntity .

ea:AssessmentDimension a owl:Class ;
    rdfs:label "Assessment dimension"@en ;
    rdfs:subClassOf ea:AssessmentDomainEntity .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    skos:altLabel "Checklist"@en,
        "Scoring guide"@en .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or other topics."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf ea:AssessmentDomainEntity ;
    skos:altLabel "Educational assessment"@en,
        "Educational evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:CriterionReferencedAssessment ea:NormReferencedAssessment ea:IpsativeAssessment ) .

