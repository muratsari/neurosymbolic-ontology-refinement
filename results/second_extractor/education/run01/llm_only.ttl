@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology formalizing concepts, classifications, psychometrics, and standards of educational assessment as stated in the corpus."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:BackwardLookingOrientation ] ) ] .

ea:AnecdotalFeedback a owl:Class ;
    rdfs:label "Anecdotal feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:ForwardLookingOrientation ] ) ] .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic assessment"@en ;
    rdfs:subClassOf ea:Assessment .

ea:BloomsTaxonomy a owl:Class ;
    rdfs:label "Bloom's taxonomy"@en ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:CapstonePortfolio a owl:Class ;
    rdfs:label "Capstone portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio .

ea:Cheating a owl:Class ;
    rdfs:label "Cheating"@en ;
    rdfs:subClassOf ea:EducationalPhenomenon .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College admissions test"@en ;
    rdfs:subClassOf ea:Test .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common assessment"@en ;
    rdfs:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive examination"@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:NormReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ea:HighStakesAssessment ) ] ;
    skos:altLabel "Competitive exam"@en .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ComputerAdaptiveTest a owl:Class ;
    rdfs:label "Computer-adaptive test"@en ;
    rdfs:subClassOf ea:Test .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent validity"@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential validity"@en ;
    rdfs:subClassOf ea:Validity .

ea:ConsistencyFactor a owl:Class ;
    rdfs:label "Consistency factor"@en ;
    rdfs:subClassOf ea:MeasurementFactor ;
    owl:disjointWith ea:InconsistencyFactor .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content validity"@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical validity"@en,
        "Subject-matter validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous assessment"@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent validity"@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-referenced test"@en ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:CriterionReferencedAssessment ) ] ;
    skos:altLabel "CRT"@en .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental rubric"@en ;
    rdfs:comment "The corpus defines developmental rubrics as a subset of analytical rubrics."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic assessment"@en ;
    rdfs:comment "Tension noted: Passage 2 coordinates diagnostic assessment alongside placement, formative, and summative assessment. Another passage asserts that a common form of formative assessment is diagnostic assessment. Both classifications are asserted."@en ;
    rdfs:subClassOf ea:Assessment,
        ea:FormativeAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "Diagnostic testing"@en .

ea:DikwPyramidTaxonomy a owl:Class ;
    rdfs:label "DIKW pyramid taxonomy"@en ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant validity"@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent validity"@en .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Essay question"@en .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended-response item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Extended-response question"@en .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face validity"@en ;
    rdfs:subClassOf ea:Validity .

ea:FinalExam a owl:Class ;
    rdfs:label "Final exam"@en ;
    rdfs:subClassOf ea:UnitTest ;
    skos:altLabel "Final examination"@en,
        "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:InformalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:Formal ] ) ] .

ea:FormativeFeedback a owl:Class ;
    rdfs:label "Formative feedback"@en ;
    rdfs:subClassOf ea:Feedback .

ea:GradeInflation a owl:Class ;
    rdfs:label "Grade inflation"@en ;
    rdfs:subClassOf ea:EducationalPhenomenon .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-stakes test"@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:HighStakesAssessment ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic rubric"@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringMethod ;
                        owl:someValuesFrom ea:HolisticScoring ] ) ] .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended learning outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Aim"@en,
        "ILO"@en .

ea:InterMethodReliability a owl:Class ;
    rdfs:label "Inter-method reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Alternate-forms reliability"@en,
        "Form equivalence"@en,
        "Parallel-forms reliability"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim assessment"@en ;
    rdfs:comment "Tension noted: Some educators classify interim tests as formative (used diagnostically), while others consider them summative. The corpus highlights this ongoing debate."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark assessment"@en,
        "Benchmark test"@en,
        "Interim test"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:ExternalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentSource ;
                        owl:someValuesFrom ea:InternalSource ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International comparison test"@en ;
    rdfs:subClassOf ea:Test .

ea:IntraRaterReliability a owl:Class ;
    rdfs:label "Intra-rater reliability"@en ;
    rdfs:subClassOf ea:InterRaterReliability .

ea:LowStakesTest a owl:Class ;
    rdfs:label "Low-stakes test"@en ;
    rdfs:subClassOf ea:LowStakesAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:LowStakesAssessment ) ] .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching item"@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    skos:altLabel "Matching question"@en .

ea:MathematicalProblemItem a owl:Class ;
    rdfs:label "Mathematical problem item"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Calculation question"@en .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured learning outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Objective"@en .

ea:MidtermExam a owl:Class ;
    rdfs:label "Midterm exam"@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Midterm examination"@en .

ea:ModelOfHierarchicalComplexityTaxonomy a owl:Class ;
    rdfs:label "Model of hierarchical complexity taxonomy"@en ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-response item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-standardized test"@en ;
    rdfs:subClassOf ea:NonStandardizedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NonStandardizedAssessment ) ] .

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-referenced test"@en ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ) ] ;
    skos:altLabel "NRT"@en .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective assessment"@en ;
    rdfs:comment "Tension noted: While categorized as coordinate alternatives, some critics argue there is no such thing as truly objective assessment due to inherent design, cultural, and content biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:SubjectiveAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivity ;
                        owl:someValuesFrom ea:Objective ] ) ] .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed score"@en ;
    rdfs:subClassOf ea:MeasurementScore ;
    owl:disjointWith ea:MeasurementError,
        ea:TrueScore .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:label "One-best-answer item"@en ;
    rdfs:subClassOf ea:MultipleChoiceItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:MultipleChoiceItem [ a owl:Restriction ;
                        owl:onClass ea:AnswerKey ;
                        owl:onProperty ea:hasAnswerKey ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ;
    skos:altLabel "Single best answer"@en .

ea:OralTest a owl:Class ;
    rdfs:label "Oral test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:OralDeliveryMode ] ) ] .

ea:PersonnelEvaluationStandard a owl:Class ;
    rdfs:label "Personnel evaluation standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:label "Physical portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio ;
    owl:disjointWith ea:DigitalPortfolio .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial assessment"@en,
        "Placement evaluation"@en,
        "Pre-assessment"@en,
        "TKT"@en,
        "Threshold knowledge test"@en .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:PracticalDeliveryMode ] ) ] .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive validity"@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProgramEvaluationStandard a owl:Class ;
    rdfs:label "Program evaluation standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological test"@en ;
    rdfs:subClassOf ea:Test .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:subClassOf ea:Test .

ea:RandomError a owl:Class ;
    rdfs:label "Random error"@en ;
    rdfs:subClassOf ea:MeasurementError ;
    owl:disjointWith ea:SystematicError .

ea:RecastFeedback a owl:Class ;
    rdfs:label "Recast feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "Recast"@en .

ea:ScoreFeedback a owl:Class ;
    rdfs:label "Score feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score inflation"@en ;
    rdfs:subClassOf ea:EducationalPhenomenon .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] ;
    skos:altLabel "Screening test"@en .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short-answer item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Short-answer question"@en .

ea:SplitHalfReliability a owl:Class ;
    rdfs:label "Split-half reliability"@en ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized test"@en ;
    rdfs:subClassOf ea:StandardizedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:StandardizedAssessment ) ] .

ea:StructureOfObservedLearningOutcomeTaxonomy a owl:Class ;
    rdfs:label "Structure of observed learning outcome taxonomy"@en ;
    rdfs:subClassOf ea:LearningOutcomeTaxonomy ;
    skos:altLabel "SOLO taxonomy"@en .

ea:StudentEvaluationStandard a owl:Class ;
    rdfs:label "Student evaluation standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:label "Student growth measure"@en ;
    rdfs:comment "Student growth measures are related to, but distinct from, value-added measures as they do not control for non-teacher factors."@en ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:disjointWith ea:FormativeAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of learning"@en,
        "Summative evaluation"@en .

ea:TeachingToTheTest a owl:Class ;
    rdfs:label "Teaching to the test"@en ;
    rdfs:subClassOf ea:EducationalPhenomenon .

ea:TestAnxiety a owl:Class ;
    rdfs:label "Test anxiety"@en ;
    rdfs:subClassOf ea:EducationalPhenomenon .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-retest reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-informed scoring"@en ;
    rdfs:comment "Trait-informed scoring trains raters to score according to a guide but remains holistic at heart by deciding a single final score."@en ;
    rdfs:subClassOf ea:HolisticScoring ;
    skos:altLabel "Trait-informed holistic scoring"@en .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-false item"@en ;
    rdfs:comment "Tension noted: One passage lists true/false and multiple-choice as coordinate objective item types; another passage classifies true/false as a family of multiple-choice questions requiring the test taker to choose all answers that are appropriate. Both claims are captured."@en ;
    rdfs:subClassOf ea:MultipleChoiceItem,
        ea:ObjectiveItem ;
    skos:altLabel "True-false question"@en .

ea:UnbiasedExaminer a owl:Class ;
    rdfs:label "Unbiased examiner"@en ;
    rdfs:subClassOf ea:Examiner ;
    skos:altLabel "Unbiased personnel"@en .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended learning outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-added measure"@en ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure ;
    skos:altLabel "Growth measure"@en .

ea:WordBankFillInTheBlankItem a owl:Class ;
    rdfs:label "Word bank fill-in-the-blank item"@en ;
    rdfs:subClassOf ea:FillInTheBlankItem ;
    owl:disjointWith ea:NoWordBankFillInTheBlankItem .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:WrittenDeliveryMode ] ) ] ;
    skos:altLabel "Paper test"@en,
        "eExam"@en .

ea:hasAchievementLevel a owl:ObjectProperty ;
    rdfs:label "has achievement level"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:AchievementLevel ;
    owl:inverseOf ea:isAchievementLevelOf .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isAssessmentItemOf .

ea:hasCriterionDomain a owl:ObjectProperty ;
    rdfs:label "has criterion domain"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:CriterionDomain ;
    owl:inverseOf ea:isCriterionDomainOf .

ea:hasCronbachAlpha a owl:DatatypeProperty ;
    rdfs:label "has Cronbach's alpha"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasCutScoreValue a owl:DatatypeProperty ;
    rdfs:label "has cut score value"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Distractor ;
    rdfs:subPropertyOf ea:hasItemOption ;
    owl:inverseOf ea:isDistractorOf .

ea:hasEvaluativeCriterion a owl:ObjectProperty ;
    rdfs:label "has evaluative criterion"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:EvaluativeCriterion ;
    owl:inverseOf ea:isEvaluativeCriterionOf .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback ;
    owl:inverseOf ea:isFeedbackOf .

ea:hasGranularityLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has granularity level"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel ;
    owl:inverseOf ea:isGranularityLevelOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasItemStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has item stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem ;
    owl:inverseOf ea:isItemStemOf .

ea:hasLearningActivity a owl:ObjectProperty ;
    rdfs:label "has learning activity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningActivity ;
    owl:inverseOf ea:isLearningActivityOf .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasMeasurementFactor a owl:ObjectProperty ;
    rdfs:label "has measurement factor"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementFactor ;
    owl:inverseOf ea:isMeasurementFactorOf .

ea:hasMeasurementScore a owl:ObjectProperty ;
    rdfs:label "has measurement score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementScore ;
    owl:inverseOf ea:isMeasurementScoreOf .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasPassingPercentage a owl:DatatypeProperty ;
    rdfs:label "has passing percentage"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasPercentileRank a owl:DatatypeProperty ;
    rdfs:label "has percentile rank"@en ;
    rdfs:domain ea:MeasurementScore ;
    rdfs:range xsd:decimal .

ea:hasPerformanceFormat a owl:ObjectProperty ;
    rdfs:label "has performance format"@en ;
    rdfs:domain ea:PerformanceAssessment ;
    rdfs:range ea:PerformanceFormat ;
    owl:inverseOf ea:isPerformanceFormatOf .

ea:hasPerformanceIndicator a owl:ObjectProperty ;
    rdfs:label "has performance indicator"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:PerformanceIndicator ;
    owl:inverseOf ea:isPerformanceIndicatorOf .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    owl:inverseOf ea:isReliabilityOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Assessment ;
