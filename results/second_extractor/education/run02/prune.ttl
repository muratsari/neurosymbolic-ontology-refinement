@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology formalizing educational assessment concepts, classification axes, quality dimensions, scoring instruments, and test item structures as described in the source corpus."@en .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common Assessment"@en ;
    rdfs:comment "Assessment collaboratively developed and administered consistently across classrooms, schools, or departments."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "Norm-referenced, high-stakes examination where examinees are ranked to select candidates for limited positions."@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:NormReferencedAssessment,
        ea:Test .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "Assessment requiring an expert examiner and an evaluative rubric due to implicit task formats (e.g. final year thesis)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Correlation between the test and a criterion measured at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:comment "Validity addressing the consequences and social impact of test score usage."@en ;
    rdfs:subClassOf ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "Extent to which assessment content represents all facets and specifications of the behavior/subject domain."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "Assessment evaluating progress throughout a prescribed course, often combining formative tests."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:comment "Degree to which two measures that theoretically should be related are related."@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:comment "Feedback aimed at identifying and rectifying errors, ideally specific, supportive, and timely."@en ;
    rdfs:subClassOf ea:Feedback .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-Referenced Test"@en ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytic rubrics facilitating transformative learning through developmental successions."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:comment "Degree to which measures that theoretically should not be related are confirmed to be unrelated."@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Free Response Question"@en .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended Response Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationLocus ;
                        owl:someValuesFrom ea:ExternalLocus ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "Extent to which an assessment superficially appears or looks valid to examinees or observers."@en ;
    rdfs:subClassOf ea:Validity .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:FormalType ] ) ] .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Assessment conducted concurrently with instruction to monitor learning and provide ongoing formative feedback."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en .

ea:FormativeFeedback a owl:Class ;
    rdfs:label "Formative Feedback"@en ;
    rdfs:comment "Qualitative, in-process information focusing on details of content to guide next steps."@en ;
    rdfs:subClassOf ea:Feedback .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:comment "Assessment asking those assessed to consider themselves in hypothetical future situations."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ForwardLookingPurpose ] ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:InformalType ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Periodic assessment to monitor student progress toward standards; debated whether it is formative or summative in nature."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationLocus ;
                        owl:someValuesFrom ea:InternalLocus ] ) ] .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:comment "Assessment measuring present performance against the learner's own past performance."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:LowStakesType ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple Response Item"@en ;
    rdfs:comment "An objective question in which more than one answer option may be keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:NonStandardizedFormat ] ) ] .

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-Referenced Test"@en ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "Assessment characterized by questions having a single correct answer; contested by critics asserting inherent test biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:ObjectiveType ] ) ] .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed Score"@en ;
    rdfs:comment "The actual attained score X in classical test theory (X = T + E)."@en ;
    rdfs:subClassOf ea:Score .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMedium ;
                        owl:someValuesFrom ea:OralMedium ] ) ] .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel Forms Reliability"@en ;
    rdfs:comment "Equivalence of scores across different forms of a test based on the same content."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Form Equivalence"@en,
        "Inter-Method Reliability"@en .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    rdfs:comment "Assessment in which learners evaluate the work of their peers."@en ;
    rdfs:subClassOf ea:Assessment .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:label "Performance-Based Assessment"@en ;
    rdfs:comment "Requires examinees to perform a task, solve real-world problems, or produce an extended response or artifact."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Authentic Assessment"@en,
        "Performance Assessment"@en,
        "Performance Test"@en .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "Assessment conducted before instruction to place students appropriately and establish a baseline."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMedium ;
                        owl:someValuesFrom ea:PracticalMedium ] ) ] .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Extent to which a test score predicts a criterion measured at a future point in time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score Inflation"@en ;
    rdfs:comment "Increase in test scores without genuine improvements in student learning, often driven by high-stakes pressure."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "Assessment used to determine readiness or identify need for specialized services or learning disabilities."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self Assessment"@en ;
    rdfs:comment "Assessment in which learners assess their own performance or understanding."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short Answer Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:StandardizedFormat ] ) ] ;
    skos:altLabel "Standardized Assessment"@en .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "Assessment characterized by questions having multiple possible answers or multiple expressive formulations."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:SubjectiveType ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "Assessment carried out at the conclusion of an instructional unit to evaluate learning outcomes and assign grades."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en .

ea:SystematicError a owl:Class ;
    rdfs:label "Systematic Error"@en ;
    rdfs:subClassOf ea:MeasurementError ;
    owl:disjointWith ea:RandomError .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:comment "Consistency of scores across separate test administrations under identical conditions."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:TrueScore a owl:Class ;
    rdfs:label "True Score"@en ;
    rdfs:comment "The replicable feature of the concept being measured (T in X = T + E)."@en ;
    rdfs:subClassOf ea:Score .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical algorithms using test scores and demographic data to quantify a teacher's effect on student learning."@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Growth Measure"@en .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMedium ;
                        owl:someValuesFrom ea:WrittenMedium ] ) ] .

ea:hasAgreementPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has agreement percentage"@en ;
    rdfs:comment "Joint probability of agreement between two or more raters."@en ;
    rdfs:domain ea:InterRaterReliability ;
    rdfs:range xsd:decimal .

ea:hasCronbachAlpha a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Cronbach's alpha"@en ;
    rdfs:comment "Statistic calculated from pairwise correlations between items to estimate internal consistency."@en ;
    rdfs:domain ea:InternalConsistencyReliability ;
    rdfs:range xsd:decimal .

ea:hasCutscore a owl:ObjectProperty ;
    rdfs:label "has cutscore"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:Cutscore .

ea:hasCutscoreValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has cutscore value"@en ;
    rdfs:comment "Numerical cutoff value required to achieve proficiency or pass."@en ;
    rdfs:domain ea:Cutscore ;
    rdfs:range xsd:decimal .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has item count"@en ;
    rdfs:comment "The total number of items contained in a test."@en ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasItemDistractor a owl:ObjectProperty ;
    rdfs:label "has item distractor"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemDistractor .

ea:hasItemKey a owl:ObjectProperty ;
    rdfs:label "has item key"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemKey .

ea:hasItemOption a owl:ObjectProperty ;
    rdfs:label "has item option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemOption .

ea:hasItemStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has item stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasPortfolio a owl:ObjectProperty ;
    rdfs:label "has portfolio"@en ;
    rdfs:domain ea:PortfolioBasedAssessment ;
    rdfs:range ea:StudentPortfolio .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:comment "Quantitative reliability index ranging between 0.00 and 1.00."@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasReliabilityFacet a owl:ObjectProperty ;
    rdfs:label "has reliability facet"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:ReliabilityFacet .

ea:hasScore a owl:ObjectProperty ;
    rdfs:label "has score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Score .

ea:hasScoringAgentType a owl:ObjectProperty ;
    rdfs:label "has scoring agent type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringAgentType .

ea:hasScoringMethod a owl:ObjectProperty ;
    rdfs:label "has scoring method"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringMethod .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity .

ea:isObjectivityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is objectivity category of"@en ;
    rdfs:domain ea:ObjectivityCategory ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasObjectivityCategory .

ea:isPurposeOf a owl:ObjectProperty ;
    rdfs:label "is purpose of"@en ;
    rdfs:domain ea:PurposeCategory ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasPurpose .

ea:isReferencingFrameworkOf a owl:ObjectProperty ;
    rdfs:label "is referencing framework of"@en ;
    rdfs:domain ea:ReferencingFramework ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasReferencingFramework .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasRubric .

ea:isStoredInItemBank a owl:ObjectProperty ;
    rdfs:label "is stored in item bank"@en ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:ItemBank ;
    owl:inverseOf ea:storesTestItem .

ea:isTestItemOf a owl:ObjectProperty ;
    rdfs:label "is test item of"@en ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Test ;
    owl:inverseOf ea:hasTestItem .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "A rubric evaluating distinct dimensions or traits separately."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:HolisticRubric .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:ComputerBasedMedium a owl:Class ;
    rdfs:label "Computer-Based Medium"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:ComputerScoring a owl:Class ;
    rdfs:label "Computer Scoring"@en ;
    rdfs:subClassOf ea:ScoringAgentType .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:comment "Identifies learning difficulties, gaps, or current skill levels to inform targeted remediation or programs."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:EducationalProcess a owl:Class ;
    rdfs:label "Educational Process"@en ;
    rdfs:comment "A continuous or systematic process within an educational context."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:HighStakesType ] ) ] ;
    skos:altLabel "High-Stakes Test"@en .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "A rubric providing an overall rating considering all aspects of a work integrated as one."@en ;
    rdfs:subClassOf ea:Rubric .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:HumanScoring a owl:Class ;
    rdfs:label "Human Scoring"@en ;
    rdfs:subClassOf ea:ScoringAgentType .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:comment "Degree of agreement among independent human scorers or raters."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Coder Reliability"@en,
        "Inter-Observer Reliability"@en,
        "Rater Reliability"@en .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:comment "Consistency of results across items within a test (e.g. Cronbach's alpha, split-half)."@en ;
    rdfs:subClassOf ea:Reliability .

ea:ItemDistractor a owl:Class ;
    rdfs:label "Item Distractor"@en ;
    rdfs:comment "An incorrect but plausible alternative answer choice."@en ;
    rdfs:subClassOf ea:ItemOption ;
    owl:disjointWith ea:ItemKey .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:comment "The opening problem, question, or incomplete statement of a test item."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "Statements of what students are expected to know, understand, or be able to do."@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Learning Standard"@en .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:comment "A statistically selected comparison group of test takers against which relative standing is computed."@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Norming Group"@en .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:label "Portfolio-Based Assessment"@en ;
    rdfs:comment "Assessment based on a collection of academic work compiled over time."@en ;
    rdfs:subClassOf ea:Assessment .

ea:RandomError a owl:Class ;
    rdfs:label "Random Error"@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:label "Rater-Related Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityFacet .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:comment "A compilation of academic work and educational evidence assembled over time."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Digital Portfolio"@en,
        "E-Portfolio"@en .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:label "Student-Related Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityFacet .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:label "Test Administration-Related Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityFacet .

ea:TestRelatedReliability a owl:Class ;
    rdfs:label "Test-Related Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityFacet .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:hasTestItem a owl:ObjectProperty ;
    rdfs:label "has test item"@en ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItem .

ea:storesTestItem a owl:ObjectProperty ;
    rdfs:label "stores test item"@en ;
    rdfs:domain ea:ItemBank ;
    rdfs:range ea:TestItem .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "Extent to which operationalizations measure a construct as defined by theory; modern theory views this as subsuming other validity types."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:comment "Assessment measuring performance against fixed criteria or learning standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Standards-Based Assessment"@en .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:comment "Interprets test scores against defined, objective criteria or learning standards without peer comparison."@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "Extent to which operationalization relates to or predicts a theoretically related outcome or gold standard."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:Cutscore a owl:Class ;
    rdfs:label "Cutscore"@en ;
    rdfs:comment "A score dividing performance categories (such as pass and fail) in criterion-referenced tests."@en ;
    rdfs:subClassOf ea:EvaluationStandard ;
    skos:altLabel "Passing Score"@en .

ea:EvaluationStandard a owl:Class ;
    rdfs:label "Evaluation Standard"@en ;
    rdfs:comment "A standard, rubric, or guideline used to evaluate performance or quality."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:ExternalLocus a owl:Class ;
    rdfs:label "External Locus"@en ;
    rdfs:comment "Set by an external governing body and marked by outside personnel."@en ;
    rdfs:subClassOf ea:AdministrationLocus .

ea:FormalType a owl:Class ;
    rdfs:label "Formal Type"@en ;
    rdfs:comment "Typically written, contributing a score or grade to final performance."@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:comment "In-process monitoring of learning to provide ongoing feedback and adjust instruction."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:ForwardLookingPurpose a owl:Class ;
    rdfs:label "Forward-Looking Purpose"@en ;
    rdfs:comment "Asks test takers to consider themselves in hypothetical future situations."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HighStakesType a owl:Class ;
    rdfs:label "High Stakes Type"@en ;
    rdfs:comment "Assessment carrying major consequences such as graduation, rewards, sanctions, or licensing."@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalType a owl:Class ;
    rdfs:label "Informal Type"@en ;
    rdfs:comment "Casual, unrecorded toward final grades, including observation and discussions."@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:comment "Evaluates student progress periodically to determine if they are on track for summative goals."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:InternalLocus a owl:Class ;
    rdfs:label "Internal Locus"@en ;
    rdfs:comment "Set and marked by the school or internal instructors."@en ;
    rdfs:subClassOf ea:AdministrationLocus .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:comment "Interprets present performance against an individual's own prior performance or across domains within the student."@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ItemBank a owl:Class ;
    rdfs:label "Item Bank"@en ;
    rdfs:comment "A repository where test items are stored for retrieval and test construction."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Test Bank"@en .

ea:ItemKey a owl:Class ;
    rdfs:label "Item Key"@en ;
    rdfs:comment "The correct answer option among the choices."@en ;
    rdfs:subClassOf ea:ItemOption .

ea:LowStakesType a owl:Class ;
    rdfs:label "Low Stakes Type"@en ;
    rdfs:comment "Assessment carrying minor or no significant public/external consequences."@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:comment "Discrepancy between obtained scores and corresponding true scores (E in X = T + E)."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:NonStandardizedFormat a owl:Class ;
    rdfs:label "Non-Standardized Format"@en ;
    rdfs:comment "Flexible in scope and format, administered under differing conditions or evaluated variably."@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:comment "Interprets test scores by comparing test takers to a predefined population or norming group on a relative distribution."@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ObjectiveType a owl:Class ;
    rdfs:label "Objective Type"@en ;
    rdfs:comment "Form of questioning that has a single correct answer."@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:OralMedium a owl:Class ;
    rdfs:label "Oral Medium"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:comment "Establishes a baseline before instruction to place students in appropriate instructional sequences or strategies."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:PracticalMedium a owl:Class ;
    rdfs:label "Practical Medium"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:PsychometricQuality a owl:Class ;
    rdfs:label "Psychometric Quality"@en ;
    rdfs:comment "A measurement characteristic or quality attribute of an assessment, such as reliability or validity."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:comment "Identifies specialized educational needs, readiness, or developmental issues."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedFormat a owl:Class ;
    rdfs:label "Standardized Format"@en ;
    rdfs:comment "Administered and scored in a predetermined, uniform manner across all test takers."@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:SubjectiveType a owl:Class ;
    rdfs:label "Subjective Type"@en ;
    rdfs:comment "Form of questioning that may have more than one correct answer or way of expressing the answer."@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:comment "Evaluates competence, learning outcomes, or program efficacy at the end of an instructional unit."@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:WrittenMedium a owl:Class ;
    rdfs:label "Written Medium"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:hasAdministrationLocus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has administration locus"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationLocus .

ea:hasFormalityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasStakesCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory .

ea:hasStandardizationStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization status"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationStatus .

ea:AdministrationLocus a owl:Class ;
    rdfs:label "Administration Locus"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:InternalLocus ea:ExternalLocus ) .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "Information provided to students or teachers regarding performance and understanding."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:FormalityCategory a owl:Class ;
    rdfs:label "Formality Category"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:FormalType ea:InformalType ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:comment "A possible answer choice offered in a multiple choice or response item."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:comment "Assessment yielding an estimate of position in a predefined population."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Normative Assessment"@en .

ea:Score a owl:Class ;
    rdfs:label "Score"@en ;
    rdfs:comment "Numerical or categorical indicator of student performance."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:ScoringAgentType a owl:Class ;
    rdfs:label "Scoring Agent Type"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:HumanScoring ea:ComputerScoring ) .

ea:StakesCategory a owl:Class ;
    rdfs:label "Stakes Category"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:HighStakesType ea:LowStakesType ) .

ea:StandardizationStatus a owl:Class ;
    rdfs:label "Standardization Status"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:StandardizedFormat ea:NonStandardizedFormat ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "A test item permitting open responses evaluated with human judgment or rubrics."@en ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:ObjectiveItem .

ea:hasDeliveryMedium a owl:ObjectProperty ;
    rdfs:label "has delivery medium"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:DeliveryMedium .

ea:hasObjectivityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has objectivity category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item"@en ;
    rdfs:comment "An objective item with a stem and several alternative answers, containing exactly one key."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Objective Response"@en .

ea:ObjectivityCategory a owl:Class ;
    rdfs:label "Objectivity Category"@en ;
    rdfs:comment "Classification based on whether assessment questioning has a single correct answer or permits multiple answers."@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:ObjectiveType ea:SubjectiveType ) .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide containing evaluative criteria, quality definitions, and scoring strategies."@en ;
    rdfs:subClassOf ea:EvaluationStandard ;
    skos:altLabel "Scoring Guide"@en .

ea:ScoringMethod a owl:Class ;
    rdfs:label "Scoring Method"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:HolisticScoring ea:AnalyticScoring ea:TraitInformedScoring ) .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework .

ea:DeliveryMedium a owl:Class ;
    rdfs:label "Delivery Medium"@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:WrittenMedium ea:OralMedium ea:PracticalMedium ea:ComputerBasedMedium ) .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:comment "Framework against which assessment results or test scores are interpreted."@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:ReliabilityFacet a owl:Class ;
    rdfs:label "Reliability Facet"@en ;
    rdfs:comment "Source or type of error variability affecting reliability."@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:StudentRelatedReliability ea:RaterRelatedReliability ea:TestAdministrationRelatedReliability ea:TestRelatedReliability ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "A test item with a single predetermined correct answer."@en ;
    rdfs:subClassOf ea:TestItem .

ea:TestItem a owl:Class ;
    rdfs:label "Test Item"@en ;
    rdfs:comment "A single question, problem, or prompt within an assessment."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Question"@en .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The extent to which an assessment tool measures what it is intended to measure."@en ;
    rdfs:subClassOf ea:PsychometricQuality .

ea:AssessmentArtifact a owl:Class ;
    rdfs:label "Assessment Artifact"@en ;
    rdfs:comment "A physical, digital, or conceptual artifact produced, used, or compiled in an assessment process."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "Freedom from measurement error; degree of consistency across repeated occasions or equivalent forms."@en ;
    rdfs:subClassOf ea:PsychometricQuality .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:PurposeCategory a owl:Class ;
    rdfs:label "Purpose Category"@en ;
    rdfs:comment "The intended educational objective or function of an assessment."@en ;
    rdfs:subClassOf ea:ValuePartition ;
    owl:disjointUnionOf ( ea:DiagnosticPurpose ea:FormativePurpose ea:PlacementPurpose ea:SummativePurpose ea:InterimPurpose ea:ScreeningPurpose ea:ForwardLookingPurpose ) .

ea:AssessmentEntity a owl:Class ;
    rdfs:label "Assessment Entity"@en ;
    rdfs:comment "Top-level domain entity in the educational assessment domain."@en .

ea:ValuePartition a owl:Class ;
    rdfs:label "Value Partition"@en ;
    rdfs:comment "Abstract superclass for reified assessment classification dimensions."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or other attributes through a set of questions or tasks."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf ea:EducationalProcess ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

