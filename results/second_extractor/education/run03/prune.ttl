@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology representing the educational assessment domain strictly as described in the source corpus."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringApproach ;
                        owl:someValuesFrom ea:AnalyticScoringApproach ] ) ] .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College Admissions Test"@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:NormReferencedAssessment ;
    skos:altLabel "Competitive Exam"@en .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "Assessment requiring a rubric and an expert examiner, such as a thesis or funding proposal."@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:subClassOf ea:ValidityEvidence ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:subClassOf ea:AssessmentFeedback .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocusOfControl ;
                        owl:someValuesFrom ea:ExternalControlCategory ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:FinalExamination a owl:Class ;
    rdfs:label "Final Examination"@en ;
    rdfs:subClassOf ea:SummativeAssessment ;
    skos:altLabel "Final Exam"@en,
        "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringApproach ;
                        owl:someValuesFrom ea:HolisticScoringApproach ] ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Aim"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocusOfControl ;
                        owl:someValuesFrom ea:InternalControlCategory ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International Comparison Test"@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeFramework ] ) ] .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakesLevel ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Objective"@en .

ea:MidtermExamination a owl:Class ;
    rdfs:label "Midterm Examination"@en ;
    rdfs:comment "Midterm exams are described as either formative or summative assessments."@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    skos:altLabel "Midterm Exam"@en .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple Response Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationFormat ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] ;
    skos:altLabel "Non-Standardized Assessment"@en .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:ObjectiveScoringCategory ] ) ] .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    rdfs:subClassOf ea:FormativeAssessment ;
    skos:altLabel "Peer Evaluation"@en .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:label "Portfolio-Based Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    skos:altLabel "Portfolio Assessment"@en .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological Test"@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self Assessment"@en ;
    rdfs:subClassOf ea:FormativeAssessment ;
    skos:altLabel "Self-Evaluation"@en .

ea:SplitHalfReliability a owl:Class ;
    rdfs:label "Split-Half Reliability"@en ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:SubjectiveScoringCategory ] ) ] .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:subClassOf ea:TeacherEvaluation ;
    skos:altLabel "Growth Measure"@en .

ea:hasCriterionDomain a owl:ObjectProperty ;
    rdfs:label "has criterion domain"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:CriterionSpecification .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range xsd:decimal .

ea:hasDeliveryMedium a owl:ObjectProperty ;
    rdfs:label "has delivery medium"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:DeliveryMedium .

ea:hasDistractorOption a owl:ObjectProperty ;
    rdfs:label "has distractor option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemDistractorOption ;
    rdfs:subPropertyOf ea:hasAlternativeOption .

ea:hasErrorScoreVariance a owl:DatatypeProperty ;
    rdfs:label "has error score variance"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range xsd:decimal .

ea:hasEvaluativeCriterion a owl:ObjectProperty ;
    rdfs:label "has evaluative criterion"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:EvaluativeCriterion .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AssessmentFeedback .

ea:hasGranularityFocus a owl:ObjectProperty ;
    rdfs:label "has granularity focus"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AssessmentGranularity .

ea:hasItem a owl:ObjectProperty ;
    rdfs:label "has item"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isItemOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range xsd:integer .

ea:hasKeyOption a owl:ObjectProperty ;
    rdfs:label "has key option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemKeyOption ;
    rdfs:subPropertyOf ea:hasAlternativeOption .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:LearningOutcome .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasObservedScoreVariance a owl:DatatypeProperty ;
    rdfs:label "has observed score variance"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range xsd:decimal .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range xsd:decimal .

ea:hasReliabilityEstimate a owl:ObjectProperty ;
    rdfs:label "has reliability estimate"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:ReliabilityEstimate .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem .

ea:hasTiming a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has timing"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AdministrationTiming .

ea:hasTrueScoreVariance a owl:DatatypeProperty ;
    rdfs:label "has true score variance"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range xsd:decimal .

ea:hasValidityEvidence a owl:ObjectProperty ;
    rdfs:label "has validity evidence"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:ValidityEvidence .

ea:AcademicProgramGranularity a owl:Class ;
    rdfs:label "Academic Program Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:ComputerDelivery a owl:Class ;
    rdfs:label "Computer Delivery"@en ;
    rdfs:subClassOf ea:DeliveryMedium ;
    skos:altLabel "On-Screen Delivery"@en,
        "Online Delivery"@en .

ea:ConcurrentTiming a owl:Class ;
    rdfs:label "Concurrent Timing"@en ;
    rdfs:subClassOf ea:AdministrationTiming .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:label "Course Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:CriterionSpecification a owl:Class ;
    rdfs:label "Criterion Specification"@en ;
    rdfs:comment "The domain of subject matter that a criterion-referenced test is designed to assess."@en .

ea:DevelopmentalScoringApproach a owl:Class ;
    rdfs:label "Developmental Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:label "Educational System Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Essay Question"@en .

ea:EvaluativeCriterion a owl:Class ;
    rdfs:label "Evaluative Criterion"@en .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakesLevel ] ) ] ;
    skos:altLabel "High-Stakes Test"@en .

ea:IndividualLearnerGranularity a owl:Class ;
    rdfs:label "Individual Learner Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:InstitutionGranularity a owl:Class ;
    rdfs:label "Institution Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:InterMethodReliability a owl:Class ;
    rdfs:label "Inter-Method Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityEstimate ;
    skos:altLabel "Form Equivalence"@en,
        "Parallel-Forms Reliability"@en .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityEstimate ;
    skos:altLabel "Inter-Observer Reliability"@en,
        "Inter-Rater Agreement"@en .

ea:ItemKeyOption a owl:Class ;
    rdfs:label "Item Key Option"@en ;
    rdfs:subClassOf ea:ItemOption ;
    owl:disjointWith ea:ItemDistractorOption ;
    skos:altLabel "Correct Answer"@en,
        "Key"@en .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:label "Learning Community Granularity"@en ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    skos:altLabel "Norming Group"@en .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:label "One-Best-Answer Item"@en ;
    rdfs:subClassOf ea:MultipleChoiceItem ;
    skos:altLabel "Single Best Answer"@en .

ea:OralDelivery a owl:Class ;
    rdfs:label "Oral Delivery"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:PaperDelivery a owl:Class ;
    rdfs:label "Paper Delivery"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:label "Performance-Based Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    skos:altLabel "Performance Assessment"@en,
        "Performance Test"@en .

ea:PostInstructionTiming a owl:Class ;
    rdfs:label "Post-Instruction Timing"@en ;
    rdfs:subClassOf ea:AdministrationTiming .

ea:PracticalDelivery a owl:Class ;
    rdfs:label "Practical Delivery"@en ;
    rdfs:subClassOf ea:DeliveryMedium .

ea:PreInstructionTiming a owl:Class ;
    rdfs:label "Pre-Instruction Timing"@en ;
    rdfs:subClassOf ea:AdministrationTiming .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short Answer Item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Short Answer Question"@en .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en .

ea:TeacherEvaluation a owl:Class ;
    rdfs:label "Teacher Evaluation"@en ;
    rdfs:comment "Assessment of educational faculty by supervisors or via student test score measures."@en ;
    rdfs:subClassOf ea:EducationalAssessment .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityEstimate ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:subClassOf ea:MultipleChoiceItem ;
    skos:altLabel "True-False Question"@en .

ea:isItemOf a owl:ObjectProperty ;
    rdfs:label "is item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:EducationalAssessment .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:EducationalAssessment .

ea:AnalyticScoringApproach a owl:Class ;
    rdfs:label "Analytic Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:AssessmentFeedback a owl:Class ;
    rdfs:label "Assessment Feedback"@en .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "Modern validity theory defines construct validity as overarching, subsuming all other types of validity evidence."@en ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencedFramework ] ) ] ;
    skos:altLabel "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en .

ea:CriterionReferencedFramework a owl:Class ;
    rdfs:label "Criterion-Referenced Framework"@en ;
    rdfs:subClassOf ea:ReferencingFramework ;
    skos:altLabel "Standards-Based Framework"@en .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:subClassOf ea:ValidityEvidence ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:ExternalControlCategory a owl:Class ;
    rdfs:label "External Control Category"@en ;
    rdfs:subClassOf ea:LocusOfControlCategory .

ea:FormalCategory a owl:Class ;
    rdfs:label "Formal Category"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Passages coordinate formative assessment alongside diagnostic and placement assessment, while other passages state that diagnostic assessment is a common form of formative assessment. Both claims are modeled."@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose ;
    skos:altLabel "Assessment for Learning Purpose"@en .

ea:FreeResponseItem a owl:Class ;
    rdfs:label "Free Response Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ"@en,
        "Free Response Question"@en,
        "Open-Ended Question"@en .

ea:HighStakesLevel a owl:Class ;
    rdfs:label "High Stakes Level"@en ;
    rdfs:subClassOf ea:StakesLevel .

ea:HolisticScoringApproach a owl:Class ;
    rdfs:label "Holistic Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "Nonreductionist Grading"@en .

ea:InformalCategory a owl:Class ;
    rdfs:label "Informal Category"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose ;
    skos:altLabel "Benchmark Assessment Purpose"@en .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:subClassOf ea:ReliabilityEstimate ;
    skos:altLabel "Internal Consistency"@en .

ea:InternalControlCategory a owl:Class ;
    rdfs:label "Internal Control Category"@en ;
    rdfs:subClassOf ea:LocusOfControlCategory .

ea:IpsativeFramework a owl:Class ;
    rdfs:label "Ipsative Framework"@en ;
    rdfs:subClassOf ea:ReferencingFramework ;
    skos:altLabel "Forced-Choice Framework"@en .

ea:ItemComponent a owl:Class ;
    rdfs:label "Item Component"@en .

ea:ItemDistractorOption a owl:Class ;
    rdfs:label "Item Distractor Option"@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Distractor"@en,
        "Incorrect Answer"@en .

ea:LowStakesLevel a owl:Class ;
    rdfs:label "Low Stakes Level"@en ;
    rdfs:subClassOf ea:StakesLevel .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:label "Non-Standardized Category"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencedFramework ] ) ] ;
    skos:altLabel "Norm-Referenced Test"@en,
        "Normative Assessment"@en .

ea:NormReferencedFramework a owl:Class ;
    rdfs:label "Norm-Referenced Framework"@en ;
    rdfs:subClassOf ea:ReferencingFramework ;
    skos:altLabel "Normative Framework"@en .

ea:ObjectiveScoringCategory a owl:Class ;
    rdfs:label "Objective Scoring Category"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose ;
    skos:altLabel "Initial Assessment Purpose"@en,
        "Pre-Assessment Purpose"@en .

ea:PsychometricQualityAttribute a owl:Class ;
    rdfs:label "Psychometric Quality Attribute"@en .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:StandardizedCategory a owl:Class ;
    rdfs:label "Standardized Category"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveScoringCategory a owl:Class ;
    rdfs:label "Subjective Scoring Category"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose ;
    skos:altLabel "Assessment of Learning Purpose"@en .

ea:hasAlternativeOption a owl:ObjectProperty ;
    rdfs:label "has alternative option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemOption .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:FormalityCategory .

ea:hasLocusOfControl a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has locus of control"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:LocusOfControlCategory .

ea:hasScoringApproach a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring approach"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ea:EducationalAssessment ea:Rubric ) ] ;
    rdfs:range ea:ScoringApproach .

ea:hasScoringObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring objectivity"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:ObjectivityCategory .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes level"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:StakesLevel .

ea:hasStandardizationFormat a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization format"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:StandardizationCategory .

ea:FormalityCategory a owl:Class ;
    rdfs:label "Formality Category"@en ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:subClassOf ea:ItemComponent ;
    skos:altLabel "Alternative Answer"@en .

ea:LocusOfControlCategory a owl:Class ;
    rdfs:label "Locus of Control Category"@en ;
    owl:disjointUnionOf ( ea:InternalControlCategory ea:ExternalControlCategory ) .

ea:ObjectivityCategory a owl:Class ;
    rdfs:label "Objectivity Category"@en ;
    owl:disjointUnionOf ( ea:ObjectiveScoringCategory ea:SubjectiveScoringCategory ) .

ea:StakesLevel a owl:Class ;
    rdfs:label "Stakes Level"@en ;
    owl:disjointUnionOf ( ea:HighStakesLevel ea:LowStakesLevel ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:label "Standardization Category"@en ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:ReferencingFramework .

ea:AdministrationTiming a owl:Class ;
    rdfs:label "Administration Timing"@en ;
    owl:disjointUnionOf ( ea:PreInstructionTiming ea:ConcurrentTiming ea:PostInstructionTiming ) .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    skos:altLabel "Question"@en,
        "Test Item"@en .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    skos:altLabel "Student Learning Outcome"@en .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    owl:disjointUnionOf ( ea:CriterionReferencedFramework ea:NormReferencedFramework ea:IpsativeFramework ) .

ea:ScoringApproach a owl:Class ;
    rdfs:label "Scoring Approach"@en ;
    owl:disjointUnionOf ( ea:HolisticScoringApproach ea:AnalyticScoringApproach ea:DevelopmentalScoringApproach ) .

ea:DeliveryMedium a owl:Class ;
    rdfs:label "Delivery Medium"@en ;
    owl:disjointUnionOf ( ea:PaperDelivery ea:ComputerDelivery ea:OralDelivery ea:PracticalDelivery ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:ReliabilityEstimate a owl:Class ;
    rdfs:label "Reliability Estimate"@en ;
    rdfs:subClassOf ea:PsychometricQualityAttribute ;
    skos:altLabel "Reliability"@en .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:subClassOf ea:EducationalAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:EducationalAssessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationFormat ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] ;
    skos:altLabel "Standardized Assessment"@en .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:EducationalAssessment ;
    rdfs:range ea:AssessmentPurpose .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en,
        "Objective Response"@en .

ea:ValidityEvidence a owl:Class ;
    rdfs:label "Validity Evidence"@en ;
    rdfs:subClassOf ea:PsychometricQualityAttribute ;
    skos:altLabel "Validity"@en .

ea:AssessmentGranularity a owl:Class ;
    rdfs:label "Assessment Granularity"@en ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:AssessmentPurpose a owl:Class ;
    rdfs:label "Assessment Purpose"@en ;
    owl:disjointUnionOf ( ea:FormativePurpose ea:SummativePurpose ea:PlacementPurpose ea:DiagnosticPurpose ea:InterimPurpose ea:ScreeningPurpose ) .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses containing evaluative criteria, quality definitions, and a scoring strategy."@en ;
    skos:altLabel "Scoring Guide"@en .

ea:EducationalAssessment a owl:Class ;
    rdfs:label "Educational Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning."@en ;
    skos:altLabel "Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveItem ea:SubjectiveItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TestRetestReliability ea:InterRaterReliability ea:InterMethodReliability ea:InternalConsistencyReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:OneBestAnswerItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:EssayItem ea:ShortAnswerItem ) .

