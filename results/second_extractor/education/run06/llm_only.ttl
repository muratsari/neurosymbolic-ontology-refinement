ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:subClassOf ea:Rubric .

ea:AssessmentItemPart a owl:Class ;
    rdfs:label "Assessment Item Part"@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:subClassOf ea:AssessmentValidity .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:subClassOf ea:AssessmentValidity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:ExternalOrigin a owl:Class ;
    rdfs:label "External Origin"@en ;
    rdfs:subClassOf ea:AssessmentOrigin .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:FormalEvaluation a owl:Class ;
    rdfs:label "Formal Evaluation"@en ;
    rdfs:subClassOf ea:AssessmentFormality .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:HighStakes a owl:Class ;
    rdfs:label "High Stakes"@en ;
    rdfs:subClassOf ea:AssessmentStakes .

ea:InformalEvaluation a owl:Class ;
    rdfs:label "Informal Evaluation"@en ;
    rdfs:subClassOf ea:AssessmentFormality .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:InternalOrigin a owl:Class ;
    rdfs:label "Internal Origin"@en ;
    rdfs:subClassOf ea:AssessmentOrigin .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:subClassOf ea:AssessmentItemPart .

ea:LowStakes a owl:Class ;
    rdfs:label "Low Stakes"@en ;
    rdfs:subClassOf ea:AssessmentStakes .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:ItemKey ;
            owl:onProperty ea:hasKey ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en,
        "Objective Response Item"@en .

ea:NonStandardizedStatus a owl:Class ;
    rdfs:label "Non-Standardized Status"@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ObjectiveEvaluation a owl:Class ;
    rdfs:label "Objective Evaluation"@en ;
    rdfs:subClassOf ea:AssessmentObjectivity .

ea:OpenEndedItem a owl:Class ;
    rdfs:label "Open-Ended Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ"@en,
        "Free Response Question"@en .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Performance-Based Assessment"@en .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:PortfolioAssessment a owl:Class ;
    rdfs:label "Portfolio Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Portfolio-Based Assessment"@en .

ea:QualityAttribute a owl:Class ;
    rdfs:label "Quality Attribute"@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:StandardizedStatus a owl:Class ;
    rdfs:label "Standardized Status"@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:SubjectiveEvaluation a owl:Class ;
    rdfs:label "Subjective Evaluation"@en ;
    rdfs:subClassOf ea:AssessmentObjectivity .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:TestScore a owl:Class ;
    rdfs:label "Test Score"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:ObservedScore ea:TrueScore ) .

ea:TestingAdjustment a owl:Class ;
    rdfs:label "Testing Adjustment"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:TestAccommodation ea:TestModification ) .

ea:hasFormality a owl:ObjectProperty ;
    rdfs:label "has formality"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentFormality ;
    owl:inverseOf ea:isFormalityOf .

ea:hasKey a owl:ObjectProperty ;
    rdfs:label "has key"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemKey ;
    owl:inverseOf ea:isKeyOf .

ea:hasObjectivity a owl:ObjectProperty ;
    rdfs:label "has objectivity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentObjectivity ;
    owl:inverseOf ea:isObjectivityOf .

ea:hasOrigin a owl:ObjectProperty ;
    rdfs:label "has origin"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentOrigin ;
    owl:inverseOf ea:isOriginOf .

ea:hasStakes a owl:ObjectProperty ;
    rdfs:label "has stakes"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentStakes ;
    owl:inverseOf ea:isStakesOf .

ea:hasStandardization a owl:ObjectProperty ;
    rdfs:label "has standardization"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationStatus ;
    owl:inverseOf ea:isStandardizationOf .

ea:AssessmentFeedback a owl:Class ;
    rdfs:label "Assessment Feedback"@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:subClassOf ea:AssessmentFeedback .

ea:ItemDistractor a owl:Class ;
    rdfs:label "Item Distractor"@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Incorrect Answer"@en .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed Score"@en ;
    rdfs:subClassOf ea:TestScore .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:TrueScore a owl:Class ;
    rdfs:label "True Score"@en ;
    rdfs:subClassOf ea:TestScore .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:subClassOf ea:Test .

ea:hasReferencing a owl:ObjectProperty ;
    rdfs:label "has referencing"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework ;
    owl:inverseOf ea:isReferencingOf .

ea:AssessmentFormality a owl:Class ;
    rdfs:label "Assessment Formality"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:FormalEvaluation ea:InformalEvaluation ) .

ea:AssessmentObjectivity a owl:Class ;
    rdfs:label "Assessment Objectivity"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:ObjectiveEvaluation ea:SubjectiveEvaluation ) .

ea:AssessmentOrigin a owl:Class ;
    rdfs:label "Assessment Origin"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:InternalOrigin ea:ExternalOrigin ) .

ea:AssessmentStakes a owl:Class ;
    rdfs:label "Assessment Stakes"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:subClassOf ea:AssessmentItemPart ;
    owl:disjointUnionOf ( ea:ItemKey ea:ItemDistractor ) ;
    skos:altLabel "Alternative Answer"@en .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:RandomError ea:SystematicError ) .

ea:PerformanceFormat a owl:Class ;
    rdfs:label "Performance Format"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:ProductFormat ea:PerformanceExecutionFormat ) .

ea:ReliabilityFactor a owl:Class ;
    rdfs:label "Reliability Factor"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:StudentRelatedFactor ea:RaterRelatedFactor ea:TestAdministrationFactor ea:TestRelatedFactor ) .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Scoring Guide"@en .

ea:StandardizationStatus a owl:Class ;
    rdfs:label "Standardization Status"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:StandardizedStatus ea:NonStandardizedStatus ) .

ea:ItemKey a owl:Class ;
    rdfs:label "Item Key"@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Correct Answer"@en .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:ScoringMethod a owl:Class ;
    rdfs:label "Scoring Method"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:HolisticScoring ea:AnalyticScoring ea:TraitInformedScoring ) .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentPurpose ;
    owl:inverseOf ea:isPurposeOf .

ea:AssessmentValidity a owl:Class ;
    rdfs:label "Assessment Validity"@en ;
    rdfs:subClassOf ea:QualityAttribute ;
    owl:disjointWith ea:AssessmentReliability ;
    skos:altLabel "Test Validity"@en,
        "Validity"@en .

ea:AssessmentGranularity a owl:Class ;
    rdfs:label "Assessment Granularity"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:AssessmentPurpose a owl:Class ;
    rdfs:label "Assessment Purpose"@en ;
    rdfs:subClassOf ea:AssessmentAxisValue ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ea:ScreeningPurpose ea:InterimPurpose ) .

ea:AssessmentAxisValue a owl:Class ;
    rdfs:label "Assessment Axis Value"@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:AssessmentReliability a owl:Class ;
    rdfs:label "Assessment Reliability"@en ;
    rdfs:subClassOf ea:QualityAttribute ;
    skos:altLabel "Reliability"@en .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    owl:disjointUnionOf ( ea:ObjectiveItem ea:SubjectiveItem ) ;
    skos:altLabel "Item"@en,
        "Question"@en .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:AssessmentEntity a owl:Class ;
    rdfs:label "Assessment Entity"@en ;
    rdfs:subClassOf owl:Thing .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HighStakesAssessment ea:LowStakesAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:StandardizedAssessment ea:NonStandardizedAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:WrittenTest ea:OralTest ea:PracticalTest ) .

[] a owl:AllDisjointClasses ;
    rdfs:comment "Corpus tension: Encodes the coordinate partition from passage 2 ('Placement, formative, summative and diagnostic assessment') alongside the subordination of DiagnosticAssessment under FormativeAssessment."@en ;
    owl:members ( ea:PlacementAssessment ea:FormativeAssessment ea:SummativeAssessment ea:DiagnosticAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:CriterionReferencedAssessment ea:NormReferencedAssessment ea:IpsativeAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveAssessment ea:SubjectiveAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:FormalAssessment ea:InformalAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:InternalAssessment ea:ExternalAssessment ) .

