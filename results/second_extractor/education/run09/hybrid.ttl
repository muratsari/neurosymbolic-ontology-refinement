@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An OWL DL ontology modeling educational assessment, measurement, psychometric properties, item types, scoring, and feedback strictly as described in the provided corpus."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:comment "Measures knowledge and skills learned over a past period; backward-looking."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AnecdotalFeedback a owl:Class ;
    rdfs:label "Anecdotal Feedback"@en ;
    rdfs:comment "Descriptive oral or written commentary detailing strengths and next steps."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:comment "Predicts ability to succeed in future intellectual or physical endeavors; forward-looking."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside school."@en ;
    rdfs:subClassOf ea:PerformanceBasedAssessment .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College Admissions Test"@en ;
    rdfs:comment "Standardized test used to make admissions decisions in higher education."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "A norm-referenced, high-stakes test ranking candidates to select top rankers for limited positions."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ea:HighStakesTest ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment that requires an expert examiner and a rubric, such as a final-year project thesis."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ComputerAdaptiveTest a owl:Class ;
    rdfs:label "Computer-Adaptive Test"@en ;
    rdfs:comment "A computer-based test that adapts item presentation dynamically."@en ;
    rdfs:subClassOf ea:ComputerBasedTest .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:comment "Validity concerning the social and educational consequences of test score use."@en ;
    rdfs:subClassOf ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "The degree to which items cover a representative sample of the domain to be measured."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "Assessment that evaluates student progress throughout a course as an alternative to single final exams."@en ;
    rdfs:subClassOf ea:Assessment .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytical rubrics organized across dimensions of developmental successions."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment"@en ;
    rdfs:comment "Corpus tension: Listed as a coordinate alternative to placement, formative, and summative assessments in one section, but explicitly characterized as a common form or subset of formative assessment in other sections. Both claims are modeled here."@en ;
    rdfs:subClassOf ea:Assessment,
        ea:FormativeAssessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "Diagnostic Testing"@en .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:comment "An open-ended item requiring an extended prose response."@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Free Response Question"@en .

ea:EvaluationStandard a owl:Class ;
    rdfs:label "Evaluation Standard"@en ;
    rdfs:comment "Guidelines or criteria published to promote evaluations that are appropriate, useful, feasible, and accurate."@en .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended-Response Item"@en ;
    rdfs:comment "An item requiring an extended written or demonstrated response."@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:comment "Assessment set by an external governing body and marked by external or unbiased personnel."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAgencyCategory ;
                        owl:someValuesFrom ea:ExternalAgency ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "Subjective appearance of whether a test looks like it measures what it claims."@en ;
    rdfs:subClassOf ea:Validity .

ea:FinalExam a owl:Class ;
    rdfs:label "Final Exam"@en ;
    rdfs:comment "A culminating test of topics covered across an instructional period or entire degree."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:comment "Assessment typically implying a written document, numerical score, or grade contributing to student evaluation."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:FormalFormality ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:comment "Asks test takers to consider themselves in hypothetical future situations."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ForwardLookingPurpose ] ) ] .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:comment "Casual assessment that does not contribute to a final course grade, such as observations or checklists."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:InformalFormality ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Periodic assessment to monitor student progress toward standards; debated whether it functions as formative or summative."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:comment "Assessment set and marked by the school or internal teachers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAgencyCategory ;
                        owl:someValuesFrom ea:InternalAgency ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International Comparison Test"@en ;
    rdfs:comment "Standardized test administered across multiple countries to compare educational performance."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:comment "Assesses present performance against the previous performance of the individual test taker."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] .

ea:ItemBank a owl:Class ;
    rdfs:label "Item Bank"@en ;
    rdfs:comment "A repository where assessment items are stored."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:LowStakesTest a owl:Class ;
    rdfs:label "Low-Stakes Test"@en ;
    rdfs:comment "An assessment carrying no significant or public consequences."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:LowStakes ] ) ] ;
    skos:altLabel "Low-Stakes Assessment"@en .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:comment "An item pairing items from one list with another."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MidtermExam a owl:Class ;
    rdfs:label "Midterm Exam"@en ;
    rdfs:comment "An examination administered near the middle of an academic term."@en ;
    rdfs:subClassOf ea:Test .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-Response Item"@en ;
    rdfs:comment "An item where more than one answer option may be keyed as correct."@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    rdfs:comment "A test where different conditions, questions, or evaluations are used across test takers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:NonStandardizedFormat ] ) ] ;
    skos:altLabel "Non-Standardized Assessment"@en .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "Assessment consisting of questioning that has a single correct answer."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:ObjectiveScoring ] ) ] .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:comment "A test administered verbally."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:OralMode ] ) ] .

ea:PaperBasedTest a owl:Class ;
    rdfs:label "Paper-Based Test"@en ;
    rdfs:comment "A written test administered on paper."@en ;
    rdfs:subClassOf ea:WrittenTest .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    rdfs:comment "Assessment conducted by peers of the learner."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Peer Evaluation"@en .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "Conducted before instruction to establish a baseline and place students at the most appropriate point in an instructional sequence."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:Portfolio a owl:Class ;
    rdfs:label "Portfolio"@en ;
    rdfs:comment "A compilation of student work and educational evidence collected over time."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Student Portfolio"@en .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:label "Portfolio-Based Assessment"@en ;
    rdfs:comment "Assessment based on a collection of academic work assembled over time."@en ;
    rdfs:subClassOf ea:Assessment .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:comment "A test requiring practical demonstration of skills, such as driving or a musical recital."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:PracticalMode ] ) ] .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological Test"@en ;
    rdfs:comment "Measures cognitive abilities, mental, emotional, developmental, or social characteristics."@en ;
    rdfs:subClassOf ea:Test .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:comment "A brief assessment covering a small amount of material."@en ;
    rdfs:subClassOf ea:Test .

ea:Recast a owl:Class ;
    rdfs:label "Recast"@en ;
    rdfs:comment "Subtle reformulations of learner errors modeling correct usage."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "Motherese"@en .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score Inflation"@en ;
    rdfs:comment "Increases in test scores that do not reflect genuine improvements in student learning."@en ;
    rdfs:subClassOf ea:EducationalActivity .

ea:ScoreInterpretation a owl:Class ;
    rdfs:label "Score Interpretation"@en ;
    rdfs:comment "The method or framework used to interpret test scores."@en .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "Used to determine readiness for a program or identify needs for specialized assistance."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self-Assessment"@en ;
    rdfs:comment "Assessment where learners evaluate their own work and progress."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Self-Evaluation"@en .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short-Answer Item"@en ;
    rdfs:comment "An open-ended item requiring a brief written response."@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "Assessment consisting of questioning that may have more than one correct answer or way of expressing it."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:SubjectiveScoring ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "Administered at the conclusion of an instructional period to evaluate student learning against standards; typically graded and often high-stakes."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en,
        "Summative Evaluation"@en .

ea:TechnologyMediatedFeedback a owl:Class ;
    rdfs:label "Technology-Mediated Feedback"@en ;
    rdfs:comment "Automated feedback delivered rapidly by software or specialized forms like IF-AT."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:comment "An item requiring verification of whether a statement is true or false."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical algorithms used to estimate individual teacher contributions to student progress."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Growth Measure"@en .

ea:hasAssessor a owl:ObjectProperty ;
    rdfs:label "has assessor"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Stakeholder .

ea:hasCriterionCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has criterion count"@en ;
    rdfs:comment "The number of evaluative criteria outlined in a rubric."@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range xsd:integer .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:CutScore .

ea:hasCutScorePercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has cut score percentage"@en ;
    rdfs:comment "Percentage threshold required to attain passing status or proficiency."@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Distractor ;
    rdfs:subPropertyOf ea:hasItemOption .

ea:hasErrorVariance a owl:DatatypeProperty ;
    rdfs:label "has error variance"@en ;
    rdfs:comment "Variance attributable to errors in measurement."@en ;
    rdfs:domain ea:MeasurementError ;
    rdfs:range xsd:decimal .

ea:hasGradingContribution a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has grading contribution"@en ;
    rdfs:comment "Indicates whether the assessment contributes a numerical score or grade to a student's final course record."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:boolean .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has item count"@en ;
    rdfs:comment "The total number of items contained in the assessment."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasItemStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has item stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem ;
    rdfs:subPropertyOf ea:hasItemComponent .

ea:hasKeyedResponse a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has keyed response"@en ;
    rdfs:comment "A multiple-choice item has exactly one keyed response, whereas multiple-response items allow more."@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:KeyedResponse ;
    rdfs:subPropertyOf ea:hasItemOption .

ea:hasLearner a owl:ObjectProperty ;
    rdfs:label "has learner"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Learner .

ea:hasMeasurementError a owl:ObjectProperty ;
    rdfs:label "has measurement error"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementError ;
    rdfs:subPropertyOf ea:hasMeasurementProperty .

ea:hasNormGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup .

ea:hasObservedScore a owl:DatatypeProperty ;
    rdfs:label "has observed score"@en ;
    rdfs:comment "The attained score on an assessment (X = T + E)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    rdfs:subPropertyOf ea:hasMeasurementProperty .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:comment "Numerical index of reliability, typically ranging from 0.00 to 1.00."@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasTrueScore a owl:DatatypeProperty ;
    rdfs:label "has true score"@en ;
    rdfs:comment "The replicable score component free of measurement error (T in Classical Test Theory)."@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity ;
    rdfs:subPropertyOf ea:hasMeasurementProperty .

ea:hasWordBank a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has word bank"@en ;
    rdfs:domain ea:FillInTheBlankItem ;
    rdfs:range ea:WordBank ;
    rdfs:subPropertyOf ea:hasItemComponent .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs:label "is assessment item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasAssessmentItem .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is feedback of"@en ;
    rdfs:domain ea:Feedback ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasFeedback .

ea:isItemComponentOf a owl:ObjectProperty ;
    rdfs:label "is item component of"@en ;
    rdfs:domain ea:ItemComponent ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:hasItemComponent .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasLearningOutcome .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment ;
    owl:inverseOf ea:hasRubric .

ea:CommandWord a owl:Class ;
    rdfs:label "Command Word"@en ;
    rdfs:comment "A directive word instructing an examinee how to respond."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:ComputerBasedTest a owl:Class ;
    rdfs:label "Computer-Based Test"@en ;
    rdfs:comment "A test administered on a computer or digital system."@en ;
    rdfs:subClassOf ea:WrittenTest ;
    skos:altLabel "Electronic Exam"@en,
        "On-Screen Test"@en,
        "Online Assessment"@en .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Criterion validity when test and criterion data are gathered at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:comment "Degree to which two measures that theoretically should be related are related."@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:comment "Measures student performance against a fixed, predetermined set of criteria or learning standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en .

ea:DemonstrationOutcome a owl:Class ;
    rdfs:label "Demonstration Outcome"@en ;
    rdfs:comment "A transient performance act, e.g. a speech, athletic display, or musical recital."@en ;
    rdfs:subClassOf ea:PerformanceOutcome .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:comment "Degree to which concepts or measures supposed to be unrelated are unrelated."@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:Distractor a owl:Class ;
    rdfs:label "Distractor"@en ;
    rdfs:comment "An incorrect option designed to be plausible yet wrong."@en ;
    rdfs:subClassOf ea:ItemOption .

ea:Educator a owl:Class ;
    rdfs:label "Educator"@en ;
    rdfs:subClassOf ea:Stakeholder ;
    skos:altLabel "Instructor"@en,
        "Teacher"@en .

ea:EvaluativeFeedback a owl:Class ;
    rdfs:label "Evaluative Feedback"@en ;
    rdfs:comment "Feedback provided purely as a grade or evaluation score."@en ;
    rdfs:subClassOf ea:Feedback .

ea:Examiner a owl:Class ;
    rdfs:label "Examiner"@en ;
    rdfs:subClassOf ea:Stakeholder ;
    skos:altLabel "Invigilator"@en,
        "Proctor"@en,
        "Test Administrator"@en .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:comment "An item providing identifying characteristics requiring recall of a missing term."@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Conducted during instruction to monitor student learning and modify teaching and learning activities; typically low-stakes and provides ongoing qualitative feedback."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-Stakes Test"@en ;
    rdfs:comment "An assessment whose results have important consequences, such as graduation, licensure, or accountability."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:HighStakes ] ) ] ;
    skos:altLabel "High-Stakes Assessment"@en .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "Provides an overall rating for student work, considering all aspects together."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringApproach ;
                        owl:someValuesFrom ea:HolisticScoringApproach ] ) ] .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:comment "Agreement between independent observers or raters evaluating the same phenomenon."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Coder Reliability"@en,
        "Inter-Observer Reliability"@en,
        "Rater Reliability"@en .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:comment "Consistency of results across items within the same test (e.g. Cronbach's alpha)."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Internal Consistency"@en .

ea:KeyedResponse a owl:Class ;
    rdfs:label "Keyed Response"@en ;
    rdfs:comment "The designated correct answer choice among options."@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Key"@en .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:comment "A statistically selected sample of test takers used to establish relative norms."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Norming Group"@en,
        "Reference Population"@en .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel-Forms Reliability"@en ;
    rdfs:comment "Consistency of scores across equivalent alternate test forms."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Alternate-Forms Reliability"@en,
        "Form Equivalence"@en,
        "Inter-Method Reliability"@en .

ea:PerformanceBasedAssessment a owl:Class ;
    rdfs:label "Performance-Based Assessment"@en ;
    rdfs:comment "Requires students to perform an actual task or create a product rather than simply answering questions."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Performance Test"@en .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Criterion validity when test scores predict a criterion assessed in the future."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductOutcome a owl:Class ;
    rdfs:label "Product Outcome"@en ;
    rdfs:comment "A tangible artifact produced by a student, e.g. a painting, portfolio, or paper."@en ;
    rdfs:subClassOf ea:PerformanceOutcome .

ea:RandomError a owl:Class ;
    rdfs:label "Random Error"@en ;
    rdfs:comment "Unsystematic measurement fluctuations acting as random variables."@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:Rater a owl:Class ;
    rdfs:label "Rater"@en ;
    rdfs:subClassOf ea:Stakeholder ;
    skos:altLabel "Grader"@en,
        "Marker"@en,
        "Scorer"@en .

ea:SystematicError a owl:Class ;
    rdfs:label "Systematic Error"@en ;
    rdfs:comment "Predictable bias or constant discrepancy embedded in measurement scores."@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:comment "Consistency of scores across separate test administrations under identical conditions."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoringApproach a owl:Class ;
    rdfs:label "Trait-Informed Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "Evaluates distinct dimensions or components of student work separately."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Rubric [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringApproach ;
                        owl:someValuesFrom ea:AnalyticScoringApproach ] ) ] .

ea:AnalyticScoringApproach a owl:Class ;
    rdfs:label "Analytic Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "The extent to which operationalizations measure a construct defined by theory; modern validity theory considers it overarching."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "Correlation between test scores and an external criterion variable."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    rdfs:comment "A predetermined score threshold dividing performance levels."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Cut-off Score"@en,
        "Passing Score"@en .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:EducationalActivity a owl:Class ;
    rdfs:label "Educational Activity"@en ;
    rdfs:comment "An activity in an educational context."@en .

ea:ExternalAgency a owl:Class ;
    rdfs:label "External Agency"@en ;
    rdfs:subClassOf ea:AgencyCategory .

ea:FormalFormality a owl:Class ;
    rdfs:label "Formal Formality"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:ForwardLookingPurpose a owl:Class ;
    rdfs:label "Forward-Looking Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HighStakes a owl:Class ;
    rdfs:label "High Stakes"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:HolisticScoringApproach a owl:Class ;
    rdfs:label "Holistic Scoring Approach"@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:InformalFormality a owl:Class ;
    rdfs:label "Informal Formality"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:InternalAgency a owl:Class ;
    rdfs:label "Internal Agency"@en ;
    rdfs:subClassOf ea:AgencyCategory .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:comment "The opening problem, question, or incomplete statement of an item."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:Learner a owl:Class ;
    rdfs:label "Learner"@en ;
    rdfs:subClassOf ea:Stakeholder ;
    skos:altLabel "Candidate"@en,
        "Student"@en,
        "Test Taker"@en .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "A statement describing what students are expected to know and be able to do."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Intended Learning Outcome"@en,
        "Learning Objective"@en,
        "Learning Standard"@en .

ea:LowStakes a owl:Class ;
    rdfs:label "Low Stakes"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:NonStandardizedFormat a owl:Class ;
    rdfs:label "Non-Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:comment "Compares and ranks test takers in relation to one another or against a norming group on a curve."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Norm-Referenced Test"@en,
        "Normative Assessment"@en .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:OralMode a owl:Class ;
    rdfs:label "Oral Mode"@en ;
    rdfs:subClassOf ea:DeliveryMode .

ea:PerformanceOutcome a owl:Class ;
    rdfs:label "Performance Outcome"@en ;
    rdfs:comment "The manifest result of a performance-based assessment."@en ;
    rdfs:subClassOf ea:AssessmentArtifact .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:PracticalMode a owl:Class ;
    rdfs:label "Practical Mode"@en ;
    rdfs:subClassOf ea:DeliveryMode .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedFormat a owl:Class ;
    rdfs:label "Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:WordBank a owl:Class ;
    rdfs:label "Word Bank"@en ;
    rdfs:comment "A set of possible words provided to fill in blanks."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:WrittenMode a owl:Class ;
    rdfs:label "Written Mode"@en ;
    rdfs:subClassOf ea:DeliveryMode .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "A test administered on paper or computer."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasDeliveryMode ;
                        owl:someValuesFrom ea:WrittenMode ] ) ] .

ea:hasAgencyCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has agency category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AgencyCategory .

ea:hasFormalityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory .

ea:hasItemOption a owl:ObjectProperty ;
    rdfs:label "has item option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemOption ;
    rdfs:subPropertyOf ea:hasItemComponent .

ea:hasScoringApproach a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring approach"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ea:Assessment ea:Rubric ) ] ;
    rdfs:range ea:ScoringApproach .

ea:hasStakesCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory .

ea:hasStandardizationCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationCategory .

ea:AgencyCategory a owl:Class ;
    rdfs:label "Agency Category"@en ;
    owl:disjointUnionOf ( ea:InternalAgency ea:ExternalAgency ) .

ea:FormalityCategory a owl:Class ;
    rdfs:label "Formality Category"@en ;
    owl:disjointUnionOf ( ea:FormalFormality ea:InformalFormality ) .

ea:ObjectiveScoring a owl:Class ;
    rdfs:label "Objective Scoring"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:ObjectivityCategory a owl:Class ;
    rdfs:label "Objectivity Category"@en ;
    owl:disjointUnionOf ( ea:ObjectiveScoring ea:SubjectiveScoring ) .

ea:StakesCategory a owl:Class ;
    rdfs:label "Stakes Category"@en ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:label "Standardization Category"@en ;
    owl:disjointUnionOf ( ea:StandardizedFormat ea:NonStandardizedFormat ) .

ea:SubjectiveScoring a owl:Class ;
    rdfs:label "Subjective Scoring"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:hasDeliveryMode a owl:ObjectProperty ;
    rdfs:label "has delivery mode"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:DeliveryMode .

ea:hasMeasurementProperty a owl:ObjectProperty ;
    rdfs:label "has measurement property"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementProperty .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:comment "Feedback informing learners about accuracy and specific steps for improvement."@en ;
    rdfs:subClassOf ea:Feedback .

ea:DeliveryMode a owl:Class ;
    rdfs:label "Delivery Mode"@en ;
    owl:disjointUnionOf ( ea:WrittenMode ea:OralMode ea:PracticalMode ) .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "Information provided to students or teachers regarding performance or understanding."@en ;
    owl:disjointUnionOf ( ea:CorrectiveFeedback ea:EvaluativeFeedback ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:comment "An alternative answer choice in a selection item."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:MeasurementProperty a owl:Class ;
    rdfs:label "Measurement Property"@en ;
    rdfs:comment "A quality attribute of an educational assessment or measurement."@en ;
    owl:disjointUnionOf ( ea:Validity ea:Reliability ea:MeasurementError ) .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:comment "An item consisting of a stem and options, with only one correct key."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "An item format with a single correct answer."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:AssessmentItem [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:ObjectiveScoring ] ) ] .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:ScoringApproach a owl:Class ;
    rdfs:label "Scoring Approach"@en ;
    owl:disjointUnionOf ( ea:HolisticScoringApproach ea:AnalyticScoringApproach ea:TraitInformedScoringApproach ) .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:comment "A test administered and scored in a consistent, uniform, predetermined manner."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:StandardizedFormat ] ) ] ;
    skos:altLabel "Standardized Assessment"@en .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "An item format allowing more than one correct answer or formulation."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:equivalentClass [ owl:intersectionOf ( ea:AssessmentItem [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:SubjectiveScoring ] ) ] .

ea:hasItemComponent a owl:ObjectProperty ;
    rdfs:label "has item component"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemComponent .

ea:hasObjectivityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has objectivity category"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ea:Assessment ea:AssessmentItem ) ] ;
    rdfs:range ea:ObjectivityCategory .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:comment "Discrepancy between observed test scores and corresponding true scores."@en ;
    rdfs:subClassOf ea:MeasurementProperty .

ea:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:comment "An individual or agent involved in educational assessment."@en ;
    owl:disjointUnionOf ( ea:Learner ea:Educator ea:Examiner ea:Rater ) .

ea:ItemComponent a owl:Class ;
    rdfs:label "Item Component"@en ;
    rdfs:comment "A structural part of an assessment item."@en ;
    owl:disjointUnionOf ( ea:ItemStem ea:ItemOption ea:WordBank ea:CommandWord ) .

ea:AssessmentArtifact a owl:Class ;
    rdfs:label "Assessment Artifact"@en ;
    rdfs:comment "An instrument, guide, scoring tool, or evidentiary product used or produced in assessment."@en .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency of an assessment, or freedom from measurement error."@en ;
    rdfs:subClassOf ea:MeasurementProperty .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The extent to which an assessment tool measures what it is intended to measure."@en ;
    rdfs:subClassOf ea:MeasurementProperty .

ea:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory .

ea:PurposeCategory a owl:Class ;
    rdfs:label "Purpose Category"@en ;
    owl:disjointUnionOf ( ea:FormativePurpose ea:SummativePurpose ea:PlacementPurpose ea:DiagnosticPurpose ea:InterimPurpose ea:ScreeningPurpose ea:ForwardLookingPurpose ) .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring tool containing criteria, quality definitions, and a scoring strategy."@en ;
    rdfs:subClassOf ea:AssessmentArtifact ;
    skos:altLabel "Scoring Guide"@en .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:comment "A unit of an assessment or test, such as a question, problem, or prompt."@en ;
    skos:altLabel "Question"@en,
        "Test Item"@en .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An assessment intended to measure knowledge, skill, aptitude, physical fitness, or standing."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf ea:EducationalActivity ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveItem ea:SubjectiveItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticRubric ea:AnalyticRubric ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ProductOutcome ea:DemonstrationOutcome ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:InterRaterReliability ea:TestRetestReliability ea:ParallelFormsReliability ea:InternalConsistencyReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:RandomError ea:SystematicError ) .

