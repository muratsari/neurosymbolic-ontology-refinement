    rdfs:subClassOf ea:PsychometricQuality ;
    owl:disjointUnionOf ( ea:TemporalStability ea:FormEquivalence ea:InternalConsistency ea:InterRaterReliability ) .

ea:ValidityEvidence a owl:Class ;
