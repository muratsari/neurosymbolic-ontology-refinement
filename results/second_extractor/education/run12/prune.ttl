ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "Concerns how well operationalizations represent a construct defined by theory. Note: In traditional listings, Content, Criterion, Construct, Face, and Consequential validity appear as coordinate categories. Modern validity theory, however, asserts that construct validity subsumes all other types of validity evidence."@en ;
    rdfs:subClassOf ea:ValidityEvidence .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencedFramework ] ) ] ;
    skos:altLabel "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en .

ea:CriterionReferencedFramework a owl:Class ;
    rdfs:label "Criterion-Referenced Framework"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:EducationalFeedback a owl:Class ;
