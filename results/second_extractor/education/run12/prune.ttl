    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses."@en ;
    rdfs:subClassOf ea:AssessmentEvaluationTool ;
    skos:altLabel "Scoring Guide"@en .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:onClass ea:ItemStem ;
                        owl:onProperty ea:hasItemStem ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ea:KeyOption ;
                        owl:onProperty ea:hasKeyOption ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:ItemOption ;
                        owl:onProperty ea:hasItemOption ] ) ] ;
    skos:altLabel "MCQ"@en,
        "Multiple-Choice Question"@en,
        "Objective Response"@en .

ea:AssessmentProcessAttribute a owl:Class ;
    rdfs:label "Assessment Process Attribute"@en ;
    rdfs:comment "Reified dimensions, axes, and characteristics classifying assessment practice."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf ea:AssessmentEntity ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:MultipleChoiceItem ea:MatchingItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:EssayItem ea:ShortAnswerItem ea:ExtendedResponseItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ContentValidity ea:CriterionValidity ea:FaceValidity ea:ConsequentialValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:Assessment ea:AssessmentComponent ea:AssessmentEvaluationTool ea:AssessmentProcessAttribute ea:CurricularEntity ea:EducationalFeedback ea:EducationalMeasurementEntity ea:PsychometricQuality ) .

