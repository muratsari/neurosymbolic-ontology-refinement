    rdfs:comment "Structural items, questions, and parts forming assessments."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:CurricularEntity a owl:Class ;
    rdfs:label "Curricular Entity"@en ;
    rdfs:comment "Standards, outcomes, and evaluative criteria guiding education."@en ;
    rdfs:subClassOf ea:AssessmentEntity .

ea:InconsistencyFactor a owl:Class ;
    rdfs:label "Inconsistency Factor"@en ;
    rdfs:subClassOf ea:ReliabilityFactor ;
    owl:disjointUnionOf ( ea:StudentRelatedInconsistency ea:RaterRelatedInconsistency ea:AdministrationRelatedInconsistency ea:TestRelatedInconsistency ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:subClassOf ea:AssessmentComponent ;
    owl:disjointUnionOf ( ea:KeyOption ea:DistractorOption ) ;
    skos:altLabel "Alternative Answer"@en .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:subClassOf ea:CurricularEntity ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:subClassOf ea:AssessmentProcessAttribute ;
