@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology of educational assessment, testing, psychometrics, and evaluation derived strictly from corpus documentation."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:comment "A backward-looking test measuring knowledge and skills acquired through past instruction."@en ;
    rdfs:subClassOf ea:Test .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:comment "A forward-looking test forecasting future success in intellectual or physical endeavors."@en ;
    rdfs:subClassOf ea:Test .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside the school setting."@en ;
    rdfs:subClassOf ea:PerformanceAssessment .

ea:ClassicalTestTheory a owl:Class ;
    rdfs:label "Classical Test Theory"@en ;
    rdfs:comment "Psychometric theory stating that observed score variance is the sum of true score and error variance."@en ;
    rdfs:subClassOf ea:MeasurementTheory .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College Admissions Test"@en ;
    rdfs:comment "A standardized test used in decisions regarding admission to postsecondary programs."@en ;
    rdfs:subClassOf ea:Test .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "A norm-referenced, high-stakes test where candidates are ranked to select a fixed number of top rankers."@en ;
    rdfs:subClassOf ea:Test .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment characterized by implicit format requiring a rubric and an expert examiner (e.g. thesis)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ComputerAdaptiveTest a owl:Class ;
    rdfs:label "Computer-Adaptive Test"@en ;
    rdfs:comment "A computer-delivered standardized test that dynamically adjusts question difficulty based on answers."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:ComputerScoring a owl:Class ;
    rdfs:label "Computer Scoring"@en ;
    rdfs:comment "Automated scoring of objective or open-ended items by computer systems."@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Correlation between test scores and a criterion measure obtained at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:comment "Evaluation of the social and instructional consequences of test score use."@en ;
    rdfs:subClassOf ea:Validity .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:label "Constructive Alignment"@en ;
    rdfs:comment "The deliberate structural alignment between learning outcomes, activities, and assessments."@en ;
    rdfs:subClassOf owl:Thing .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "The extent to which test items representatively sample the specified content domain."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "A form of examination that evaluates progress throughout a course as an alternative to the final examination system."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:comment "Degree of positive relationship between measures of theoretically related constructs."@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:comment "Information specifying student errors, next steps, and remediation guidance."@en ;
    rdfs:subClassOf ea:Feedback .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:comment "Assessment that evaluates student performance against defined, predetermined criteria or learning standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "CRT"@en,
        "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytic rubrics assessing progress along developmental successions."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:comment "Demonstration that unrelated constructs do not correlate with the target measure."@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:comment "An extended written response question testing complex cognitive objectives."@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Essay Question"@en .

ea:Examiner a owl:Class ;
    rdfs:label "Examiner"@en ;
    rdfs:comment "An individual judging student performance."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Grader"@en,
        "Rater"@en,
        "Scorer"@en .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:comment "Assessment set by an external governing body and marked by independent personnel."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasOriginCategory ;
                        owl:someValuesFrom ea:ExternalSource ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "The subjective appearance of whether a test looks valid to untrained observers."@en ;
    rdfs:subClassOf ea:Validity .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:comment "An item requiring recall of a specific term with or without a word bank."@en ;
    rdfs:subClassOf ea:TestItem .

ea:FinalExamination a owl:Class ;
    rdfs:label "Final Examination"@en ;
    rdfs:comment "A comprehensive test or greater form of unit test given at the conclusion of a course."@en ;
    rdfs:subClassOf ea:UnitTest ;
    skos:altLabel "Final Exam"@en,
        "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:comment "Assessment typically implying a written document, yielding numerical scores or grades based on student performance."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:FormalEvaluation ] ) ] .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "In-process evaluations of student learning conducted during instruction to modify teaching and learning activities and provide ongoing qualitative feedback."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en .

ea:FormativeFeedback a owl:Class ;
    rdfs:label "Formative Feedback"@en ;
    rdfs:comment "Qualitative in-process guidance focusing on details of learning."@en ;
    rdfs:subClassOf ea:Feedback .

ea:FormulaScoring a owl:Class ;
    rdfs:label "Formula Scoring"@en ;
    rdfs:comment "Correction method negating guessing effects by deducting marks for wrong answers."@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:GoverningBody a owl:Class ;
    rdfs:label "Governing Body"@en ;
    rdfs:comment "An external agency setting educational standards or licensing tests."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Examination Board"@en,
        "Test Provider"@en .

ea:GradingCurve a owl:Class ;
    rdfs:label "Grading Curve"@en ;
    rdfs:comment "A method of relative grading mapping scores onto a pre-specified distribution."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Bell Curve"@en,
        "Curved Grading"@en .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:comment "An assessment used to make major, consequential decisions about individuals, educators, or institutions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:HighStakes ] ) ] ;
    skos:altLabel "High-Stakes Test"@en .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "A rubric providing an overall rating for work as an integrated entity."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric .

ea:HumanScoring a owl:Class ;
    rdfs:label "Human Scoring"@en ;
    rdfs:comment "Evaluation and mark assignment conducted by human evaluators."@en ;
    rdfs:subClassOf ea:ScoringMethod .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:comment "Casual evaluation (e.g. observation, checklists) that does not contribute to a final course grade."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:InformalEvaluation ] ) ] .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended Learning Outcome"@en ;
    rdfs:comment "Pre-planned educational aims aligned with instructional activities."@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:comment "Degree of agreement among independent raters scoring the same work."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Observer Reliability"@en,
        "Inter-Rater Agreement"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Periodic evaluation used to determine if students are on track. Note: corpus reports ongoing debate on whether interim assessments are formative or summative."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en,
        "Benchmark Test"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:comment "Assessment set and marked by the school/teachers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasOriginCategory ;
                        owl:someValuesFrom ea:InternalSource ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International Comparison Test"@en ;
    rdfs:comment "A test administered to representative student samples across nations (e.g. PISA, TIMSS)."@en ;
    rdfs:subClassOf ea:StandardizedTest .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:comment "Assessment comparing present performance against prior performance within the same individual."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] ;
    skos:altLabel "Forced-Choice Assessment"@en .

ea:ItemBank a owl:Class ;
    rdfs:label "Item Bank"@en ;
    rdfs:comment "A repository of calibrated and stored assessment items."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Test Bank"@en .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:comment "An assessment carrying no significant external or public consequences, usually measuring formative progress."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:LowStakes ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:comment "An objective item pairing items from two parallel lists."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MathematicsQuestion a owl:Class ;
    rdfs:label "Mathematics Question"@en ;
    rdfs:comment "A problem-solving question requiring freehand steps and calculations."@en ;
    rdfs:subClassOf ea:TestItem ;
    skos:altLabel "Calculation Question"@en .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured Learning Outcome"@en ;
    rdfs:comment "Outcomes empirically evaluated through assessment tasks."@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:MidtermExamination a owl:Class ;
    rdfs:label "Midterm Examination"@en ;
    rdfs:comment "An exam administered near the middle of an academic term; can be formative or summative."@en ;
    rdfs:subClassOf ea:Test .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple Response Item"@en ;
    rdfs:comment "An objective item in which more than one option is keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:Key ;
                        owl:onProperty ea:hasKey ] ) ] .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    rdfs:comment "A test where different conditions, questions, or evaluations are applied across test takers."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:NonStandardizedFormat ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "A form of questioning that has a single correct answer. Note tension: some theorists argue objective assessment does not exist due to inherent design biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:ObjectiveEvaluation ] ) ] .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:label "One-Best-Answer Item"@en ;
    rdfs:comment "A multiple choice item requiring selection of a single best response."@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:comment "A test administered verbally."@en ;
    rdfs:subClassOf ea:Test .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel-Forms Reliability"@en ;
    rdfs:comment "Consistency of examinee performance on equivalent alternate test forms."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Alternate-Forms Reliability"@en,
        "Form Equivalence"@en,
        "Inter-Method Reliability"@en .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "An assessment conducted before instruction or intervention to establish a baseline or place students according to prior achievement or characteristics."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:comment "A test requiring candidates to demonstrate or perform a set of physical, technical, or applied skills."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Performance Test"@en .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Correlation between test scores and criterion performance measured at a future date."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:Proctor a owl:Class ;
    rdfs:label "Proctor"@en ;
    rdfs:comment "An agent monitoring testing environments to provide instructions and prevent cheating."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Invigilator"@en .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological Test"@en ;
    rdfs:comment "A standardized test measuring cognitive, emotional, developmental, or social characteristics."@en ;
    rdfs:subClassOf ea:Test .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:comment "A brief assessment covering a small amount of instructional material."@en ;
    rdfs:subClassOf ea:Test .

ea:RaschModel a owl:Class ;
    rdfs:label "Rasch Model"@en ;
    rdfs:comment "A measurement model establishing correspondence between total score and scale locations."@en ;
    rdfs:subClassOf ea:ItemResponseTheory .

ea:RawScore a owl:Class ;
    rdfs:label "Raw Score"@en ;
    rdfs:comment "The initial unadjusted count of correct points obtained on a test."@en ;
    rdfs:subClassOf ea:Score .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score Inflation"@en ;
    rdfs:comment "Increases in test scores that do not reflect genuine improvements in student learning."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Grade Inflation"@en .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "An assessment used to determine whether students may need specialized assistance or are ready to begin an academic program."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short Answer Item"@en ;
    rdfs:comment "A brief constructed-response item."@en ;
    rdfs:subClassOf ea:FreeResponseItem .

ea:Student a owl:Class ;
    rdfs:label "Student"@en ;
    rdfs:comment "An individual undergoing assessment or instruction."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Candidate"@en,
        "Learner"@en,
        "Test Taker"@en .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "A form of questioning that may have more than one correct answer or expression of the correct answer."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:SubjectiveEvaluation ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "An assessment carried out at the conclusion of an instructional period to summarize learning and evaluate student competence against standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en,
        "Evaluative Assessment"@en .

ea:Teacher a owl:Class ;
    rdfs:label "Teacher"@en ;
    rdfs:comment "A professional responsible for instruction and classroom-level assessment."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Educator"@en,
        "Instructor"@en .

ea:TeachingToTheTest a owl:Class ;
    rdfs:label "Teaching to the Test"@en ;
    rdfs:comment "Narrowing curriculum and instruction to focus exclusively on material expected on an upcoming exam."@en ;
    rdfs:subClassOf owl:Thing .

ea:TestAnxiety a owl:Class ;
    rdfs:label "Test Anxiety"@en ;
    rdfs:comment "Nervousness and reduced focus experienced by test takers when being evaluated."@en ;
    rdfs:subClassOf owl:Thing .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:comment "Consistency of scores across separate test administrations under identical conditions."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:comment "Holistic scoring training raters against distinct traits before deciding a single final mark."@en ;
    rdfs:subClassOf ea:HolisticScoring .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:comment "A binary choice objective item."@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended Learning Outcome"@en ;
    rdfs:comment "Beneficial or unpredicted outcomes that were neither planned nor sought."@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical algorithms using test scores to isolate teacher contributions to student progress."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Growth Measure"@en,
        "VAM"@en .

ea:ValueAddedScore a owl:Class ;
    rdfs:label "Value-Added Score"@en ;
    rdfs:comment "A score quantifying an individual teacher's statistical contribution to student learning growth."@en ;
    rdfs:subClassOf ea:Score .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "A test administered on paper or computer as an electronic examination."@en ;
    rdfs:subClassOf ea:Test .

ea:hasCronbachAlpha a owl:DatatypeProperty ;
    rdfs:label "has Cronbach's alpha"@en ;
    rdfs:domain ea:InternalConsistencyReliability ;
    rdfs:range xsd:decimal .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasCutScoreValue a owl:DatatypeProperty ;
    rdfs:label "has cut score value"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasDeliveryFormat a owl:ObjectProperty ;
    rdfs:label "has delivery format"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:DeliveryFormat ;
    owl:inverseOf ea:isDeliveryFormatOf .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback ;
    owl:inverseOf ea:isFeedbackOf .

ea:hasGradedStatus a owl:DatatypeProperty ;
    rdfs:label "has graded status"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:boolean .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasLearningStandard a owl:ObjectProperty ;
    rdfs:label "has learning standard"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningStandard ;
    owl:inverseOf ea:isLearningStandardOf .

ea:hasMeasurementError a owl:ObjectProperty ;
    rdfs:label "has measurement error"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementError ;
    owl:inverseOf ea:isMeasurementErrorOf .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasObservedScoreValue a owl:DatatypeProperty ;
    rdfs:label "has observed score value"@en ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range xsd:decimal .

ea:hasOption a owl:ObjectProperty ;
    rdfs:label "has option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Option ;
    owl:inverseOf ea:isOptionOf .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    rdfs:subPropertyOf ea:hasQualityAttribute ;
    owl:inverseOf ea:isReliabilityOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasScoringMethod a owl:ObjectProperty ;
    rdfs:label "has scoring method"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringMethod ;
    owl:inverseOf ea:isScoringMethodOf .

ea:hasTestItem a owl:ObjectProperty ;
    rdfs:label "has test item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestItem ;
    owl:inverseOf ea:isTestItemOf .

ea:hasTrueScoreValue a owl:DatatypeProperty ;
    rdfs:label "has true score value"@en ;
    rdfs:domain ea:TrueScore ;
    rdfs:range xsd:decimal .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity ;
    rdfs:subPropertyOf ea:hasQualityAttribute ;
    owl:inverseOf ea:isValidityOf .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:comment "Scoring based on independent criterion-by-criterion evaluations summed for a final mark."@en ;
    rdfs:subClassOf ea:ScoringMethod ;
    skos:altLabel "Analytic Grading"@en .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:comment "Scoring that approaches student work as an integrated whole rather than counting component errors."@en ;
    rdfs:subClassOf ea:ScoringMethod ;
    owl:disjointWith ea:AnalyticScoring ;
    skos:altLabel "Holistic Grading"@en,
        "Nonreductionist Grading"@en .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:comment "Consistency of results across items within a single test."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Internal Consistency"@en .

ea:ItemResponseTheory a owl:Class ;
    rdfs:label "Item Response Theory"@en ;
    rdfs:comment "Psychometric models estimating latent trait parameters from item response patterns."@en ;
    rdfs:subClassOf ea:MeasurementTheory .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed Score"@en ;
    rdfs:comment "The actual attained test score X composed of true score and measurement error."@en ;
    rdfs:subClassOf ea:Score .

ea:OralDelivery a owl:Class ;
    rdfs:label "Oral Delivery"@en ;
    rdfs:subClassOf ea:DeliveryFormat .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:comment "An assessment requiring students to complete complex, real-world tasks yielding products or performances."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Performance-Based Assessment"@en .

ea:PracticalDelivery a owl:Class ;
    rdfs:label "Practical Delivery"@en ;
    rdfs:subClassOf ea:DeliveryFormat .

ea:RandomError a owl:Class ;
    rdfs:label "Random Error"@en ;
    rdfs:comment "Uncorrelated error acting as a random variable with mean zero."@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:SystematicError a owl:Class ;
    rdfs:label "Systematic Error"@en ;
    rdfs:comment "Consistent or biased deviation in observed measurements."@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:TrueScore a owl:Class ;
    rdfs:label "True Score"@en ;
    rdfs:comment "The replicable feature T of candidate performance in the absence of measurement error."@en ;
    rdfs:subClassOf ea:Score .

ea:UnitTest a owl:Class ;
    rdfs:label "Unit Test"@en ;
    rdfs:comment "A test evaluating learning over an instructional unit."@en ;
    rdfs:subClassOf ea:Test .

ea:WrittenDelivery a owl:Class ;
    rdfs:label "Written Delivery"@en ;
    rdfs:subClassOf ea:DeliveryFormat .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Distractor ;
    owl:inverseOf ea:isDistractorOf .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Stem ;
    owl:inverseOf ea:isStemOf .

ea:hasStudentPortfolio a owl:ObjectProperty ;
    rdfs:label "has student portfolio"@en ;
    rdfs:domain ea:PortfolioAssessment ;
    rdfs:range ea:StudentPortfolio ;
    owl:inverseOf ea:isStudentPortfolioOf .

ea:isCutScoreOf a owl:ObjectProperty ;
    rdfs:label "is cut score of"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range ea:Assessment .

ea:isDeliveryFormatOf a owl:ObjectProperty ;
    rdfs:label "is delivery format of"@en ;
    rdfs:domain ea:DeliveryFormat ;
    rdfs:range ea:Assessment .

ea:isDistractorOf a owl:ObjectProperty ;
    rdfs:label "is distractor of"@en ;
    rdfs:domain ea:Distractor ;
    rdfs:range ea:MultipleChoiceItem .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is feedback of"@en ;
    rdfs:domain ea:Feedback ;
    rdfs:range ea:Assessment .

ea:isFormalityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is formality category of"@en ;
    rdfs:domain ea:FormalityCategory ;
    rdfs:range ea:Assessment .

ea:isKeyOf a owl:ObjectProperty ;
    rdfs:label "is key of"@en ;
    rdfs:domain ea:Key ;
    rdfs:range ea:ObjectiveItem .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment .

ea:isLearningStandardOf a owl:ObjectProperty ;
    rdfs:label "is learning standard of"@en ;
    rdfs:domain ea:LearningStandard ;
    rdfs:range ea:Assessment .

ea:isMeasurementErrorOf a owl:ObjectProperty ;
    rdfs:label "is measurement error of"@en ;
    rdfs:domain ea:MeasurementError ;
    rdfs:range ea:Assessment .

ea:isNormGroupOf a owl:ObjectProperty ;
    rdfs:label "is norm group of"@en ;
    rdfs:domain ea:NormGroup ;
    rdfs:range ea:NormReferencedAssessment .

ea:isObjectivityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is objectivity category of"@en ;
    rdfs:domain ea:ObjectivityCategory ;
    rdfs:range ea:Assessment .

ea:isOptionOf a owl:ObjectProperty ;
    rdfs:label "is option of"@en ;
    rdfs:domain ea:Option ;
    rdfs:range ea:MultipleChoiceItem .

ea:isOriginCategoryOf a owl:ObjectProperty ;
    rdfs:label "is origin category of"@en ;
    rdfs:domain ea:OriginCategory ;
    rdfs:range ea:Assessment .

ea:isPurposeOf a owl:ObjectProperty ;
    rdfs:label "is purpose of"@en ;
    rdfs:domain ea:PurposeCategory ;
    rdfs:range ea:Assessment .

ea:isQualityAttributeOf a owl:ObjectProperty ;
    rdfs:label "is quality attribute of"@en ;
    rdfs:domain ea:QualityAttribute ;
    rdfs:range ea:Assessment .

ea:isReferencingFrameworkOf a owl:ObjectProperty ;
    rdfs:label "is referencing framework of"@en ;
    rdfs:domain ea:ReferencingFramework ;
    rdfs:range ea:Assessment .

ea:isReliabilityOf a owl:ObjectProperty ;
    rdfs:label "is reliability of"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:Assessment .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment .

ea:isScoringMethodOf a owl:ObjectProperty ;
    rdfs:label "is scoring method of"@en ;
    rdfs:domain ea:ScoringMethod ;
    rdfs:range ea:Assessment .

ea:isStakesCategoryOf a owl:ObjectProperty ;
    rdfs:label "is stakes category of"@en ;
    rdfs:domain ea:StakesCategory ;
    rdfs:range ea:Assessment .

ea:isStandardizationCategoryOf a owl:ObjectProperty ;
    rdfs:label "is standardization category of"@en ;
    rdfs:domain ea:StandardizationCategory ;
    rdfs:range ea:Assessment .

ea:isStemOf a owl:ObjectProperty ;
    rdfs:label "is stem of"@en ;
    rdfs:domain ea:Stem ;
    rdfs:range ea:MultipleChoiceItem .

ea:isStudentPortfolioOf a owl:ObjectProperty ;
    rdfs:label "is student portfolio of"@en ;
    rdfs:domain ea:StudentPortfolio ;
    rdfs:range ea:PortfolioAssessment .

ea:isTestItemOf a owl:ObjectProperty ;
    rdfs:label "is test item of"@en ;
    rdfs:domain ea:TestItem ;
    rdfs:range ea:Assessment .

ea:isValidityOf a owl:ObjectProperty ;
    rdfs:label "is validity of"@en ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:Assessment .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "A rubric evaluating distinct dimensions or traits separately."@en ;
    rdfs:subClassOf ea:Rubric .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "The degree to which a test operationalizes and reflects the intended theoretical construct. Tension in corpus: modern theory defines construct validity as overarching and subsuming content and criterion validity, whereas other passages present them as coordinate types."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "The extent to which scores correlate with an external criterion variable."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:ExternalSource a owl:Class ;
    rdfs:label "External Source"@en ;
    rdfs:subClassOf ea:OriginCategory .

ea:FormalEvaluation a owl:Class ;
    rdfs:label "Formal Evaluation"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:FreeResponseItem a owl:Class ;
    rdfs:label "Free Response Item"@en ;
    rdfs:comment "An item requiring test takers to formulate and write their own prose response."@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "FRQ"@en,
        "Free Response Question"@en,
        "Open-Ended Question"@en .

ea:HighStakes a owl:Class ;
    rdfs:label "High Stakes"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalEvaluation a owl:Class ;
    rdfs:label "Informal Evaluation"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:InternalSource a owl:Class ;
    rdfs:label "Internal Source"@en ;
    rdfs:subClassOf ea:OriginCategory .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ItemComponent a owl:Class ;
    rdfs:label "Item Component"@en ;
    rdfs:comment "Structural constituent of a test item."@en ;
    rdfs:subClassOf owl:Thing .

ea:LearningStandard a owl:Class ;
    rdfs:label "Learning Standard"@en ;
    rdfs:comment "Concise, written descriptions of what students are expected to know and do."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Performance Standard"@en .

ea:LowStakes a owl:Class ;
    rdfs:label "Low Stakes"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:MeasurementTheory a owl:Class ;
    rdfs:label "Measurement Theory"@en ;
    rdfs:comment "Theoretical frameworks explaining test score variance and item performance."@en ;
    rdfs:subClassOf owl:Thing .

ea:NonStandardizedFormat a owl:Class ;
    rdfs:label "Non-Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:comment "A statistically selected reference sample against which norm-referenced test takers are compared."@en ;
    rdfs:subClassOf ea:EducationalAgent ;
    skos:altLabel "Norming Group"@en .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:comment "Assessment designed to rank test takers in relation to one another or a representative norming group."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "NRT"@en,
        "Norm-Referenced Test"@en,
        "Normative Assessment"@en .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ObjectiveEvaluation a owl:Class ;
    rdfs:label "Objective Evaluation"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:PortfolioAssessment a owl:Class ;
    rdfs:label "Portfolio Assessment"@en ;
    rdfs:comment "An assessment based on collections of student work evaluating learning progress and achievement over time."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStudentPortfolio ;
                        owl:someValuesFrom ea:StudentPortfolio ] ) ] ;
    skos:altLabel "Portfolio-Based Assessment"@en .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedFormat a owl:Class ;
    rdfs:label "Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:comment "A test administered and scored in a predetermined, standard, and consistent manner across test takers."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:StandardizedFormat ] ) ] .

ea:SubjectiveEvaluation a owl:Class ;
    rdfs:label "Subjective Evaluation"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "An item format allowing extended or open-ended responses requiring evaluator interpretation."@en ;
    rdfs:subClassOf ea:TestItem .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:hasFormalityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory ;
    owl:inverseOf ea:isFormalityCategoryOf .

ea:hasKey a owl:ObjectProperty ;
    rdfs:label "has key"@en ;
    rdfs:domain ea:ObjectiveItem ;
    rdfs:range ea:Key ;
    owl:inverseOf ea:isKeyOf .

ea:hasObjectivityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has objectivity category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory ;
    owl:inverseOf ea:isObjectivityCategoryOf .

ea:hasOriginCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has origin category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:OriginCategory ;
    owl:inverseOf ea:isOriginCategoryOf .

ea:hasQualityAttribute a owl:ObjectProperty ;
    rdfs:label "has quality attribute"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:QualityAttribute ;
    owl:inverseOf ea:isQualityAttributeOf .

ea:hasStakesCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory ;
    owl:inverseOf ea:isStakesCategoryOf .

ea:hasStandardizationCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationCategory ;
    owl:inverseOf ea:isStandardizationCategoryOf .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    rdfs:comment "A predetermined score threshold defining passing or proficiency levels."@en ;
    rdfs:subClassOf ea:Score ;
    skos:altLabel "Cutoff Score"@en,
        "Passing Score"@en .

ea:Stem a owl:Class ;
    rdfs:label "Stem"@en ;
    rdfs:comment "The opening problem, question, or prompt of an item."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:comment "A compilation of academic work and educational evidence collected over time."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Digital Portfolio"@en,
        "E-Portfolio"@en .

ea:hasReferencingFramework a owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework ;
    owl:inverseOf ea:isReferencingFrameworkOf .

ea:Distractor a owl:Class ;
    rdfs:label "Distractor"@en ;
    rdfs:comment "An incorrect option designed to be plausible."@en ;
    rdfs:subClassOf ea:Option .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "Information provided to a learner regarding performance to modify learning."@en ;
    rdfs:subClassOf owl:Thing .

ea:FormalityCategory a owl:Class ;
    rdfs:label "Formality Category"@en ;
    rdfs:comment "The reified axis of assessment formality."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:FormalEvaluation ea:InformalEvaluation ) .

ea:Key a owl:Class ;
    rdfs:label "Key"@en ;
    rdfs:comment "The designated correct option."@en ;
    rdfs:subClassOf ea:Option ;
    owl:disjointWith ea:Distractor .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:comment "Discrepancy between observed test scores and corresponding true scores."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:RandomError ea:SystematicError ) .

ea:ObjectivityCategory a owl:Class ;
    rdfs:label "Objectivity Category"@en ;
    rdfs:comment "The reified axis of assessment objectivity based on question response structure."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:ObjectiveEvaluation ea:SubjectiveEvaluation ) .

ea:Option a owl:Class ;
    rdfs:label "Option"@en ;
    rdfs:comment "A selectable answer choice in an item."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:OriginCategory a owl:Class ;
    rdfs:label "Origin Category"@en ;
    rdfs:comment "The setting and marking source of an assessment."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:InternalSource ea:ExternalSource ) .

ea:QualityAttribute a owl:Class ;
    rdfs:label "Quality Attribute"@en ;
    rdfs:comment "Psychometric attribute indicating the technical adequacy of an assessment."@en ;
    rdfs:subClassOf owl:Thing .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide containing evaluative criteria, quality definitions, and scoring strategies."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Scoring Guide"@en .

ea:StakesCategory a owl:Class ;
    rdfs:label "Stakes Category"@en ;
    rdfs:comment "The level of consequence associated with assessment outcomes."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:label "Standardization Category"@en ;
    rdfs:comment "The consistency of administration and scoring procedures."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:StandardizedFormat ea:NonStandardizedFormat ) .

ea:DeliveryFormat a owl:Class ;
    rdfs:label "Delivery Format"@en ;
    rdfs:comment "The physical or operational medium through which a test is administered."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:WrittenDelivery ea:OralDelivery ea:PracticalDelivery ) .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "Statements specifying what learners should be able to do by the end of instruction."@en ;
    rdfs:subClassOf owl:Thing .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:comment "The framework against which test results or candidate performances are compared."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:Score a owl:Class ;
    rdfs:label "Score"@en ;
    rdfs:comment "The numerical or categorical result assigned to an assessment."@en ;
    rdfs:subClassOf owl:Thing .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory ;
    owl:inverseOf ea:isPurposeOf .

ea:EducationalAgent a owl:Class ;
    rdfs:label "Educational Agent"@en ;
    rdfs:comment "Participants and organizations involved in designing, administering, or taking assessments."@en ;
    rdfs:subClassOf owl:Thing .

ea:TestItem a owl:Class ;
    rdfs:label "Test Item"@en ;
    rdfs:comment "A single discrete unit of questioning or task in an assessment."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Assessment Item"@en,
        "Question"@en .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "An item format with a predetermined single or constrained set of correct answers."@en ;
    rdfs:subClassOf ea:TestItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency of measurement and freedom from measurement error across occasions."@en ;
    rdfs:subClassOf ea:QualityAttribute .

ea:ScoringMethod a owl:Class ;
    rdfs:label "Scoring Method"@en ;
    rdfs:comment "The operational protocol used to assign marks to student performances."@en ;
    rdfs:subClassOf owl:Thing .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The degree to which a tool measures what it purports to measure and supports valid inferences."@en ;
    rdfs:subClassOf ea:QualityAttribute .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item"@en ;
    rdfs:comment "An objective item with a stem, exactly one keyed correct answer, and distractors."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:onClass ea:Stem ;
                        owl:onProperty ea:hasStem ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:onClass ea:Key ;
                        owl:onProperty ea:hasKey ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass ea:Distractor ;
                        owl:onProperty ea:hasDistractor ] ) ] ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en .

ea:PurposeCategory a owl:Class ;
    rdfs:label "Purpose Category"@en ;
    rdfs:comment "The value-partition class representing the reified operational purpose of an educational assessment."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ea:ScreeningPurpose ea:InterimPurpose ) .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification in other topics."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

