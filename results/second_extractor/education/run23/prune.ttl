@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Domain Ontology"@en ;
    rdfs:comment "An OWL ontology comprehensively modeling the educational assessment domain strictly derived from the provided corpus."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:comment "A backward-looking test designed to measure knowledge and skills already learned in school."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:BackwardLooking ] ) ] .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:comment "A forward-looking test designed to forecast potential or predict success in future endeavors."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:ForwardLooking ] ) ] .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:comment "Measurement of accomplishments within a realistic, practical context relevant outside the school setting."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CapstonePortfolio a owl:Class ;
    rdfs:label "Capstone Portfolio"@en ;
    rdfs:comment "A portfolio assembled at the culmination of a school level or multiyear project."@en ;
    rdfs:subClassOf ea:StudentPortfolio .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College Admissions Test"@en ;
    rdfs:comment "A standardized test used in the process of deciding postsecondary admission (e.g. SAT, ACT)."@en ;
    rdfs:subClassOf ea:StandardizedAssessment .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common Assessment"@en ;
    rdfs:comment "Assessments collaboratively developed and shared across classrooms, grade levels, or departments to ensure consistency in evaluation."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "Norm-referenced, high-stakes test in which candidates are ranked to select a fixed top number of candidates."@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ea:HighStakesAssessment ) ] ;
    skos:altLabel "Competitive Exam"@en .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment requiring a rubric and an expert examiner due to format implicitness (e.g. final year project thesis)."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] ) ] .

ea:ComputerBasedAssessment a owl:Class ;
    rdfs:label "Computer-Based Assessment"@en ;
    rdfs:comment "An assessment administered and scored via computers or online networks."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Computer-Adaptive Test"@en,
        "Online Assessment"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "An examination approach that evaluates a student's progress throughout a prescribed course as an alternative to final exams."@en ;
    rdfs:subClassOf ea:Assessment .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytical rubrics supporting transformative learning across developmental stages."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment"@en ;
    rdfs:comment "Passage 2 and Passage 3 list Diagnostic Assessment as a coordinate category alongside placement, formative, and summative assessments. However, later passages explicitly state that 'a common form of formative assessment is diagnostic assessment'. Both claims are modeled: DiagnosticPurpose is subordinated under FormativePurpose, making DiagnosticAssessment a subclass of FormativeAssessment while acknowledging its coordinate enumeration in Passage 2."@en ;
    rdfs:subClassOf ea:FormativeAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "Diagnostic Evaluation"@en,
        "Diagnostic Testing"@en .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:comment "Assessment set by an outside governing body or board and scored by independent personnel."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentOrigin ;
                        owl:someValuesFrom ea:ExternalOrigin ] ) ] .

ea:FinalExamination a owl:Class ;
    rdfs:label "Final Examination"@en ;
    rdfs:comment "A summative exam given at the end of a degree course or term covering the topics addressed."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:comment "Assessment usually documented in writing and assigned a numerical score or grade contributing to the permanent record."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityLevel ;
                        owl:someValuesFrom ea:FormalFormality ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:comment "An assessment asking those being assessed to consider themselves in hypothetical future situations."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientation ;
                        owl:someValuesFrom ea:ForwardLooking ] ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "A rubric providing an overall rating for a work, considering all aspects collectively."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:comment "Casual assessment that does not contribute to a final course grade (e.g. checklists, observations, discussions)."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityLevel ;
                        owl:someValuesFrom ea:InformalFormality ] ) ] .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Periodic assessment to monitor student progress toward standards; debated as having formative and/or summative functions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en,
        "Benchmark Test"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:comment "Assessment set and marked by the school/teachers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentOrigin ;
                        owl:someValuesFrom ea:InternalOrigin ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International Comparison Test"@en ;
    rdfs:comment "Periodic assessment administered across countries to monitor trends and compare performance (e.g. PISA, TIMSS, PIRLS)."@en ;
    rdfs:subClassOf ea:StandardizedAssessment .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:comment "Assessment comparing present performance against the candidate's own previous performance over time or across internal domains."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingApproach ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] ;
    skos:altLabel "Forced-Choice Assessment"@en,
        "Ipsative Measure"@en .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:comment "An assessment carrying no major public consequences, typically used for classroom feedback."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakes ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en .

ea:MidtermExamination a owl:Class ;
    rdfs:label "Midterm Examination"@en ;
    rdfs:comment "An exam given near the middle of an academic term, which may function as formative or summative assessment."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Midterm Exam"@en .

ea:NonStandardizedAssessment a owl:Class ;
    rdfs:label "Non-Standardized Assessment"@en ;
    rdfs:comment "An assessment where questions, administration conditions, or evaluation standards vary among candidates."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:NonStandardizedStatus ] ) ] ;
    skos:altLabel "Non-Standardized Test"@en .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "Assessment questioning that has a single correct answer. Note that critics argue that no assessment is entirely objective due to inherent cultural and selection biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:ObjectiveScoring ] ) ] .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:comment "A test administered verbally."@en ;
    rdfs:subClassOf ea:Test .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    rdfs:comment "An assessment conducted by student peers providing feedback on student work."@en ;
    rdfs:subClassOf ea:Assessment .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:label "Physical Portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio ;
    owl:disjointWith ea:DigitalPortfolio .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "Assessment conducted before instruction to establish a baseline or place students into appropriate instructional points."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:comment "A test requiring a candidate to perform a set of skills or a practical demonstration."@en ;
    rdfs:subClassOf ea:Test .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological Test"@en ;
    rdfs:comment "Assessment measuring cognitive abilities, mental, emotional, developmental, or social characteristics (e.g. IQ tests)."@en ;
    rdfs:subClassOf ea:Assessment .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:comment "A brief assessment covering a small amount of material, often used formatively."@en ;
    rdfs:subClassOf ea:Test .

ea:RaterRelatedFactor a owl:Class ;
    rdfs:label "Rater-Related Factor"@en ;
    rdfs:comment "Subjectivity, bias, and scoring variation between evaluators."@en ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "Assessment used to determine whether students need specialized assistance, special education services, or readiness for a program."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] ;
    skos:altLabel "Developmental Screening Test"@en .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self-Assessment"@en ;
    rdfs:comment "An assessment in which students assess themselves, often functioning as a diagnostic or formative tool."@en ;
    rdfs:subClassOf ea:Assessment .

ea:StudentRelatedFactor a owl:Class ;
    rdfs:label "Student-Related Factor"@en ;
    rdfs:comment "Personal characteristics such as fatigue, health, motivation, and anxiety."@en ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "Assessment questioning that may have more than one correct answer or more than one way of expressing it."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:SubjectiveScoring ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "Evaluative assessment given at the conclusion of an instructional period to judge learning outcomes and program efficacy."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en,
        "Summative Evaluation"@en .

ea:TestAdministrationFactor a owl:Class ;
    rdfs:label "Test Administration Factor"@en ;
    rdfs:comment "Conditions of testing including distractions and clarity of instructions."@en ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:TestRelatedFactor a owl:Class ;
    rdfs:label "Test-Related Factor"@en ;
    rdfs:comment "Item phrasing ambiguity, test length, and format characteristics."@en ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "A statistical algorithm that attempts to isolate an individual teacher's contribution to learning by controlling for student background."@en ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure ;
    owl:disjointWith ea:StudentGrowthMeasure ;
    skos:altLabel "Growth Measure"@en .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "A test administered on paper or on a computer where candidates respond by writing or typing."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "eExam"@en .

ea:hasAlphaCoefficient a owl:DatatypeProperty ;
    rdfs:label "has alpha coefficient"@en ;
    rdfs:domain ea:InternalConsistencyReliability ;
    rdfs:range xsd:decimal .

ea:hasAlternativeAnswer a owl:ObjectProperty ;
    rdfs:label "has alternative answer"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:AlternativeAnswer ;
    owl:inverseOf ea:isAlternativeAnswerOf .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isAssessmentItemOf .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasCutScoreValue a owl:DatatypeProperty ;
    rdfs:label "has cut score value"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasEvaluationStandard a owl:ObjectProperty ;
    rdfs:label "has evaluation standard"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:EvaluationStandard ;
    owl:inverseOf ea:isEvaluationStandardOf .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback ;
    owl:inverseOf ea:isFeedbackOf .

ea:hasGranularityLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has granularity level"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityLevel ;
    owl:inverseOf ea:isGranularityLevelOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasPassingPercentage a owl:DatatypeProperty ;
    rdfs:label "has passing percentage"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    owl:inverseOf ea:isReliabilityOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasReliabilityFactor a owl:ObjectProperty ;
    rdfs:label "has reliability factor"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReliabilityFactor ;
    owl:inverseOf ea:isReliabilityFactorOf .

ea:hasScoringApproach a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring approach"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringApproach ;
    owl:inverseOf ea:isScoringApproachOf .

ea:hasStandardCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standard category"@en ;
    rdfs:domain ea:EvaluationStandard ;
    rdfs:range ea:StandardCategory ;
    owl:inverseOf ea:isStandardCategoryOf .

ea:hasTeacherEvaluationMeasure a owl:ObjectProperty ;
    rdfs:label "has teacher evaluation measure"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TeacherEvaluationMeasure ;
    owl:inverseOf ea:isTeacherEvaluationMeasureOf .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity ;
    owl:inverseOf ea:isValidityOf .

skos:altLabel a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

ea:AcademicProgramGranularity a owl:Class ;
    rdfs:label "Academic Program Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:AccuracyCategory a owl:Class ;
    rdfs:label "Accuracy Category"@en ;
    rdfs:comment "Category under which reliability and validity standards are established."@en ;
    rdfs:subClassOf ea:StandardCategory .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:comment "Grading involving criterion-by-criterion independent judgments added up for a final score."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "Analytic Grading"@en .

ea:AppropriatenessCategory a owl:Class ;
    rdfs:label "Appropriateness Category"@en ;
    rdfs:subClassOf ea:StandardCategory .

ea:CalculationItem a owl:Class ;
    rdfs:label "Calculation Item"@en ;
    rdfs:comment "A problem requiring a freehand response where marks are awarded for intermediate steps."@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Mathematics Question"@en .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Criterion validity where predictor test and criterion data are gathered at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:comment "Validity addressing the consequences, ethical uses, and educational impact of score use."@en ;
    rdfs:subClassOf ea:Validity .

ea:ConsistencyFactor a owl:Class ;
    rdfs:label "Consistency Factor"@en ;
    rdfs:comment "Stable characteristics of the candidate or attribute being measured (True Score component)."@en ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "Systematic examination of test content to determine whether it covers a representative sample of the domain."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en,
        "Subject-Matter Validity"@en .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:comment "Degree to which two measures of constructs that theoretically should be related are related."@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:label "Course Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:DemonstrationFormat a owl:Class ;
    rdfs:label "Demonstration Format"@en ;
    rdfs:comment "A live demonstration such as a speech, athletic skill, musical recital, or reading."@en ;
    rdfs:subClassOf ea:PerformanceFormat .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:comment "Purpose focusing on identifying learning difficulties, deficiencies, or current knowledge to plan instruction."@en ;
    rdfs:subClassOf ea:FormativePurpose .

ea:DigitalPortfolio a owl:Class ;
    rdfs:label "Digital Portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio ;
    skos:altLabel "Online Portfolio"@en,
        "e-Portfolio"@en .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:comment "Degree to which concepts or measurements that are supposed to be unrelated are unrelated."@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:comment "An item requiring an extended written prose response evaluated on content and composition."@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Essay Question"@en .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended Response Item"@en ;
    rdfs:comment "An item requiring a detailed constructed response."@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "Superficial appearance of whether a test appears to measure its target construct to non-experts."@en ;
    rdfs:subClassOf ea:Validity .

ea:FeasibilityCategory a owl:Class ;
    rdfs:label "Feasibility Category"@en ;
    rdfs:subClassOf ea:StandardCategory .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Ongoing in-process evaluation conducted during learning to provide feedback and modify instruction."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en,
        "Formative Evaluation"@en,
        "Formative Feedback"@en .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:comment "An assessment carrying important consequences, rewards, or penalties for examinees, teachers, or institutions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakes ] ) ] ;
    skos:altLabel "High-Stakes Test"@en .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:comment "Grading that bases a mark on overall quality, treating work as an integrated entity."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "General Impression"@en,
        "Holistic Grading"@en,
        "Nonreductionist Grading"@en .

ea:IndividualLearnerGranularity a owl:Class ;
    rdfs:label "Individual Learner Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:InstitutionGranularity a owl:Class ;
    rdfs:label "Institution Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Aim"@en .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:comment "Degree of agreement among independent raters assessing the same performance."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Observer Reliability"@en,
        "Inter-Rater Agreement"@en,
        "Inter-Rater Concordance"@en,
        "Rater Reliability"@en .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:label "Learning Community Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:comment "An objective item requiring pairing of prompts with options."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Objective"@en .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple Response Item"@en ;
    rdfs:comment "An item where more than one option is keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:cardinality 1 ;
                        owl:onProperty ea:hasStem ] [ a owl:Restriction ;
                        owl:minCardinality 2 ;
                        owl:onProperty ea:hasAnswerKey ] ) ] .

ea:NoWordBankFillInTheBlankItem a owl:Class ;
    rdfs:label "No Word Bank Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:FillInTheBlankItem .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:label "One Best Answer Item"@en ;
    rdfs:comment "A multiple choice item requiring selection of the single best response from several options."@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel Forms Reliability"@en ;
    rdfs:comment "Equivalence of examinee performance on different test forms based on identical content specifications."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Alternate-Forms Reliability"@en,
        "Form Equivalence"@en,
        "Inter-Method Reliability"@en .

ea:PersonnelEvaluationStandard a owl:Class ;
    rdfs:label "Personnel Evaluation Standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Criterion validity where the test score predicts an outcome assessed at a later point in time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductFormat a owl:Class ;
    rdfs:label "Product Format"@en ;
    rdfs:comment "A tangible artifact such as a painting, portfolio, paper, or exhibition."@en ;
    rdfs:subClassOf ea:PerformanceFormat .

ea:ProgramEvaluationStandard a owl:Class ;
    rdfs:label "Program Evaluation Standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:RandomError a owl:Class ;
    rdfs:label "Random Error"@en ;
    rdfs:comment "Errors acting as random variables with a mean of zero."@en ;
    rdfs:subClassOf ea:InconsistencyFactor .

ea:RecastFeedback a owl:Class ;
    rdfs:label "Recast Feedback"@en ;
    rdfs:comment "Subtle correction reformulating a learner's erroneous utterance."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "Motherese"@en .

ea:ScoreFeedback a owl:Class ;
    rdfs:label "Score Feedback"@en ;
    rdfs:comment "Feedback conveyed solely as a numerical grade, percentage, or letter mark."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short Answer Item"@en ;
    rdfs:comment "An item requiring a brief written answer."@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Short Answer Question"@en .

ea:StudentEvaluationStandard a owl:Class ;
    rdfs:label "Student Evaluation Standard"@en ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:label "Student Growth Measure"@en ;
    rdfs:comment "A metric quantifying student achievement gains without controlling for non-teacher demographic influences."@en ;
    rdfs:subClassOf ea:TeacherEvaluationMeasure .

ea:SystemGranularity a owl:Class ;
    rdfs:label "System Granularity"@en ;
    rdfs:subClassOf ea:GranularityLevel .

ea:SystematicError a owl:Class ;
    rdfs:label "Systematic Error"@en ;
    rdfs:comment "Consistent non-random bias in measurement."@en ;
    rdfs:subClassOf ea:InconsistencyFactor .

ea:TechnologyMediatedFeedback a owl:Class ;
    rdfs:label "Technology-Mediated Feedback"@en ;
    rdfs:comment "Automated feedback delivered rapidly by computer systems or devices (e.g. IF-AT forms)."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "Immediate Feedback"@en .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:comment "Consistency of scores across separate test administrations under identical conditions."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:comment "Scoring where raters consider individual traits on a rubric before deciding on a single holistic final score."@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:comment "A binary choice item family requiring verification of a statement."@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:UtilityCategory a owl:Class ;
    rdfs:label "Utility Category"@en ;
    rdfs:subClassOf ea:StandardCategory .

ea:VerbalFeedback a owl:Class ;
    rdfs:label "Verbal Feedback"@en ;
    rdfs:comment "Spoken comments given to learners during or following tasks."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:WordBankFillInTheBlankItem a owl:Class ;
    rdfs:label "Word Bank Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:FillInTheBlankItem .

ea:WrittenFeedback a owl:Class ;
    rdfs:label "Written Feedback"@en ;
    rdfs:comment "Written prose comments or margin annotations providing actionable guidance."@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "Anecdotal Feedback"@en .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Distractor ;
    owl:inverseOf ea:isDistractorOf .

ea:hasPerformanceFormat a owl:ObjectProperty ;
    rdfs:label "has performance format"@en ;
    rdfs:domain ea:PerformanceAssessment ;
    rdfs:range ea:PerformanceFormat ;
    owl:inverseOf ea:isPerformanceFormatOf .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasStudentPortfolio a owl:ObjectProperty ;
    rdfs:label "has student portfolio"@en ;
    rdfs:domain ea:PortfolioAssessment ;
    rdfs:range ea:StudentPortfolio ;
    owl:inverseOf ea:isStudentPortfolioOf .

ea:isAlternativeAnswerOf a owl:ObjectProperty ;
    rdfs:label "is alternative answer of"@en ;
    rdfs:domain ea:AlternativeAnswer ;
    rdfs:range ea:AssessmentItem .

ea:isAnswerKeyOf a owl:ObjectProperty ;
    rdfs:label "is answer key of"@en ;
    rdfs:domain ea:AnswerKey ;
    rdfs:range ea:AssessmentItem .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs:label "is assessment item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Assessment .

ea:isAssessmentOriginOf a owl:ObjectProperty ;
    rdfs:label "is assessment origin of"@en ;
    rdfs:domain ea:AssessmentOrigin ;
    rdfs:range ea:Assessment .

ea:isAssessmentPurposeOf a owl:ObjectProperty ;
    rdfs:label "is assessment purpose of"@en ;
    rdfs:domain ea:AssessmentPurpose ;
    rdfs:range ea:Assessment .

ea:isCutScoreOf a owl:ObjectProperty ;
    rdfs:label "is cut score of"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range ea:CriterionReferencedAssessment .

ea:isDistractorOf a owl:ObjectProperty ;
    rdfs:label "is distractor of"@en ;
    rdfs:domain ea:Distractor ;
    rdfs:range ea:AssessmentItem .

ea:isEvaluationStandardOf a owl:ObjectProperty ;
    rdfs:label "is evaluation standard of"@en ;
    rdfs:domain ea:EvaluationStandard ;
    rdfs:range ea:Assessment .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is feedback of"@en ;
    rdfs:domain ea:Feedback ;
    rdfs:range ea:Assessment .

ea:isFormalityLevelOf a owl:ObjectProperty ;
    rdfs:label "is formality level of"@en ;
    rdfs:domain ea:FormalityLevel ;
    rdfs:range ea:Assessment .

ea:isGranularityLevelOf a owl:ObjectProperty ;
    rdfs:label "is granularity level of"@en ;
    rdfs:domain ea:GranularityLevel ;
    rdfs:range ea:Assessment .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment .

ea:isNormGroupOf a owl:ObjectProperty ;
    rdfs:label "is norm group of"@en ;
    rdfs:domain ea:NormGroup ;
    rdfs:range ea:NormReferencedAssessment .

ea:isPerformanceFormatOf a owl:ObjectProperty ;
    rdfs:label "is performance format of"@en ;
    rdfs:domain ea:PerformanceFormat ;
    rdfs:range ea:PerformanceAssessment .

ea:isReferencingApproachOf a owl:ObjectProperty ;
    rdfs:label "is referencing approach of"@en ;
    rdfs:domain ea:ReferencingApproach ;
    rdfs:range ea:Assessment .

ea:isReliabilityFactorOf a owl:ObjectProperty ;
    rdfs:label "is reliability factor of"@en ;
    rdfs:domain ea:ReliabilityFactor ;
    rdfs:range ea:Assessment .

ea:isReliabilityOf a owl:ObjectProperty ;
    rdfs:label "is reliability of"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:Assessment .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment .

ea:isScoringApproachOf a owl:ObjectProperty ;
    rdfs:label "is scoring approach of"@en ;
    rdfs:domain ea:ScoringApproach ;
    rdfs:range ea:Assessment .

ea:isScoringObjectivityOf a owl:ObjectProperty ;
    rdfs:label "is scoring objectivity of"@en ;
    rdfs:domain ea:ScoringObjectivity ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ea:Assessment ea:AssessmentItem ) ] .

ea:isStakesLevelOf a owl:ObjectProperty ;
    rdfs:label "is stakes level of"@en ;
    rdfs:domain ea:StakesLevel ;
    rdfs:range ea:Assessment .

ea:isStandardCategoryOf a owl:ObjectProperty ;
    rdfs:label "is standard category of"@en ;
    rdfs:domain ea:StandardCategory ;
    rdfs:range ea:EvaluationStandard .

ea:isStandardizationStatusOf a owl:ObjectProperty ;
    rdfs:label "is standardization status of"@en ;
    rdfs:domain ea:StandardizationStatus ;
    rdfs:range ea:Assessment .

ea:isStemOf a owl:ObjectProperty ;
    rdfs:label "is stem of"@en ;
    rdfs:domain ea:Stem ;
    rdfs:range ea:AssessmentItem .

ea:isStudentPortfolioOf a owl:ObjectProperty ;
    rdfs:label "is student portfolio of"@en ;
    rdfs:domain ea:StudentPortfolio ;
    rdfs:range ea:PortfolioAssessment .

ea:isTeacherEvaluationMeasureOf a owl:ObjectProperty ;
    rdfs:label "is teacher evaluation measure of"@en ;
    rdfs:domain ea:TeacherEvaluationMeasure ;
    rdfs:range ea:Assessment .

ea:isTemporalOrientationOf a owl:ObjectProperty ;
    rdfs:label "is temporal orientation of"@en ;
    rdfs:domain ea:TemporalOrientation ;
    rdfs:range ea:Assessment .

ea:isValidityOf a owl:ObjectProperty ;
    rdfs:label "is validity of"@en ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:Assessment .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "A rubric evaluating various dimensions or components separately."@en ;
    rdfs:subClassOf ea:Rubric .

ea:BackwardLooking a owl:Class ;
    rdfs:label "Backward-Looking"@en ;
    rdfs:subClassOf ea:TemporalOrientation .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:comment "Assessment where performance is measured against defined criteria, learning standards, or expected behaviors rather than peers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingApproach ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "CRT"@en,
        "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en,
        "Standards-Referenced Assessment"@en .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingApproach .

ea:ExternalOrigin a owl:Class ;
    rdfs:label "External Origin"@en ;
    rdfs:subClassOf ea:AssessmentOrigin .

ea:FormalFormality a owl:Class ;
    rdfs:label "Formal Formality"@en ;
    rdfs:subClassOf ea:FormalityLevel .

ea:HighStakes a owl:Class ;
    rdfs:label "High Stakes"@en ;
    rdfs:subClassOf ea:StakesLevel .

ea:InformalFormality a owl:Class ;
    rdfs:label "Informal Formality"@en ;
    rdfs:subClassOf ea:FormalityLevel .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose ;
    skos:altLabel "Benchmark Purpose"@en .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:comment "Consistency of results across items within a test, measured via Cronbach's alpha, split-half, etc."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Internal Consistency"@en .

ea:InternalOrigin a owl:Class ;
    rdfs:label "Internal Origin"@en ;
    rdfs:subClassOf ea:AssessmentOrigin .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingApproach .

ea:ItemComponent a owl:Class ;
    rdfs:label "Item Component"@en ;
    rdfs:subClassOf owl:Thing .

ea:LowStakes a owl:Class ;
    rdfs:label "Low Stakes"@en ;
    rdfs:subClassOf ea:StakesLevel .

ea:NonStandardizedStatus a owl:Class ;
    rdfs:label "Non-Standardized Status"@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:comment "A statistically selected sample of previous test takers against whom scores are compared."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Norming Group"@en .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingApproach .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:comment "An assessment requiring examinees to perform a task, activity, or create a product demonstrating real-world application."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPerformanceFormat ;
                        owl:someValuesFrom ea:PerformanceFormat ] ) ] ;
    skos:altLabel "Performance Test"@en,
        "Performance-Based Assessment"@en .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:PortfolioAssessment a owl:Class ;
    rdfs:label "Portfolio Assessment"@en ;
    rdfs:comment "An assessment based on collections of student work assembled over time."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStudentPortfolio ;
                        owl:someValuesFrom ea:StudentPortfolio ] ) ] ;
    skos:altLabel "Portfolio-Based Assessment"@en .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:StandardizedAssessment a owl:Class ;
    rdfs:label "Standardized Assessment"@en ;
    rdfs:comment "An assessment administered and scored in a predetermined, uniform manner across all examinees."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:StandardizedStatus ] ) ] ;
    skos:altLabel "Standardized Test"@en .

ea:StandardizedStatus a owl:Class ;
    rdfs:label "Standardized Status"@en ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:hasAnswerKey a owl:ObjectProperty ;
    rdfs:label "has answer key"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:AnswerKey ;
    owl:inverseOf ea:isAnswerKeyOf .

ea:hasAssessmentOrigin a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has assessment origin"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentOrigin ;
    owl:inverseOf ea:isAssessmentOriginOf .

ea:hasFormalityLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality level"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityLevel ;
    owl:inverseOf ea:isFormalityLevelOf .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes level"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesLevel ;
    owl:inverseOf ea:isStakesLevelOf .

ea:hasStandardizationStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization status"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationStatus ;
    owl:inverseOf ea:isStandardizationStatusOf .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stem"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Stem ;
    owl:inverseOf ea:isStemOf .

ea:AnswerKey a owl:Class ;
    rdfs:label "Answer Key"@en ;
    rdfs:comment "The correct alternative answer in an item."@en ;
    rdfs:subClassOf ea:AlternativeAnswer ;
    skos:altLabel "Key"@en .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "The extent to which operationalizations measure a construct defined by a theory. The corpus notes that modern validity theory regards construct validity as overarching and subsuming all other forms of validity evidence, though classical frameworks present them as coordinate categories."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "Correlation between test scores and an outside criterion variable or outcome."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    rdfs:comment "A score threshold determining whether an examinee passes or achieves a proficiency standard."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Cutscore"@en,
        "Passing Score"@en .

ea:Distractor a owl:Class ;
    rdfs:label "Distractor"@en ;
    rdfs:comment "An incorrect alternative answer designed to be plausible."@en ;
    rdfs:subClassOf ea:AlternativeAnswer .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "Information returned to students and instructors about learning performance."@en ;
    rdfs:subClassOf owl:Thing .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:comment "An item providing identifying characteristics and requiring recall of the correct term."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:ForwardLooking a owl:Class ;
    rdfs:label "Forward-Looking"@en ;
    rdfs:subClassOf ea:TemporalOrientation .

ea:InconsistencyFactor a owl:Class ;
    rdfs:label "Inconsistency Factor"@en ;
    rdfs:comment "Measurement errors embedded in observed scores (E in Classical Test Theory X = T + E)."@en ;
    rdfs:subClassOf ea:ReliabilityFactor ;
    skos:altLabel "Measurement Error"@en .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple Choice Item"@en ;
    rdfs:comment "An item consisting of a stem and options where only one answer is keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:cardinality 1 ;
                        owl:onProperty ea:hasStem ] [ a owl:Restriction ;
                        owl:cardinality 1 ;
                        owl:onProperty ea:hasAnswerKey ] [ a owl:Restriction ;
                        owl:minCardinality 1 ;
                        owl:onProperty ea:hasDistractor ] ) ] ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en,
        "Objective Response"@en .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:comment "Assessment that ranks and compares examinees against a peer sample or norming group on a relative scale (curve)."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingApproach ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "NRT"@en,
        "Norm-Referenced Test"@en,
        "Normative Assessment"@en .

ea:ObjectiveScoring a owl:Class ;
    rdfs:label "Objective Scoring"@en ;
    rdfs:subClassOf ea:ScoringObjectivity .

ea:Stem a owl:Class ;
    rdfs:label "Stem"@en ;
    rdfs:comment "The opening portion of an item—a problem, question, or incomplete statement."@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:SubjectiveScoring a owl:Class ;
    rdfs:label "Subjective Scoring"@en ;
    rdfs:subClassOf ea:ScoringObjectivity .

ea:hasReferencingApproach a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing approach"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingApproach ;
    owl:inverseOf ea:isReferencingApproachOf .

ea:hasTemporalOrientation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has temporal orientation"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TemporalOrientation ;
    owl:inverseOf ea:isTemporalOrientationOf .

ea:AssessmentOrigin a owl:Class ;
    rdfs:label "Assessment Origin"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:InternalOrigin ea:ExternalOrigin ) .

ea:FormalityLevel a owl:Class ;
    rdfs:label "Formality Level"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:FormalFormality ea:InformalFormality ) .

ea:ScoringObjectivity a owl:Class ;
    rdfs:label "Scoring Objectivity"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:ObjectiveScoring ea:SubjectiveScoring ) .

ea:StakesLevel a owl:Class ;
    rdfs:label "Stakes Level"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:StandardizationStatus a owl:Class ;
    rdfs:label "Standardization Status"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:StandardizedStatus ea:NonStandardizedStatus ) .

ea:TeacherEvaluationMeasure a owl:Class ;
    rdfs:label "Teacher Evaluation Measure"@en ;
    rdfs:comment "Statistical metrics evaluating educator impact based on student test data."@en ;
    rdfs:subClassOf owl:Thing .

ea:TemporalOrientation a owl:Class ;
    rdfs:label "Temporal Orientation"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:BackwardLooking ea:ForwardLooking ) .

ea:hasScoringObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring objectivity"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ea:Assessment ea:AssessmentItem ) ] ;
    rdfs:range ea:ScoringObjectivity ;
    owl:inverseOf ea:isScoringObjectivityOf .

ea:AlternativeAnswer a owl:Class ;
    rdfs:label "Alternative Answer"@en ;
    rdfs:comment "A possible answer that an examinee can select from."@en ;
    rdfs:subClassOf ea:ItemComponent ;
    skos:altLabel "Option"@en .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:comment "Feedback that is nonevaluative, supportive, timely, and specific to guide improvement."@en ;
    rdfs:subClassOf ea:Feedback .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "Statements specifying what learners should know, understand, or be able to do."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:PerformanceFormat a owl:Class ;
    rdfs:label "Performance Format"@en ;
    rdfs:comment "The format of performance-based tasks, classified into products and live demonstrations."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:ProductFormat ea:DemonstrationFormat ) .

ea:ReferencingApproach a owl:Class ;
    rdfs:label "Referencing Approach"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide containing evaluative criteria, quality definitions, and scoring strategy to evaluate constructed responses."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Scoring Guide"@en .

ea:ScoringApproach a owl:Class ;
    rdfs:label "Scoring Approach"@en ;
    rdfs:comment "The method used by raters to evaluate candidate work."@en ;
    rdfs:subClassOf owl:Thing .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "An open-ended item requiring human judgment or rubrics to grade constructed prose or freehand responses."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:AssessmentItem [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:SubjectiveScoring ] ) ] ;
    skos:altLabel "FRQ"@en,
        "Free Response Question"@en,
        "Open-Ended Question"@en .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency of measurement and freedom from measurement error, defined as true score variance over total variance."@en ;
    rdfs:subClassOf owl:Thing .

ea:StandardCategory a owl:Class ;
    rdfs:label "Standard Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:AppropriatenessCategory ea:UtilityCategory ea:FeasibilityCategory ea:AccuracyCategory ) .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:comment "A curated collection of student work compiled to demonstrate learning growth over time."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Portfolio"@en .

ea:hasAssessmentPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has assessment purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentPurpose ;
    owl:inverseOf ea:isAssessmentPurposeOf .

ea:AssessmentPurpose a owl:Class ;
    rdfs:label "Assessment Purpose"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:InterimPurpose ea:ScreeningPurpose ) .

ea:EvaluationStandard a owl:Class ;
    rdfs:label "Evaluation Standard"@en ;
    rdfs:comment "Guidelines established by professional joint committees for quality evaluation practice."@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:PersonnelEvaluationStandard ea:ProgramEvaluationStandard ea:StudentEvaluationStandard ) .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "An item format with pre-determined correct answer(s) scorable without subjective interpretation."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:AssessmentItem [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:ObjectiveScoring ] ) ] .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The extent to which an assessment measures what it claims or is intended to measure."@en ;
    rdfs:subClassOf owl:Thing .

ea:GranularityLevel a owl:Class ;
    rdfs:label "Granularity Level"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:SystemGranularity ) .

ea:ReliabilityFactor a owl:Class ;
    rdfs:label "Reliability Factor"@en ;
    rdfs:comment "Factors influencing test consistency."@en ;
    rdfs:subClassOf owl:Thing .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification in other topics."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:comment "A unit or prompt forming part of an assessment or test."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Item"@en,
        "Question"@en,
        "Test Question"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ObjectiveItem ea:SubjectiveItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ea:FillInTheBlankItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:OneBestAnswerItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:WordBankFillInTheBlankItem ea:NoWordBankFillInTheBlankItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:EssayItem ea:ShortAnswerItem ea:ExtendedResponseItem ea:CalculationItem ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:Stem ea:AlternativeAnswer ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:AnswerKey ea:Distractor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticScoring ea:AnalyticScoring ea:TraitInformedScoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TestRetestReliability ea:ParallelFormsReliability ea:InternalConsistencyReliability ea:InterRaterReliability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConsistencyFactor ea:InconsistencyFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:RandomError ea:SystematicError ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConstructValidity ea:ContentValidity ea:CriterionValidity ea:FaceValidity ea:ConsequentialValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:RecastFeedback ea:VerbalFeedback ea:WrittenFeedback ea:ScoreFeedback ea:TechnologyMediatedFeedback ) .

