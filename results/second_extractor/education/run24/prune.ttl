@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs1: <http://www.w3.org/2007/05/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs1:comment "An OWL 2 DL ontology formalizing the domain of educational assessment based strictly on the provided corpus."@en ;
    rdfs1:label "Educational Assessment Ontology"@en .

ea:CommonAssessment a owl:Class ;
    rdfs1:label "Common Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs1:label "Competitive Examination"@en ;
    rdfs1:subClassOf ea:HighStakesAssessment,
        ea:NormReferencedAssessment .

ea:ComputerBasedAssessment a owl:Class ;
    skos:altLabel "Online Assessment"@en,
        "eExam"@en ;
    rdfs1:label "Computer-Based Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:ConsequentialValidity a owl:Class ;
    rdfs1:label "Consequential Validity"@en ;
    rdfs1:subClassOf ea:ValidityEvidence .

ea:ContentValidity a owl:Class ;
    skos:altLabel "Logical Validity"@en ;
    rdfs1:label "Content Validity"@en ;
    rdfs1:subClassOf ea:ValidityEvidence .

ea:ContinuousAssessment a owl:Class ;
    rdfs1:label "Continuous Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:CorrectiveFeedback a owl:Class ;
    rdfs1:label "Corrective Feedback"@en ;
    rdfs1:subClassOf ea:Feedback .

ea:DevelopmentalRubric a owl:Class ;
    rdfs1:label "Developmental Rubric"@en ;
    rdfs1:subClassOf ea:AnalyticRubric .

ea:DiscriminantValidity a owl:Class ;
    owl:disjointWith ea:ConvergentValidity ;
    skos:altLabel "Divergent Validity"@en ;
    rdfs1:label "Discriminant Validity"@en ;
    rdfs1:subClassOf ea:ConstructValidity .

ea:EssayItem a owl:Class ;
    skos:altLabel "Essay Question"@en ;
    rdfs1:label "Essay Item"@en ;
    rdfs1:subClassOf ea:SubjectiveItem .

ea:ExtendedResponseItem a owl:Class ;
    rdfs1:label "Extended-Response Item"@en ;
    rdfs1:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:ExternalSource ] ) ] ;
    rdfs1:label "External Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:FaceValidity a owl:Class ;
    rdfs1:label "Face Validity"@en ;
    rdfs1:subClassOf ea:ValidityEvidence .

ea:FillInTheBlankItem a owl:Class ;
    rdfs1:label "Fill-in-the-Blank Item"@en ;
    rdfs1:subClassOf ea:AssessmentItem .

ea:FormalAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:FormalType ] ) ] ;
    rdfs1:label "Formal Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:FormativeFeedback a owl:Class ;
    rdfs1:label "Formative Feedback"@en ;
    rdfs1:subClassOf ea:Feedback .

ea:ForwardLookingAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:ForwardLookingPurpose ] ) ] ;
    rdfs1:label "Forward-Looking Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:FreeResponseQuestion a owl:Class ;
    rdfs1:label "Free-Response Question"@en ;
    rdfs1:subClassOf ea:SubjectiveItem .

ea:HolisticRubric a owl:Class ;
    owl:disjointWith ea:AnalyticRubric ;
    rdfs1:label "Holistic Rubric"@en ;
    rdfs1:subClassOf ea:Rubric .

ea:InformalAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:InformalType ] ) ] ;
    rdfs1:label "Informal Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:InterRaterReliability a owl:Class ;
    skos:altLabel "Inter-Coder Reliability"@en,
        "Inter-Observer Reliability"@en,
        "Rater Reliability"@en ;
    rdfs1:label "Inter-Rater Reliability"@en ;
    rdfs1:subClassOf ea:ReliabilityEstimate .

ea:InterimAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en,
        "Benchmark Test"@en ;
    rdfs1:comment "Corpus notes that educators debate whether interim assessments are formative (used diagnostically to inform instructional modifications) or summative (used to evaluate benchmark achievement)."@en ;
    rdfs1:label "Interim Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:InternalAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationSource ;
                        owl:someValuesFrom ea:InternalSource ] ) ] ;
    rdfs1:label "Internal Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs1:label "Internal Consistency Reliability"@en ;
    rdfs1:subClassOf ea:ReliabilityEstimate .

ea:IntraRaterReliability a owl:Class ;
    rdfs1:label "Intra-Rater Reliability"@en ;
    rdfs1:subClassOf ea:ReliabilityEstimate .

ea:IpsativeAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] ;
    rdfs1:label "Ipsative Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:LowStakesAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:LowStakesType ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en ;
    rdfs1:label "Low-Stakes Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:MatchingItem a owl:Class ;
    rdfs1:label "Matching Item"@en ;
    rdfs1:subClassOf ea:ObjectiveItem .

ea:MultipleResponseItem a owl:Class ;
    owl:disjointWith ea:ObjectiveItem ;
    rdfs1:label "Multiple-Response Item"@en ;
    rdfs1:subClassOf ea:AssessmentItem .

ea:NonStandardizedAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:NonStandardizedType ] ) ] ;
    skos:altLabel "Non-Standardized Test"@en ;
    rdfs1:label "Non-Standardized Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:ObjectiveAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityType ;
                        owl:someValuesFrom ea:ObjectiveType ] ) ] ;
    rdfs1:label "Objective Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:OralAssessment a owl:Class ;
    skos:altLabel "Oral Test"@en ;
    rdfs1:label "Oral Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:ParallelFormsReliability a owl:Class ;
    skos:altLabel "Alternate-Forms Reliability"@en,
        "Form Equivalence"@en,
        "Inter-Method Reliability"@en ;
    rdfs1:label "Parallel-Forms Reliability"@en ;
    rdfs1:subClassOf ea:ReliabilityEstimate .

ea:PeerAssessment a owl:Class ;
    rdfs1:label "Peer Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:PerformanceBasedAssessment a owl:Class ;
    skos:altLabel "Authentic Assessment"@en,
        "Performance Assessment"@en ;
    rdfs1:label "Performance-Based Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:PlacementAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en ;
    rdfs1:label "Placement Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs1:label "Portfolio-Based Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:PracticalAssessment a owl:Class ;
    skos:altLabel "Practical Test"@en ;
    rdfs1:label "Practical Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:ScreeningAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] ;
    rdfs1:label "Screening Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:SelfAssessment a owl:Class ;
    rdfs1:label "Self Assessment"@en ;
    rdfs1:subClassOf ea:Assessment,
        ea:DiagnosticAssessment .

ea:ShortAnswerItem a owl:Class ;
    skos:altLabel "Short Answer Question"@en ;
    rdfs1:label "Short-Answer Item"@en ;
    rdfs1:subClassOf ea:SubjectiveItem .

ea:StandardizedAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:StandardizedType ] ) ] ;
    skos:altLabel "Standardized Test"@en ;
    rdfs1:label "Standardized Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:SubjectiveAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityType ;
                        owl:someValuesFrom ea:SubjectiveType ] ) ] ;
    rdfs1:label "Subjective Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:SummativeAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en ;
    rdfs1:label "Summative Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:TestRetestReliability a owl:Class ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en ;
    rdfs1:label "Test-Retest Reliability"@en ;
    rdfs1:subClassOf ea:ReliabilityEstimate .

ea:TrueFalseItem a owl:Class ;
    rdfs1:label "True-False Item"@en ;
    rdfs1:subClassOf ea:ObjectiveItem .

ea:WrittenAssessment a owl:Class ;
    skos:altLabel "Written Test"@en ;
    rdfs1:label "Written Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:hasAssessmentItem a owl:ObjectProperty ;
    owl:inverseOf ea:isAssessmentItemOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has assessment item"@en ;
    rdfs1:range ea:AssessmentItem .

ea:hasAssessmentRubric a owl:ObjectProperty ;
    owl:inverseOf ea:isAssessmentRubricOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has assessment rubric"@en ;
    rdfs1:range ea:Rubric .

ea:hasCutScore a owl:DatatypeProperty ;
    rdfs1:domain ea:CriterionReferencedAssessment ;
    rdfs1:label "has cut score"@en ;
    rdfs1:range xsd:decimal .

ea:hasFeedback a owl:ObjectProperty ;
    owl:inverseOf ea:isFeedbackOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has feedback"@en ;
    rdfs1:range ea:Feedback .

ea:hasGradingStatus a owl:DatatypeProperty ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has grading status"@en ;
    rdfs1:range xsd:boolean .

ea:hasGranularityLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isGranularityLevelOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has granularity level"@en ;
    rdfs1:range ea:GranularityLevel .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has item count"@en ;
    rdfs1:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    owl:inverseOf ea:isLearningOutcomeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has learning outcome"@en ;
    rdfs1:range ea:LearningOutcome .

ea:hasNumericalScore a owl:DatatypeProperty ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has numerical score"@en ;
    rdfs1:range xsd:decimal .

ea:hasPercentileRank a owl:DatatypeProperty ;
    rdfs1:domain ea:NormReferencedAssessment ;
    rdfs1:label "has percentile rank"@en ;
    rdfs1:range xsd:decimal .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs1:domain ea:ReliabilityEstimate ;
    rdfs1:label "has reliability coefficient"@en ;
    rdfs1:range xsd:decimal .

ea:hasReliabilityEstimate a owl:ObjectProperty ;
    owl:inverseOf ea:isReliabilityEstimateOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has reliability estimate"@en ;
    rdfs1:range ea:ReliabilityEstimate .

ea:hasScoringMethod a owl:ObjectProperty ;
    owl:inverseOf ea:isScoringMethodOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has scoring method"@en ;
    rdfs1:range ea:ScoringMethod .

ea:hasValidityEvidence a owl:ObjectProperty ;
    owl:inverseOf ea:isValidityEvidenceOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has validity evidence"@en ;
    rdfs1:range ea:ValidityEvidence .

owl:AllDisjointClasses owl:members ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:AcademicProgramGranularity a owl:Class ;
    rdfs1:label "Academic Program Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:AnalyticScoring a owl:Class ;
    skos:altLabel "Analytic Grading"@en ;
    rdfs1:label "Analytic Scoring"@en ;
    rdfs1:subClassOf ea:ScoringMethod .

ea:ConcurrentValidity a owl:Class ;
    rdfs1:label "Concurrent Validity"@en ;
    rdfs1:subClassOf ea:CriterionValidity .

ea:ConvergentValidity a owl:Class ;
    rdfs1:label "Convergent Validity"@en ;
    rdfs1:subClassOf ea:ConstructValidity .

ea:CourseGranularity a owl:Class ;
    rdfs1:label "Course Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:CriterionReferencedAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en ;
    rdfs1:label "Criterion-Referenced Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:DiagnosticAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "Diagnostic Testing"@en ;
    rdfs1:comment "The corpus presents a taxonomic tension: one passage lists diagnostic assessment as a coordinate category alongside placement, formative, and summative assessments, whereas another passage explicitly asserts that a common form of formative assessment is diagnostic assessment. Both classifications are preserved."@en ;
    rdfs1:label "Diagnostic Assessment"@en ;
    rdfs1:subClassOf ea:Assessment,
        ea:FormativeAssessment .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs1:label "Educational System Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:FormativeAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Educative Assessment"@en ;
    rdfs1:label "Formative Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:HighStakesAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:HighStakesType ] ) ] ;
    skos:altLabel "High-Stakes Test"@en ;
    rdfs1:label "High-Stakes Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:HolisticScoring a owl:Class ;
    skos:altLabel "Holistic Grading"@en ;
    rdfs1:label "Holistic Scoring"@en ;
    rdfs1:subClassOf ea:ScoringMethod .

ea:InstitutionGranularity a owl:Class ;
    rdfs1:label "Institution Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:IntendedLearningOutcome a owl:Class ;
    skos:altLabel "Aim"@en ;
    rdfs1:label "Intended Learning Outcome"@en ;
    rdfs1:subClassOf ea:LearningOutcome .

ea:LearnerGranularity a owl:Class ;
    rdfs1:label "Learner Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs1:label "Learning Community Granularity"@en ;
    rdfs1:subClassOf ea:GranularityLevel .

ea:MeasuredLearningOutcome a owl:Class ;
    skos:altLabel "Objective"@en ;
    rdfs1:label "Measured Learning Outcome"@en ;
    rdfs1:subClassOf ea:LearningOutcome .

ea:PredictiveValidity a owl:Class ;
    rdfs1:label "Predictive Validity"@en ;
    rdfs1:subClassOf ea:CriterionValidity .

ea:TraitInformedScoring a owl:Class ;
    rdfs1:label "Trait-Informed Scoring"@en ;
    rdfs1:subClassOf ea:ScoringMethod .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs1:label "Unintended Learning Outcome"@en ;
    rdfs1:subClassOf ea:LearningOutcome .

ea:hasIncorrectAnswerOption a owl:ObjectProperty ;
    owl:inverseOf ea:isIncorrectAnswerOptionOf ;
    rdfs1:domain ea:MultipleChoiceItem ;
    rdfs1:label "has incorrect answer option"@en ;
    rdfs1:range ea:IncorrectAnswerOption ;
    rdfs1:subPropertyOf ea:hasAssessmentItemOption .

ea:isAdministrationSourceOf a owl:ObjectProperty ;
    rdfs1:domain ea:AdministrationSource ;
    rdfs1:label "is administration source of"@en ;
    rdfs1:range ea:Assessment .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs1:domain ea:AssessmentItem ;
    rdfs1:label "is assessment item of"@en ;
    rdfs1:range ea:Assessment .

ea:isAssessmentItemOptionOf a owl:ObjectProperty ;
    rdfs1:domain ea:AssessmentItemOption ;
    rdfs1:label "is assessment item option of"@en ;
    rdfs1:range ea:MultipleChoiceItem .

ea:isAssessmentPurposeOf a owl:ObjectProperty ;
    rdfs1:domain ea:AssessmentPurpose ;
    rdfs1:label "is assessment purpose of"@en ;
    rdfs1:range ea:Assessment .

ea:isAssessmentRubricOf a owl:ObjectProperty ;
    rdfs1:domain ea:Rubric ;
    rdfs1:label "is assessment rubric of"@en ;
    rdfs1:range ea:Assessment .

ea:isCorrectAnswerOptionOf a owl:ObjectProperty ;
    rdfs1:domain ea:CorrectAnswerOption ;
    rdfs1:label "is correct answer option of"@en ;
    rdfs1:range ea:MultipleChoiceItem .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs1:domain ea:Feedback ;
    rdfs1:label "is feedback of"@en ;
    rdfs1:range ea:Assessment .

ea:isFormalityTypeOf a owl:ObjectProperty ;
    rdfs1:domain ea:FormalityType ;
    rdfs1:label "is formality type of"@en ;
    rdfs1:range ea:Assessment .

ea:isGranularityLevelOf a owl:ObjectProperty ;
    rdfs1:domain ea:GranularityLevel ;
    rdfs1:label "is granularity level of"@en ;
    rdfs1:range ea:Assessment .

ea:isIncorrectAnswerOptionOf a owl:ObjectProperty ;
    rdfs1:domain ea:IncorrectAnswerOption ;
    rdfs1:label "is incorrect answer option of"@en ;
    rdfs1:range ea:MultipleChoiceItem .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs1:domain ea:LearningOutcome ;
    rdfs1:label "is learning outcome of"@en ;
    rdfs1:range ea:Assessment .

ea:isObjectivityTypeOf a owl:ObjectProperty ;
    rdfs1:domain ea:ObjectivityType ;
    rdfs1:label "is objectivity type of"@en ;
    rdfs1:range ea:Assessment .

ea:isReferencingFrameworkOf a owl:ObjectProperty ;
    rdfs1:domain ea:ReferencingFramework ;
    rdfs1:label "is referencing framework of"@en ;
    rdfs1:range ea:Assessment .

ea:isReliabilityEstimateOf a owl:ObjectProperty ;
    rdfs1:domain ea:ReliabilityEstimate ;
    rdfs1:label "is reliability estimate of"@en ;
    rdfs1:range ea:Assessment .

ea:isScoringMethodOf a owl:ObjectProperty ;
    rdfs1:domain ea:ScoringMethod ;
    rdfs1:label "is scoring method of"@en ;
    rdfs1:range ea:Assessment .

ea:isStakesTypeOf a owl:ObjectProperty ;
    rdfs1:domain ea:StakesType ;
    rdfs1:label "is stakes type of"@en ;
    rdfs1:range ea:Assessment .

ea:isStandardizationTypeOf a owl:ObjectProperty ;
    rdfs1:domain ea:StandardizationType ;
    rdfs1:label "is standardization type of"@en ;
    rdfs1:range ea:Assessment .

ea:isValidityEvidenceOf a owl:ObjectProperty ;
    rdfs1:domain ea:ValidityEvidence ;
    rdfs1:label "is validity evidence of"@en ;
    rdfs1:range ea:Assessment .

ea:AnalyticRubric a owl:Class ;
    rdfs1:label "Analytic Rubric"@en ;
    rdfs1:subClassOf ea:Rubric .

ea:ConstructValidity a owl:Class ;
    rdfs1:comment "Modern validity theory asserts that construct validity subsumes all other forms of validity evidence."@en ;
    rdfs1:label "Construct Validity"@en ;
    rdfs1:subClassOf ea:ValidityEvidence .

ea:CorrectAnswerOption a owl:Class ;
    owl:disjointWith ea:IncorrectAnswerOption ;
    skos:altLabel "Key"@en ;
    rdfs1:label "Correct Answer Option"@en ;
    rdfs1:subClassOf ea:AssessmentItemOption .

ea:CriterionReferencing a owl:Class ;
    rdfs1:label "Criterion Referencing"@en ;
    rdfs1:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    owl:disjointUnionOf ( ea:ConcurrentValidity ea:PredictiveValidity ) ;
    skos:altLabel "Criterion-Related Validity"@en ;
    rdfs1:label "Criterion Validity"@en ;
    rdfs1:subClassOf ea:ValidityEvidence .

ea:DiagnosticPurpose a owl:Class ;
    rdfs1:label "Diagnostic Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:ExternalSource a owl:Class ;
    rdfs1:label "External Source"@en ;
    rdfs1:subClassOf ea:AdministrationSource .

ea:FormalType a owl:Class ;
    rdfs1:label "Formal Type"@en ;
    rdfs1:subClassOf ea:FormalityType .

ea:FormativePurpose a owl:Class ;
    rdfs1:label "Formative Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:ForwardLookingPurpose a owl:Class ;
    rdfs1:label "Forward Looking Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:HighStakesType a owl:Class ;
    rdfs1:label "High Stakes Type"@en ;
    rdfs1:subClassOf ea:StakesType .

ea:InformalType a owl:Class ;
    rdfs1:label "Informal Type"@en ;
    rdfs1:subClassOf ea:FormalityType .

ea:InterimPurpose a owl:Class ;
    rdfs1:label "Interim Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:InternalSource a owl:Class ;
    rdfs1:label "Internal Source"@en ;
    rdfs1:subClassOf ea:AdministrationSource .

ea:IpsativeReferencing a owl:Class ;
    skos:altLabel "Forced-Choice Referencing"@en ;
    rdfs1:label "Ipsative Referencing"@en ;
    rdfs1:subClassOf ea:ReferencingFramework .

ea:LowStakesType a owl:Class ;
    rdfs1:label "Low Stakes Type"@en ;
    rdfs1:subClassOf ea:StakesType .

ea:NonStandardizedType a owl:Class ;
    rdfs1:label "Non-Standardized Type"@en ;
    rdfs1:subClassOf ea:StandardizationType .

ea:NormReferencedAssessment a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Norm-Referenced Test"@en,
        "Normative Assessment"@en ;
    rdfs1:label "Norm-Referenced Assessment"@en ;
    rdfs1:subClassOf ea:Assessment .

ea:NormReferencing a owl:Class ;
    rdfs1:label "Norm Referencing"@en ;
    rdfs1:subClassOf ea:ReferencingFramework .

ea:ObjectiveType a owl:Class ;
    rdfs1:label "Objective Type"@en ;
    rdfs1:subClassOf ea:ObjectivityType .

ea:PlacementPurpose a owl:Class ;
    rdfs1:label "Placement Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:PsychometricQuality a owl:Class ;
    rdfs1:label "Psychometric Quality"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:ScreeningPurpose a owl:Class ;
    rdfs1:label "Screening Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:StandardizedType a owl:Class ;
    rdfs1:label "Standardized Type"@en ;
    rdfs1:subClassOf ea:StandardizationType .

ea:SubjectiveType a owl:Class ;
    rdfs1:label "Subjective Type"@en ;
    rdfs1:subClassOf ea:ObjectivityType .

ea:SummativePurpose a owl:Class ;
    rdfs1:label "Summative Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPurpose .

ea:hasAdministrationSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isAdministrationSourceOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has administration source"@en ;
    rdfs1:range ea:AdministrationSource .

ea:hasAssessmentItemOption a owl:ObjectProperty ;
    owl:inverseOf ea:isAssessmentItemOptionOf ;
    rdfs1:domain ea:MultipleChoiceItem ;
    rdfs1:label "has assessment item option"@en ;
    rdfs1:range ea:AssessmentItemOption .

ea:hasCorrectAnswerOption a owl:ObjectProperty ;
    owl:inverseOf ea:isCorrectAnswerOptionOf ;
    rdfs1:domain ea:MultipleChoiceItem ;
    rdfs1:label "has correct answer option"@en ;
    rdfs1:range ea:CorrectAnswerOption ;
    rdfs1:subPropertyOf ea:hasAssessmentItemOption .

ea:hasFormalityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isFormalityTypeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has formality type"@en ;
    rdfs1:range ea:FormalityType .

ea:hasObjectivityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isObjectivityTypeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has objectivity type"@en ;
    rdfs1:range ea:ObjectivityType .

ea:hasStakesType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isStakesTypeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has stakes type"@en ;
    rdfs1:range ea:StakesType .

ea:hasStandardizationType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isStandardizationTypeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has standardization type"@en ;
    rdfs1:range ea:StandardizationType .

ea:IncorrectAnswerOption a owl:Class ;
    skos:altLabel "Distractor"@en ;
    rdfs1:label "Incorrect Answer Option"@en ;
    rdfs1:subClassOf ea:AssessmentItemOption .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isReferencingFrameworkOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has referencing framework"@en ;
    rdfs1:range ea:ReferencingFramework .

ea:AdministrationSource a owl:Class ;
    owl:disjointUnionOf ( ea:InternalSource ea:ExternalSource ) ;
    rdfs1:label "Administration Source"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:AssessmentItemOption a owl:Class ;
    skos:altLabel "Alternative Answer"@en,
        "Choice"@en ;
    rdfs1:label "Assessment Item Option"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:Feedback a owl:Class ;
    rdfs1:label "Feedback"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:FormalityType a owl:Class ;
    owl:disjointUnionOf ( ea:FormalType ea:InformalType ) ;
    rdfs1:label "Formality Type"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:ObjectivityType a owl:Class ;
    owl:disjointUnionOf ( ea:ObjectiveType ea:SubjectiveType ) ;
    rdfs1:comment "The corpus notes a critical tension: assessment is widely categorized into objective and subjective, yet some argue that no assessment is truly objective due to inherent cultural and curricular biases."@en ;
    rdfs1:label "Objectivity Type"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:Rubric a owl:Class ;
    skos:altLabel "Scoring Guide"@en ;
    rdfs1:label "Rubric"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:StakesType a owl:Class ;
    owl:disjointUnionOf ( ea:HighStakesType ea:LowStakesType ) ;
    rdfs1:label "Stakes Type"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:StandardizationType a owl:Class ;
    owl:disjointUnionOf ( ea:StandardizedType ea:NonStandardizedType ) ;
    rdfs1:label "Standardization Type"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:SubjectiveItem a owl:Class ;
    owl:disjointWith ea:ObjectiveItem ;
    rdfs1:label "Subjective Item"@en ;
    rdfs1:subClassOf ea:AssessmentItem .

ea:LearningOutcome a owl:Class ;
    rdfs1:label "Learning Outcome"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:ReferencingFramework a owl:Class ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) ;
    rdfs1:label "Referencing Framework"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:ScoringMethod a owl:Class ;
    owl:disjointUnionOf ( ea:HolisticScoring ea:AnalyticScoring ea:TraitInformedScoring ) ;
    rdfs1:label "Scoring Method"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:MultipleChoiceItem a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:ObjectiveItem [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ea:hasCorrectAnswerOption ] [ a owl:Restriction ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ea:hasIncorrectAnswerOption ] ) ] ;
    skos:altLabel "Multiple Choice Question"@en ;
    rdfs1:label "Multiple-Choice Item"@en ;
    rdfs1:subClassOf ea:ObjectiveItem .

ea:ObjectiveItem a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:AssessmentItem [ a owl:Restriction ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty ea:hasCorrectAnswerOption ] ) ] ;
    rdfs1:label "Objective Item"@en ;
    rdfs1:subClassOf ea:AssessmentItem .

ea:AssessmentItem a owl:Class ;
    skos:altLabel "Question"@en,
        "Test Item"@en ;
    rdfs1:label "Assessment Item"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:ValidityEvidence a owl:Class ;
    rdfs1:label "Validity Evidence"@en ;
    rdfs1:subClassOf ea:PsychometricQuality .

ea:hasAssessmentPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    owl:inverseOf ea:isAssessmentPurposeOf ;
    rdfs1:domain ea:Assessment ;
    rdfs1:label "has assessment purpose"@en ;
    rdfs1:range ea:AssessmentPurpose .

ea:AssessmentPartitionValue a owl:Class ;
    rdfs1:label "Assessment Partition Value"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

ea:GranularityLevel a owl:Class ;
    owl:disjointUnionOf ( ea:LearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) ;
    rdfs1:label "Granularity Level"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:ReliabilityEstimate a owl:Class ;
    rdfs1:label "Reliability Estimate"@en ;
    rdfs1:subClassOf ea:PsychometricQuality .

ea:AssessmentPurpose a owl:Class ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ea:ScreeningPurpose ea:InterimPurpose ea:ForwardLookingPurpose ) ;
    rdfs1:label "Assessment Purpose"@en ;
    rdfs1:subClassOf ea:AssessmentPartitionValue .

ea:EducationalConcept a owl:Class ;
    rdfs1:label "Educational Concept"@en .

ea:Assessment a owl:Class ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en ;
    rdfs1:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning."@en ;
    rdfs1:label "Assessment"@en ;
    rdfs1:subClassOf ea:EducationalConcept .

