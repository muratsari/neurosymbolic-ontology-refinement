@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An OWL 2 DL ontology formally modeling the domain of educational assessment based on literature on psychometrics, testing, evaluation, validity, and reliability."@en .

ea:AnecdotalFeedback a owl:Class ;
    rdfs:label "Anecdotal Feedback"@en ;
    rdfs:subClassOf ea:WrittenFeedback .

ea:BackwardLookingAssessment a owl:Class ;
    rdfs:label "Backward-Looking Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientationCategory ;
                        owl:someValuesFrom ea:BackwardLookingCategory ] ) ] ;
    skos:altLabel "Achievement Test"@en .

ea:CapstonePortfolio a owl:Class ;
    rdfs:label "Capstone Portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common Assessment"@en ;
    rdfs:comment "Collaboratively developed assessment used across multiple classrooms to ensure consistent evaluation."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:subClassOf ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ea:HighStakesAssessment ) ] ;
    skos:altLabel "Competitive Exam"@en .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment requiring a rubric and an expert examiner, such as a thesis or funding proposal."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Criterion validity when test data and criterion data are collected at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity ;
    owl:disjointWith ea:PredictiveValidity .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:subClassOf ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "Systematic examination of test content to determine whether it covers a representative sample of the behavior or knowledge domain."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "An educational examination evaluating progress throughout a course, often alternative to final examinations."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:comment "Degree to which two measures of constructs that theoretically should be related are related."@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:disjointWith ea:DiscriminantValidity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Criterion-Referenced Test"@en,
        "Standards-Based Assessment"@en .

ea:CronbachAlphaReliability a owl:Class ;
    rdfs:label "Cronbach's Alpha Reliability"@en ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytical rubrics that facilitates assessment across multiple dimensions of developmental successions."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment"@en ;
    rdfs:comment "The corpus presents a classification tension regarding DiagnosticAssessment: passage 2 lists it as a coordinate category alongside placement, formative, and summative assessments, whereas passage 3 and later passages state that diagnostic assessment is a common form of formative assessment. Both claims are represented."@en ;
    rdfs:subClassOf ea:Assessment,
        ea:FormativeAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:subClassOf ea:FreeResponseItem ;
    skos:altLabel "Essay Question"@en .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended-Response Item"@en ;
    rdfs:subClassOf ea:FreeResponseItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocalityCategory ;
                        owl:someValuesFrom ea:ExternalCategory ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "Estimate of whether a test appears or looks superficially to measure a certain criterion."@en ;
    rdfs:subClassOf ea:Validity .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:comment "Provides identifying characteristics and requires the examinee to recall the correct term."@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:FinalExamination a owl:Class ;
    rdfs:label "Final Examination"@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Final Exam"@en,
        "Finals"@en .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:FormalCategory ] ) ] .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasTemporalOrientationCategory ;
                        owl:someValuesFrom ea:ForwardLookingCategory ] ) ] ;
    skos:altLabel "Aptitude Test"@en .

ea:GoverningBody a owl:Class ;
    rdfs:label "Governing Body"@en ;
    rdfs:subClassOf ea:Agent .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "A rubric providing an overall rating for a piece of work, considering all aspects together."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:comment "An approach that appraises student works as integrated entities based on overall quality."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    owl:disjointWith ea:AnalyticScoring ;
    skos:altLabel "General Merit Scoring"@en,
        "Holistic Grading"@en,
        "Nonreductionist Grading"@en .

ea:ImmediateFeedbackAssessmentTechnique a owl:Class ;
    rdfs:label "Immediate Feedback Assessment Technique"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "IF-AT"@en .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityCategory ;
                        owl:someValuesFrom ea:InformalCategory ] ) ] .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:comment "Degree of agreement among independent observers or raters."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Coder Reliability"@en,
        "Inter-Observer Reliability"@en,
        "Rater Reliability"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasLocalityCategory ;
                        owl:someValuesFrom ea:InternalCategory ] ) ] .

ea:IntraRaterReliability a owl:Class ;
    rdfs:label "Intra-Rater Reliability"@en ;
    rdfs:comment "Consistency of ratings produced by a single rater across occasions."@en ;
    rdfs:subClassOf ea:Reliability .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] ;
    skos:altLabel "Forced-Choice Assessment"@en .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:LowStakesCategory ] ) ] ;
    skos:altLabel "Low-Stakes Test"@en .

ea:MarkupFeedback a owl:Class ;
    rdfs:label "Markup Feedback"@en ;
    rdfs:subClassOf ea:WrittenFeedback .

ea:MathematicalProblemItem a owl:Class ;
    rdfs:label "Mathematical Problem Item"@en ;
    rdfs:comment "A problem requiring a freehand response where marks are given for steps taken."@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:MidtermExamination a owl:Class ;
    rdfs:label "Midterm Examination"@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Midterm Exam"@en .

ea:NonStandardizedAssessment a owl:Class ;
    rdfs:label "Non-Standardized Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:NonStandardizedCategory ] ) ] ;
    skos:altLabel "Non-Standardized Test"@en .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "The corpus notes a critical tension: while assessment is widely divided into objective and subjective types, critics argue the distinction is inaccurate because no assessment is truly objective due to inherent cultural and content biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:ObjectiveCategory ] ) ] .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:subClassOf ea:Test .

ea:PaperBasedTest a owl:Class ;
    rdfs:label "Paper-Based Test"@en ;
    rdfs:subClassOf ea:WrittenTest ;
    owl:disjointWith ea:ComputerBasedTest .

ea:ParallelFormsReliability a owl:Class ;
    rdfs:label "Parallel Forms Reliability"@en ;
    rdfs:comment "Equivalence of performance on different forms of a test based on the same content."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Alternate Forms Reliability"@en,
        "Form Equivalence"@en,
        "Inter-Method Reliability"@en .

ea:PeerAssessment a owl:Class ;
    rdfs:label "Peer Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:PeerExaminer ] ) ] .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:comment "An assessment requiring students to solve real-world problems or perform authentic tasks yielding products or performances."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Authentic Assessment"@en,
        "Performance-Based Assessment"@en .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:label "Physical Portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio ;
    owl:disjointWith ea:DigitalPortfolio .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PortfolioBasedAssessment a owl:Class ;
    rdfs:label "Portfolio-Based Assessment"@en ;
    rdfs:comment "Assessment based on the collection of student academic work over time."@en ;
    rdfs:subClassOf ea:Assessment .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:subClassOf ea:Test .

ea:Quiz a owl:Class ;
    rdfs:label "Quiz"@en ;
    rdfs:comment "A brief assessment covering a small amount of instructional material."@en ;
    rdfs:subClassOf ea:Test .

ea:RandomError a owl:Class ;
    rdfs:label "Random Error"@en ;
    rdfs:subClassOf ea:MeasurementError ;
    owl:disjointWith ea:SystematicError .

ea:RaterRelatedReliability a owl:Class ;
    rdfs:label "Rater-Related Reliability"@en ;
    rdfs:subClassOf ea:Reliability .

ea:Recast a owl:Class ;
    rdfs:label "Recast"@en ;
    rdfs:subClassOf ea:OralFeedback .

ea:ScoreFeedback a owl:Class ;
    rdfs:label "Score Feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:SelfAssessment a owl:Class ;
    rdfs:label "Self-Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:SelfExaminer ] ) ] .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short-Answer Item"@en ;
    rdfs:subClassOf ea:FreeResponseItem .

ea:SplitHalfReliability a owl:Class ;
    rdfs:label "Split-Half Reliability"@en ;
    rdfs:subClassOf ea:InternalConsistencyReliability .

ea:StandardizedAssessment a owl:Class ;
    rdfs:label "Standardized Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationCategory ;
                        owl:someValuesFrom ea:StandardizedCategory ] ) ] ;
    skos:altLabel "Standardized Test"@en .

ea:StudentRelatedReliability a owl:Class ;
    rdfs:label "Student-Related Reliability"@en ;
    rdfs:subClassOf ea:Reliability .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityCategory ;
                        owl:someValuesFrom ea:SubjectiveCategory ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en .

ea:TeacherExaminer a owl:Class ;
    rdfs:label "Teacher Examiner"@en ;
    rdfs:subClassOf ea:Examiner .

ea:TestAdministrationRelatedReliability a owl:Class ;
    rdfs:label "Test Administration-Related Reliability"@en ;
    rdfs:subClassOf ea:Reliability .

ea:TestRelatedReliability a owl:Class ;
    rdfs:label "Test-Related Reliability"@en ;
    rdfs:subClassOf ea:Reliability .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:comment "Consistency of test scores from one administration to the next under the same conditions."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:comment "Scoring that trains raters to use a scoring guide scaled to accomplishment levels while remaining holistic at heart."@en ;
    rdfs:subClassOf ea:ScoringApproach .

ea:ValidAssessment a owl:Class ;
    rdfs:label "Valid Assessment"@en ;
    rdfs:comment "An assessment that measures what it is intended to measure. Note: The corpus states that a test cannot be valid unless it is reliable (reliability places an upper bound on validity), thus ValidAssessment is a subclass of ReliableAssessment."@en ;
    rdfs:subClassOf ea:Assessment,
        ea:ReliableAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasValidity ;
                        owl:someValuesFrom ea:Validity ] ) ] .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical algorithms used to estimate the effect of individual teachers or schools on student learning."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Growth Measure"@en .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isAssessmentItemOf .

ea:hasCorrectiveFeedback a owl:ObjectProperty ;
    rdfs:label "has corrective feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:CorrectiveFeedback ;
    owl:inverseOf ea:isCorrectiveFeedbackOf .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasDistractorOption a owl:ObjectProperty ;
    rdfs:label "has distractor option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:DistractorOption ;
    rdfs:subPropertyOf ea:hasOption ;
    owl:inverseOf ea:isDistractorOptionOf .

ea:hasEffectSize a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has effect size"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasEvaluativeCriterion a owl:ObjectProperty ;
    rdfs:label "has evaluative criterion"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:EvaluativeCriterion ;
    owl:inverseOf ea:isEvaluativeCriterionOf .

ea:hasGranularityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has granularity category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:GranularityCategory ;
    owl:inverseOf ea:isGranularityCategoryOf .

ea:hasItemBank a owl:ObjectProperty ;
    rdfs:label "has item bank"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemBank ;
    owl:inverseOf ea:isItemBankOf .

ea:hasItemCount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasLearningStandard a owl:ObjectProperty ;
    rdfs:label "has learning standard"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningStandard ;
    owl:inverseOf ea:isLearningStandardOf .

ea:hasMeasurementError a owl:ObjectProperty ;
    rdfs:label "has measurement error"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementError ;
    owl:inverseOf ea:isMeasurementErrorOf .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasObservedScore a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has observed score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObservedScore ;
    rdfs:subPropertyOf ea:hasTestScore .

ea:hasPassingPercentage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has passing percentage"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasQualityDefinition a owl:ObjectProperty ;
    rdfs:label "has quality definition"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:QualityDefinition ;
    owl:inverseOf ea:isQualityDefinitionOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:decimal .

ea:hasScoringApproach a owl:ObjectProperty ;
    rdfs:label "has scoring approach"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringApproach ;
    owl:inverseOf ea:isScoringApproachOf .

ea:hasScoringStrategy a owl:ObjectProperty ;
    rdfs:label "has scoring strategy"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:ScoringStrategy ;
    owl:inverseOf ea:isScoringStrategyOf .

ea:hasTestTaker a owl:ObjectProperty ;
    rdfs:label "has test taker"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestTaker ;
    owl:inverseOf ea:isTestTakerOf .

ea:hasTrueScore a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has true score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TrueScore ;
    rdfs:subPropertyOf ea:hasTestScore .

ea:AcademicProgramGranularity a owl:Class ;
    rdfs:label "Academic Program Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:comment "A scoring approach involving criterion-by-criterion judgments."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "Analytic Grading"@en .

ea:ComputerBasedTest a owl:Class ;
    rdfs:label "Computer-Based Test"@en ;
    rdfs:subClassOf ea:WrittenTest ;
    skos:altLabel "Electronic Examination"@en,
        "Online Test"@en .

ea:CourseGranularity a owl:Class ;
    rdfs:label "Course Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:DigitalPortfolio a owl:Class ;
    rdfs:label "Digital Portfolio"@en ;
    rdfs:subClassOf ea:StudentPortfolio ;
    skos:altLabel "E-Portfolio"@en,
        "Online Portfolio"@en .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:comment "Tests whether concepts or measurements that are supposed to be unrelated are unrelated."@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:label "Educational System Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:ExpertExaminer a owl:Class ;
    rdfs:label "Expert Examiner"@en ;
    rdfs:subClassOf ea:Examiner .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Educative Assessment"@en .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesCategory ;
                        owl:someValuesFrom ea:HighStakesCategory ] ) ] ;
    skos:altLabel "High-Stakes Test"@en .

ea:IndividualLearnerGranularity a owl:Class ;
    rdfs:label "Individual Learner Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:InstitutionGranularity a owl:Class ;
    rdfs:label "Institution Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Aim"@en .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:label "Learning Community Granularity"@en ;
    rdfs:subClassOf ea:GranularityCategory .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome ;
    skos:altLabel "Objective"@en .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-Response Item"@en ;
    rdfs:comment "An item in which more than one answer option may be keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed Score"@en ;
    rdfs:comment "The attained score recorded from a measurement event (X = T + E)."@en ;
    rdfs:subClassOf ea:TestScore ;
    owl:disjointWith ea:TrueScore .

ea:OralFeedback a owl:Class ;
    rdfs:label "Oral Feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:PeerExaminer a owl:Class ;
    rdfs:label "Peer Examiner"@en ;
    rdfs:subClassOf ea:Examiner .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Criterion validity when test scores predict criterion data collected at a future time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ReliableAssessment a owl:Class ;
    rdfs:label "Reliable Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReliability ;
                        owl:someValuesFrom ea:Reliability ] ) ] .

ea:SelfExaminer a owl:Class ;
    rdfs:label "Self Examiner"@en ;
    rdfs:subClassOf ea:Examiner .

ea:SystematicError a owl:Class ;
    rdfs:label "Systematic Error"@en ;
    rdfs:subClassOf ea:MeasurementError .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasKeyOption a owl:ObjectProperty ;
    rdfs:label "has key option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:KeyOption ;
    rdfs:subPropertyOf ea:hasOption ;
    owl:inverseOf ea:isKeyOptionOf .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    owl:inverseOf ea:isReliabilityOf .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemStem ;
    owl:inverseOf ea:isStemOf .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity ;
    owl:inverseOf ea:isValidityOf .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs:label "is assessment item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Assessment .

ea:isCorrectiveFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is corrective feedback of"@en ;
    rdfs:domain ea:CorrectiveFeedback ;
    rdfs:range ea:Assessment .

ea:isCutScoreOf a owl:ObjectProperty ;
    rdfs:label "is cut score of"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range ea:Assessment .

ea:isDistractorOptionOf a owl:ObjectProperty ;
    rdfs:label "is distractor option of"@en ;
    rdfs:domain ea:DistractorOption ;
    rdfs:range ea:MultipleChoiceItem .

ea:isEvaluativeCriterionOf a owl:ObjectProperty ;
    rdfs:label "is evaluative criterion of"@en ;
    rdfs:domain ea:EvaluativeCriterion ;
    rdfs:range ea:Rubric .

ea:isExaminerOf a owl:ObjectProperty ;
    rdfs:label "is examiner of"@en ;
    rdfs:domain ea:Examiner ;
    rdfs:range ea:Assessment .

ea:isFormalityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is formality category of"@en ;
    rdfs:domain ea:FormalityCategory ;
    rdfs:range ea:Assessment .

ea:isGranularityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is granularity category of"@en ;
    rdfs:domain ea:GranularityCategory ;
    rdfs:range ea:Assessment .

ea:isItemBankOf a owl:ObjectProperty ;
    rdfs:label "is item bank of"@en ;
    rdfs:domain ea:ItemBank ;
    rdfs:range ea:AssessmentItem .

ea:isKeyOptionOf a owl:ObjectProperty ;
    rdfs:label "is key option of"@en ;
    rdfs:domain ea:KeyOption ;
    rdfs:range ea:MultipleChoiceItem .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment .

ea:isLearningStandardOf a owl:ObjectProperty ;
    rdfs:label "is learning standard of"@en ;
    rdfs:domain ea:LearningStandard ;
    rdfs:range ea:Assessment .

ea:isLocalityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is locality category of"@en ;
    rdfs:domain ea:LocalityCategory ;
    rdfs:range ea:Assessment .

ea:isMeasurementErrorOf a owl:ObjectProperty ;
    rdfs:label "is measurement error of"@en ;
    rdfs:domain ea:MeasurementError ;
    rdfs:range ea:Assessment .

ea:isNormGroupOf a owl:ObjectProperty ;
    rdfs:label "is norm group of"@en ;
    rdfs:domain ea:NormGroup ;
    rdfs:range ea:NormReferencedAssessment .

ea:isObjectivityCategoryOf a owl:ObjectProperty ;
    rdfs:label "is objectivity category of"@en ;
    rdfs:domain ea:ObjectivityCategory ;
    rdfs:range ea:Assessment .

ea:isOptionOf a owl:ObjectProperty ;
    rdfs:label "is option of"@en ;
    rdfs:domain ea:ItemOption ;
    rdfs:range ea:MultipleChoiceItem .

ea:isPurposeOf a owl:ObjectProperty ;
    rdfs:label "is purpose of"@en ;
    rdfs:domain ea:PurposeCategory ;
    rdfs:range ea:Assessment .

ea:isQualityDefinitionOf a owl:ObjectProperty ;
    rdfs:label "is quality definition of"@en ;
    rdfs:domain ea:QualityDefinition ;
    rdfs:range ea:Rubric .

ea:isReferencingFrameworkOf a owl:ObjectProperty ;
    rdfs:label "is referencing framework of"@en ;
    rdfs:domain ea:ReferencingFramework ;
    rdfs:range ea:Assessment .

ea:isReliabilityOf a owl:ObjectProperty ;
    rdfs:label "is reliability of"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:Assessment .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment .

ea:isScoringApproachOf a owl:ObjectProperty ;
    rdfs:label "is scoring approach of"@en ;
    rdfs:domain ea:ScoringApproach ;
    rdfs:range ea:Assessment .

ea:isScoringStrategyOf a owl:ObjectProperty ;
    rdfs:label "is scoring strategy of"@en ;
    rdfs:domain ea:ScoringStrategy ;
    rdfs:range ea:Rubric .

ea:isStakesCategoryOf a owl:ObjectProperty ;
    rdfs:label "is stakes category of"@en ;
    rdfs:domain ea:StakesCategory ;
    rdfs:range ea:Assessment .

ea:isStandardizationCategoryOf a owl:ObjectProperty ;
    rdfs:label "is standardization category of"@en ;
    rdfs:domain ea:StandardizationCategory ;
    rdfs:range ea:Assessment .

ea:isStemOf a owl:ObjectProperty ;
    rdfs:label "is stem of"@en ;
    rdfs:domain ea:ItemStem ;
    rdfs:range ea:MultipleChoiceItem .

ea:isTemporalOrientationCategoryOf a owl:ObjectProperty ;
    rdfs:label "is temporal orientation category of"@en ;
    rdfs:domain ea:TemporalOrientationCategory ;
    rdfs:range ea:Assessment .

ea:isTestScoreOf a owl:ObjectProperty ;
    rdfs:label "is test score of"@en ;
    rdfs:domain ea:TestScore ;
    rdfs:range ea:Assessment .

ea:isTestTakerOf a owl:ObjectProperty ;
    rdfs:label "is test taker of"@en ;
    rdfs:domain ea:TestTaker ;
    rdfs:range ea:Assessment .

ea:isValidityOf a owl:ObjectProperty ;
    rdfs:label "is validity of"@en ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:Assessment .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "A rubric that evaluates various dimensions or components separately."@en ;
    rdfs:subClassOf ea:Rubric .

ea:AssessmentItemComponent a owl:Class ;
    rdfs:label "Assessment Item Component"@en ;
    rdfs:subClassOf owl:Thing .

ea:BackwardLookingCategory a owl:Class ;
    rdfs:label "Backward-Looking Category"@en ;
    rdfs:subClassOf ea:TemporalOrientationCategory .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "The extent to which operationalizations of a construct measure the construct defined by theory. Note: Modern validity theory views construct validity as overarching and subsuming all other validity evidence, whereas traditional taxonomies treat it as a coordinate category alongside content and criterion validity. Both claims are documented in the corpus."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "Extent to which an assessment relates to or predicts a theoretically related external outcome or criterion."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:EvaluativeCriterion a owl:Class ;
    rdfs:label "Evaluative Criterion"@en ;
    rdfs:subClassOf ea:RubricComponent .

ea:ExternalCategory a owl:Class ;
    rdfs:label "External Category"@en ;
    rdfs:subClassOf ea:LocalityCategory .

ea:FormalCategory a owl:Class ;
    rdfs:label "Formal Category"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory ;
    skos:altLabel "Assessment for Learning Purpose"@en,
        "Educative Purpose"@en .

ea:ForwardLookingCategory a owl:Class ;
    rdfs:label "Forward-Looking Category"@en ;
    rdfs:subClassOf ea:TemporalOrientationCategory .

ea:HighStakesCategory a owl:Class ;
    rdfs:label "High Stakes Category"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:InformalCategory a owl:Class ;
    rdfs:label "Informal Category"@en ;
    rdfs:subClassOf ea:FormalityCategory .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory ;
    skos:altLabel "Benchmark Purpose"@en .

ea:InternalCategory a owl:Class ;
    rdfs:label "Internal Category"@en ;
    rdfs:subClassOf ea:LocalityCategory .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:comment "Consistency of results across items within a test."@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Internal Consistency"@en .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ItemBank a owl:Class ;
    rdfs:label "Item Bank"@en ;
    rdfs:comment "A repository where assessment items are stored."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Test Bank"@en .

ea:LearningStandard a owl:Class ;
    rdfs:label "Learning Standard"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Performance Standard"@en .

ea:LowStakesCategory a owl:Class ;
    rdfs:label "Low Stakes Category"@en ;
    rdfs:subClassOf ea:StakesCategory .

ea:MeasurementQuality a owl:Class ;
    rdfs:label "Measurement Quality"@en ;
    rdfs:subClassOf owl:Thing .

ea:NonStandardizedCategory a owl:Class ;
    rdfs:label "Non-Standardized Category"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Norming Group"@en,
        "Reference Population"@en .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:ObjectiveCategory a owl:Class ;
    rdfs:label "Objective Category"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory ;
    skos:altLabel "Initial Assessment Purpose"@en,
        "Pre-Assessment Purpose"@en .

ea:QualityDefinition a owl:Class ;
    rdfs:label "Quality Definition"@en ;
    rdfs:subClassOf ea:RubricComponent ;
    skos:altLabel "Achievement Level Definition"@en .

ea:ScoringStrategy a owl:Class ;
    rdfs:label "Scoring Strategy"@en ;
    rdfs:subClassOf ea:RubricComponent .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory .

ea:StandardizedCategory a owl:Class ;
    rdfs:label "Standardized Category"@en ;
    rdfs:subClassOf ea:StandardizationCategory .

ea:SubjectiveCategory a owl:Class ;
    rdfs:label "Subjective Category"@en ;
    rdfs:subClassOf ea:ObjectivityCategory .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:PurposeCategory ;
    skos:altLabel "Assessment of Learning Purpose"@en .

ea:TestTaker a owl:Class ;
    rdfs:label "Test Taker"@en ;
    rdfs:subClassOf ea:Agent ;
    skos:altLabel "Candidate"@en,
        "Examinee"@en,
        "Learner"@en,
        "Student"@en .

ea:TrueScore a owl:Class ;
    rdfs:label "True Score"@en ;
    rdfs:comment "The replicable feature of the concept being measured that would recur in the absence of error."@en ;
    rdfs:subClassOf ea:TestScore .

ea:WrittenFeedback a owl:Class ;
    rdfs:label "Written Feedback"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "A test administered on paper or on a computer."@en ;
    rdfs:subClassOf ea:Test .

ea:hasFormalityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityCategory ;
    owl:inverseOf ea:isFormalityCategoryOf .

ea:hasLocalityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has locality category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LocalityCategory ;
    owl:inverseOf ea:isLocalityCategoryOf .

ea:hasObjectivityCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has objectivity category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityCategory ;
    owl:inverseOf ea:isObjectivityCategoryOf .

ea:hasOption a owl:ObjectProperty ;
    rdfs:label "has option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:ItemOption ;
    owl:inverseOf ea:isOptionOf .

ea:hasStakesCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesCategory ;
    owl:inverseOf ea:isStakesCategoryOf .

ea:hasStandardizationCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationCategory ;
    owl:inverseOf ea:isStandardizationCategoryOf .

ea:hasTemporalOrientationCategory a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has temporal orientation category"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TemporalOrientationCategory ;
    owl:inverseOf ea:isTemporalOrientationCategoryOf .

ea:hasTestScore a owl:ObjectProperty ;
    rdfs:label "has test score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestScore ;
    owl:inverseOf ea:isTestScoreOf .

ea:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:subClassOf owl:Thing .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Cutoff Score"@en,
        "Passing Score"@en .

ea:DistractorOption a owl:Class ;
    rdfs:label "Distractor Option"@en ;
    rdfs:comment "An incorrect answer option in a multiple choice item."@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Distractor"@en .

ea:FreeResponseItem a owl:Class ;
    rdfs:label "Free-Response Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Open-Ended Question"@en .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:comment "The opening problem, question, or incomplete statement of an item."@en ;
    rdfs:subClassOf ea:AssessmentItemComponent .

ea:KeyOption a owl:Class ;
    rdfs:label "Key Option"@en ;
    rdfs:comment "The correct answer option in a multiple choice item."@en ;
    rdfs:subClassOf ea:ItemOption ;
    owl:disjointWith ea:DistractorOption ;
    skos:altLabel "Key"@en .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Norm-Referenced Test"@en,
        "Normative Assessment"@en .

ea:RubricComponent a owl:Class ;
    rdfs:label "Rubric Component"@en ;
    rdfs:subClassOf owl:Thing .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:comment "A compilation of academic work and educational evidence assembled to evaluate learning progress and achievement."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Portfolio"@en .

ea:hasExaminer a owl:ObjectProperty ;
    rdfs:label "has examiner"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Examiner ;
    owl:inverseOf ea:isExaminerOf .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework ;
    owl:inverseOf ea:isReferencingFrameworkOf .

ea:FormalityCategory a owl:Class ;
    rdfs:label "Formality Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:FormalCategory ea:InformalCategory ) .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:comment "A possible answer that an examinee can choose from in an item."@en ;
    rdfs:subClassOf ea:AssessmentItemComponent .

ea:LocalityCategory a owl:Class ;
    rdfs:label "Locality Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:InternalCategory ea:ExternalCategory ) .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:comment "The discrepancy between observed scores obtained on tests and the corresponding true scores."@en ;
    rdfs:subClassOf owl:Thing .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "A form of questioning that has a single correct answer."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:SubjectiveItem ;
    skos:altLabel "Objective Question"@en .

ea:ObjectivityCategory a owl:Class ;
    rdfs:label "Objectivity Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:ObjectiveCategory ea:SubjectiveCategory ) .

ea:StakesCategory a owl:Class ;
    rdfs:label "Stakes Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:HighStakesCategory ea:LowStakesCategory ) .

ea:StandardizationCategory a owl:Class ;
    rdfs:label "Standardization Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:StandardizedCategory ea:NonStandardizedCategory ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "A form of questioning that may have more than one correct answer or way of expressing it."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    skos:altLabel "Subjective Question"@en .

ea:TemporalOrientationCategory a owl:Class ;
    rdfs:label "Temporal Orientation Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:BackwardLookingCategory ea:ForwardLookingCategory ) .

ea:TestScore a owl:Class ;
    rdfs:label "Test Score"@en ;
    rdfs:subClassOf owl:Thing .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "Statement about what students should be able to do by the end of a teaching session."@en ;
    rdfs:subClassOf owl:Thing .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:ScoringApproach a owl:Class ;
    rdfs:label "Scoring Approach"@en ;
    rdfs:subClassOf owl:Thing .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:comment "A unit of an assessment or test, stored in an item bank, representing a problem, prompt, or question."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Question"@en,
        "Test Item"@en .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:comment "Feedback received by a learner on their understanding or performance by an agent."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Feedback"@en .

ea:Examiner a owl:Class ;
    rdfs:label "Examiner"@en ;
    rdfs:subClassOf ea:Agent .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PurposeCategory ;
    owl:inverseOf ea:isPurposeOf .

ea:GranularityCategory a owl:Class ;
    rdfs:label "Granularity Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:PurposeCategory a owl:Class ;
    rdfs:label "Purpose Category"@en ;
    rdfs:subClassOf owl:Thing ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:FormativePurpose ea:SummativePurpose ea:DiagnosticPurpose ea:InterimPurpose ea:ScreeningPurpose ) .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or other attributes."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The degree to which an assessment tool measures what it is intended to measure."@en ;
    rdfs:subClassOf ea:MeasurementQuality ;
    skos:altLabel "Test Validity"@en .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:comment "An item consisting of a stem and several options, with exactly one option keyed as correct."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:ItemStem ;
            owl:onProperty ea:hasStem ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass ea:KeyOption ;
            owl:onProperty ea:hasKeyOption ;
            owl:qualifiedCardinality 1 ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Single-Best-Answer Item"@en .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide used to evaluate the quality of students' constructed responses."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Scoring Guide"@en .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency of an assessment, or freedom of a measure from measurement error."@en ;
    rdfs:subClassOf ea:MeasurementQuality .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:TrueFalseItem ea:MultipleChoiceItem ea:MultipleResponseItem ea:MatchingItem ) .

