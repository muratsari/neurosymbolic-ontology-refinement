@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology formalizing educational assessment concepts, classification axes, measurement theory, psychometrics, and evaluation standards based strictly on the provided corpus."@en .

ea:AccuracyStandard a owl:Class ;
    rdfs:subClassOf ea:StandardCategory .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:comment "Backward-looking test measuring acquired knowledge and skills."@en ;
    rdfs:subClassOf ea:Test .

ea:AnecdotalFeedback a owl:Class ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:comment "Forward-looking test predicting ability to succeed in future settings."@en ;
    rdfs:subClassOf ea:Test .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:comment "Measurement of accomplishments in realistic contexts relevant outside of school."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CapstonePortfolio a owl:Class ;
    rdfs:subClassOf ea:PortfolioAssessment .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:CommonAssessment a owl:Class ;
    rdfs:label "Common Assessment"@en ;
    rdfs:comment "Shared assessment administered consistently across classrooms or schools."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "Norm-referenced, high-stakes test ranking candidates to select top rankers for limited positions."@en ;
    rdfs:subClassOf ea:HighStakesTest,
        ea:NormReferencedTest ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:NormReferencedTest ea:HighStakesTest ) ] .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment requiring a rubric and an expert examiner due to format implicitness."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasRubric ;
                        owl:someValuesFrom ea:Rubric ] [ a owl:Restriction ;
                        owl:onProperty ea:hasExaminer ;
                        owl:someValuesFrom ea:ExpertExaminer ] ) ] .

ea:ComputerAdaptiveTest a owl:Class ;
    rdfs:label "Computer-Adaptive Test"@en ;
    rdfs:subClassOf ea:ComputerBasedTest .

ea:ComputerScorer a owl:Class ;
    rdfs:subClassOf ea:Examiner .

ea:ConsequentialValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:ConstructiveAlignment a owl:Class ;
    rdfs:label "Constructive Alignment"@en ;
    rdfs:comment "Design principle aligning intended learning outcomes, learning activities, and assessment tasks."@en .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en,
        "Subject-Matter Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "Examination evaluating student progress continuously throughout a course."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    owl:disjointWith ea:DiscriminantValidity .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-Referenced Test"@en ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:CriterionReferencedAssessment ) ] ;
    skos:altLabel "CRT"@en .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytical rubrics supporting transformative learning across developmental stages."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:DiagnosticAssessment a owl:Class ;
    rdfs:label "Diagnostic Assessment"@en ;
    rdfs:comment "Tension in corpus: One passage lists placement, formative, summative, and diagnostic assessment as coordinate alternative categories; another passage states that diagnostic assessment is a common form of formative assessment ('including diagnostic testing'). Both claims are encoded."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:DiagnosticPurpose ] ) ] ;
    skos:altLabel "Diagnostic Evaluation"@en,
        "Diagnostic Test"@en .

ea:DigitalPortfolio a owl:Class ;
    rdfs:subClassOf ea:PortfolioAssessment ;
    skos:altLabel "Online Portfolio"@en,
        "e-Portfolio"@en .

ea:EssayItem a owl:Class ;
    rdfs:subClassOf ea:FreeResponseQuestion .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:comment "Assessment set by a governing body and evaluated by independent or external personnel."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasOrigin ;
                        owl:someValuesFrom ea:ExternalOrigin ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:subClassOf ea:Validity .

ea:FacultyEvaluation a owl:Class ;
    rdfs:label "Faculty Evaluation"@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Job-Performance Evaluation"@en,
        "Teacher Evaluation"@en .

ea:FeasibilityStandard a owl:Class ;
    rdfs:subClassOf ea:StandardCategory .

ea:FillInTheBlankWithWordBankItem a owl:Class ;
    rdfs:subClassOf ea:FillInTheBlankItem ;
    owl:disjointWith ea:FillInTheBlankWithoutWordBankItem .

ea:FinalExam a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:comment "Assessment typically recorded as a numerical score or grade contributing to a final academic record."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:FormalFormality ] ) ] .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Assessment conducted during instruction to monitor student progress and provide ongoing feedback to improve learning."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Classroom Assessment"@en,
        "Educative Assessment"@en,
        "Formative Evaluation"@en .

ea:FormativeFeedback a owl:Class ;
    rdfs:subClassOf ea:Feedback .

ea:ForwardLookingAssessment a owl:Class ;
    rdfs:label "Forward-Looking Assessment"@en ;
    rdfs:comment "Assessment asking examinees to consider hypothetical future situations."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ForwardLookingPurpose ] ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:comment "Rubric providing an overall rating for a work considering all aspects jointly."@en ;
    rdfs:subClassOf ea:Rubric ;
    owl:disjointWith ea:AnalyticRubric .

ea:HumanScorer a owl:Class ;
    rdfs:subClassOf ea:Examiner .

ea:ImmediateFeedbackAssessmentTechnique a owl:Class ;
    rdfs:label "Immediate Feedback Assessment Technique"@en ;
    rdfs:subClassOf ea:CorrectiveFeedback ;
    skos:altLabel "IF-AT"@en .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:comment "Casual assessment that does not contribute directly to a final grade, such as observation or discussions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormality ;
                        owl:someValuesFrom ea:InformalFormality ] ) ] .

ea:InterMethodReliability a owl:Class ;
    rdfs:label "Inter-Method Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Form Equivalence"@en,
        "Parallel-Forms Reliability"@en .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Coder Reliability"@en,
        "Inter-Observer Reliability"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Tension in corpus: Interim assessments are viewed by some educators as formative (used diagnostically to guide instruction) and by others as summative (benchmarking progress toward end-of-course exams)."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:comment "Assessment set and marked internally by school instructors."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasOrigin ;
                        owl:someValuesFrom ea:InternalOrigin ] ) ] .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:comment "Assessment comparing present performance against the candidate's own previous performance or internal domains."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:IpsativeReferencedFramework ] ) ] ;
    skos:altLabel "Forced-Choice Assessment"@en .

ea:LowStakesTest a owl:Class ;
    rdfs:label "Low-Stakes Test"@en ;
    rdfs:subClassOf ea:LowStakesAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:LowStakesAssessment ) ] .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MathematicsItem a owl:Class ;
    rdfs:label "Mathematics Item"@en ;
    rdfs:comment "Calculation or proof question evaluated on solution steps as well as outcomes."@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:MidtermExam a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-Response Item"@en ;
    rdfs:comment "Item in which more than one option may be keyed as correct."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ea:KeyOption ;
            owl:onProperty ea:hasKeyOption ],
        ea:ObjectiveItem .

ea:NonStandardizedTest a owl:Class ;
    rdfs:label "Non-Standardized Test"@en ;
    rdfs:subClassOf ea:NonStandardizedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NonStandardizedAssessment ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "Tension noted in corpus: Objective assessment is defined as questioning with a single correct answer, yet critics argue that all assessments carry inherent cultural and content biases."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:ObjectiveScoring ] ) ] .

ea:OneBestAnswerItem a owl:Class ;
    rdfs:label "One-Best-Answer Item"@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:OralFeedback a owl:Class ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:OralTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:PaperBasedTest a owl:Class ;
    rdfs:subClassOf ea:WrittenTest .

ea:PerformanceTest a owl:Class ;
    rdfs:label "Performance Test"@en ;
    rdfs:comment "Assessment requiring an examinee to perform an active task or operation."@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Simulation"@en,
        "Work Sample"@en .

ea:PhysicalPortfolio a owl:Class ;
    rdfs:subClassOf ea:PortfolioAssessment .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "Assessment conducted prior to instruction to establish a baseline or determine optimal instructional placement."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Placement Evaluation"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PracticalTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:ProductAssessment a owl:Class ;
    rdfs:label "Product Assessment"@en ;
    rdfs:comment "Assessment of an enduring artifact such as an essay, portfolio, or artwork."@en ;
    rdfs:subClassOf ea:PerformanceAssessment ;
    owl:disjointWith ea:LivePerformanceAssessment .

ea:ProprietyStandard a owl:Class ;
    rdfs:subClassOf ea:StandardCategory .

ea:PsychologicalTest a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:Quiz a owl:Class ;
    rdfs:subClassOf ea:Test .

ea:RaterRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score Inflation"@en ;
    rdfs:comment "Increase in scores without corresponding improvement in actual student learning."@en ;
    skos:altLabel "Grade Inflation"@en .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "Assessment used to determine whether students need specialized assistance, services, or readiness for a grade or program."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:ShortAnswerItem a owl:Class ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:subClassOf ea:StandardizedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:StandardizedAssessment ) ] .

ea:StudentGrowthMeasure a owl:Class ;
    rdfs:label "Student Growth Measure"@en ;
    rdfs:comment "Measure using student test scores to quantify academic achievement and growth."@en .

ea:StudentRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "Assessment involving questioning that may have more than one correct answer or expression of the answer."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasScoringObjectivity ;
                        owl:someValuesFrom ea:SubjectiveScoring ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "Assessment administered at the conclusion of an instructional period to evaluate student learning against benchmarks or standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en,
        "Summative Evaluation"@en .

ea:SummativeFeedback a owl:Class ;
    rdfs:subClassOf ea:Feedback .

ea:TeachingToTheTest a owl:Class ;
    rdfs:label "Teaching to the Test"@en ;
    rdfs:comment "Instructional narrowing focused predominantly on the specific content evaluated by a test."@en .

ea:TestAdministrationRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:TestRelatedFactor a owl:Class ;
    rdfs:subClassOf ea:ReliabilityFactor .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:comment "Holistic scoring that trains raters to consult trait rubrics before reaching a single global score."@en ;
    rdfs:subClassOf ea:HolisticScoring .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:subClassOf ea:MultipleChoiceItem .

ea:UtilityStandard a owl:Class ;
    rdfs:subClassOf ea:StandardCategory .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical model attempting to isolate an individual teacher's effect on student learning over time."@en ;
    skos:altLabel "Growth Measure"@en .

ea:WrittenFeedback a owl:Class ;
    rdfs:subClassOf ea:CorrectiveFeedback .

ea:hasAchievementLevel a owl:ObjectProperty ;
    rdfs:label "has achievement level"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:AchievementLevel ;
    owl:inverseOf ea:isAchievementLevelOf .

ea:hasAssessmentGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has assessment granularity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentGranularity ;
    owl:inverseOf ea:isAssessmentGranularityOf .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Test ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isAssessmentItemOf .

ea:hasCronbachAlpha a owl:DatatypeProperty ;
    rdfs:label "has Cronbach alpha"@en ;
    rdfs:domain ea:InternalConsistencyReliability ;
    rdfs:range xsd:decimal .

ea:hasCutScore a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:CriterionReferencedAssessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasCutScoreValue a owl:DatatypeProperty ;
    rdfs:label "has cut score value"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasEvaluationStandard a owl:ObjectProperty ;
    rdfs:label "has evaluation standard"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:EvaluationStandard ;
    owl:inverseOf ea:isEvaluationStandardOf .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback ;
    owl:inverseOf ea:isFeedbackOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Test ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasLearningStandard a owl:ObjectProperty ;
    rdfs:label "has learning standard"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningStandard ;
    owl:inverseOf ea:isLearningStandardOf .

ea:hasMeasurementError a owl:ObjectProperty ;
    rdfs:label "has measurement error"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:MeasurementError ;
    owl:inverseOf ea:isMeasurementErrorOf .

ea:hasNormGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasObservedScore a owl:ObjectProperty ;
    rdfs:label "has observed score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObservedScore ;
    owl:inverseOf ea:isObservedScoreOf .

ea:hasReliability a owl:ObjectProperty ;
    rdfs:label "has reliability"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Reliability ;
    owl:inverseOf ea:isReliabilityOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubricCriterion a owl:ObjectProperty ;
    rdfs:label "has rubric criterion"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:RubricCriterion ;
    owl:inverseOf ea:isRubricCriterionOf .

ea:hasScoreValue a owl:DatatypeProperty ;
    rdfs:label "has score value"@en ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range xsd:decimal .

ea:hasScoringStrategy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring strategy"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:ScoringStrategy ;
    owl:inverseOf ea:isScoringStrategyOf .

ea:hasTestItemBank a owl:ObjectProperty ;
    rdfs:label "has test item bank"@en ;
    rdfs:domain ea:Test ;
    rdfs:range ea:TestItemBank ;
    owl:inverseOf ea:isTestItemBankOf .

ea:hasTestTaker a owl:ObjectProperty ;
    rdfs:label "has test taker"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TestTaker ;
    owl:inverseOf ea:isTestTakerOf .

ea:hasTrueScore a owl:ObjectProperty ;
    rdfs:label "has true score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:TrueScore ;
    owl:inverseOf ea:isTrueScoreOf .

ea:hasValidity a owl:ObjectProperty ;
    rdfs:label "has validity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Validity ;
    owl:inverseOf ea:isValidityOf .

skos:altLabel a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

ea:AcademicProgramGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:comment "Scoring breaking down work into criterion-by-criterion components."@en ;
    rdfs:subClassOf ea:ScoringStrategy ;
    skos:altLabel "Analytic Grading"@en .

ea:ComputerBasedTest a owl:Class ;
    rdfs:subClassOf ea:WrittenTest ;
    skos:altLabel "On-Screen Test"@en,
        "Online Assessment"@en,
        "eExam"@en .

ea:ConcurrentValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity .

ea:CourseGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:EducationalSystemGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:ExpertExaminer a owl:Class ;
    rdfs:subClassOf ea:Examiner .

ea:FillInTheBlankWithoutWordBankItem a owl:Class ;
    rdfs:subClassOf ea:FillInTheBlankItem .

ea:FreeResponseQuestion a owl:Class ;
    rdfs:label "Free-Response Question"@en ;
    rdfs:subClassOf ea:SubjectiveItem ;
    skos:altLabel "Essay Question"@en,
        "FRQ"@en .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:comment "Scoring that bases marks on overall integrated quality rather than separate traits."@en ;
    rdfs:subClassOf ea:ScoringStrategy ;
    owl:disjointWith ea:AnalyticScoring ;
    skos:altLabel "Holistic Grading"@en,
        "Nonreductionist Grading"@en .

ea:IndividualLearnerGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:InstitutionGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Internal Consistency"@en .

ea:LearningCommunityGranularity a owl:Class ;
    rdfs:subClassOf ea:AssessmentGranularity .

ea:LivePerformanceAssessment a owl:Class ;
    rdfs:label "Live Performance Assessment"@en ;
    rdfs:comment "Assessment of an ephemeral performance such as a recital or speech."@en ;
    rdfs:subClassOf ea:PerformanceAssessment .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:PersonnelEvaluationStandard a owl:Class ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:PredictiveValidity a owl:Class ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProgramEvaluationStandard a owl:Class ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:RandomError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:StudentEvaluationStandard a owl:Class ;
    rdfs:subClassOf ea:EvaluationStandard .

ea:SystematicError a owl:Class ;
    rdfs:subClassOf ea:MeasurementError .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:subClassOf ea:LearningOutcome .

ea:hasDistractorOption a owl:ObjectProperty ;
    rdfs:label "has distractor option"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:DistractorOption ;
    rdfs:subPropertyOf ea:hasOption ;
    owl:inverseOf ea:isDistractorOptionOf .

ea:hasExaminer a owl:ObjectProperty ;
    rdfs:label "has examiner"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Examiner ;
    owl:inverseOf ea:isExaminerOf .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasStem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stem"@en ;
    rdfs:domain ea:MultipleChoiceItem ;
    rdfs:range ea:Stem ;
    owl:inverseOf ea:isStemOf .

ea:isAchievementLevelOf a owl:ObjectProperty ;
    rdfs:label "is achievement level of"@en ;
    rdfs:domain ea:AchievementLevel ;
    rdfs:range ea:Rubric .

ea:isAssessmentGranularityOf a owl:ObjectProperty ;
    rdfs:label "is assessment granularity of"@en ;
    rdfs:domain ea:AssessmentGranularity ;
    rdfs:range ea:Assessment .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs:label "is assessment item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Test .

ea:isCutScoreOf a owl:ObjectProperty ;
    rdfs:label "is cut score of"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range ea:CriterionReferencedAssessment .

ea:isDistractorOptionOf a owl:ObjectProperty ;
    rdfs:label "is distractor option of"@en ;
    rdfs:domain ea:DistractorOption ;
    rdfs:range ea:MultipleChoiceItem ;
    rdfs:subPropertyOf ea:isOptionOf .

ea:isEvaluationStandardOf a owl:ObjectProperty ;
    rdfs:label "is evaluation standard of"@en ;
    rdfs:domain ea:EvaluationStandard ;
    rdfs:range ea:Assessment .

ea:isExaminerOf a owl:ObjectProperty ;
    rdfs:label "is examiner of"@en ;
    rdfs:domain ea:Examiner ;
    rdfs:range ea:Assessment .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is feedback of"@en ;
    rdfs:domain ea:Feedback ;
    rdfs:range ea:Assessment .

ea:isFormalityOf a owl:ObjectProperty ;
    rdfs:label "is formality of"@en ;
    rdfs:domain ea:Formality ;
    rdfs:range ea:Assessment .

ea:isKeyOptionOf a owl:ObjectProperty ;
    rdfs:label "is key option of"@en ;
    rdfs:domain ea:KeyOption ;
    rdfs:range ea:AssessmentItem ;
    rdfs:subPropertyOf ea:isOptionOf .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment .

ea:isLearningStandardOf a owl:ObjectProperty ;
    rdfs:label "is learning standard of"@en ;
    rdfs:domain ea:LearningStandard ;
    rdfs:range ea:Assessment .

ea:isMeasurementErrorOf a owl:ObjectProperty ;
    rdfs:label "is measurement error of"@en ;
    rdfs:domain ea:MeasurementError ;
    rdfs:range ea:Assessment .

ea:isNormGroupOf a owl:ObjectProperty ;
    rdfs:label "is norm group of"@en ;
    rdfs:domain ea:NormGroup ;
    rdfs:range ea:NormReferencedAssessment .

ea:isObservedScoreOf a owl:ObjectProperty ;
    rdfs:label "is observed score of"@en ;
    rdfs:domain ea:ObservedScore ;
    rdfs:range ea:Assessment .

ea:isOriginOf a owl:ObjectProperty ;
    rdfs:label "is origin of"@en ;
    rdfs:domain ea:Origin ;
    rdfs:range ea:Assessment .

ea:isPurposeOf a owl:ObjectProperty ;
    rdfs:label "is purpose of"@en ;
    rdfs:domain ea:Purpose ;
    rdfs:range ea:Assessment .

ea:isReferencingFrameworkOf a owl:ObjectProperty ;
    rdfs:label "is referencing framework of"@en ;
    rdfs:domain ea:ReferencingFramework ;
    rdfs:range ea:Assessment .

ea:isReliabilityOf a owl:ObjectProperty ;
    rdfs:label "is reliability of"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range ea:Assessment .

ea:isRubricCriterionOf a owl:ObjectProperty ;
    rdfs:label "is rubric criterion of"@en ;
    rdfs:domain ea:RubricCriterion ;
    rdfs:range ea:Rubric .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment .

ea:isScoringObjectivityOf a owl:ObjectProperty ;
    rdfs:label "is scoring objectivity of"@en ;
    rdfs:domain ea:ScoringObjectivity ;
    rdfs:range ea:Assessment .

ea:isScoringStrategyOf a owl:ObjectProperty ;
    rdfs:label "is scoring strategy of"@en ;
    rdfs:domain ea:ScoringStrategy ;
    rdfs:range ea:Rubric .

ea:isStakesLevelOf a owl:ObjectProperty ;
    rdfs:label "is stakes level of"@en ;
    rdfs:domain ea:StakesLevel ;
    rdfs:range ea:Assessment .

ea:isStandardizationStatusOf a owl:ObjectProperty ;
    rdfs:label "is standardization status of"@en ;
    rdfs:domain ea:StandardizationStatus ;
    rdfs:range ea:Assessment .

ea:isStemOf a owl:ObjectProperty ;
    rdfs:label "is stem of"@en ;
    rdfs:domain ea:Stem ;
    rdfs:range ea:MultipleChoiceItem .

ea:isTestItemBankOf a owl:ObjectProperty ;
    rdfs:label "is test item bank of"@en ;
    rdfs:domain ea:TestItemBank ;
    rdfs:range ea:Test .

ea:isTestTakerOf a owl:ObjectProperty ;
    rdfs:label "is test taker of"@en ;
    rdfs:domain ea:TestTaker ;
    rdfs:range ea:Assessment .

ea:isTrueScoreOf a owl:ObjectProperty ;
    rdfs:label "is true score of"@en ;
    rdfs:domain ea:TrueScore ;
    rdfs:range ea:Assessment .

ea:isValidityOf a owl:ObjectProperty ;
    rdfs:label "is validity of"@en ;
    rdfs:domain ea:Validity ;
    rdfs:range ea:Assessment .

ea:AchievementLevel a owl:Class ;
    rdfs:label "Achievement Level"@en .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:comment "Rubric evaluating multiple dimensions separately."@en ;
    rdfs:subClassOf ea:Rubric .

ea:AssessmentQualityAttribute a owl:Class ;
    rdfs:label "Assessment Quality Attribute"@en ;
    rdfs:comment "Core psychometric or quality dimension of an assessment."@en .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "Extent to which operationalizations measure the theoretical construct; modern theory views it as overarching."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionReferencedFramework a owl:Class ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:subClassOf ea:Validity ;
    owl:disjointUnionOf ( ea:ConcurrentValidity ea:PredictiveValidity ) ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:ExternalOrigin a owl:Class ;
    rdfs:subClassOf ea:Origin .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:FormalFormality a owl:Class ;
    rdfs:subClassOf ea:Formality .

ea:FormativePurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:ForwardLookingPurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:comment "Assessment used to make important decisions carrying significant rewards or sanctions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:HighStakesLevel ] ) ] .

ea:HighStakesLevel a owl:Class ;
    rdfs:subClassOf ea:StakesLevel .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-Stakes Test"@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:HighStakesAssessment ) ] .

ea:InformalFormality a owl:Class ;
    rdfs:subClassOf ea:Formality .

ea:InterimPurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:InternalOrigin a owl:Class ;
    rdfs:subClassOf ea:Origin .

ea:IpsativeReferencedFramework a owl:Class ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:LearningStandard a owl:Class ;
    rdfs:label "Learning Standard"@en ;
    rdfs:comment "Predetermined criterion or concise written description of what students are expected to know and be able to do."@en ;
    skos:altLabel "Content Standard"@en,
        "Performance Standard"@en .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:comment "Assessment used primarily to measure achievement or diagnose learning needs without major public consequences."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesLevel ;
                        owl:someValuesFrom ea:LowStakesLevel ] ) ] .

ea:LowStakesLevel a owl:Class ;
    rdfs:subClassOf ea:StakesLevel .

ea:NonStandardizedAssessment a owl:Class ;
    rdfs:label "Non-Standardized Assessment"@en ;
    rdfs:comment "Assessment flexible in scope, varying in conditions, format, or difficulty."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:NonStandardizedStatus ] ) ] .

ea:NonStandardizedStatus a owl:Class ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    skos:altLabel "Norming Group"@en .

ea:NormReferencedFramework a owl:Class ;
    rdfs:subClassOf ea:ReferencingFramework .

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-Referenced Test"@en ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test ea:NormReferencedAssessment ) ] ;
    skos:altLabel "NRT"@en .

ea:ObjectiveScoring a owl:Class ;
    rdfs:subClassOf ea:ScoringObjectivity .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:comment "Assessment requiring students to complete complex tasks or demonstrate hands-on proficiency."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Performance-Based Assessment"@en .

ea:PlacementPurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:RubricCriterion a owl:Class ;
    rdfs:label "Rubric Criterion"@en .

ea:ScreeningPurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:StandardizedAssessment a owl:Class ;
    rdfs:label "Standardized Assessment"@en ;
    rdfs:comment "Assessment administered and scored uniformly across all candidates."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationStatus ;
                        owl:someValuesFrom ea:StandardizedStatus ] ) ] .

ea:StandardizedStatus a owl:Class ;
    rdfs:subClassOf ea:StandardizationStatus .

ea:SubjectiveScoring a owl:Class ;
    rdfs:subClassOf ea:ScoringObjectivity .

ea:SummativePurpose a owl:Class ;
    rdfs:subClassOf ea:Purpose .

ea:TestItemBank a owl:Class ;
    rdfs:label "Test Item Bank"@en ;
    skos:altLabel "Item Bank"@en .

ea:TestTaker a owl:Class ;
    rdfs:label "Test Taker"@en ;
    skos:altLabel "Candidate"@en,
        "Examinee"@en,
        "Student"@en .

ea:TrueScore a owl:Class ;
    rdfs:label "True Score"@en .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "Test administered on paper or computer requiring typing or writing."@en ;
    rdfs:subClassOf ea:Test .

ea:hasFormality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Formality ;
    owl:inverseOf ea:isFormalityOf .

ea:hasKeyOption a owl:ObjectProperty ;
    rdfs:label "has key option"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:KeyOption ;
    rdfs:subPropertyOf ea:hasOption ;
    owl:inverseOf ea:isKeyOptionOf .

ea:hasOption a owl:ObjectProperty ;
    rdfs:label "has option"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Option ;
    owl:inverseOf ea:isOptionOf .

ea:hasOrigin a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has origin"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Origin ;
    owl:inverseOf ea:isOriginOf .

ea:hasScoringObjectivity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has scoring objectivity"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringObjectivity ;
    owl:inverseOf ea:isScoringObjectivityOf .

ea:hasStakesLevel a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes level"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesLevel ;
    owl:inverseOf ea:isStakesLevelOf .

ea:hasStandardizationStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization status"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationStatus ;
    owl:inverseOf ea:isStandardizationStatusOf .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    skos:altLabel "Cut-off Score"@en,
        "Passing Score"@en .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:comment "Questioning item that has a single predetermined correct answer."@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:ObservedScore a owl:Class ;
    rdfs:label "Observed Score"@en .

ea:PortfolioAssessment a owl:Class ;
    rdfs:label "Portfolio Assessment"@en ;
    rdfs:comment "A compilation of academic work and educational evidence collected over time."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Portfolio"@en,
        "Student Portfolio"@en .

ea:Stem a owl:Class ;
    rdfs:label "Stem"@en .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:comment "Questioning item allowing multiple correct responses or modes of expression."@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:hasReferencingFramework a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing framework"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingFramework ;
    owl:inverseOf ea:isReferencingFrameworkOf .

ea:isOptionOf a owl:ObjectProperty ;
    rdfs:label "is option of"@en ;
    rdfs:domain ea:Option ;
    rdfs:range ea:AssessmentItem .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:subClassOf ea:Feedback .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:comment "Assessment comparing candidate performance against defined, objective criteria or learning standards rather than peers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:CriterionReferencedFramework ] ) ] ;
    skos:altLabel "Standards-Based Assessment"@en .

ea:DistractorOption a owl:Class ;
    rdfs:label "Distractor Option"@en ;
    rdfs:subClassOf ea:Option ;
    skos:altLabel "Distractor"@en .

ea:Formality a owl:Class ;
    rdfs:label "Formality"@en ;
    rdfs:comment "The degree of formal structure and grade-bearing impact of an assessment."@en ;
    owl:disjointUnionOf ( ea:FormalFormality ea:InformalFormality ) .

ea:KeyOption a owl:Class ;
    rdfs:label "Key Option"@en ;
    rdfs:subClassOf ea:Option ;
    owl:disjointWith ea:DistractorOption ;
    skos:altLabel "Key"@en .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    owl:disjointUnionOf ( ea:RandomError ea:SystematicError ) .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:comment "Assessment comparing test-taker performance against a norm group or sample of peers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingFramework ;
                        owl:someValuesFrom ea:NormReferencedFramework ] ) ] ;
    skos:altLabel "Normative Assessment"@en .

ea:Option a owl:Class ;
    rdfs:label "Option"@en ;
    skos:altLabel "Alternative Answer"@en .

ea:Origin a owl:Class ;
    rdfs:label "Origin"@en ;
    rdfs:comment "The institutional locus of authoring and marking."@en ;
    owl:disjointUnionOf ( ea:ExternalOrigin ea:InternalOrigin ) .

ea:ReliabilityFactor a owl:Class ;
    rdfs:label "Reliability Factor"@en .

ea:ScoringObjectivity a owl:Class ;
    rdfs:label "Scoring Objectivity"@en ;
    rdfs:comment "The degree to which scoring relies on predetermined single correct answers versus judgment."@en ;
    owl:disjointUnionOf ( ea:ObjectiveScoring ea:SubjectiveScoring ) .

ea:ScoringStrategy a owl:Class ;
    rdfs:label "Scoring Strategy"@en .

ea:StakesLevel a owl:Class ;
    rdfs:label "Stakes Level"@en ;
    rdfs:comment "The severity or consequence attached to assessment results."@en ;
    owl:disjointUnionOf ( ea:HighStakesLevel ea:LowStakesLevel ) .

ea:StandardCategory a owl:Class ;
    rdfs:label "Standard Category"@en .

ea:StandardizationStatus a owl:Class ;
    rdfs:label "Standardization Status"@en ;
    rdfs:comment "The uniformity with which tests are administered and scored."@en ;
    owl:disjointUnionOf ( ea:NonStandardizedStatus ea:StandardizedStatus ) .

ea:EvaluationStandard a owl:Class ;
    rdfs:label "Evaluation Standard"@en ;
    rdfs:comment "Standards established to guide designing, implementing, and assessing evaluations."@en ;
    owl:disjointUnionOf ( ea:PersonnelEvaluationStandard ea:ProgramEvaluationStandard ea:StudentEvaluationStandard ) .

ea:Examiner a owl:Class ;
    rdfs:label "Examiner"@en ;
    skos:altLabel "Evaluator"@en,
        "Rater"@en,
        "Scorer"@en .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "Information provided to a learner regarding performance to guide improvement."@en .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:comment "A statement specifying what learners are expected to know or be able to do."@en ;
    owl:disjointUnionOf ( ea:IntendedLearningOutcome ea:MeasuredLearningOutcome ea:UnintendedLearningOutcome ) .

ea:ReferencingFramework a owl:Class ;
    rdfs:label "Referencing Framework"@en ;
    rdfs:comment "The reference standard against which assessment results are compared."@en ;
    owl:disjointUnionOf ( ea:CriterionReferencedFramework ea:IpsativeReferencedFramework ea:NormReferencedFramework ) .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:comment "Item consisting of a stem, one keyed correct answer, and one or more distractors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:Stem ;
            owl:onProperty ea:hasStem ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ea:KeyOption ;
            owl:onProperty ea:hasKeyOption ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ea:DistractorOption ;
            owl:onProperty ea:hasDistractorOption ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Multiple Choice Question"@en,
        "Objective Response"@en .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency and precision of measurement and freedom from measurement error."@en ;
    rdfs:subClassOf ea:AssessmentQualityAttribute .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The degree to which an assessment tool measures what it claims or is intended to measure."@en ;
    rdfs:subClassOf ea:AssessmentQualityAttribute .

ea:hasPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Purpose ;
    owl:inverseOf ea:isPurposeOf .

ea:AssessmentGranularity a owl:Class ;
    rdfs:label "Assessment Granularity"@en ;
    rdfs:comment "The organizational or structural level at which assessment focuses."@en ;
    owl:disjointUnionOf ( ea:IndividualLearnerGranularity ea:LearningCommunityGranularity ea:CourseGranularity ea:AcademicProgramGranularity ea:InstitutionGranularity ea:EducationalSystemGranularity ) .

ea:Purpose a owl:Class ;
    rdfs:label "Purpose"@en ;
    rdfs:comment "The intended educational objective or function served by an assessment."@en ;
    owl:disjointUnionOf ( ea:DiagnosticPurpose ea:FormativePurpose ea:ForwardLookingPurpose ea:InterimPurpose ea:PlacementPurpose ea:ScreeningPurpose ea:SummativePurpose ) ;
    skos:altLabel "Purpose Category"@en .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:comment "A unit of testing presented to a candidate to elicit a response."@en ;
    skos:altLabel "Item"@en,
        "Question"@en .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "An evaluation tool containing evaluative criteria, quality definitions for levels of achievement, and a scoring strategy."@en ;
    skos:altLabel "Scoring Guide"@en .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure knowledge, skill, aptitude, or physical fitness."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

