@prefix ea: <http://example.org/onto/assessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/assessment> a owl:Ontology ;
    rdfs:label "Educational Assessment Ontology"@en ;
    rdfs:comment "An ontology formalizing concepts, typologies, evaluation criteria, and psychometric properties in educational assessment based strictly on the provided corpus."@en .

ea:AchievementTest a owl:Class ;
    rdfs:label "Achievement Test"@en ;
    rdfs:comment "Backward-looking test designed to measure knowledge and skills learned in school."@en ;
    rdfs:subClassOf ea:Test .

ea:AptitudeTest a owl:Class ;
    rdfs:label "Aptitude Test"@en ;
    rdfs:comment "Forward-looking test that attempts to predict ability to succeed in a future endeavor."@en ;
    rdfs:subClassOf ea:Test .

ea:AuthenticAssessment a owl:Class ;
    rdfs:label "Authentic Assessment"@en ;
    rdfs:comment "Tension: Modeled both as a subClassOf PerformanceAssessment and as a coordinate form of assessment depending on passage."@en ;
    rdfs:subClassOf ea:Assessment,
        ea:PerformanceAssessment .

ea:CollegeAdmissionsTest a owl:Class ;
    rdfs:label "College Admissions Test"@en ;
    rdfs:subClassOf ea:Test .

ea:CompetitiveExamination a owl:Class ;
    rdfs:label "Competitive Examination"@en ;
    rdfs:comment "A norm-referenced, high-stakes test in which candidates are ranked to select a fixed top number."@en ;
    rdfs:subClassOf ea:HighStakesTest,
        ea:NormReferencedTest .

ea:ComplexAssessment a owl:Class ;
    rdfs:label "Complex Assessment"@en ;
    rdfs:comment "An assessment requiring a rubric and an expert examiner, such as a thesis or grant proposal."@en ;
    rdfs:subClassOf ea:Assessment .

ea:ComputerAdaptiveTest a owl:Class ;
    rdfs:label "Computer-Adaptive Test"@en ;
    rdfs:subClassOf ea:Test .

ea:ConsequentialValidity a owl:Class ;
    rdfs:label "Consequential Validity"@en ;
    rdfs:subClassOf ea:Validity .

ea:ContentValidity a owl:Class ;
    rdfs:label "Content Validity"@en ;
    rdfs:comment "Tension: One passage notes content validity as a coordinate category of evidence alongside criterion and construct validity, while modern validity theory subsumes it under construct validity. Modeled directly under Validity and as evidence of Construct Validity."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Logical Validity"@en .

ea:ContinuousAssessment a owl:Class ;
    rdfs:label "Continuous Assessment"@en ;
    rdfs:comment "Evaluates student progress throughout a course, often used as an alternative to final exams."@en ;
    rdfs:subClassOf ea:Assessment .

ea:CorrectiveFeedback a owl:Class ;
    rdfs:label "Corrective Feedback"@en ;
    rdfs:subClassOf ea:Feedback .

ea:CriterionReferencedTest a owl:Class ;
    rdfs:label "Criterion-Referenced Test"@en ;
    rdfs:subClassOf ea:CriterionReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingType ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] .

ea:DevelopmentalRubric a owl:Class ;
    rdfs:label "Developmental Rubric"@en ;
    rdfs:comment "A subset of analytical rubrics facilitating assessment across developmental successions."@en ;
    rdfs:subClassOf ea:AnalyticRubric .

ea:EssayItem a owl:Class ;
    rdfs:label "Essay Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExtendedResponseItem a owl:Class ;
    rdfs:label "Extended-Response Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:ExternalAssessment a owl:Class ;
    rdfs:label "External Assessment"@en ;
    rdfs:comment "Set by a governing body and marked by external or unbiased personnel."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationOrigin ;
                        owl:someValuesFrom ea:ExternalOrigin ] ) ] .

ea:FaceValidity a owl:Class ;
    rdfs:label "Face Validity"@en ;
    rdfs:comment "The extent to which a test superficially looks like it covers the concept it purports to measure."@en ;
    rdfs:subClassOf ea:Validity .

ea:FillInTheBlankItem a owl:Class ;
    rdfs:label "Fill-in-the-Blank Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:FormalAssessment a owl:Class ;
    rdfs:label "Formal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:FormalFormality ] ) ] .

ea:FormativeAssessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Ongoing, in-process assessment aimed at monitoring and improving student learning and modifying instruction."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:FormativePurpose ] ) ] ;
    skos:altLabel "Assessment for Learning"@en,
        "Educative Assessment"@en .

ea:InformalAssessment a owl:Class ;
    rdfs:label "Informal Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasFormalityType ;
                        owl:someValuesFrom ea:InformalFormality ] ) ] .

ea:IntendedLearningOutcome a owl:Class ;
    rdfs:label "Intended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:InterMethodReliability a owl:Class ;
    rdfs:label "Inter-Method Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Form Equivalence"@en,
        "Parallel-Forms Reliability"@en .

ea:InterRaterReliability a owl:Class ;
    rdfs:label "Inter-Rater Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Inter-Observer Reliability"@en,
        "Rater Reliability"@en .

ea:InterimAssessment a owl:Class ;
    rdfs:label "Interim Assessment"@en ;
    rdfs:comment "Periodic assessment to determine whether students are on track to master material for summative or standardized tests. Tension exists over whether it is formative, summative, or distinct."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:InterimPurpose ] ) ] ;
    skos:altLabel "Benchmark Assessment"@en .

ea:InternalAssessment a owl:Class ;
    rdfs:label "Internal Assessment"@en ;
    rdfs:comment "Set and marked by the school/teachers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAdministrationOrigin ;
                        owl:someValuesFrom ea:InternalOrigin ] ) ] .

ea:InternalConsistencyReliability a owl:Class ;
    rdfs:label "Internal Consistency Reliability"@en ;
    rdfs:subClassOf ea:Reliability .

ea:InternationalComparisonTest a owl:Class ;
    rdfs:label "International Comparison Test"@en ;
    rdfs:subClassOf ea:Test .

ea:IpsativeAssessment a owl:Class ;
    rdfs:label "Ipsative Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingType ;
                        owl:someValuesFrom ea:IpsativeReferencing ] ) ] ;
    skos:altLabel "Forced-Choice Assessment"@en .

ea:LowStakesAssessment a owl:Class ;
    rdfs:label "Low-Stakes Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:LowStakes ] ) ] .

ea:MatchingItem a owl:Class ;
    rdfs:label "Matching Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:MeasuredLearningOutcome a owl:Class ;
    rdfs:label "Measured Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:MeasurementError a owl:Class ;
    rdfs:label "Measurement Error"@en ;
    rdfs:subClassOf ea:PsychometricPhenomenon .

ea:MultipleChoiceItem a owl:Class ;
    rdfs:label "Multiple-Choice Item"@en ;
    rdfs:comment "Has a stem, options, exactly one correct answer (the key), and distractors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ea:ItemKey ;
            owl:onProperty ea:hasCorrectAnswer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ea:hasItemPart ;
            owl:someValuesFrom ea:ItemStem ],
        ea:ObjectiveItem ;
    skos:altLabel "MCQ"@en,
        "Objective Response"@en .

ea:MultipleResponseItem a owl:Class ;
    rdfs:label "Multiple-Response Item"@en ;
    rdfs:comment "Item where more than one answer may be keyed as correct."@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:NonStandardizedAssessment a owl:Class ;
    rdfs:label "Non-Standardized Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:NonStandardizedFormat ] ) ] .

ea:ObjectiveAssessment a owl:Class ;
    rdfs:label "Objective Assessment"@en ;
    rdfs:comment "A form of questioning that has a single correct answer."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityType ;
                        owl:someValuesFrom ea:ObjectiveObjectivity ] ) ] .

ea:OralTest a owl:Class ;
    rdfs:label "Oral Test"@en ;
    rdfs:subClassOf ea:Test .

ea:PlacementAssessment a owl:Class ;
    rdfs:label "Placement Assessment"@en ;
    rdfs:comment "Conducted before instruction to establish a baseline or place students into the instructional sequence."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:PlacementPurpose ] ) ] ;
    skos:altLabel "Initial Assessment"@en,
        "Pre-Assessment"@en,
        "Threshold Knowledge Test"@en .

ea:PortfolioAssessment a owl:Class ;
    rdfs:label "Portfolio Assessment"@en ;
    rdfs:comment "Evaluation of a compilation of academic work and educational evidence assembled over time."@en ;
    rdfs:subClassOf ea:PerformanceAssessment ;
    skos:altLabel "Portfolio-Based Assessment"@en .

ea:PracticalTest a owl:Class ;
    rdfs:label "Practical Test"@en ;
    rdfs:subClassOf ea:Test ;
    skos:altLabel "Performance Test"@en .

ea:PsychologicalTest a owl:Class ;
    rdfs:label "Psychological Test"@en ;
    rdfs:comment "Measures cognitive abilities and mental, emotional, developmental, and social characteristics."@en ;
    rdfs:subClassOf ea:Test .

ea:ScoreInflation a owl:Class ;
    rdfs:label "Score Inflation"@en ;
    rdfs:subClassOf ea:PsychometricPhenomenon .

ea:ScreeningAssessment a owl:Class ;
    rdfs:label "Screening Assessment"@en ;
    rdfs:comment "Assessment used to determine whether students need specialized assistance or are ready to begin a program."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:ScreeningPurpose ] ) ] .

ea:ShortAnswerItem a owl:Class ;
    rdfs:label "Short-Answer Item"@en ;
    rdfs:subClassOf ea:SubjectiveItem .

ea:StandardizedTest a owl:Class ;
    rdfs:label "Standardized Test"@en ;
    rdfs:subClassOf ea:StandardizedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:StandardizedFormat ] ) ] .

ea:StudentPortfolio a owl:Class ;
    rdfs:label "Student Portfolio"@en ;
    rdfs:subClassOf ea:EducationalArtifact ;
    skos:altLabel "Digital Portfolio"@en,
        "E-Portfolio"@en .

ea:SubjectiveAssessment a owl:Class ;
    rdfs:label "Subjective Assessment"@en ;
    rdfs:comment "A form of questioning that may have more than one correct answer or way of expressing it."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasObjectivityType ;
                        owl:someValuesFrom ea:SubjectiveObjectivity ] ) ] .

ea:SummativeAssessment a owl:Class ;
    rdfs:label "Summative Assessment"@en ;
    rdfs:comment "Assessment conducted at the conclusion of an instructional period to evaluate student learning against standards."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasAssessmentPurpose ;
                        owl:someValuesFrom ea:SummativePurpose ] ) ] ;
    skos:altLabel "Assessment of Learning"@en .

ea:TestRetestReliability a owl:Class ;
    rdfs:label "Test-Retest Reliability"@en ;
    rdfs:subClassOf ea:Reliability ;
    skos:altLabel "Repeatability"@en,
        "Temporal Stability"@en .

ea:TraitInformedScoring a owl:Class ;
    rdfs:label "Trait-Informed Scoring"@en ;
    rdfs:comment "Holistic at heart but trains raters using a scoring guide with multiple writing traits."@en ;
    rdfs:subClassOf ea:HolisticScoring .

ea:TrueFalseItem a owl:Class ;
    rdfs:label "True-False Item"@en ;
    rdfs:subClassOf ea:ObjectiveItem .

ea:UnintendedLearningOutcome a owl:Class ;
    rdfs:label "Unintended Learning Outcome"@en ;
    rdfs:subClassOf ea:LearningOutcome .

ea:ValueAddedMeasure a owl:Class ;
    rdfs:label "Value-Added Measure"@en ;
    rdfs:comment "Statistical algorithms using student test scores to quantify teacher impact on learning."@en ;
    rdfs:subClassOf ea:EducationalProcess ;
    skos:altLabel "Growth Measure"@en .

ea:WrittenTest a owl:Class ;
    rdfs:label "Written Test"@en ;
    rdfs:comment "A test administered on paper or on a computer (as an eExam)."@en ;
    rdfs:subClassOf ea:Test .

ea:hasAssessmentItem a owl:ObjectProperty ;
    rdfs:label "has assessment item"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentItem ;
    owl:inverseOf ea:isAssessmentItemOf .

ea:hasCriterion a owl:ObjectProperty ;
    rdfs:label "has criterion"@en ;
    rdfs:domain [ owl:unionOf ( ea:Assessment ea:Rubric ) ] ;
    rdfs:range ea:EvaluativeCriterion ;
    owl:inverseOf ea:isCriterionOf .

ea:hasCutScore a owl:ObjectProperty ;
    rdfs:label "has cut score"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:CutScore ;
    owl:inverseOf ea:isCutScoreOf .

ea:hasCutScorePercentage a owl:DatatypeProperty ;
    rdfs:label "has cut score percentage"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range xsd:decimal .

ea:hasDistractor a owl:ObjectProperty ;
    rdfs:label "has distractor"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemDistractor ;
    owl:inverseOf ea:isDistractorOf .

ea:hasFeedback a owl:ObjectProperty ;
    rdfs:label "has feedback"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Feedback ;
    owl:inverseOf ea:isFeedbackOf .

ea:hasItemCount a owl:DatatypeProperty ;
    rdfs:label "has item count"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range xsd:integer .

ea:hasLearningOutcome a owl:ObjectProperty ;
    rdfs:label "has learning outcome"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:LearningOutcome ;
    owl:inverseOf ea:isLearningOutcomeOf .

ea:hasNormGroup a owl:ObjectProperty ;
    rdfs:label "has norm group"@en ;
    rdfs:domain ea:NormReferencedAssessment ;
    rdfs:range ea:NormGroup ;
    owl:inverseOf ea:isNormGroupOf .

ea:hasPsychometricQuality a owl:ObjectProperty ;
    rdfs:label "has psychometric quality"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:PsychometricQuality ;
    owl:inverseOf ea:isPsychometricQualityOf .

ea:hasReliabilityCoefficient a owl:DatatypeProperty ;
    rdfs:label "has reliability coefficient"@en ;
    rdfs:domain ea:Reliability ;
    rdfs:range xsd:decimal .

ea:hasRubric a owl:ObjectProperty ;
    rdfs:label "has rubric"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:Rubric ;
    owl:inverseOf ea:isRubricOf .

ea:hasScoringApproach a owl:ObjectProperty ;
    rdfs:label "has scoring approach"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ScoringApproach ;
    owl:inverseOf ea:isScoringApproachOf .

ea:AnalyticScoring a owl:Class ;
    rdfs:label "Analytic Scoring"@en ;
    rdfs:comment "Involves criterion-by-criterion judgments evaluating components separately."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "Analytic Grading"@en .

ea:ConcurrentValidity a owl:Class ;
    rdfs:label "Concurrent Validity"@en ;
    rdfs:comment "Correlation between test data and criterion data collected at the same time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ConvergentValidity a owl:Class ;
    rdfs:label "Convergent Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity .

ea:CriterionReferencedAssessment a owl:Class ;
    rdfs:label "Criterion-Referenced Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingType ;
                        owl:someValuesFrom ea:CriterionReferencing ] ) ] ;
    skos:altLabel "Standards-Based Assessment"@en .

ea:DemonstrationFormat a owl:Class ;
    rdfs:label "Demonstration Format"@en ;
    rdfs:subClassOf ea:PerformanceFormat .

ea:DiagnosticPurpose a owl:Class ;
    rdfs:label "Diagnostic Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:DiscriminantValidity a owl:Class ;
    rdfs:label "Discriminant Validity"@en ;
    rdfs:subClassOf ea:ConstructValidity ;
    skos:altLabel "Divergent Validity"@en .

ea:EducationalGroup a owl:Class ;
    rdfs:label "Educational Group"@en .

ea:HighStakesAssessment a owl:Class ;
    rdfs:label "High-Stakes Assessment"@en ;
    rdfs:comment "An assessment whose results have important consequences such as penalties, graduation, or job decisions."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:HighStakes ] ) ] .

ea:HighStakesTest a owl:Class ;
    rdfs:label "High-Stakes Test"@en ;
    rdfs:subClassOf ea:HighStakesAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasStakesType ;
                        owl:someValuesFrom ea:HighStakes ] ) ] .

ea:HolisticRubric a owl:Class ;
    rdfs:label "Holistic Rubric"@en ;
    rdfs:subClassOf ea:Rubric .

ea:ItemStem a owl:Class ;
    rdfs:label "Item Stem"@en ;
    rdfs:subClassOf ea:ItemComponent .

ea:NormReferencedTest a owl:Class ;
    rdfs:label "Norm-Referenced Test"@en ;
    rdfs:subClassOf ea:NormReferencedAssessment,
        ea:Test ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Test [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingType ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] .

ea:PredictiveValidity a owl:Class ;
    rdfs:label "Predictive Validity"@en ;
    rdfs:comment "Correlation between test data collected first and criterion data collected at a later time."@en ;
    rdfs:subClassOf ea:CriterionValidity .

ea:ProductFormat a owl:Class ;
    rdfs:label "Product Format"@en ;
    rdfs:subClassOf ea:PerformanceFormat .

ea:StandardizedAssessment a owl:Class ;
    rdfs:label "Standardized Assessment"@en ;
    rdfs:comment "An assessment administered and scored in a predetermined, consistent manner across all test takers."@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasStandardizationType ;
                        owl:someValuesFrom ea:StandardizedFormat ] ) ] .

ea:hasCorrectAnswer a owl:ObjectProperty ;
    rdfs:label "has correct answer"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemOption ;
    owl:inverseOf ea:isCorrectAnswerOf .

ea:hasItemPart a owl:ObjectProperty ;
    rdfs:label "has item part"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:ItemComponent ;
    owl:inverseOf ea:isItemPartOf .

ea:isAdministrationOriginOf a owl:ObjectProperty ;
    rdfs:label "is administration origin of"@en ;
    rdfs:domain ea:AdministrationOrigin ;
    rdfs:range ea:Assessment .

ea:isAssessmentItemOf a owl:ObjectProperty ;
    rdfs:label "is assessment item of"@en ;
    rdfs:domain ea:AssessmentItem ;
    rdfs:range ea:Assessment .

ea:isAssessmentPurposeOf a owl:ObjectProperty ;
    rdfs:label "is assessment purpose of"@en ;
    rdfs:domain ea:AssessmentPurpose ;
    rdfs:range ea:Assessment .

ea:isCorrectAnswerOf a owl:ObjectProperty ;
    rdfs:label "is correct answer of"@en ;
    rdfs:domain ea:ItemOption ;
    rdfs:range ea:AssessmentItem .

ea:isCriterionOf a owl:ObjectProperty ;
    rdfs:label "is criterion of"@en ;
    rdfs:domain ea:EvaluativeCriterion ;
    rdfs:range [ owl:unionOf ( ea:Assessment ea:Rubric ) ] .

ea:isCutScoreOf a owl:ObjectProperty ;
    rdfs:label "is cut score of"@en ;
    rdfs:domain ea:CutScore ;
    rdfs:range ea:Assessment .

ea:isDistractorOf a owl:ObjectProperty ;
    rdfs:label "is distractor of"@en ;
    rdfs:domain ea:ItemDistractor ;
    rdfs:range ea:AssessmentItem .

ea:isFeedbackOf a owl:ObjectProperty ;
    rdfs:label "is feedback of"@en ;
    rdfs:domain ea:Feedback ;
    rdfs:range ea:Assessment .

ea:isFormalityTypeOf a owl:ObjectProperty ;
    rdfs:label "is formality type of"@en ;
    rdfs:domain ea:FormalityType ;
    rdfs:range ea:Assessment .

ea:isItemPartOf a owl:ObjectProperty ;
    rdfs:label "is item part of"@en ;
    rdfs:domain ea:ItemComponent ;
    rdfs:range ea:AssessmentItem .

ea:isLearningOutcomeOf a owl:ObjectProperty ;
    rdfs:label "is learning outcome of"@en ;
    rdfs:domain ea:LearningOutcome ;
    rdfs:range ea:Assessment .

ea:isNormGroupOf a owl:ObjectProperty ;
    rdfs:label "is norm group of"@en ;
    rdfs:domain ea:NormGroup ;
    rdfs:range ea:NormReferencedAssessment .

ea:isObjectivityTypeOf a owl:ObjectProperty ;
    rdfs:label "is objectivity type of"@en ;
    rdfs:domain ea:ObjectivityType ;
    rdfs:range ea:Assessment .

ea:isPsychometricQualityOf a owl:ObjectProperty ;
    rdfs:label "is psychometric quality of"@en ;
    rdfs:domain ea:PsychometricQuality ;
    rdfs:range ea:Assessment .

ea:isReferencingTypeOf a owl:ObjectProperty ;
    rdfs:label "is referencing type of"@en ;
    rdfs:domain ea:ReferencingType ;
    rdfs:range ea:Assessment .

ea:isRubricOf a owl:ObjectProperty ;
    rdfs:label "is rubric of"@en ;
    rdfs:domain ea:Rubric ;
    rdfs:range ea:Assessment .

ea:isScoringApproachOf a owl:ObjectProperty ;
    rdfs:label "is scoring approach of"@en ;
    rdfs:domain ea:ScoringApproach ;
    rdfs:range ea:Assessment .

ea:isStakesTypeOf a owl:ObjectProperty ;
    rdfs:label "is stakes type of"@en ;
    rdfs:domain ea:StakesType ;
    rdfs:range ea:Assessment .

ea:isStandardizationTypeOf a owl:ObjectProperty ;
    rdfs:label "is standardization type of"@en ;
    rdfs:domain ea:StandardizationType ;
    rdfs:range ea:Assessment .

ea:AnalyticRubric a owl:Class ;
    rdfs:label "Analytic Rubric"@en ;
    rdfs:subClassOf ea:Rubric .

ea:ConstructValidity a owl:Class ;
    rdfs:label "Construct Validity"@en ;
    rdfs:comment "Extent to which operationalizations of a construct measure the construct defined by a theory. In modern validity theory it subsumes content and criterion validity."@en ;
    rdfs:subClassOf ea:Validity .

ea:CriterionValidity a owl:Class ;
    rdfs:label "Criterion Validity"@en ;
    rdfs:comment "Extent to which an assessment correlates to an outside reference criterion."@en ;
    rdfs:subClassOf ea:Validity ;
    skos:altLabel "Criterion-Related Validity"@en .

ea:EvaluativeCriterion a owl:Class ;
    rdfs:label "Evaluative Criterion"@en ;
    rdfs:subClassOf ea:EducationalArtifact .

ea:ExternalOrigin a owl:Class ;
    rdfs:label "External Origin"@en ;
    rdfs:subClassOf ea:AdministrationOrigin .

ea:FormalFormality a owl:Class ;
    rdfs:label "Formal Formality"@en ;
    rdfs:subClassOf ea:FormalityType .

ea:FormativePurpose a owl:Class ;
    rdfs:label "Formative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:HolisticScoring a owl:Class ;
    rdfs:label "Holistic Scoring"@en ;
    rdfs:comment "Approaches student work as an integrated entity rather than reducing it to parts."@en ;
    rdfs:subClassOf ea:ScoringApproach ;
    skos:altLabel "Holistic Grading"@en,
        "Nonreductionist Grading"@en .

ea:InformalFormality a owl:Class ;
    rdfs:label "Informal Formality"@en ;
    rdfs:subClassOf ea:FormalityType .

ea:InterimPurpose a owl:Class ;
    rdfs:label "Interim Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:InternalOrigin a owl:Class ;
    rdfs:label "Internal Origin"@en ;
    rdfs:subClassOf ea:AdministrationOrigin .

ea:IpsativeReferencing a owl:Class ;
    rdfs:label "Ipsative Referencing"@en ;
    rdfs:subClassOf ea:ReferencingType .

ea:ItemKey a owl:Class ;
    rdfs:label "Item Key"@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Correct Answer"@en .

ea:LowStakes a owl:Class ;
    rdfs:label "Low Stakes"@en ;
    rdfs:subClassOf ea:StakesType .

ea:NonStandardizedFormat a owl:Class ;
    rdfs:label "Non-Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationType .

ea:NormGroup a owl:Class ;
    rdfs:label "Norm Group"@en ;
    rdfs:subClassOf ea:EducationalGroup ;
    skos:altLabel "Norming Group"@en .

ea:ObjectiveObjectivity a owl:Class ;
    rdfs:label "Objective Objectivity"@en ;
    rdfs:subClassOf ea:ObjectivityType .

ea:PerformanceAssessment a owl:Class ;
    rdfs:label "Performance Assessment"@en ;
    rdfs:comment "Requires students to perform a task or create a product rather than simply answering questions."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Performance-Based Assessment"@en .

ea:PerformanceFormat a owl:Class ;
    rdfs:label "Performance Format"@en ;
    owl:disjointUnionOf ( ea:ProductFormat ea:DemonstrationFormat ) .

ea:PlacementPurpose a owl:Class ;
    rdfs:label "Placement Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:PsychometricPhenomenon a owl:Class ;
    rdfs:label "Psychometric Phenomenon"@en .

ea:ScreeningPurpose a owl:Class ;
    rdfs:label "Screening Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:SubjectiveObjectivity a owl:Class ;
    rdfs:label "Subjective Objectivity"@en ;
    rdfs:subClassOf ea:ObjectivityType .

ea:SummativePurpose a owl:Class ;
    rdfs:label "Summative Purpose"@en ;
    rdfs:subClassOf ea:AssessmentPurpose .

ea:hasAdministrationOrigin a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has administration origin"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AdministrationOrigin ;
    owl:inverseOf ea:isAdministrationOriginOf .

ea:hasFormalityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has formality type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:FormalityType ;
    owl:inverseOf ea:isFormalityTypeOf .

ea:hasObjectivityType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has objectivity type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ObjectivityType ;
    owl:inverseOf ea:isObjectivityTypeOf .

ea:CriterionReferencing a owl:Class ;
    rdfs:label "Criterion Referencing"@en ;
    rdfs:subClassOf ea:ReferencingType .

ea:CutScore a owl:Class ;
    rdfs:label "Cut Score"@en ;
    rdfs:subClassOf ea:EducationalArtifact ;
    skos:altLabel "Cutoff Score"@en .

ea:EducationalProcess a owl:Class ;
    rdfs:label "Educational Process"@en .

ea:Feedback a owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:subClassOf ea:EducationalProcess .

ea:HighStakes a owl:Class ;
    rdfs:label "High Stakes"@en ;
    rdfs:subClassOf ea:StakesType .

ea:ItemDistractor a owl:Class ;
    rdfs:label "Item Distractor"@en ;
    rdfs:subClassOf ea:ItemOption ;
    skos:altLabel "Incorrect Answer"@en .

ea:NormReferencedAssessment a owl:Class ;
    rdfs:label "Norm-Referenced Assessment"@en ;
    rdfs:subClassOf ea:Assessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ea:Assessment [ a owl:Restriction ;
                        owl:onProperty ea:hasReferencingType ;
                        owl:someValuesFrom ea:NormReferencing ] ) ] ;
    skos:altLabel "Normative Assessment"@en .

ea:NormReferencing a owl:Class ;
    rdfs:label "Norm Referencing"@en ;
    rdfs:subClassOf ea:ReferencingType .

ea:StandardizedFormat a owl:Class ;
    rdfs:label "Standardized Format"@en ;
    rdfs:subClassOf ea:StandardizationType .

ea:hasStakesType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has stakes type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StakesType ;
    owl:inverseOf ea:isStakesTypeOf .

ea:hasStandardizationType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has standardization type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:StandardizationType ;
    owl:inverseOf ea:isStandardizationTypeOf .

ea:AdministrationOrigin a owl:Class ;
    rdfs:label "Administration Origin"@en ;
    owl:disjointUnionOf ( ea:InternalOrigin ea:ExternalOrigin ) .

ea:FormalityType a owl:Class ;
    rdfs:label "Formality Type"@en ;
    owl:disjointUnionOf ( ea:FormalFormality ea:InformalFormality ) .

ea:ItemComponent a owl:Class ;
    rdfs:label "Item Component"@en ;
    rdfs:subClassOf ea:EducationalArtifact .

ea:ItemOption a owl:Class ;
    rdfs:label "Item Option"@en ;
    rdfs:subClassOf ea:ItemComponent ;
    skos:altLabel "Alternative Answer"@en .

ea:ObjectivityType a owl:Class ;
    rdfs:label "Objectivity Type"@en ;
    owl:disjointUnionOf ( ea:ObjectiveObjectivity ea:SubjectiveObjectivity ) .

ea:PsychometricQuality a owl:Class ;
    rdfs:label "Psychometric Quality"@en ;
    owl:disjointUnionOf ( ea:Reliability ea:Validity ) .

ea:ScoringApproach a owl:Class ;
    rdfs:label "Scoring Approach"@en ;
    owl:disjointUnionOf ( ea:HolisticScoring ea:AnalyticScoring ) .

ea:StakesType a owl:Class ;
    rdfs:label "Stakes Type"@en ;
    owl:disjointUnionOf ( ea:HighStakes ea:LowStakes ) .

ea:StandardizationType a owl:Class ;
    rdfs:label "Standardization Type"@en ;
    owl:disjointUnionOf ( ea:StandardizedFormat ea:NonStandardizedFormat ) .

ea:SubjectiveItem a owl:Class ;
    rdfs:label "Subjective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem .

ea:LearningOutcome a owl:Class ;
    rdfs:label "Learning Outcome"@en ;
    rdfs:subClassOf ea:EducationalArtifact .

ea:ObjectiveItem a owl:Class ;
    rdfs:label "Objective Item"@en ;
    rdfs:subClassOf ea:AssessmentItem ;
    owl:disjointWith ea:SubjectiveItem .

ea:ReferencingType a owl:Class ;
    rdfs:label "Referencing Type"@en ;
    owl:disjointUnionOf ( ea:CriterionReferencing ea:NormReferencing ea:IpsativeReferencing ) .

ea:hasAssessmentPurpose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has assessment purpose"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:AssessmentPurpose ;
    owl:inverseOf ea:isAssessmentPurposeOf .

ea:hasReferencingType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has referencing type"@en ;
    rdfs:domain ea:Assessment ;
    rdfs:range ea:ReferencingType ;
    owl:inverseOf ea:isReferencingTypeOf .

ea:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The consistency of an assessment; freedom of a measure from measurement error."@en ;
    rdfs:subClassOf ea:PsychometricQuality .

ea:Rubric a owl:Class ;
    rdfs:label "Rubric"@en ;
    rdfs:comment "A scoring guide used to evaluate the quality of constructed responses."@en ;
    rdfs:subClassOf ea:EducationalArtifact ;
    skos:altLabel "Scoring Guide"@en .

ea:Validity a owl:Class ;
    rdfs:label "Validity"@en ;
    rdfs:comment "The extent to which an assessment measures what it is intended to measure."@en ;
    rdfs:subClassOf ea:PsychometricQuality .

ea:EducationalArtifact a owl:Class ;
    rdfs:label "Educational Artifact"@en .

ea:AssessmentPurpose a owl:Class ;
    rdfs:label "Assessment Purpose"@en ;
    owl:disjointUnionOf ( ea:PlacementPurpose ea:DiagnosticPurpose ea:FormativePurpose ea:SummativePurpose ea:InterimPurpose ea:ScreeningPurpose ) .

ea:AssessmentItem a owl:Class ;
    rdfs:label "Assessment Item"@en ;
    rdfs:subClassOf ea:EducationalArtifact ;
    skos:altLabel "Question"@en .

ea:Test a owl:Class ;
    rdfs:label "Test"@en ;
    rdfs:comment "An educational assessment intended to measure a test-taker's knowledge, skill, aptitude, physical fitness, or classification."@en ;
    rdfs:subClassOf ea:Assessment ;
    skos:altLabel "Exam"@en,
        "Examination"@en .

ea:Assessment a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "The systematic process of documenting and using empirical data on knowledge, skill, attitudes, aptitude, and beliefs to refine programs and improve student learning."@en ;
    rdfs:subClassOf ea:EducationalProcess ;
    skos:altLabel "Educational Assessment"@en,
        "Educational Evaluation"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ItemKey ea:ItemDistractor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:HolisticRubric ea:AnalyticRubric ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConcurrentValidity ea:PredictiveValidity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ea:ConvergentValidity ea:DiscriminantValidity ) .

