@prefix fis: <http://example.org/onto/securities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/securities> a owl:Ontology ;
    rdfs:label "Securities and Financial Instruments Ontology"@en ;
    rdfs:comment "An ontology formalizing financial instruments, securities, debt, equity, derivatives, and investment funds as described across regulatory, market, and accounting frameworks in the provided corpus."@en .

fis:AmericanDepositaryReceipt a owl:Class ;
    rdfs:label "American Depositary Receipt"@en ;
    rdfs:comment "A depositary receipt issued by a US bank and listed on a United States stock exchange."@en ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:AssetBackedCommercialPaper a owl:Class ;
    rdfs:label "Asset Backed Commercial Paper"@en ;
    rdfs:comment "Commercial paper backed by a commitment of assets placed into a conduit."@en ;
    rdfs:subClassOf fis:CommercialPaper ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:CommercialPaper [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Asset ] ) ] .

fis:Bank a owl:Class ;
    rdfs:label "Bank"@en ;
    rdfs:comment "A commercial credit institution that takes deposits and issues loans."@en ;
    rdfs:subClassOf fis:FinancialInstitution .

fis:CallableBond a owl:Class ;
    rdfs:label "Callable Bond"@en ;
    rdfs:comment "A bond granting the issuer the option to redeem the debt prior to its scheduled maturity date."@en ;
    rdfs:subClassOf fis:Bond .

fis:CallablePreferredStock a owl:Class ;
    rdfs:label "Callable Preferred Stock"@en ;
    rdfs:comment "Preferred stock that gives the issuing corporation the right to repurchase and retire the shares at a predetermined call price."@en ;
    rdfs:subClassOf fis:PreferredStock .

fis:CentralBank a owl:Class ;
    rdfs:label "Central Bank"@en ;
    rdfs:comment "A national or monetary union institution responsible for monetary policy and currency issuance."@en ;
    rdfs:subClassOf fis:FinancialInstitution .

fis:CentralSecuritiesDepository a owl:Class ;
    rdfs:label "Central Securities Depository"@en ;
    rdfs:comment "A specialist entity that holds securities to enable book-entry transfer and safeguard issue integrity."@en ;
    rdfs:subClassOf fis:FinancialInstitution .

fis:CertificateOfDeposit a owl:Class ;
    rdfs:label "Certificate of Deposit"@en ;
    rdfs:comment "A negotiable or non-negotiable time deposit receipt sold by depository institutions with a fixed term and specified interest rate."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:CollateralizedDebtObligation a owl:Class ;
    rdfs:label "Collateralized Debt Obligation"@en ;
    rdfs:comment "A structured asset-backed security backed by a pool of bonds, loans, or other asset-backed tranches and sliced into prioritized risk tranches."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity .

fis:CollateralizedMortgageObligation a owl:Class ;
    rdfs:label "Collateralized Mortgage Obligation"@en ;
    rdfs:comment "A structured pay-through debt obligation secured by a pool of mortgages and divided into tranches with sequential payout priorities."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:CommercialMortgageBackedSecurity a owl:Class ;
    rdfs:label "Commercial Mortgage Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by commercial real estate mortgages."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MortgageBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:CommercialMortgage ] ) ] .

fis:ConvertibleBond a owl:Class ;
    rdfs:label "Convertible Bond"@en ;
    rdfs:comment "A bond that can be converted at the election of the holder into a specified number of common shares of the issuing corporation."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond fis:HybridSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:ConvertiblePreferredStock a owl:Class ;
    rdfs:label "Convertible Preferred Stock"@en ;
    rdfs:comment "Preferred stock that includes an option for the holder to convert the shares into a predetermined number of common shares."@en ;
    rdfs:subClassOf fis:PreferredStock ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:PreferredStock [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:CorporateBond a owl:Class ;
    rdfs:label "Corporate Bond"@en ;
    rdfs:comment "A bond issued by a corporation to raise capital for commercial and industrial operations."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:CoveredBond a owl:Class ;
    rdfs:label "Covered Bond"@en ;
    rdfs:comment "A bond backed by cash flows from mortgages or public sector assets where the assets remain on the issuing bank's balance sheet."@en ;
    rdfs:subClassOf fis:Bond .

fis:CreditDefaultSwap a owl:Class ;
    rdfs:label "Credit Default Swap"@en ;
    rdfs:comment "A bilateral credit derivative contract where the protection buyer pays a periodic fee and the seller compensates the buyer upon default of a reference debt obligation."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:CumulativePreferredStock a owl:Class ;
    rdfs:label "Cumulative Preferred Stock"@en ;
    rdfs:comment "Preferred stock requiring that any passed or omitted dividends accumulate and must be paid before any dividend is paid on common stock."@en ;
    rdfs:subClassOf fis:PreferredStock .

fis:CurrencySwap a owl:Class ;
    rdfs:label "Currency Swap"@en ;
    rdfs:comment "A swap contract to exchange periodic cash flows and principal streams in two different currencies."@en ;
    rdfs:subClassOf fis:Swap .

fis:EquitySwap a owl:Class ;
    rdfs:label "Equity Swap"@en ;
    rdfs:comment "A swap contract where at least one leg is based on the return of an equity index or stock."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Stock ] ) ] .

fis:EuropeanDepositaryReceipt a owl:Class ;
    rdfs:label "European Depositary Receipt"@en ;
    rdfs:comment "A depositary receipt issued by a European bank representing foreign securities."@en ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:ExchangeTradedFund a owl:Class ;
    rdfs:label "Exchange Traded Fund"@en ;
    rdfs:comment "An investment fund holding a portfolio of assets whose shares trade continuously throughout market hours on organized exchanges at market prices."@en ;
    rdfs:subClassOf fis:InvestmentFund,
        fis:Security ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund fis:Security [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingExchange ;
                        owl:someValuesFrom fis:Exchange ] ) ] .

fis:ExchangeableBond a owl:Class ;
    rdfs:label "Exchangeable Bond"@en ;
    rdfs:comment "A bond that gives the holder the right to exchange the bond for common shares of a corporation other than the issuing company."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity .

fis:FixedRateBond a owl:Class ;
    rdfs:label "Fixed Rate Bond"@en ;
    rdfs:comment "A bond carrying a coupon payment that remains constant throughout the life of the instrument."@en ;
    rdfs:subClassOf fis:Bond .

fis:FloatingRateBond a owl:Class ;
    rdfs:label "Floating Rate Bond"@en ;
    rdfs:comment "A debt security with a variable coupon reset periodically based on a reference interest rate index."@en ;
    rdfs:subClassOf fis:Bond .

fis:ForeignExchangeForward a owl:Class ;
    rdfs:label "Foreign Exchange Forward"@en ;
    rdfs:comment "A forward contract locking in an exchange rate for the purchase or sale of a specified foreign currency on a future date."@en ;
    rdfs:subClassOf fis:Forward .

fis:ForwardRateAgreement a owl:Class ;
    rdfs:label "Forward Rate Agreement"@en ;
    rdfs:comment "An over-the-counter forward contract that determines an interest rate to be paid or received on an agreed notional principal at a future settlement date."@en ;
    rdfs:subClassOf fis:Forward .

fis:GlobalDepositaryReceipt a owl:Class ;
    rdfs:label "Global Depositary Receipt"@en ;
    rdfs:comment "A depositary receipt issued internationally across multiple jurisdictions."@en ;
    rdfs:subClassOf fis:DepositaryReceipt .

fis:GovernmentBond a owl:Class ;
    rdfs:label "Government Bond"@en ;
    rdfs:comment "A medium or long-term debt security issued by a sovereign national government."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:HedgeFund a owl:Class ;
    rdfs:label "Hedge Fund"@en ;
    rdfs:comment "A pooled investment vehicle available to high-net-worth investors employing flexible, leveraged, or speculative investment strategies."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:InflationIndexedBond a owl:Class ;
    rdfs:label "Inflation Indexed Bond"@en ;
    rdfs:comment "A bond whose principal and/or interest payments are adjusted relative to a consumer price inflation index."@en ;
    rdfs:subClassOf fis:Bond .

fis:InterestRateFuture a owl:Class ;
    rdfs:label "Interest Rate Future"@en ;
    rdfs:comment "An exchange-traded future on an interest rate instrument, such as a Treasury bond or bank bill."@en ;
    rdfs:subClassOf fis:Future .

fis:InterestRateSwap a owl:Class ;
    rdfs:label "Interest Rate Swap"@en ;
    rdfs:comment "A swap contract where counterparties exchange fixed-rate interest cash flows for floating-rate cash flows calculated on a notional principal."@en ;
    rdfs:subClassOf fis:Swap .

fis:MoneyMarketFund a owl:Class ;
    rdfs:label "Money Market Fund"@en ;
    rdfs:comment "An investment fund that invests in liquid, short-term debt instruments, commercial paper, Treasury bills, and certificates of deposit."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:MunicipalBond a owl:Class ;
    rdfs:label "Municipal Bond"@en ;
    rdfs:comment "A bond issued by a state, province, city, local authority, or special district."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:LocalGovernment ] ) ] .

fis:MutualFund a owl:Class ;
    rdfs:label "Mutual Fund"@en ;
    rdfs:comment "An open-end investment company that pools money from investors to invest in a portfolio, where shares are bought and redeemed at net asset value."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:NonCumulativePreferredStock a owl:Class ;
    rdfs:label "Non Cumulative Preferred Stock"@en ;
    rdfs:comment "Preferred stock where any omitted dividend is forfeited and does not accumulate."@en ;
    rdfs:subClassOf fis:PreferredStock .

fis:PerpetualBond a owl:Class ;
    rdfs:label "Perpetual Bond"@en ;
    rdfs:comment "A bond with no stated maturity date, paying interest indefinitely at the discretion of or until called by the issuer."@en ;
    rdfs:subClassOf fis:Bond .

fis:PutableBond a owl:Class ;
    rdfs:label "Putable Bond"@en ;
    rdfs:comment "A bond granting the holder the option to force the issuer to repay the principal prior to scheduled maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:ResidentialMortgageBackedSecurity a owl:Class ;
    rdfs:label "Residential Mortgage Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by residential real estate loans."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MortgageBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:ResidentialMortgage ] ) ] .

fis:StockFuture a owl:Class ;
    rdfs:label "Stock Future"@en ;
    rdfs:comment "A futures contract whose underlying reference asset is an individual corporate stock or equity security."@en ;
    rdfs:subClassOf fis:Future ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Future [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Stock ] ) ] .

fis:StockIndexFuture a owl:Class ;
    rdfs:label "Stock Index Future"@en ;
    rdfs:comment "A cash-settled futures contract whose underlying is a stock market index."@en ;
    rdfs:subClassOf fis:Future ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Future [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:FinancialIndex ] ) ] .

fis:StockOption a owl:Class ;
    rdfs:label "Stock Option"@en ;
    rdfs:comment "An option whose underlying asset is a share of corporate stock."@en ;
    rdfs:subClassOf fis:Option ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Stock ] ) ] .

fis:SupranationalBond a owl:Class ;
    rdfs:label "Supranational Bond"@en ;
    rdfs:comment "A bond issued by an international organization or multilateral development bank."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SupranationalOrganization ] ) ] .

fis:TreasuryBill a owl:Class ;
    rdfs:label "Treasury Bill"@en ;
    rdfs:comment "A short-term zero-coupon debt obligation issued by a national government with a maturity of one year or less."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument fis:ZeroCouponBond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:Warrant a owl:Class ;
    rdfs:label "Warrant"@en ;
    rdfs:comment "A long-dated option issued by a company that gives the holder the right to purchase shares of new equity directly from the company at a specified price."@en ;
    rdfs:subClassOf fis:Derivative,
        fis:HybridSecurity .

fis:hasCouponRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has coupon rate"@en ;
    rdfs:comment "The annual percentage interest rate paid on the par value of a debt instrument."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasExpirationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has expiration date"@en ;
    rdfs:comment "The date on which an option, forward, or future contract expires or must be settled."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:dateTime .

fis:hasHolder a owl:ObjectProperty ;
    rdfs:label "has holder"@en ;
    rdfs:comment "Relates a financial instrument or security to the investor or entity holding it."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:LegalEntity ;
    owl:inverseOf fis:isHolderOf .

fis:hasIsin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has ISIN"@en ;
    rdfs:comment "The 12-digit alphanumeric International Securities Identification Number that uniquely identifies the security."@en ;
    rdfs:domain fis:Security ;
    rdfs:range xsd:string .

fis:hasMaturityDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has maturity date"@en ;
    rdfs:comment "The date on which the principal amount of a debt security is due to be repaid and interest payments cease."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:dateTime .

fis:hasNotionalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has notional amount"@en ;
    rdfs:comment "The reference or nominal amount used to calculate periodic cash flows in swaps and other derivative contracts."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:decimal .

fis:hasParValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has par value"@en ;
    rdfs:comment "The nominal, face, or principal amount stated on a debt security or share of capital stock."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:decimal .

fis:hasPortfolioConstituent a owl:ObjectProperty ;
    rdfs:label "has portfolio constituent"@en ;
    rdfs:comment "Relates an investment portfolio to an individual asset or security contained within it."@en ;
    rdfs:domain fis:Portfolio ;
    rdfs:range fis:Asset ;
    owl:inverseOf fis:isPortfolioConstituentOf .

fis:hasStrikePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has strike price"@en ;
    rdfs:comment "The predetermined fixed price at which the holder of an option may transact the underlying asset."@en ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:decimal .

fis:hasVotingRight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has voting right"@en ;
    rdfs:comment "Indicates whether the security entitles the holder to vote on corporate governance and policy matters."@en ;
    rdfs:domain fis:EquitySecurity ;
    rdfs:range xsd:boolean .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

fis:AmericanOption a owl:Class ;
    rdfs:label "American Option"@en ;
    rdfs:comment "An option that may be exercised at any trading time on or before its expiration date."@en ;
    rdfs:subClassOf fis:Option .

fis:BermudanOption a owl:Class ;
    rdfs:label "Bermudan Option"@en ;
    rdfs:comment "An option that may be exercised on specified dates on or before expiration."@en ;
    rdfs:subClassOf fis:Option .

fis:CallOption a owl:Class ;
    rdfs:label "Call Option"@en ;
    rdfs:comment "An option that grants the buyer the right to buy the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:EuropeanOption a owl:Class ;
    rdfs:label "European Option"@en ;
    rdfs:comment "An option that may only be exercised on its expiration date."@en ;
    rdfs:subClassOf fis:Option .

fis:InstitutionalInvestor a owl:Class ;
    rdfs:label "Institutional Investor"@en ;
    rdfs:comment "An organization such as a bank, pension fund, insurance company, or mutual fund that trades securities in wholesale volume."@en ;
    rdfs:subClassOf fis:Investor .

fis:Loan a owl:Class ;
    rdfs:label "Loan"@en ;
    rdfs:comment "A non-negotiable or bilateral debt contract where a lender delivers funds to a borrower against scheduled repayment."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:PutOption a owl:Class ;
    rdfs:label "Put Option"@en ;
    rdfs:comment "An option that grants the buyer the right to sell the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:RetailInvestor a owl:Class ;
    rdfs:label "Retail Investor"@en ;
    rdfs:comment "An individual member of the public investing personally rather than by way of professional business."@en ;
    rdfs:subClassOf fis:Investor .

fis:ZeroCouponBond a owl:Class ;
    rdfs:label "Zero Coupon Bond"@en ;
    rdfs:comment "A bond that pays no periodic coupon interest, issued at a deep discount, with the full face value repaid at maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:hasClearingHouse a owl:ObjectProperty ;
    rdfs:label "has clearing house"@en ;
    rdfs:comment "Relates an exchange-traded derivative or cleared instrument to the clearing house acting as central counterparty."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:ClearingHouse ;
    owl:inverseOf fis:isClearingHouseOf .

fis:hasPortfolio a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has portfolio"@en ;
    rdfs:comment "Relates an investment fund to the portfolio of assets and securities it pools and holds."@en ;
    rdfs:domain fis:InvestmentFund ;
    rdfs:range fis:Portfolio ;
    owl:inverseOf fis:isPortfolioOf .

fis:isClearingHouseOf a owl:ObjectProperty ;
    rdfs:label "is clearing house of"@en ;
    rdfs:comment "Relates a clearing house to the financial instruments it clears."@en ;
    rdfs:domain fis:ClearingHouse ;
    rdfs:range fis:FinancialInstrument .

fis:isCollateralOf a owl:ObjectProperty ;
    rdfs:label "is collateral of"@en ;
    rdfs:comment "Relates an asset or asset pool to the debt security it pledges to back."@en ;
    rdfs:domain fis:Asset ;
    rdfs:range fis:DebtSecurity .

fis:isHolderOf a owl:ObjectProperty ;
    rdfs:label "is holder of"@en ;
    rdfs:comment "Relates an investor or entity to the financial instrument or security it holds."@en ;
    rdfs:domain fis:LegalEntity ;
    rdfs:range fis:FinancialInstrument .

fis:isIssuerOf a owl:ObjectProperty ;
    rdfs:label "is issuer of"@en ;
    rdfs:comment "Relates a legal entity to the financial instruments or securities it has issued."@en ;
    rdfs:domain fis:LegalEntity ;
    rdfs:range fis:FinancialInstrument .

fis:isPortfolioConstituentOf a owl:ObjectProperty ;
    rdfs:label "is portfolio constituent of"@en ;
    rdfs:comment "Relates an asset to the portfolio of which it is a constituent part."@en ;
    rdfs:domain fis:Asset ;
    rdfs:range fis:Portfolio .

fis:isPortfolioOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is portfolio of"@en ;
    rdfs:comment "Relates a portfolio of pooled assets to the investment fund that owns it."@en ;
    rdfs:domain fis:Portfolio ;
    rdfs:range fis:InvestmentFund .

fis:isTradingExchangeOf a owl:ObjectProperty ;
    rdfs:label "is trading exchange of"@en ;
    rdfs:comment "Relates an organized exchange to the financial instruments traded on it."@en ;
    rdfs:domain fis:Exchange ;
    rdfs:range fis:FinancialInstrument .

fis:isUnderlyingOf a owl:ObjectProperty ;
    rdfs:label "is underlying of"@en ;
    rdfs:comment "Relates an asset, index, or reference rate to the derivative or hybrid security that derives value from it."@en ;
    rdfs:domain fis:UnderlyingAsset ;
    rdfs:range fis:FinancialInstrument .

fis:CommercialMortgage a owl:Class ;
    rdfs:label "Commercial Mortgage"@en ;
    rdfs:comment "A mortgage secured by commercial or multi-dwelling income property."@en ;
    rdfs:subClassOf fis:Mortgage .

fis:CommercialPaper a owl:Class ;
    rdfs:label "Commercial Paper"@en ;
    rdfs:comment "An unsecured short-term promissory note issued by a corporation or financial institution, typically with a maturity of not more than 270 days."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:FinancialIndex a owl:Class ;
    rdfs:label "Financial Index"@en ;
    rdfs:comment "A statistical indicator or benchmark rate, such as a stock market index, inflation rate, or reference interest rate."@en .

fis:Government a owl:Class ;
    rdfs:label "Government"@en ;
    rdfs:comment "A public administrative entity exercising governing authority."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:Investor a owl:Class ;
    rdfs:label "Investor"@en ;
    rdfs:comment "A natural person or institution that allocates capital to securities with the expectation of a financial return."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:LocalGovernment a owl:Class ;
    rdfs:label "Local Government"@en ;
    rdfs:comment "A state, provincial, municipal, or city subdivision within a nation issuing municipal bonds."@en ;
    rdfs:subClassOf fis:Government .

fis:ResidentialMortgage a owl:Class ;
    rdfs:label "Residential Mortgage"@en ;
    rdfs:comment "A mortgage secured by single-family or residential real estate."@en ;
    rdfs:subClassOf fis:Mortgage .

fis:SupranationalOrganization a owl:Class ;
    rdfs:label "Supranational Organization"@en ;
    rdfs:comment "An international institution formed by multiple sovereign nations, such as the World Bank or IMF."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:hasTradingExchange a owl:ObjectProperty ;
    rdfs:label "has trading exchange"@en ;
    rdfs:comment "Relates an exchange-traded security or derivative to the organized exchange on which it is listed or traded."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Exchange ;
    owl:inverseOf fis:isTradingExchangeOf .

fis:AssetBackedSecurity a owl:Class ;
    rdfs:label "Asset Backed Security"@en ;
    rdfs:comment "A debt security whose interest and principal payments are backed by cash flows from an underlying discrete pool of receivables or loans."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Asset ] ) ] .

fis:ClearingHouse a owl:Class ;
    rdfs:label "Clearing House"@en ;
    rdfs:comment "An intermediary institution that reconciles, guarantees, and settles contract obligations between parties."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:CommonStock a owl:Class ;
    rdfs:label "Common Stock"@en ;
    rdfs:comment "Ordinary equity ownership conferring voting rights and residual claims to profits and assets upon liquidation."@en ;
    rdfs:subClassOf fis:Stock .

fis:Corporation a owl:Class ;
    rdfs:label "Corporation"@en ;
    rdfs:comment "A commercial or business enterprise that issues capital stock or corporate bonds to raise finance."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:DepositaryReceipt a owl:Class ;
    rdfs:label "Depositary Receipt"@en ;
    rdfs:comment "A negotiable instrument issued by a bank representing a foreign company's publicly traded equity, traded on a domestic exchange."@en ;
    rdfs:subClassOf fis:EquitySecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:EquitySecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Stock ] ) ] .

fis:FinancialInstitution a owl:Class ;
    rdfs:label "Financial Institution"@en ;
    rdfs:comment "An entity providing financial services, banking, intermediation, or depository facilities."@en ;
    rdfs:subClassOf fis:Corporation .

fis:Forward a owl:Class ;
    rdfs:label "Forward"@en ;
    rdfs:comment "A customized, non-standardized bilateral contract between two parties to buy or sell an asset at a predetermined price on a future date, traded over the counter."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Mortgage a owl:Class ;
    rdfs:label "Mortgage"@en ;
    rdfs:comment "A debt instrument or loan secured by specified real estate property."@en ;
    rdfs:subClassOf fis:Loan .

fis:SovereignGovernment a owl:Class ;
    rdfs:label "Sovereign Government"@en ;
    rdfs:comment "A national sovereign state issuing treasury debt securities."@en ;
    rdfs:subClassOf fis:Government .

fis:UnderlyingAsset a owl:Class ;
    rdfs:label "Underlying Asset"@en ;
    rdfs:comment "The reference item, financial instrument, commodity, currency, interest rate, index, or factual credit event upon which a derivative or structured instrument is based."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( fis:Asset fis:FinancialIndex ) ] .

fis:Exchange a owl:Class ;
    rdfs:label "Exchange"@en ;
    rdfs:comment "An organized, officially recognized secondary market where securities, derivatives, and commodities are traded."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:MoneyMarketInstrument a owl:Class ;
    rdfs:label "Money Market Instrument"@en ;
    rdfs:comment "A short-term debt instrument with an original maturity of one year or less, highly liquid and near-cash."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:EquitySecurity a owl:Class ;
    rdfs:label "Equity Security"@en ;
    rdfs:comment "A negotiable financial instrument representing an ownership interest in the residual value of a corporation, trust, or partnership after creditors are paid."@en ;
    rdfs:subClassOf fis:Security .

fis:HybridSecurity a owl:Class ;
    rdfs:label "Hybrid Security"@en ;
    rdfs:comment "A security that combines debt and equity characteristics, such as convertible debt or preference shares."@en ;
    rdfs:subClassOf fis:Security .

fis:MortgageBackedSecurity a owl:Class ;
    rdfs:label "Mortgage Backed Security"@en ;
    rdfs:comment "An asset-backed security secured by a pool of real estate mortgages."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Mortgage ] ) ] .

fis:Portfolio a owl:Class ;
    rdfs:label "Portfolio"@en ;
    rdfs:comment "A collection or pool of investments, securities, or loans held by an institution, investment fund, or investor."@en .

fis:hasCollateral a owl:ObjectProperty ;
    rdfs:label "has collateral"@en ;
    rdfs:comment "Relates a secured debt obligation or asset-backed security to the pool of assets or specific property securing it."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range fis:Asset ;
    owl:inverseOf fis:isCollateralOf .

fis:hasIssuer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has issuer"@en ;
    rdfs:comment "Relates a financial instrument or security to the legal entity that issued it."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:LegalEntity ;
    owl:inverseOf fis:isIssuerOf .

fis:Future a owl:Class ;
    rdfs:label "Future"@en ;
    rdfs:comment "A standardized contract traded on an organized exchange and cleared through a clearing house, obligating the buyer to purchase and the seller to deliver an asset at a specified price on a future date."@en ;
    rdfs:subClassOf fis:Derivative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingExchange ;
                        owl:someValuesFrom fis:Exchange ] [ a owl:Restriction ;
                        owl:onProperty fis:hasClearingHouse ;
                        owl:someValuesFrom fis:ClearingHouse ] ) ] .

fis:PreferredStock a owl:Class ;
    rdfs:label "Preferred Stock"@en ;
    rdfs:comment "A class of capital stock that has preference over common stock in dividend payments and liquidation proceeds, generally lacking voting rights."@en ;
    rdfs:subClassOf fis:HybridSecurity,
        fis:Stock .

fis:Security a owl:Class ;
    rdfs:label "Security"@en ;
    rdfs:comment "A tradable, negotiable financial asset representing an investment claim against an issuer. In jurisdictions such as the US it includes debt, equity, and derivatives, while other jurisdictions restrict the term primarily to equities and debt instruments."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:Stock a owl:Class ;
    rdfs:label "Stock"@en ;
    rdfs:comment "Shares constituting the fractional ownership of a corporation's capital stock."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:InvestmentFund a owl:Class ;
    rdfs:label "Investment Fund"@en ;
    rdfs:comment "A pooled investment vehicle that collects capital from multiple investors to purchase a diversified portfolio of securities and other assets."@en ;
    rdfs:subClassOf fis:FinancialInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:FinancialInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasPortfolio ;
                        owl:someValuesFrom fis:Portfolio ] ) ] .

fis:Swap a owl:Class ;
    rdfs:label "Swap"@en ;
    rdfs:comment "A derivative agreement between two counterparties to exchange streams of future cash flows according to a prearranged formula."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "A resource controlled by an enterprise as a result of past events from which future economic benefits are expected to flow."@en .

fis:DebtSecurity a owl:Class ;
    rdfs:label "Debt Security"@en ;
    rdfs:comment "A negotiable financial instrument serving as evidence of a promise on the part of the issuer to make payment of principal and interest to the holder on specified future dates."@en ;
    rdfs:subClassOf fis:Security .

fis:Derivative a owl:Class ;
    rdfs:label "Derivative"@en ;
    rdfs:comment "A financial contract whose value depends on the value of one or more underlying reference assets, rates, indices, or events. Traded as a security in some legal jurisdictions and as a distinct financial contract family in accounting standards (IFRS 9)."@en ;
    rdfs:subClassOf fis:FinancialInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:FinancialInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:UnderlyingAsset ] ) ] .

fis:Option a owl:Class ;
    rdfs:label "Option"@en ;
    rdfs:comment "A contract that conveys to the buyer the right, but not the obligation, to buy or sell an underlying asset at a specified strike price on or before a specified date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:hasUnderlying a owl:ObjectProperty ;
    rdfs:label "has underlying"@en ;
    rdfs:comment "Relates a derivative contract, hybrid instrument, or structured security to its underlying asset, index, reference rate, or contract."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:UnderlyingAsset ;
    owl:inverseOf fis:isUnderlyingOf .

fis:LegalEntity a owl:Class ;
    rdfs:label "Legal Entity"@en ;
    rdfs:comment "An individual, corporation, partnership, government body, or international organization capable of entering contracts and incurring obligations."@en .

fis:FinancialInstrument a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "A monetary contract between parties that gives rise to a financial asset of one entity and a financial liability or equity instrument of another entity."@en ;
    rdfs:subClassOf fis:Asset .

fis:Bond a owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:comment "A debt security under which the issuer contracts to pay the holder a fixed principal amount on a stated future maturity date and periodic coupon interest during its life."@en ;
    rdfs:subClassOf fis:DebtSecurity .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Forward fis:Future fis:Option fis:Swap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CallOption fis:PutOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:AmericanOption fis:EuropeanOption fis:BermudanOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CommonStock fis:PreferredStock ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:SovereignGovernment fis:LocalGovernment fis:SupranationalOrganization fis:Corporation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:RetailInvestor fis:InstitutionalInvestor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:ResidentialMortgage fis:CommercialMortgage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:DebtSecurity fis:EquitySecurity ) .

