@prefix fis: <http://example.org/onto/securities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/securities> a owl:Ontology ;
    rdfs:label "Securities and Financial Instruments Domain Ontology"@en ;
    rdfs:comment "An ontology formalizing securities, financial instruments, derivatives, debt, equity, funds, issuers, and related market concepts as described in financial markets corpus literature."@en .

fis:CallableBond a owl:Class ;
    rdfs:label "Callable Bond"@en ;
    rdfs:comment "A bond granting the issuer the option to redeem the debt prior to its scheduled maturity date."@en ;
    rdfs:subClassOf fis:Bond .

fis:CertificateOfDeposit a owl:Class ;
    rdfs:label "Certificate of Deposit"@en ;
    rdfs:comment "A time deposit offered by banks and depository institutions for a specified term and interest rate."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:CollateralizedDebtObligation a owl:Class ;
    rdfs:label "Collateralized Debt Obligation"@en ;
    rdfs:comment "A structured asset-backed security backed by a pool of debt obligations tranched by seniority."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity .

fis:CollateralizedMortgageObligation a owl:Class ;
    rdfs:label "Collateralized Mortgage Obligation"@en ;
    rdfs:comment "A multi-class pay-through mortgage-backed security divided into tranches with distinct priority profiles."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:CommercialPaper a owl:Class ;
    rdfs:label "Commercial Paper"@en ;
    rdfs:comment "An unsecured short-term promissory note issued by a corporation to meet immediate liquidity needs. In the US, maturity is 270 days or less."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:Commodity a owl:Class ;
    rdfs:label "Commodity"@en ;
    rdfs:comment "A basic good used in commerce, such as agricultural produce, metals, or energy resources."@en ;
    rdfs:subClassOf fis:Asset,
        fis:Underlying .

fis:ConvertibleBond a owl:Class ;
    rdfs:label "Convertible Bond"@en ;
    rdfs:comment "A corporate bond granting the holder the option to convert the debt into a predetermined number of common shares. Corpus note: Under IAS 32, this is treated as a compound instrument split between liability and equity components, rather than a single instrument."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond fis:ConvertibleSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasTargetSecurity ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:ConvertiblePreferredStock a owl:Class ;
    rdfs:label "Convertible Preferred Stock"@en ;
    rdfs:comment "Preferred stock convertible into a predetermined quantity of common shares."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:PreferredStock fis:ConvertibleSecurity ) ] .

fis:CorporateBond a owl:Class ;
    rdfs:label "Corporate Bond"@en ;
    rdfs:comment "A bond issued by a corporation or commercial enterprise."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:CoveredBond a owl:Class ;
    rdfs:label "Covered Bond"@en ;
    rdfs:comment "A debt security backed by cash flows from mortgages or public sector assets that remain on the issuer balance sheet."@en ;
    rdfs:subClassOf fis:Bond .

fis:CreditDefaultSwap a owl:Class ;
    rdfs:label "Credit Default Swap"@en ;
    rdfs:comment "A bilateral credit derivative where the protection seller agrees to compensate the protection buyer in the event of default on a reference debt obligation."@en ;
    rdfs:subClassOf fis:Swap .

fis:CumulativePreferredStock a owl:Class ;
    rdfs:label "Cumulative Preferred Stock"@en ;
    rdfs:comment "Preferred stock where any omitted dividend payments accumulate in arrears and must be paid prior to common dividends."@en ;
    rdfs:subClassOf fis:PreferredStock ;
    owl:disjointWith fis:NonCumulativePreferredStock .

fis:CurrencySwap a owl:Class ;
    rdfs:label "Currency Swap"@en ;
    rdfs:comment "A contractual agreement to exchange principal and interest payments in two distinct currencies."@en ;
    rdfs:subClassOf fis:Swap .

fis:DepositaryReceipt a owl:Class ;
    rdfs:label "Depositary Receipt"@en ;
    rdfs:comment "A negotiable certificate issued by a depositary bank representing shares of a foreign company trading on a local exchange."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:EquityDerivative a owl:Class ;
    rdfs:label "Equity Derivative"@en ;
    rdfs:comment "A derivative contract whose underlying asset is an individual stock or equity index."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:EquitySecurity ] ) ] .

fis:EquityWarrant a owl:Class ;
    rdfs:label "Equity Warrant"@en ;
    rdfs:comment "A long-dated option issued directly by a corporation allowing the holder to purchase newly issued shares at a specified price."@en ;
    rdfs:subClassOf fis:HybridSecurity,
        fis:Option .

fis:ExchangeTradedDerivative a owl:Class ;
    rdfs:label "Exchange-Traded Derivative"@en ;
    rdfs:comment "A standardized derivative contract cleared through a central clearing house and traded on an organized exchange."@en ;
    owl:disjointWith fis:OverTheCounterDerivative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:Exchange ] ) ] .

fis:FinancialLiability a owl:Class ;
    rdfs:label "Financial Liability"@en ;
    rdfs:comment "A contractual obligation to deliver cash or another financial asset to another entity, or to exchange financial instruments under potentially unfavourable conditions."@en .

fis:FixedRateBond a owl:Class ;
    rdfs:label "Fixed Rate Bond"@en ;
    rdfs:comment "A bond with a constant nominal interest rate throughout its duration."@en ;
    rdfs:subClassOf fis:Bond .

fis:FloatingRateNote a owl:Class ;
    rdfs:label "Floating Rate Note"@en ;
    rdfs:comment "A bond with a variable coupon periodically reset based on a money market reference rate."@en ;
    rdfs:subClassOf fis:Bond .

fis:GovernmentBond a owl:Class ;
    rdfs:label "Government Bond"@en ;
    rdfs:comment "A bond issued by a sovereign national government to finance public expenditure."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:InterestRateSwap a owl:Class ;
    rdfs:label "Interest Rate Swap"@en ;
    rdfs:comment "A swap contract exchanging streams of interest rate cash flows (e.g., fixed rate for floating rate) based on a notional amount."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:InterestRate ] ) ] .

fis:MarketIndex a owl:Class ;
    rdfs:label "Market Index"@en ;
    rdfs:comment "A statistical measure of the changes in a portfolio of stocks, bonds, or other indicators."@en ;
    rdfs:subClassOf fis:Underlying .

fis:MunicipalBond a owl:Class ;
    rdfs:label "Municipal Bond"@en ;
    rdfs:comment "A bond issued by a local authority, state, province, or municipal government."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SubSovereignGovernment ] ) ] .

fis:MutualFund a owl:Class ;
    rdfs:label "Mutual Fund"@en ;
    rdfs:comment "An open-ended pooled investment company whose shares are bought and redeemed at net asset value."@en ;
    rdfs:subClassOf fis:InvestmentFund ;
    owl:disjointWith fis:ExchangeTradedFund .

fis:PerpetualBond a owl:Class ;
    rdfs:label "Perpetual Bond"@en ;
    rdfs:comment "A bond with no stated maturity date that pays interest indefinitely."@en ;
    rdfs:subClassOf fis:Bond .

fis:PutableBond a owl:Class ;
    rdfs:label "Putable Bond"@en ;
    rdfs:comment "A bond granting the holder the right to force the issuer to redeem the bond prior to scheduled maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:RepurchaseAgreement a owl:Class ;
    rdfs:label "Repurchase Agreement"@en ;
    rdfs:comment "A short-term transaction combining the sale of a security with an agreement to repurchase it on a future date at a specified price."@en ;
    rdfs:subClassOf fis:FinancialContract .

fis:RetailInvestor a owl:Class ;
    rdfs:label "Retail Investor"@en ;
    rdfs:comment "Individual members of the public investing personal funds rather than on behalf of a business."@en ;
    rdfs:subClassOf fis:Investor ;
    owl:disjointWith fis:InstitutionalInvestor .

fis:SeniorBond a owl:Class ;
    rdfs:label "Senior Bond"@en ;
    rdfs:comment "A debt security that takes priority over subordinated debt in bankruptcy or liquidation."@en ;
    owl:disjointWith fis:SubordinatedBond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue false ;
                        owl:onProperty fis:hasSubordinatedStatus ] ) ] .

fis:StockOption a owl:Class ;
    rdfs:label "Stock Option"@en ;
    rdfs:comment "An option contract whose underlying reference asset is an individual corporate stock."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Stock ] ) ] .

fis:SupranationalBond a owl:Class ;
    rdfs:label "Supranational Bond"@en ;
    rdfs:comment "A bond issued by international supranational institutions."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SupranationalOrganization ] ) ] .

fis:TreasuryBill a owl:Class ;
    rdfs:label "Treasury Bill"@en ;
    rdfs:comment "A short-term debt obligation issued at a discount by a national government with maturity under one year."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:ZeroCouponBond a owl:Class ;
    rdfs:label "Zero-Coupon Bond"@en ;
    rdfs:comment "A bond that pays no periodic interest payments and is issued at a discount, repaying par at maturity."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue 0.0 ;
                        owl:onProperty fis:hasCouponRate ] ) ] .

fis:hasCurrency a owl:DatatypeProperty ;
    rdfs:label "has currency"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:string .

fis:hasExpirationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has expiration date"@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:dateTime .

fis:hasHolder a owl:ObjectProperty ;
    rdfs:label "has holder"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Investor ;
    owl:inverseOf fis:isHolderOf .

fis:hasMaturityDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has maturity date"@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:dateTime .

fis:hasMaturityInDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has maturity in days"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:integer .

fis:hasNotionalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has notional amount"@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:decimal .

fis:hasParValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has par value"@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasPortfolioMember a owl:ObjectProperty ;
    rdfs:label "has portfolio member"@en ;
    rdfs:domain fis:InvestmentFund ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:isPortfolioMemberOf .

fis:hasStrikePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has strike price"@en ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:decimal .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

fis:AmericanOption a owl:Class ;
    rdfs:label "American Option"@en ;
    rdfs:comment "An option style that may be exercised on any business date up to its expiration date."@en ;
    rdfs:subClassOf fis:Option .

fis:BearerSecurity a owl:Class ;
    rdfs:label "Bearer Security"@en ;
    rdfs:comment "A security where entitlement to rights is held merely by physical possession of the instrument without named registry."@en ;
    rdfs:subClassOf fis:Security .

fis:BermudanOption a owl:Class ;
    rdfs:label "Bermudan Option"@en ;
    rdfs:comment "An option style that may be exercised only on specified predetermined dates up to expiration."@en ;
    rdfs:subClassOf fis:Option .

fis:BookEntrySecurity a owl:Class ;
    rdfs:label "Book-Entry Security"@en ;
    rdfs:comment "A dematerialized, non-certificated security represented solely by electronic book-entry accounting records."@en ;
    rdfs:subClassOf fis:Security .

fis:CallOption a owl:Class ;
    rdfs:label "Call Option"@en ;
    rdfs:comment "An option conveying the right to buy the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:EuropeanOption a owl:Class ;
    rdfs:label "European Option"@en ;
    rdfs:comment "An option style that may be exercised only upon its specified expiration date."@en ;
    rdfs:subClassOf fis:Option .

fis:ExchangeTradedFund a owl:Class ;
    rdfs:label "Exchange-Traded Fund"@en ;
    rdfs:comment "An investment fund holding a diversified portfolio that issues shares trading continuously on a public stock exchange."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:Exchange ] ) ] .

fis:FinancialAsset a owl:Class ;
    rdfs:label "Financial Asset"@en ;
    rdfs:comment "An asset that is cash, an equity instrument of another entity, or a contractual right to receive cash or another financial instrument."@en ;
    rdfs:subClassOf fis:Asset .

fis:Forward a owl:Class ;
    rdfs:label "Forward"@en ;
    rdfs:comment "A customized bilateral over-the-counter contract to buy or sell an asset at an agreed forward price on a future date."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:hasValue false ;
                        owl:onProperty fis:hasStandardizedStatus ] [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:OverTheCounterMarket ] ) ] .

fis:Future a owl:Class ;
    rdfs:label "Future"@en ;
    rdfs:comment "A standardized, exchange-traded contract obligating parties to buy or sell an asset at a predetermined price on a specific delivery date."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty fis:hasStandardizedStatus ] [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:Exchange ] ) ] .

fis:InstitutionalInvestor a owl:Class ;
    rdfs:label "Institutional Investor"@en ;
    rdfs:comment "A specialized financial institution investing on its own account or on behalf of clients, such as banks, pension funds, or insurance companies."@en ;
    rdfs:subClassOf fis:Investor .

fis:InterestRate a owl:Class ;
    rdfs:label "Interest Rate"@en ;
    rdfs:comment "A reference rate of interest used as a benchmark for financial contracts."@en ;
    rdfs:subClassOf fis:Underlying .

fis:MortgageBackedSecurity a owl:Class ;
    rdfs:label "Mortgage-Backed Security"@en ;
    rdfs:comment "An asset-backed security secured by a pool of residential or commercial mortgages."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:MortgagePool ] ) ] .

fis:MortgagePool a owl:Class ;
    rdfs:label "Mortgage Pool"@en ;
    rdfs:comment "A pool consisting primarily of residential or commercial mortgage loans."@en ;
    rdfs:subClassOf fis:AssetPool .

fis:NonCumulativePreferredStock a owl:Class ;
    rdfs:label "Non-Cumulative Preferred Stock"@en ;
    rdfs:comment "Preferred stock where unpaid passed dividends do not accumulate and are lost to the investor."@en ;
    rdfs:subClassOf fis:PreferredStock .

fis:OverTheCounterDerivative a owl:Class ;
    rdfs:label "Over-The-Counter Derivative"@en ;
    rdfs:comment "A privately negotiated, non-cleared derivative contract transacted directly between counterparties."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:onProperty fis:hasTradingVenue ;
                        owl:someValuesFrom fis:OverTheCounterMarket ] ) ] .

fis:PutOption a owl:Class ;
    rdfs:label "Put Option"@en ;
    rdfs:comment "An option conveying the right to sell the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:RegisteredSecurity a owl:Class ;
    rdfs:label "Registered Security"@en ;
    rdfs:comment "A security whose ownership is documented and tracked on a central register maintained by the issuer or transfer agent."@en ;
    rdfs:subClassOf fis:Security .

fis:SubordinatedBond a owl:Class ;
    rdfs:label "Subordinated Bond"@en ;
    rdfs:comment "A debt security ranking below senior debt with respect to claims on assets upon issuer liquidation."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty fis:hasSubordinatedStatus ] ) ] .

fis:hasCounterparty a owl:ObjectProperty ;
    rdfs:label "has counterparty"@en ;
    rdfs:domain fis:FinancialContract ;
    rdfs:range fis:LegalEntity ;
    owl:inverseOf fis:isCounterpartyOf .

fis:hasCouponRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has coupon rate"@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasTargetSecurity a owl:ObjectProperty ;
    rdfs:label "has target security"@en ;
    rdfs:domain fis:ConvertibleSecurity ;
    rdfs:range fis:EquitySecurity ;
    owl:inverseOf fis:isTargetSecurityOf .

fis:isCollateralOf a owl:ObjectProperty ;
    rdfs:label "is collateral of"@en ;
    rdfs:domain fis:Asset ;
    rdfs:range fis:FinancialInstrument .

fis:isCounterpartyOf a owl:ObjectProperty ;
    rdfs:label "is counterparty of"@en ;
    rdfs:domain fis:LegalEntity ;
    rdfs:range fis:FinancialContract .

fis:isHolderOf a owl:ObjectProperty ;
    rdfs:label "is holder of"@en ;
    rdfs:domain fis:Investor ;
    rdfs:range fis:FinancialInstrument .

fis:isIssuerOf a owl:ObjectProperty ;
    rdfs:label "is issuer of"@en ;
    rdfs:domain fis:Issuer ;
    rdfs:range fis:FinancialInstrument .

fis:isPortfolioMemberOf a owl:ObjectProperty ;
    rdfs:label "is portfolio member of"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:InvestmentFund .

fis:isTargetSecurityOf a owl:ObjectProperty ;
    rdfs:label "is target security of"@en ;
    rdfs:domain fis:EquitySecurity ;
    rdfs:range fis:ConvertibleSecurity .

fis:isTradingVenueOf a owl:ObjectProperty ;
    rdfs:label "is trading venue of"@en ;
    rdfs:domain fis:TradingVenue ;
    rdfs:range fis:FinancialInstrument .

fis:isUnderlyingOf a owl:ObjectProperty ;
    rdfs:label "is underlying of"@en ;
    rdfs:domain fis:Underlying ;
    rdfs:range fis:Derivative .

fis:AssetBackedSecurity a owl:Class ;
    rdfs:label "Asset-Backed Security"@en ;
    rdfs:comment "A debt security whose interest and principal payments are backed by cash flows from an underlying pool of financial assets."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:AssetPool ] ) ] .

fis:AssetPool a owl:Class ;
    rdfs:label "Asset Pool"@en ;
    rdfs:comment "A discrete pool of receivables, loans, or other financial assets."@en ;
    rdfs:subClassOf fis:Asset .

fis:CommonStock a owl:Class ;
    rdfs:label "Common Stock"@en ;
    rdfs:comment "Ordinary shares conferring voting rights and discretionary dividend claims junior to all creditor and preferred claims."@en ;
    rdfs:subClassOf fis:Stock .

fis:Corporation a owl:Class ;
    rdfs:label "Corporation"@en ;
    rdfs:comment "A commercial or industrial enterprise organized under corporate law."@en ;
    rdfs:subClassOf fis:Issuer .

fis:SovereignGovernment a owl:Class ;
    rdfs:label "Sovereign Government"@en ;
    rdfs:comment "A national governing body with sovereign status that issues sovereign debt."@en ;
    rdfs:subClassOf fis:Issuer .

fis:SubSovereignGovernment a owl:Class ;
    rdfs:label "Sub-Sovereign Government"@en ;
    rdfs:comment "A state, provincial, municipal, or local governmental unit below sovereign level."@en ;
    rdfs:subClassOf fis:Issuer .

fis:SupranationalOrganization a owl:Class ;
    rdfs:label "Supranational Organization"@en ;
    rdfs:comment "An international organization established by multiple member nations, such as the World Bank or IMF."@en ;
    rdfs:subClassOf fis:Issuer .

fis:hasCollateral a owl:ObjectProperty ;
    rdfs:label "has collateral"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Asset ;
    owl:inverseOf fis:isCollateralOf .

fis:hasStandardizedStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has standardized status"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:boolean .

fis:hasSubordinatedStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has subordinated status"@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:boolean .

fis:HybridSecurity a owl:Class ;
    rdfs:label "Hybrid Security"@en ;
    rdfs:comment "A financial instrument combining characteristics of both debt securities and equity instruments."@en ;
    rdfs:subClassOf fis:Security .

fis:MoneyMarketInstrument a owl:Class ;
    rdfs:label "Money Market Instrument"@en ;
    rdfs:comment "A short-term, highly liquid debt security with an original maturity of one year or less."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:OverTheCounterMarket a owl:Class ;
    rdfs:label "Over-The-Counter Market"@en ;
    rdfs:comment "A decentralized dealer-based market where parties trade directly without a centralized exchange."@en ;
    rdfs:subClassOf fis:TradingVenue .

fis:Stock a owl:Class ;
    rdfs:label "Stock"@en ;
    rdfs:comment "Units of capital stock into which the equity ownership of a corporation is divided. Also known as shares."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:ConvertibleSecurity a owl:Class ;
    rdfs:label "Convertible Security"@en ;
    rdfs:comment "A security that may be converted into equity shares of the issuing company."@en ;
    rdfs:subClassOf fis:HybridSecurity .

fis:Exchange a owl:Class ;
    rdfs:label "Exchange"@en ;
    rdfs:comment "An organized and officially recognized marketplace for trading standardized financial instruments."@en ;
    rdfs:subClassOf fis:TradingVenue .

fis:FinancialContract a owl:Class ;
    rdfs:label "Financial Contract"@en ;
    rdfs:comment "A contract between parties governing financial transactions, rights, or obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass fis:LegalEntity ;
            owl:onProperty fis:hasCounterparty ] .

fis:InvestmentFund a owl:Class ;
    rdfs:label "Investment Fund"@en ;
    rdfs:comment "A collective investment scheme that pools capital from multiple investors to invest in a diversified portfolio of securities."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:Investor a owl:Class ;
    rdfs:label "Investor"@en ;
    rdfs:comment "A person or organization that allocates capital with the expectation of receiving financial returns."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:PreferredStock a owl:Class ;
    rdfs:label "Preferred Stock"@en ;
    rdfs:comment "A class of capital stock ranking senior to common stock regarding dividends and asset liquidation proceeds, commonly carrying fixed dividends and no voting rights."@en ;
    rdfs:subClassOf fis:HybridSecurity,
        fis:Stock .

fis:Swap a owl:Class ;
    rdfs:label "Swap"@en ;
    rdfs:comment "A derivative contract whereby counterparties agree to exchange cash flow streams over a specified duration based on an underlying notional principal."@en ;
    rdfs:subClassOf fis:Derivative .

fis:TradingVenue a owl:Class ;
    rdfs:label "Trading Venue"@en ;
    rdfs:comment "An organized market or platform on which financial instruments are traded."@en .

fis:hasIssuer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has issuer"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Issuer ;
    owl:inverseOf fis:isIssuerOf .

fis:hasUnderlying a owl:ObjectProperty ;
    rdfs:label "has underlying"@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range fis:Underlying ;
    owl:inverseOf fis:isUnderlyingOf .

fis:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "A resource with economic value that an individual, corporation, or country owns or controls."@en .

fis:EquitySecurity a owl:Class ;
    rdfs:label "Equity Security"@en ;
    rdfs:comment "A negotiable instrument acknowledging a fractional ownership interest and residual claim in an issuing entity."@en ;
    rdfs:subClassOf fis:Security,
        fis:Underlying .

fis:LegalEntity a owl:Class ;
    rdfs:label "Legal Entity"@en ;
    rdfs:comment "An individual, company, or governmental body capable of bearing legal rights and obligations."@en .

fis:hasTradingVenue a owl:ObjectProperty ;
    rdfs:label "has trading venue"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:TradingVenue ;
    owl:inverseOf fis:isTradingVenueOf .

fis:DebtSecurity a owl:Class ;
    rdfs:label "Debt Security"@en ;
    rdfs:comment "A negotiable security serving as evidence of a debt owed by an issuer to a creditor, promising repayment of principal and/or periodic interest."@en ;
    rdfs:subClassOf fis:Security .

fis:Issuer a owl:Class ;
    rdfs:label "Issuer"@en ;
    rdfs:comment "The legal entity that issues or develops securities or debt obligations."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:Security a owl:Class ;
    rdfs:label "Security"@en ;
    rdfs:comment "A tradable and negotiable financial asset that represents a claim on the issuer or equity ownership. Corpus conflict note: In the US and broadly, securities encompass debt, equity, derivatives, and pooled funds. In other jurisdictions (e.g. UK FCA handbook specifics, or civil jurisdictions), the definition specifically excludes certain instruments or restricts securities to equity and fixed income."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:Underlying a owl:Class ;
    rdfs:label "Underlying"@en ;
    rdfs:comment "The reference entity, asset, rate, index, or event from which a derivative contract derives its value."@en .

fis:Option a owl:Class ;
    rdfs:label "Option"@en ;
    rdfs:comment "A derivative contract conveying the right, but not the obligation, to buy or sell an underlying asset at a specified strike price on or before a specified date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Derivative a owl:Class ;
    rdfs:label "Derivative"@en ;
    rdfs:comment "A financial contract whose value is derived from the price, performance, or characteristics of an underlying asset, index, rate, or event. Corpus conflict note: Some sources partition derivatives into 4 basic classes (forwards, futures, options, swaps), while others (e.g. BIS) treat futures as exchange-traded standardized forwards (3 classes)."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:FinancialInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Underlying ] ) ] .

fis:Bond a owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:comment "A medium- to long-term debt security where the issuer contracts to pay the holder periodic interest payments and repay principal at maturity."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:FinancialInstrument a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "A monetary contract between parties that gives rise to a financial asset of one entity and a financial liability or equity instrument of another."@en ;
    rdfs:subClassOf fis:FinancialAsset,
        fis:FinancialContract .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CommonStock fis:PreferredStock ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:BearerSecurity fis:RegisteredSecurity fis:BookEntrySecurity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Exchange fis:OverTheCounterMarket ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Forward fis:Future fis:Option fis:Swap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CallOption fis:PutOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:AmericanOption fis:EuropeanOption fis:BermudanOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Corporation fis:SovereignGovernment fis:SubSovereignGovernment fis:SupranationalOrganization ) .

