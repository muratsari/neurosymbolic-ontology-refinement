@prefix fis: <http://example.org/onto/securities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/securities> a owl:Ontology ;
    rdfs:label "Securities and Financial Instruments Ontology"@en ;
    rdfs:comment "An ontology formalizing financial instruments, securities, debt, equity, derivatives, and investment funds as defined in the provided financial corpus."@en .

fis:CallableBond a owl:Class ;
    rdfs:label "Callable Bond"@en ;
    rdfs:comment "A bond granting the issuer the embedded option to repurchase and retire the bond prior to maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:CertificateOfDeposit a owl:Class ;
    rdfs:label "Certificate of Deposit"@en ;
    rdfs:comment "A negotiable or non-negotiable time deposit debt instrument issued by commercial banks or credit institutions."@en ;
    rdfs:subClassOf fis:DebtSecurity,
        fis:MoneyMarketInstrument .

fis:CollateralizedDebtObligation a owl:Class ;
    rdfs:label "Collateralized Debt Obligation"@en ;
    rdfs:comment "A structured asset-backed security sliced into tranches backed by a pool of bonds, loans, or other debt assets."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity .

fis:CollateralizedMortgageObligation a owl:Class ;
    rdfs:label "Collateralized Mortgage Obligation"@en ;
    rdfs:comment "A pay-through mortgage-backed security structured into multi-class tranches with sequential pay priorities."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:CommercialMortgageBackedSecurity a owl:Class ;
    rdfs:label "Commercial Mortgage-Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by commercial and multi-family real estate mortgages."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:CommercialPaper a owl:Class ;
    rdfs:label "Commercial Paper"@en ;
    rdfs:comment "An unsecured short-term promissory debt security issued by corporations with maturity of not more than 270 days."@en ;
    rdfs:subClassOf fis:DebtSecurity,
        fis:MoneyMarketInstrument .

fis:CorporateBond a owl:Class ;
    rdfs:label "Corporate Bond"@en ;
    rdfs:comment "A bond issued by a business corporation to finance ongoing operations, expansion, or mergers."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:CoveredBond a owl:Class ;
    rdfs:label "Covered Bond"@en ;
    rdfs:comment "A debt security backed by cash flows from mortgages or public sector assets that remain on the issuer's balance sheet."@en ;
    rdfs:subClassOf fis:Bond .

fis:CurrencySwap a owl:Class ;
    rdfs:label "Currency Swap"@en ;
    rdfs:comment "A swap agreement exchanging periodic interest and principal payments in two different currencies."@en ;
    rdfs:subClassOf fis:Swap .

fis:Debenture a owl:Class ;
    rdfs:label "Debenture"@en ;
    rdfs:comment "An unsecured debt security having only a general claim on the issuer's assets, typically with long maturity of at least ten years."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:DepositaryReceipt a owl:Class ;
    rdfs:label "Depositary Receipt"@en ;
    rdfs:comment "A negotiable financial instrument issued by a bank to represent a foreign company's publicly traded securities."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:ExchangeTradedFund a owl:Class ;
    rdfs:label "Exchange-Traded Fund"@en ;
    rdfs:comment "An investment fund whose shares trade continuously on national securities exchanges at market prices throughout trading hours."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:ExchangeableBond a owl:Class ;
    rdfs:label "Exchangeable Bond"@en ;
    rdfs:comment "A bond allowing conversion into the shares of a corporation other than the issuing company."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity .

fis:FixedRateBond a owl:Class ;
    rdfs:label "Fixed Rate Bond"@en ;
    rdfs:comment "A bond with coupon payments that remain constant throughout the life of the bond."@en ;
    rdfs:subClassOf fis:Bond .

fis:FloatingRateNote a owl:Class ;
    rdfs:label "Floating Rate Note"@en ;
    rdfs:comment "A debt instrument whose coupon rate is periodically reset relative to a money market reference rate (such as SOFR or LIBOR)."@en ;
    rdfs:subClassOf fis:Bond .

fis:HedgeFund a owl:Class ;
    rdfs:label "Hedge Fund"@en ;
    rdfs:comment "A private pooled investment fund open to high-net-worth investors that uses flexible, speculative strategies including short selling and leverage."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:InflationIndexedBond a owl:Class ;
    rdfs:label "Inflation-Indexed Bond"@en ;
    rdfs:comment "A bond whose principal and/or coupon payments are adjusted according to changes in a consumer price index."@en ;
    rdfs:subClassOf fis:Bond .

fis:InterestRateSwap a owl:Class ;
    rdfs:label "Interest Rate Swap"@en ;
    rdfs:comment "A swap agreement to exchange future interest cash flow streams (e.g. fixed for floating) based on a specified notional principal."@en ;
    rdfs:subClassOf fis:Swap .

fis:MunicipalBond a owl:Class ;
    rdfs:label "Municipal Bond"@en ;
    rdfs:comment "A bond issued by a state, city, local authority, or sub-sovereign entity."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Municipality ] ) ] .

fis:MutualFund a owl:Class ;
    rdfs:label "Mutual Fund"@en ;
    rdfs:comment "An open-end investment company that issues shares purchased and redeemed at net asset value (NAV) calculated at market close."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:Note a owl:Class ;
    rdfs:label "Note"@en ;
    rdfs:comment "A medium-term debt security with maturity typically shorter than a debenture (between one and ten years)."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:PerpetualBond a owl:Class ;
    rdfs:label "Perpetual Bond"@en ;
    rdfs:comment "A bond with no stated maturity date that pays interest indefinitely (irredeemable bond)."@en ;
    rdfs:subClassOf fis:Bond .

fis:PutableBond a owl:Class ;
    rdfs:label "Putable Bond"@en ;
    rdfs:comment "A bond granting the holder the embedded option to force the issuer to redeem the bond prior to maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:ResidentialMortgageBackedSecurity a owl:Class ;
    rdfs:label "Residential Mortgage-Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by residential property mortgages."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity .

fis:SupranationalBond a owl:Class ;
    rdfs:label "Supranational Bond"@en ;
    rdfs:comment "A bond issued by a supranational international organization (e.g., World Bank, IMF)."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SupranationalOrganization ] ) ] .

fis:TreasuryBill a owl:Class ;
    rdfs:label "Treasury Bill"@en ;
    rdfs:comment "A short-term zero-coupon sovereign debt security maturing in one year or less, issued at a discount."@en ;
    rdfs:subClassOf fis:GovernmentBond,
        fis:MoneyMarketInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:GovernmentBond fis:MoneyMarketInstrument fis:ZeroCouponBond ) ] .

fis:hasCounterparty a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has counterparty"@en ;
    rdfs:comment "Relates a financial contract or derivative to its participating contractual counterparties."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Counterparty ;
    owl:inverseOf fis:isCounterpartyOf .

fis:hasCouponRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has coupon rate"@en ;
    rdfs:comment "The annual interest rate stated on a debt security."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasHolder a owl:ObjectProperty ;
    rdfs:label "has holder"@en ;
    rdfs:comment "Identifies the investor, creditor, or shareholder holding the financial instrument."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Investor ;
    owl:inverseOf fis:isHolderOf .

fis:hasIsin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has ISIN"@en ;
    rdfs:comment "The 12-digit alphanumeric International Securities Identification Number."@en ;
    rdfs:domain fis:Security ;
    rdfs:range xsd:string .

fis:hasMaturityDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has maturity date"@en ;
    rdfs:comment "The date on which the debt principal is repaid or a contract reaches final settlement."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:dateTime .

fis:hasNotionalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has notional amount"@en ;
    rdfs:comment "The nominal or reference dollar amount used to calculate payments on swaps and derivatives."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:decimal .

fis:hasParValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has par value"@en ;
    rdfs:comment "The nominal or face value of a debt security or stock."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:decimal .

fis:hasPortfolioAsset a owl:ObjectProperty ;
    rdfs:label "has portfolio asset"@en ;
    rdfs:comment "Relates an investment fund or pooled vehicle to a constituent security or asset within its portfolio."@en ;
    rdfs:domain fis:InvestmentFund ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:isPortfolioAssetOf .

fis:hasStrikePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has strike price"@en ;
    rdfs:comment "The specified price at which an option or warrant holder can transact the underlying."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fis:Option fis:EquityWarrant ) ] ;
    rdfs:range xsd:decimal .

fis:hasTermInDays a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has term in days"@en ;
    rdfs:comment "The duration or tenor of an instrument measured in days."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range xsd:integer .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

fis:CallOption a owl:Class ;
    rdfs:label "Call Option"@en ;
    rdfs:comment "An option giving the holder the right, but not the obligation, to buy the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:CashInstrument a owl:Class ;
    rdfs:label "Cash Instrument"@en ;
    rdfs:comment "Financial instrument whose value is determined directly by the markets; includes transferable securities as well as non-negotiable loans and deposits."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:Forward a owl:Class ;
    rdfs:label "Forward Contract"@en ;
    rdfs:comment "A customized, non-standardized bilateral contract traded over the counter to buy or sell an underlying at a predetermined price on a future date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Future a owl:Class ;
    rdfs:label "Futures Contract"@en ;
    rdfs:comment "A standardized, exchange-traded derivative contract obligating both parties to transact an underlying asset at a specified future date and price."@en ;
    rdfs:subClassOf fis:Derivative .

fis:InstitutionalInvestor a owl:Class ;
    rdfs:label "Institutional Investor"@en ;
    rdfs:comment "Financial institutions investing on their own account or on behalf of clients, including banks, pension funds, and insurance companies."@en ;
    rdfs:subClassOf fis:Investor .

fis:PutOption a owl:Class ;
    rdfs:label "Put Option"@en ;
    rdfs:comment "An option giving the holder the right, but not the obligation, to sell the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option .

fis:RetailInvestor a owl:Class ;
    rdfs:label "Retail Investor"@en ;
    rdfs:comment "Members of the public investing personal funds rather than acting by way of business."@en ;
    rdfs:subClassOf fis:Investor .

fis:SpecialPurposeVehicle a owl:Class ;
    rdfs:label "Special Purpose Vehicle"@en ;
    rdfs:comment "A legal entity or trust created specifically to hold pooled assets and issue asset-backed securities."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:ZeroCouponBond a owl:Class ;
    rdfs:label "Zero-Coupon Bond"@en ;
    rdfs:comment "A bond that pays no periodic interest coupons, issued at a discount, repaying full par value at maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:hasReferenceEntity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has reference entity"@en ;
    rdfs:comment "Identifies the reference entity whose credit risk or default event is referenced by a credit derivative."@en ;
    rdfs:domain fis:CreditDefaultSwap ;
    rdfs:range fis:LegalEntity ;
    owl:inverseOf fis:isReferenceEntityOf .

fis:isConvertibleTargetOf a owl:ObjectProperty ;
    rdfs:label "is convertible target of"@en ;
    rdfs:domain fis:CommonStock ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( fis:ConvertibleBond fis:ConvertiblePreferredStock fis:EquityWarrant ) ] .

fis:isCounterpartyOf a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is counterparty of"@en ;
    rdfs:domain fis:Counterparty ;
    rdfs:range fis:FinancialInstrument .

fis:isHolderOf a owl:ObjectProperty ;
    rdfs:label "is holder of"@en ;
    rdfs:domain fis:Investor ;
    rdfs:range fis:FinancialInstrument .

fis:isPortfolioAssetOf a owl:ObjectProperty ;
    rdfs:label "is portfolio asset of"@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:InvestmentFund .

fis:isReferenceEntityOf a owl:ObjectProperty ;
    rdfs:label "is reference entity of"@en ;
    rdfs:domain fis:LegalEntity ;
    rdfs:range fis:CreditDefaultSwap .

fis:isUnderlyingOf a owl:ObjectProperty ;
    rdfs:label "is underlying of"@en ;
    rdfs:domain fis:Underlying ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( fis:Derivative fis:AssetBackedSecurity ) ] .

fis:ConvertibleBond a owl:Class ;
    rdfs:label "Convertible Bond"@en ;
    rdfs:comment "A hybrid corporate bond that the holder can convert into a predetermined number of common stock shares."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond fis:HybridSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasConvertibleTarget ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:ConvertiblePreferredStock a owl:Class ;
    rdfs:label "Convertible Preferred Stock"@en ;
    rdfs:comment "Preferred stock convertible into a predetermined number of shares of common stock."@en ;
    rdfs:subClassOf fis:PreferredStock ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:PreferredStock [ a owl:Restriction ;
                        owl:onProperty fis:hasConvertibleTarget ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:Corporation a owl:Class ;
    rdfs:label "Corporation"@en ;
    rdfs:comment "A commercial or industrial corporate entity."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:Counterparty a owl:Class ;
    rdfs:label "Counterparty"@en ;
    rdfs:comment "A legal entity that is a participant in a financial transaction or contract."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:CreditDefaultSwap a owl:Class ;
    rdfs:label "Credit Default Swap"@en ;
    rdfs:comment "A credit derivative contract in which the protection seller agrees to compensate the buyer upon a default or credit event of a reference entity."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasReferenceEntity ;
                        owl:someValuesFrom fis:LegalEntity ] ) ] .

fis:Government a owl:Class ;
    rdfs:label "Government"@en ;
    rdfs:comment "A sovereign national government."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:GovernmentBond a owl:Class ;
    rdfs:label "Government Bond"@en ;
    rdfs:comment "A debt security issued by a sovereign national government or treasury."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Government ] ) ] .

fis:Municipality a owl:Class ;
    rdfs:label "Municipality"@en ;
    rdfs:comment "A local or sub-sovereign governmental body (state, province, city, town)."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:PreferredStock a owl:Class ;
    rdfs:label "Preferred Stock"@en ;
    rdfs:comment "A class of capital stock that has preference in dividend payments and liquidation proceeds over common stock, usually lacking voting rights."@en ;
    rdfs:subClassOf fis:EquitySecurity,
        fis:HybridSecurity .

fis:SupranationalOrganization a owl:Class ;
    rdfs:label "Supranational Organization"@en ;
    rdfs:comment "An international organization or development bank formed by multiple nations (e.g., World Bank, IMF)."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:hasUnderlying a owl:ObjectProperty ;
    rdfs:label "has underlying"@en ;
    rdfs:comment "Identifies the underlying asset, reference rate, index, or factual event from which a derivative or structured product derives its value."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fis:Derivative fis:AssetBackedSecurity ) ] ;
    rdfs:range fis:Underlying ;
    owl:inverseOf fis:isUnderlyingOf .

fis:isIssuerOf a owl:ObjectProperty ;
    rdfs:label "is issuer of"@en ;
    rdfs:domain fis:Issuer ;
    rdfs:range fis:FinancialInstrument .

fis:EquityWarrant a owl:Class ;
    rdfs:label "Equity Warrant"@en ;
    rdfs:comment "A long-dated option issued by a company allowing the holder to purchase shares of the company at a fixed strike price."@en ;
    rdfs:subClassOf fis:HybridSecurity,
        fis:Option ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Option fis:HybridSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasConvertibleTarget ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:Issuer a owl:Class ;
    rdfs:label "Issuer"@en ;
    rdfs:comment "The company, government, or legal entity that issues securities or financial instruments."@en ;
    rdfs:subClassOf fis:LegalEntity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:LegalEntity [ a owl:Restriction ;
                        owl:onProperty fis:isIssuerOf ;
                        owl:someValuesFrom fis:FinancialInstrument ] ) ] .

fis:MortgageBackedSecurity a owl:Class ;
    rdfs:label "Mortgage-Backed Security"@en ;
    rdfs:comment "An asset-backed security secured by a pool of residential or commercial mortgage loans."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity .

fis:hasConvertibleTarget a owl:ObjectProperty ;
    rdfs:label "has convertible target"@en ;
    rdfs:comment "Relates a convertible security to the equity shares into which it can be converted."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( fis:ConvertibleBond fis:ConvertiblePreferredStock fis:EquityWarrant ) ] ;
    rdfs:range fis:CommonStock ;
    owl:inverseOf fis:isConvertibleTargetOf .

fis:AssetBackedSecurity a owl:Class ;
    rdfs:label "Asset-Backed Security"@en ;
    rdfs:comment "A debt security whose interest and principal payments are backed by cash flows from an underlying pool of financial assets."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Underlying ] ) ] .

fis:EquitySecurity a owl:Class ;
    rdfs:label "Equity Security"@en ;
    rdfs:comment "A negotiable security representing fractional ownership or a residual equity interest in the issuer's capital stock."@en ;
    rdfs:subClassOf fis:Security .

fis:Investor a owl:Class ;
    rdfs:label "Investor"@en ;
    rdfs:comment "A person or organization providing capital by purchasing or holding financial securities."@en ;
    rdfs:subClassOf fis:LegalEntity .

fis:MoneyMarketInstrument a owl:Class ;
    rdfs:label "Money Market Instrument"@en ;
    rdfs:comment "A liquid short-term debt instrument with an original maturity of one year or less (near cash)."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:Underlying a owl:Class ;
    rdfs:label "Underlying"@en ;
    rdfs:comment "The reference entity, commodity, financial instrument, interest rate, currency, index, or credit event driving a derivative or structured instrument."@en .

fis:CommonStock a owl:Class ;
    rdfs:label "Common Stock"@en ;
    rdfs:comment "A form of corporate equity ownership conferring voting rights and residual claims on corporate earnings and liquidation proceeds."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:InvestmentFund a owl:Class ;
    rdfs:label "Investment Fund"@en ;
    rdfs:comment "A collective investment vehicle that pools capital from multiple investors to invest in a diversified portfolio of securities and other assets."@en ;
    rdfs:subClassOf fis:Security .

fis:Security a owl:Class ;
    rdfs:label "Security"@en ;
    rdfs:comment "A tradable, negotiable financial asset representing an investment claim against an issuer."@en ;
    rdfs:subClassOf fis:CashInstrument .

fis:Swap a owl:Class ;
    rdfs:label "Swap"@en ;
    rdfs:comment "A derivative contract in which two counterparties agree to exchange streams of cash flows calculated on a notional principal according to a predetermined formula."@en ;
    rdfs:subClassOf fis:Derivative .

fis:hasIssuer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has issuer"@en ;
    rdfs:comment "Identifies the issuing legal entity that borrows capital or creates the security or financial instrument."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Issuer ;
    owl:inverseOf fis:isIssuerOf .

fis:HybridSecurity a owl:Class ;
    rdfs:label "Hybrid Security"@en ;
    rdfs:comment "A security combining debt and equity characteristics, such as convertible bonds and preferred shares."@en ;
    rdfs:subClassOf fis:Security .

fis:Option a owl:Class ;
    rdfs:label "Option"@en ;
    rdfs:comment "A financial derivative contract giving the owner the right, but not the obligation, to buy or sell an underlying asset at a specified strike price on or before a specified date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Derivative a owl:Class ;
    rdfs:label "Derivative"@en ;
    rdfs:comment "A financial contract whose value depends on the performance of one or more underlying assets, reference rates, indices, or factual events."@en ;
    rdfs:subClassOf fis:FinancialInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:FinancialInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Underlying ] ) ] .

fis:DebtSecurity a owl:Class ;
    rdfs:label "Debt Security"@en ;
    rdfs:comment "A negotiable financial instrument serving as evidence of a debt obligation, typically promising payment of principal and interest."@en ;
    rdfs:subClassOf fis:Security .

fis:LegalEntity a owl:Class ;
    rdfs:label "Legal Entity"@en ;
    rdfs:comment "An entity, institution, or organization capable of contracting, issuing securities, or incurring liabilities."@en .

fis:FinancialInstrument a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "A monetary contract that gives rise to a financial asset of one entity and a financial liability or equity instrument of another entity (IAS 32)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fis:hasIssuer ;
            owl:someValuesFrom fis:Issuer ] .

fis:Bond a owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:comment "A debt security under which the debtor owes the creditor a debt, promising repayment of principal at a maturity date and usually periodic interest (coupon)."@en ;
    rdfs:subClassOf fis:DebtSecurity .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:DebtSecurity fis:EquitySecurity ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Forward fis:Future fis:Option fis:Swap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CallOption fis:PutOption ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:RetailInvestor fis:InstitutionalInvestor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Corporation fis:Government fis:Municipality fis:SupranationalOrganization fis:SpecialPurposeVehicle ) .

