@prefix fis: <http://example.org/onto/securities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/securities> a owl:Ontology ;
    rdfs:label "Securities and Financial Instruments Ontology"@en ;
    rdfs:comment "An ontology modeling the financial securities and instruments domain based on authoritative market and regulatory corpus sources."@en .

fis:BillOfExchange a owl:Class ;
    rdfs:label "Bill of Exchange"@en ;
    rdfs:comment "A written order instructing a party to pay a specified sum on demand or on a specified date."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument .

fis:CertificateOfDeposit a owl:Class ;
    rdfs:label "CD"@en,
        "Certificate of Deposit"@en ;
    rdfs:comment "A time deposit debt instrument issued by commercial banks and thrift institutions for a specified term."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:FinancialInstitution ] ) ] .

fis:CollateralizedDebtObligation a owl:Class ;
    rdfs:label "CDO"@en,
        "Collateralized Debt Obligation"@en ;
    rdfs:comment "A structured asset-backed security backed by a pool of bonds, loans, or other debt obligations."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:CommercialPaper a owl:Class ;
    rdfs:label "Commercial Paper"@en ;
    rdfs:comment "An unsecured short-term promissory note issued by a corporation with a maturity of 270 days or less."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:Commodity a owl:Class ;
    rdfs:label "Commodity"@en ;
    rdfs:comment "A physical or agricultural good traded in commerce, such as corn, oil, or gold."@en ;
    rdfs:subClassOf fis:Asset .

fis:CoveredBond a owl:Class ;
    rdfs:label "Covered Bond"@en ;
    rdfs:comment "A debt security backed by cash flows from mortgages or public sector assets that remain on the issuer's balance sheet."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity .

fis:Debenture a owl:Class ;
    rdfs:label "Debenture"@en ;
    rdfs:comment "An unsecured debt security backed only by the general creditworthiness and reputation of the issuer."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:DepositaryReceipt a owl:Class ;
    rdfs:label "American Depositary Receipt"@en,
        "Depositary Receipt"@en,
        "Global Depositary Receipt"@en ;
    rdfs:comment "A negotiable financial certificate issued by a bank representing shares in a foreign company traded on a local stock exchange."@en ;
    rdfs:subClassOf fis:EquitySecurity .

fis:ExchangeableBond a owl:Class ;
    rdfs:label "Exchangeable Bond"@en ;
    rdfs:comment "A bond that gives the holder the right to exchange the bond for shares of a corporation other than the issuer."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity .

fis:FixedRateBond a owl:Class ;
    rdfs:label "Fixed Rate Bond"@en ;
    rdfs:comment "A bond with a coupon rate that remains constant throughout the life of the instrument."@en ;
    rdfs:subClassOf fis:Bond .

fis:FloatingRateNote a owl:Class ;
    rdfs:label "Floater"@en,
        "Floating Rate Bond"@en,
        "Floating Rate Note"@en ;
    rdfs:comment "A debt instrument with a variable coupon rate tied to a benchmark reference interest rate."@en ;
    rdfs:subClassOf fis:Bond .

fis:Index a owl:Class ;
    rdfs:label "Index"@en,
        "Market Index"@en ;
    rdfs:comment "A statistical benchmark measuring the performance of a defined basket of securities or assets."@en ;
    rdfs:subClassOf fis:Underlying .

fis:InflationIndexedBond a owl:Class ;
    rdfs:label "Index-Linked Bond"@en,
        "Inflation-Indexed Bond"@en,
        "Linker"@en ;
    rdfs:comment "A bond whose principal value and coupon payments are indexed to a consumer price index."@en ;
    rdfs:subClassOf fis:Bond .

fis:Note a owl:Class ;
    rdfs:label "Note"@en ;
    rdfs:comment "A debt security typically having a shorter maturity than a debenture, often between one and ten years."@en ;
    rdfs:subClassOf fis:DebtSecurity .

fis:PerpetualBond a owl:Class ;
    rdfs:label "Perp"@en,
        "Perpetual Bond"@en,
        "Perpetuity"@en ;
    rdfs:comment "A bond with no stated maturity date that pays interest indefinitely."@en ;
    rdfs:subClassOf fis:Bond .

fis:PutableBond a owl:Class ;
    rdfs:label "Putable Bond"@en,
        "Retractable Bond"@en ;
    rdfs:comment "A bond granting the holder the right to require the issuer to repay the bond prior to maturity."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasOption ;
                        owl:someValuesFrom fis:PutOption ] ) ] .

fis:TreasuryBill a owl:Class ;
    rdfs:label "T-Bill"@en,
        "Treasury Bill"@en ;
    rdfs:comment "A short-term government debt obligation issued at a discount with a maturity of one year or less."@en ;
    rdfs:subClassOf fis:MoneyMarketInstrument ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:MoneyMarketInstrument [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:Warrant a owl:Class ;
    rdfs:label "Equity Warrant"@en,
        "Warrant"@en ;
    rdfs:comment "A long-dated option issued by a corporation giving the holder the right to purchase newly issued shares at a specified price."@en ;
    rdfs:subClassOf fis:Option .

fis:ZeroCouponBond a owl:Class ;
    rdfs:label "Deep Discount Bond"@en,
        "Discount Bond"@en,
        "Zero-Coupon Bond"@en ;
    rdfs:comment "A bond that pays no periodic interest, issued at a discount and redeemed at par upon maturity."@en ;
    rdfs:subClassOf fis:Bond .

fis:hasCallPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Call Price"@en ;
    rdfs:comment "The predetermined price at which an issuer may call and redeem a callable bond before maturity."@en ;
    rdfs:domain fis:CallableBond ;
    rdfs:range xsd:decimal .

fis:hasConversionPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Conversion Price"@en ;
    rdfs:comment "The effective purchase price per share of common stock upon conversion of a convertible bond."@en ;
    rdfs:domain fis:ConvertibleBond ;
    rdfs:range xsd:decimal .

fis:hasConversionRatio a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Conversion Ratio"@en ;
    rdfs:comment "The number of shares of common stock received upon conversion of a convertible bond."@en ;
    rdfs:domain fis:ConvertibleBond ;
    rdfs:range xsd:decimal .

fis:hasCouponRate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Coupon Rate"@en ;
    rdfs:comment "The fixed or variable percentage interest rate paid periodically on a debt security."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasDeliveryDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Delivery Date"@en ;
    rdfs:comment "The specified future date on which delivery and settlement occur for a future or forward."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:dateTime .

fis:hasDeliveryPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Delivery Price"@en,
        "has Futures Price"@en ;
    rdfs:comment "The predetermined price agreed upon at the initiation of a forward or futures contract."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:decimal .

fis:hasExpirationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Expiration Date"@en ;
    rdfs:comment "The final date on which an option or derivative contract remains valid for exercise."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range xsd:dateTime .

fis:hasInternationalSecuritiesIdentificationNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has ISIN"@en,
        "has International Securities Identification Number"@en ;
    rdfs:comment "A 12-digit alphanumeric code that uniquely identifies a specific security."@en ;
    rdfs:domain fis:Security ;
    rdfs:range xsd:string .

fis:hasMaturityDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Maturity Date"@en ;
    rdfs:comment "The date on which the principal amount of a debt security is due to be repaid."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:dateTime .

fis:hasNotionalAmount a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Notional Amount"@en ;
    rdfs:comment "The reference monetary amount used to calculate periodic cash flows in a swap contract."@en ;
    rdfs:domain fis:Swap ;
    rdfs:range xsd:decimal .

fis:hasParValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Face Value"@en,
        "has Par Value"@en ;
    rdfs:comment "The stated principal amount of a debt security repaid at maturity."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range xsd:decimal .

fis:hasStrikePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has Exercise Price"@en,
        "has Strike Price"@en ;
    rdfs:comment "The predetermined fixed price at which an option holder can buy or sell the underlying asset."@en ;
    rdfs:domain fis:Option ;
    rdfs:range xsd:decimal .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

fis:CallableBond a owl:Class ;
    rdfs:label "Callable Bond"@en ;
    rdfs:comment "A bond granting the issuer the right to redeem the bond prior to its maturity date."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasOption ;
                        owl:someValuesFrom fis:CallOption ] ) ] .

fis:CommercialMortgageBackedSecurity a owl:Class ;
    rdfs:label "CMBS"@en,
        "Commercial Mortgage-Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by mortgage loans on commercial and multi-family properties."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity ;
    owl:disjointWith fis:ResidentialMortgageBackedSecurity .

fis:CorporateBond a owl:Class ;
    rdfs:label "Corporate Bond"@en ;
    rdfs:comment "A bond issued by a corporation to raise capital for business operations and investment."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:Corporation ] ) ] .

fis:CreditDefaultSwap a owl:Class ;
    rdfs:label "CDS"@en,
        "Credit Default Swap"@en ;
    rdfs:comment "A financial swap agreement transferring credit risk on a reference debt obligation from the protection buyer to the protection seller upon default."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:DebtSecurity ] ) ] .

fis:CurrencySwap a owl:Class ;
    rdfs:label "Currency Swap"@en ;
    rdfs:comment "A swap contract in which parties exchange principal and interest payments in different currencies."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:Currency ] ) ] .

fis:ExchangeTradedFund a owl:Class ;
    rdfs:label "ETF"@en,
        "Exchange-Traded Fund"@en ;
    rdfs:comment "An open-end investment company or unit investment trust whose shares trade continuously on national securities exchanges at market prices."@en ;
    rdfs:subClassOf fis:InvestmentFund ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:InvestmentFund [ a owl:Restriction ;
                        owl:onProperty fis:hasExchange ;
                        owl:someValuesFrom fis:Exchange ] ) ] .

fis:FinancialInstitution a owl:Class ;
    rdfs:label "Bank"@en,
        "Financial Institution"@en ;
    rdfs:comment "A commercial bank, investment bank, or depository institution offering credit and issuing certificates of deposit."@en ;
    rdfs:subClassOf fis:Corporation .

fis:Forward a owl:Class ;
    rdfs:label "Forward"@en,
        "Forward Contract"@en ;
    rdfs:comment "A customized, non-standardized over-the-counter contract to buy or sell an asset at a specified price and future date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Future a owl:Class ;
    rdfs:label "Future"@en,
        "Futures Contract"@en ;
    rdfs:comment "A standardized, exchange-traded contract cleared by a clearing house to buy or sell an asset at a predetermined price on a future date."@en ;
    rdfs:subClassOf fis:Derivative ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Derivative [ a owl:Restriction ;
                        owl:onProperty fis:hasExchange ;
                        owl:someValuesFrom fis:Exchange ] [ a owl:Restriction ;
                        owl:onProperty fis:hasClearingHouse ;
                        owl:someValuesFrom fis:ClearingHouse ] ) ] .

fis:GovernmentBond a owl:Class ;
    rdfs:label "Government Bond"@en,
        "Sovereign Bond"@en,
        "Treasury Bond"@en ;
    rdfs:comment "A medium- or long-term bond issued by a sovereign national government to finance public spending."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SovereignGovernment ] ) ] .

fis:HedgeFund a owl:Class ;
    rdfs:label "Hedge Fund"@en ;
    rdfs:comment "An investment fund using flexible, speculative, or leveraged strategies, available primarily to institutional and high-net-worth investors."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:InstitutionalInvestor a owl:Class ;
    rdfs:label "Institutional Investor"@en ;
    rdfs:comment "A professional organization (e.g., pension fund, insurer, bank, hedge fund) that invests pooled capital on behalf of others."@en ;
    rdfs:subClassOf fis:Investor ;
    owl:disjointWith fis:RetailInvestor .

fis:InterestRate a owl:Class ;
    rdfs:label "Interest Rate"@en ;
    rdfs:comment "The proportion of a loan charged as interest to the borrower, used as a reference benchmark in derivatives."@en ;
    rdfs:subClassOf fis:Underlying .

fis:InterestRateSwap a owl:Class ;
    rdfs:label "Interest Rate Swap"@en ;
    rdfs:comment "A swap contract in which parties exchange fixed interest rate cash flows for floating interest rate cash flows based on a notional principal."@en ;
    rdfs:subClassOf fis:Swap ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Swap [ a owl:Restriction ;
                        owl:onProperty fis:hasUnderlying ;
                        owl:someValuesFrom fis:InterestRate ] ) ] .

fis:Mortgage a owl:Class ;
    rdfs:label "Mortgage"@en,
        "Mortgage Loan"@en ;
    rdfs:comment "A debt instrument secured by the collateral of specified real estate property."@en ;
    rdfs:subClassOf fis:Collateral,
        fis:FinancialInstrument .

fis:MunicipalBond a owl:Class ;
    rdfs:label "Local Authority Bond"@en,
        "Muni"@en,
        "Municipal Bond"@en,
        "Sub-Sovereign Government Bond"@en ;
    rdfs:comment "A bond issued by a state, city, local authority, or sub-sovereign entity to fund public infrastructure projects."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:LocalGovernment ] ) ] .

fis:MutualFund a owl:Class ;
    rdfs:label "Mutual Fund"@en,
        "Open-End Investment Company"@en ;
    rdfs:comment "An SEC-registered investment fund pooling investor capital to buy a portfolio of securities, transacted at daily net asset value."@en ;
    rdfs:subClassOf fis:InvestmentFund .

fis:PreferredStock a owl:Class ;
    rdfs:label "Preference Share"@en,
        "Preferred Equity"@en,
        "Preferred Stock"@en ;
    rdfs:comment "A class of capital stock ranking senior to common stock in dividend payments and liquidation proceeds. Note on conflict: Preferred stock is legally equity, but under IAS 32 mandatorily redeemable preferred stock is classified as a financial liability."@en ;
    rdfs:subClassOf fis:EquitySecurity,
        fis:HybridSecurity ;
    owl:disjointWith fis:CommonStock .

fis:ResidentialMortgageBackedSecurity a owl:Class ;
    rdfs:label "RMBS"@en,
        "Residential Mortgage-Backed Security"@en ;
    rdfs:comment "A mortgage-backed security secured by residential mortgage loans on single-family or multi-unit dwellings."@en ;
    rdfs:subClassOf fis:MortgageBackedSecurity ;
    owl:disjointWith fis:CommercialMortgageBackedSecurity .

fis:RetailInvestor a owl:Class ;
    rdfs:label "Retail Investor"@en ;
    rdfs:comment "An individual member of the public investing personal funds rather than on behalf of a business."@en ;
    rdfs:subClassOf fis:Investor ;
    owl:disjointWith fis:InstitutionalInvestor .

fis:SpecialPurposeVehicle a owl:Class ;
    rdfs:label "Financial Vehicle Corporation"@en,
        "SPV"@en,
        "Special Purpose Vehicle"@en ;
    rdfs:comment "A bankruptcy-remote legal entity established to purchase receivables and issue asset-backed securities."@en ;
    rdfs:subClassOf fis:Issuer .

fis:SupranationalBond a owl:Class ;
    rdfs:label "Supra"@en,
        "Supranational Bond"@en ;
    rdfs:comment "A bond issued by an international organization or multilateral development bank."@en ;
    rdfs:subClassOf fis:Bond ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasIssuer ;
                        owl:someValuesFrom fis:SupranationalOrganization ] ) ] .

fis:hasBondholder a owl:ObjectProperty ;
    rdfs:label "has Bondholder"@en ;
    rdfs:comment "Relates a bond to its bondholder."@en ;
    rdfs:domain fis:Bond ;
    rdfs:range fis:Bondholder ;
    owl:inverseOf fis:isBondholderOf .

fis:hasCoupon a owl:ObjectProperty ;
    rdfs:label "has Coupon"@en ;
    rdfs:comment "Relates a debt security to its periodic interest coupon payments."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range fis:Coupon ;
    owl:inverseOf fis:isCouponOf .

fis:hasCreditRating a owl:ObjectProperty ;
    rdfs:label "has Credit Rating"@en ;
    rdfs:comment "Relates a debt security to its assigned credit rating."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range fis:CreditRating ;
    owl:inverseOf fis:isCreditRatingOf .

fis:hasCurrency a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has Currency"@en ;
    rdfs:comment "Relates a financial instrument to its currency of denomination."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Currency ;
    owl:inverseOf fis:isCurrencyOf .

fis:hasDividend a owl:ObjectProperty ;
    rdfs:label "has Dividend"@en ;
    rdfs:comment "Relates an equity security to a dividend distribution declared on it."@en ;
    rdfs:domain fis:EquitySecurity ;
    rdfs:range fis:Dividend ;
    owl:inverseOf fis:isDividendOf .

fis:hasInvestor a owl:ObjectProperty ;
    rdfs:label "has Investor"@en ;
    rdfs:comment "Relates a security to an investor who holds it."@en ;
    rdfs:domain fis:Security ;
    rdfs:range fis:Investor ;
    owl:inverseOf fis:isInvestorOf .

fis:hasShareholder a owl:ObjectProperty ;
    rdfs:label "has Shareholder"@en ;
    rdfs:comment "Relates an equity security to its shareholder."@en ;
    rdfs:domain fis:EquitySecurity ;
    rdfs:range fis:Shareholder ;
    owl:inverseOf fis:isShareholderOf .

fis:hasTranche a owl:ObjectProperty ;
    rdfs:label "has Tranche"@en ;
    rdfs:comment "Relates an asset-backed security or CDO to one of its structured tranches."@en ;
    rdfs:domain fis:AssetBackedSecurity ;
    rdfs:range fis:Tranche ;
    owl:inverseOf fis:isTrancheOf .

fis:isBondholderOf a owl:ObjectProperty ;
    rdfs:label "is Bondholder of"@en ;
    rdfs:comment "Relates a bondholder to the bond they hold."@en ;
    rdfs:domain fis:Bondholder ;
    rdfs:range fis:Bond ;
    owl:inverseOf fis:hasBondholder .

fis:isClearingHouseOf a owl:ObjectProperty ;
    rdfs:label "is Clearing House of"@en ;
    rdfs:comment "Relates a clearing house to the derivative contracts it clears."@en ;
    rdfs:domain fis:ClearingHouse ;
    rdfs:range fis:Derivative ;
    owl:inverseOf fis:hasClearingHouse .

fis:isCollateralOf a owl:ObjectProperty ;
    rdfs:label "is Collateral of"@en ;
    rdfs:comment "Relates pledged collateral to the debt security it secures."@en ;
    rdfs:domain fis:Collateral ;
    rdfs:range fis:DebtSecurity ;
    owl:inverseOf fis:hasCollateral .

fis:isCommonStockOf a owl:ObjectProperty ;
    rdfs:label "is Common Stock of"@en ;
    rdfs:comment "Relates common stock to a convertible bond that can convert into it."@en ;
    rdfs:domain fis:CommonStock ;
    rdfs:range fis:ConvertibleBond ;
    owl:inverseOf fis:hasCommonStock .

fis:isCouponOf a owl:ObjectProperty ;
    rdfs:label "is Coupon of"@en ;
    rdfs:comment "Relates an interest coupon payment to the underlying debt security."@en ;
    rdfs:domain fis:Coupon ;
    rdfs:range fis:DebtSecurity ;
    owl:inverseOf fis:hasCoupon .

fis:isCreditRatingOf a owl:ObjectProperty ;
    rdfs:label "is Credit Rating of"@en ;
    rdfs:comment "Relates a credit rating to the rated debt security."@en ;
    rdfs:domain fis:CreditRating ;
    rdfs:range fis:DebtSecurity ;
    owl:inverseOf fis:hasCreditRating .

fis:isCurrencyOf a owl:ObjectProperty ;
    rdfs:label "is Currency of"@en ;
    rdfs:comment "Relates a currency to the financial instruments denominated within it."@en ;
    rdfs:domain fis:Currency ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:hasCurrency .

fis:isDividendOf a owl:ObjectProperty ;
    rdfs:label "is Dividend of"@en ;
    rdfs:comment "Relates a dividend distribution to the equity security on which it is paid."@en ;
    rdfs:domain fis:Dividend ;
    rdfs:range fis:EquitySecurity ;
    owl:inverseOf fis:hasDividend .

fis:isExchangeOf a owl:ObjectProperty ;
    rdfs:label "is Exchange of"@en ;
    rdfs:comment "Relates an exchange to the securities listed upon it."@en ;
    rdfs:domain fis:Exchange ;
    rdfs:range fis:Security ;
    owl:inverseOf fis:hasExchange .

fis:isInvestorOf a owl:ObjectProperty ;
    rdfs:label "is Investor of"@en ;
    rdfs:comment "Relates an investor to the securities in their investment portfolio."@en ;
    rdfs:domain fis:Investor ;
    rdfs:range fis:Security ;
    owl:inverseOf fis:hasInvestor .

fis:isIssuerOf a owl:ObjectProperty ;
    rdfs:label "is Issuer of"@en ;
    rdfs:comment "Relates an issuer to the financial instruments it has issued."@en ;
    rdfs:domain fis:Issuer ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:hasIssuer .

fis:isOptionOf a owl:ObjectProperty ;
    rdfs:label "is Option of"@en ;
    rdfs:comment "Relates an embedded option to the bond containing it."@en ;
    rdfs:domain fis:Option ;
    rdfs:range fis:Bond ;
    owl:inverseOf fis:hasOption .

fis:isShareholderOf a owl:ObjectProperty ;
    rdfs:label "is Shareholder of"@en ;
    rdfs:comment "Relates a shareholder to the equity security they hold."@en ;
    rdfs:domain fis:Shareholder ;
    rdfs:range fis:EquitySecurity ;
    owl:inverseOf fis:hasShareholder .

fis:isTrancheOf a owl:ObjectProperty ;
    rdfs:label "is Tranche of"@en ;
    rdfs:comment "Relates a tranche to its parent asset-backed structure."@en ;
    rdfs:domain fis:Tranche ;
    rdfs:range fis:AssetBackedSecurity ;
    owl:inverseOf fis:hasTranche .

fis:isUnderlyingOf a owl:ObjectProperty ;
    rdfs:label "is Underlying of"@en ;
    rdfs:comment "Relates an underlying asset, index, or rate to the derivative contract that references it."@en ;
    rdfs:domain fis:Underlying ;
    rdfs:range fis:FinancialInstrument ;
    owl:inverseOf fis:hasUnderlying .

fis:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "An economic resource controlled by an entity from which future economic benefits are expected to flow."@en ;
    rdfs:subClassOf fis:Underlying .

fis:Bondholder a owl:Class ;
    rdfs:label "Bondholder"@en ;
    rdfs:comment "A creditor holding a bond issued by a corporation or governmental entity."@en ;
    rdfs:subClassOf fis:Investor .

fis:CallOption a owl:Class ;
    rdfs:label "Call Option"@en ;
    rdfs:comment "An option contract giving the holder the right to purchase the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option ;
    owl:disjointWith fis:PutOption .

fis:Coupon a owl:Class ;
    rdfs:label "Coupon"@en ;
    rdfs:comment "The periodic interest payment made to a bondholder during the life of a debt security."@en ;
    rdfs:subClassOf owl:Thing .

fis:CreditRating a owl:Class ;
    rdfs:label "Credit Rating"@en ;
    rdfs:comment "An assessment assigned by a credit rating agency of the creditworthiness of a debtor or security."@en ;
    rdfs:subClassOf owl:Thing .

fis:Dividend a owl:Class ;
    rdfs:label "Dividend"@en ;
    rdfs:comment "A discretionary distribution of a portion of a company's earnings to its shareholders."@en ;
    rdfs:subClassOf owl:Thing .

fis:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "An individual, organization, or enterprise with legal or financial standing."@en ;
    rdfs:subClassOf owl:Thing .

fis:LocalGovernment a owl:Class ;
    rdfs:label "Local Government"@en,
        "Sub-Sovereign Government"@en ;
    rdfs:comment "A regional, state, provincial, municipal, or local governmental unit issuing municipal bonds."@en ;
    rdfs:subClassOf fis:Issuer .

fis:MortgageBackedSecurity a owl:Class ;
    rdfs:label "MBS"@en,
        "Mortgage-Backed Security"@en ;
    rdfs:comment "An asset-backed security secured by a pool of residential or commercial mortgage loans."@en ;
    rdfs:subClassOf fis:AssetBackedSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:AssetBackedSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Mortgage ] ) ] .

fis:PutOption a owl:Class ;
    rdfs:label "Put Option"@en ;
    rdfs:comment "An option contract giving the holder the right to sell the underlying asset at the strike price."@en ;
    rdfs:subClassOf fis:Option ;
    owl:disjointWith fis:CallOption .

fis:Shareholder a owl:Class ;
    rdfs:label "Shareholder"@en,
        "Stockholder"@en ;
    rdfs:comment "An owner of one or more shares of capital stock in a company."@en ;
    rdfs:subClassOf fis:Investor .

fis:SupranationalOrganization a owl:Class ;
    rdfs:label "Supranational Organization"@en ;
    rdfs:comment "An international institution or development bank comprising multiple member states (e.g. World Bank)."@en ;
    rdfs:subClassOf fis:Issuer .

fis:Tranche a owl:Class ;
    rdfs:label "Tranche"@en ;
    rdfs:comment "A distinct slice or class of structured securities offering a specific risk, return, and seniority profile."@en ;
    rdfs:subClassOf owl:Thing .

fis:hasClearingHouse a owl:ObjectProperty ;
    rdfs:label "has Clearing House"@en ;
    rdfs:comment "Relates an exchange-traded derivative to its clearing house."@en ;
    rdfs:domain fis:Derivative ;
    rdfs:range fis:ClearingHouse ;
    owl:inverseOf fis:isClearingHouseOf .

fis:hasCommonStock a owl:ObjectProperty ;
    rdfs:label "has Common Stock"@en ;
    rdfs:comment "Relates a convertible bond to the common stock into which it may be converted."@en ;
    rdfs:domain fis:ConvertibleBond ;
    rdfs:range fis:CommonStock ;
    owl:inverseOf fis:isCommonStockOf .

fis:ClearingHouse a owl:Class ;
    rdfs:label "Central Counterparty"@en,
        "Clearing House"@en ;
    rdfs:comment "An intermediary that guarantees performance and mitigates default risk for exchange-traded contracts."@en ;
    rdfs:subClassOf owl:Thing .

fis:Currency a owl:Class ;
    rdfs:label "Currency"@en ;
    rdfs:comment "A system of money in common use within a country or economic jurisdiction."@en ;
    rdfs:subClassOf fis:Underlying .

fis:HybridSecurity a owl:Class ;
    rdfs:label "Hybrid Security"@en ;
    rdfs:comment "A security that combines characteristics of both debt securities and equity securities."@en ;
    rdfs:subClassOf fis:Security .

fis:SovereignGovernment a owl:Class ;
    rdfs:label "National Government"@en,
        "Sovereign Government"@en ;
    rdfs:comment "A sovereign national state or treasury that issues sovereign debt securities."@en ;
    rdfs:subClassOf fis:Issuer .

fis:hasExchange a owl:ObjectProperty ;
    rdfs:label "has Exchange"@en ;
    rdfs:comment "Relates a security or exchange-traded derivative to the exchange on which it is listed."@en ;
    rdfs:domain fis:Security ;
    rdfs:range fis:Exchange ;
    owl:inverseOf fis:isExchangeOf .

fis:hasOption a owl:ObjectProperty ;
    rdfs:label "has Option"@en ;
    rdfs:comment "Relates a bond with embedded optionality (such as a callable or putable bond) to the embedded option."@en ;
    rdfs:domain fis:Bond ;
    rdfs:range fis:Option ;
    owl:inverseOf fis:isOptionOf .

fis:Collateral a owl:Class ;
    rdfs:label "Collateral"@en ;
    rdfs:comment "An asset pledged by a borrower to secure repayment of a loan or debt obligation."@en ;
    rdfs:subClassOf fis:Asset .

fis:CommonStock a owl:Class ;
    rdfs:label "Common Share"@en,
        "Common Stock"@en,
        "Equity Share"@en,
        "Ordinary Share"@en,
        "Voting Share"@en ;
    rdfs:comment "A unit of corporate equity ownership conferring voting rights and residual claims on earnings and assets."@en ;
    rdfs:subClassOf fis:EquitySecurity ;
    owl:disjointWith fis:PreferredStock .

fis:ConvertibleBond a owl:Class ;
    rdfs:label "Convertible Bond"@en,
        "Convertible Note"@en ;
    rdfs:comment "A hybrid bond that can be converted into a predetermined number of shares of common stock of the issuer. Note on conflict: Market practice treats convertible bonds as single debt securities with embedded options, whereas IAS 32 requires bifurcation into separate liability and equity components."@en ;
    rdfs:subClassOf fis:Bond,
        fis:HybridSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:Bond [ a owl:Restriction ;
                        owl:onProperty fis:hasCommonStock ;
                        owl:someValuesFrom fis:CommonStock ] ) ] .

fis:Corporation a owl:Class ;
    rdfs:label "Company"@en,
        "Corporation"@en ;
    rdfs:comment "A commercial or industrial corporate enterprise capable of issuing equity and debt securities."@en ;
    rdfs:subClassOf fis:Issuer .

fis:Exchange a owl:Class ;
    rdfs:label "Exchange"@en,
        "Securities Exchange"@en ;
    rdfs:comment "An organized and officially recognized marketplace where securities and derivatives are traded."@en ;
    rdfs:subClassOf owl:Thing .

fis:InvestmentFund a owl:Class ;
    rdfs:label "Collective Investment Scheme"@en,
        "Investment Fund"@en ;
    rdfs:comment "An investment vehicle that pools capital from multiple investors to invest in a diversified portfolio of securities and other assets."@en ;
    rdfs:subClassOf fis:Security .

fis:hasCollateral a owl:ObjectProperty ;
    rdfs:label "has Collateral"@en ;
    rdfs:comment "Relates a debt security to the collateral backing its obligations."@en ;
    rdfs:domain fis:DebtSecurity ;
    rdfs:range fis:Collateral ;
    owl:inverseOf fis:isCollateralOf .

fis:hasUnderlying a owl:ObjectProperty ;
    rdfs:label "has Underlying"@en ;
    rdfs:comment "Relates a derivative or structured product to its underlying reference asset, rate, or index."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Underlying ;
    owl:inverseOf fis:isUnderlyingOf .

fis:Investor a owl:Class ;
    rdfs:label "Investor"@en ;
    rdfs:comment "A market participant providing capital by purchasing securities or financial instruments."@en ;
    rdfs:subClassOf fis:Entity .

fis:AssetBackedSecurity a owl:Class ;
    rdfs:label "ABS"@en,
        "Asset-Backed Security"@en ;
    rdfs:comment "A debt security whose interest and principal payments are backed by cash flows from an underlying pool of financial assets."@en ;
    rdfs:subClassOf fis:DebtSecurity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fis:DebtSecurity [ a owl:Restriction ;
                        owl:onProperty fis:hasCollateral ;
                        owl:someValuesFrom fis:Collateral ] ) ] .

fis:Issuer a owl:Class ;
    rdfs:label "Issuer"@en ;
    rdfs:comment "A legal entity that creates, registers, and sells securities to finance its operations or public debt."@en ;
    rdfs:subClassOf fis:Entity .

fis:Option a owl:Class ;
    rdfs:label "Option"@en,
        "Option Contract"@en ;
    rdfs:comment "A contract conveying the right, but not the obligation, to buy or sell an underlying asset at a specified strike price on or before a specified date."@en ;
    rdfs:subClassOf fis:Derivative .

fis:Underlying a owl:Class ;
    rdfs:label "Underlier"@en,
        "Underlying"@en,
        "Underlying Asset"@en ;
    rdfs:comment "The reference asset, rate, index, or event on which the value of a derivative or structured product depends."@en ;
    rdfs:subClassOf owl:Thing .

fis:FinancialInstrument a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:comment "A monetary contract between parties that gives rise to a financial asset of one entity and a financial liability or equity instrument of another entity."@en ;
    rdfs:subClassOf fis:Underlying,
        owl:Thing .

fis:MoneyMarketInstrument a owl:Class ;
    rdfs:label "Money Market Instrument"@en ;
    rdfs:comment "A short-term, highly liquid debt instrument with an original maturity of one year or less."@en ;
    rdfs:subClassOf fis:DebtSecurity ;
    owl:disjointWith fis:Bond .

fis:Swap a owl:Class ;
    rdfs:label "Swap"@en,
        "Swap Contract"@en ;
    rdfs:comment "A derivative contract in which two counterparties agree to exchange cash flow streams over a specified period."@en ;
    rdfs:subClassOf fis:Derivative .

fis:hasIssuer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has Issuer"@en ;
    rdfs:comment "Relates a financial instrument to the entity that issues it."@en ;
    rdfs:domain fis:FinancialInstrument ;
    rdfs:range fis:Issuer ;
    owl:inverseOf fis:isIssuerOf .

fis:EquitySecurity a owl:Class ;
    rdfs:label "Capital Stock"@en,
        "Equity Security"@en,
        "Share"@en,
        "Stock"@en ;
    rdfs:comment "A negotiable financial instrument representing an ownership interest in a corporation, trust, or partnership, conferring residual claims on assets and earnings."@en ;
    rdfs:subClassOf fis:Security ;
    owl:disjointWith fis:DebtSecurity,
        fis:Derivative .

fis:Security a owl:Class ;
    rdfs:label "Security"@en,
        "Tradable Financial Asset"@en ;
    rdfs:comment "A tradable financial asset representing a claim on an issuer, commonly categorized into debt securities, equity securities, hybrid securities, derivatives, and investment funds. Note on conflict: In the United States and under ECB definitions, 'security' broadly encompasses debt, equity, derivatives, and funds; in other jurisdictions such as the UK FCA Handbook, the definition of security excludes derivatives and is restricted to equities, debentures, government bonds, warrants, and units."@en ;
    rdfs:subClassOf fis:FinancialInstrument .

fis:Derivative a owl:Class ;
    rdfs:label "Derivative"@en,
        "Derivative Contract"@en,
        "Financial Derivative"@en ;
    rdfs:comment "A financial contract whose value depends on the performance of one or more underlying assets, rates, indices, or events. Note on conflict: Categorized as a security in US markets and ECB glossaries, but treated as a separate financial instrument category distinct from securities under accounting standards (IAS 39/IFRS 9) and certain European regimes."@en ;
    rdfs:subClassOf fis:Security ;
    owl:disjointWith fis:DebtSecurity,
        fis:EquitySecurity .

fis:DebtSecurity a owl:Class ;
    rdfs:label "Debt Security"@en,
        "Fixed Income Security"@en ;
    rdfs:comment "A negotiable financial instrument serving as evidence of a promise on the part of the issuer (borrower) to make payments of interest and repayment of principal to the holder (lender)."@en ;
    rdfs:subClassOf fis:Security ;
    owl:disjointWith fis:Derivative,
        fis:EquitySecurity .

fis:Bond a owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:comment "A long-term debt security, typically with a maturity of at least one year, obligating the issuer to repay principal and make periodic interest payments."@en ;
    rdfs:subClassOf fis:DebtSecurity ;
    owl:disjointWith fis:MoneyMarketInstrument .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:CorporateBond fis:GovernmentBond fis:MunicipalBond fis:SupranationalBond ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Forward fis:Future fis:Option fis:Swap ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:MutualFund fis:ExchangeTradedFund fis:HedgeFund ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:Corporation fis:SovereignGovernment fis:LocalGovernment fis:SupranationalOrganization fis:SpecialPurposeVehicle ) .

[] a owl:AllDisjointClasses ;
    owl:members ( fis:InterestRateSwap fis:CurrencySwap fis:CreditDefaultSwap ) .

