@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/hypertension> a owl:Ontology ;
    rdfs:label "Hypertension Domain Ontology"@en ;
    skos:definition "An ontology capturing the classification, etiology, measurement, pharmacotherapy, target-organ damage, and risk factors of hypertension."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularSecondaryCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "Congenital luminal narrowing of the aorta causing proximal hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A hypertension phenotype characterized by elevated systolic blood pressure with normal or low diastolic pressure and a widened pulse pressure, primarily due to arterial stiffness."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A blood pressure phenotype characterized by normal clinic blood pressure measurements alongside persistently elevated out-of-office blood pressure measurements."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of one or both renal arteries causing renovascular hypertension."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Hypertension that remains above goal despite concurrent adherence to three antihypertensive medication classes of which one is a diuretic, or requiring four or more medications to achieve control."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "White Coat Syndrome"@en ;
    skos:definition "A blood pressure phenotype characterized by persistently elevated clinic blood pressure measurements alongside normal out-of-office blood pressure measurements."@en .

ht:AcuteRenalFailure a owl:Class ;
    rdfs:label "Acute Renal Failure"@en ;
    rdfs:subClassOf ht:RenalTargetOrganDamage ;
    skos:altLabel "Acute Kidney Injury"@en ;
    skos:definition "Sudden decline in renal function often seen in the setting of hypertensive emergency."@en .

ht:AdvancingAge a owl:Class ;
    rdfs:label "Advancing Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "The biological aging process accompanied by progressive vascular fibrosis, calcium deposition, and arterial stiffening."@en .

ht:AlcoholConsumption a owl:Class ;
    rdfs:label "Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "Excessive intake of alcoholic beverages promoting blood pressure elevation."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Out-of-office blood pressure recording at regular intervals over a 24-hour sleep-wake cycle."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A drug class that blocks the conversion of angiotensin I to angiotensin II and prevents bradykinin degradation."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A drug class that blocks angiotensin II type 1 receptors, preventing vasoconstriction and aldosterone release."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Generalized or focal constriction of retinal arterioles."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en ;
    skos:definition "Compression of a retinal venule where it is crossed by a thickened or sclerotic retinal arteriole."@en .

ht:AtrialFibrillation a owl:Class ;
    rdfs:label "Atrial Fibrillation"@en ;
    rdfs:subClassOf ht:CardiacTargetOrganDamage ;
    skos:definition "Supraventricular tachyarrhythmia promoted by left atrial remodeling and hypertensive heart disease."@en .

ht:AuscultatoryMeasurementMethod a owl:Class ;
    rdfs:label "Auscultatory Measurement Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Measurement of blood pressure by listening for Korotkoff sounds over an artery with a stethoscope while deflating an occlusive cuff."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Beta-Adrenergic Blocker"@en ;
    skos:definition "A drug class that antagonizes beta-adrenergic receptors, reducing heart rate, cardiac contractility, and renin release."@en .

ht:ChronicKidneyDisease a owl:Class ;
    rdfs:label "Chronic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalTargetOrganDamage ;
    skos:altLabel "CKD"@en ;
    skos:definition "Progressive, irreversible loss of renal function and glomerular filtration due to hypertensive vascular damage."@en .

ht:CoronaryArteryDisease a owl:Class ;
    rdfs:label "Coronary Artery Disease"@en ;
    rdfs:subClassOf ht:CardiacTargetOrganDamage ;
    skos:altLabel "CAD"@en ;
    skos:definition "Atherosclerotic narrowing of coronary arteries aggravated by elevated arterial pressure."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Micro-infarction of the retinal nerve fiber layer appearing as a fluffy white retinal opacity."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineSecondaryCause ;
    skos:definition "A state of chronic glucocorticoid excess causing elevated arterial pressure."@en .

ht:DiabeticNephropathy a owl:Class ;
    rdfs:label "Diabetic Nephropathy"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Renal parenchymal damage secondary to diabetes mellitus causing hypertension."@en .

ht:DihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Dihydropyridine"@en ;
    skos:definition "A calcium channel blocker subtype with predominant vascular selectivity causing arterial vasodilation."@en .

ht:DrugInducedSecondaryCause a owl:Class ;
    rdfs:label "Drug Induced Secondary Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "Elevated arterial pressure caused by pharmaceutical medications, licorice, oral contraceptives, steroids, or recreational substances."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic value between 120 and 129 mmHg under ACC/AHA guidelines."@en .

ht:ExcessiveSodiumIntake a owl:Class ;
    rdfs:label "Excessive Sodium Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "High Salt Diet"@en ;
    skos:definition "High dietary intake of sodium contributing to intravascular volume expansion."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "A documented familial occurrence of hypertension among biological relatives."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Polygenic hereditary traits influencing renal salt sensitivity, vascular tone, and neurohormonal responsiveness."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Inflammation of the renal glomeruli leading to secondary hypertension."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Lipid deposits in the deep retina resulting from breakdown of the blood-retinal barrier."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:CardiacTargetOrganDamage ;
    skos:definition "Inability of the heart to pump sufficiently to meet metabolic demands, developing as a complication of hypertensive remodeling."@en .

ht:HemorrhagicStroke a owl:Class ;
    rdfs:label "Hemorrhagic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:definition "Stroke resulting from rupture of a cerebral blood vessel into brain parenchyma or subarachnoid space."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Self-measurement of blood pressure by a patient in their residential environment over multiple days."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis complicated by acute, progressive hypertension-mediated target-organ damage requiring immediate intravenous pressure reduction."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:CerebrovascularTargetOrganDamage ;
    skos:definition "Acute cerebral dysfunction characterized by headache, altered consciousness, and cerebral edema from broken autoregulation during severe pressure elevation."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A severe acute blood pressure elevation without acute target-organ damage, typically managed with gradual oral medication."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:ThyroidDisease ;
    skos:definition "Excessive thyroid hormone production producing hyperdynamic circulation and systolic hypertension."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:ThyroidDisease ;
    skos:definition "Deficient thyroid hormone production leading to increased systemic vascular resistance and secondary hypertension."@en .

ht:IschemicStroke a owl:Class ;
    rdfs:label "Ischemic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:definition "Stroke caused by arterial thrombosis or embolism occluding cerebral perfusion."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:CardiacTargetOrganDamage ;
    skos:altLabel "LVH"@en ;
    skos:definition "Compensatory thickening of the myocardium of the left ventricle in response to sustained pressure load."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Aldosterone Antagonist"@en,
        "MRA"@en ;
    skos:definition "A drug class that blocks aldosterone receptors, utilized especially in resistant hypertension and primary aldosteronism."@en .

ht:MyocardialInfarction a owl:Class ;
    rdfs:label "Myocardial Infarction"@en ;
    rdfs:subClassOf ht:CardiacTargetOrganDamage ;
    skos:definition "Ischemic necrosis of cardiac muscle tissue due to acute coronary artery occlusion accelerated by hypertension."@en .

ht:NonDihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Non Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Non-Dihydropyridine"@en ;
    skos:definition "A calcium channel blocker subtype with predominant cardiac selectivity, slowing conduction and contractility."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 119 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic value strictly less than 120 mmHg under ACC/AHA guidelines."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excess Body Weight"@en ;
    skos:definition "Excess adiposity linked to sympathetic activation, renin-aldosterone elevation, and arterial stiffness."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "A sleep disorder characterized by recurrent upper airway collapse and sympathetic activation, serving as a leading secondary cause of hypertension."@en .

ht:OfficeMeasurementMethod a owl:Class ;
    rdfs:label "Office Measurement Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement performed in a clinical or doctor's office setting by medical staff."@en .

ht:OscillometricMeasurementMethod a owl:Class ;
    rdfs:label "Oscillometric Measurement Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Measurement of blood pressure by automated detection and analysis of pressure oscillations within an inflatable cuff."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Edema and swelling of the optic nerve head, indicating malignant or severe target-organ damage."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineSecondaryCause ;
    skos:definition "A neuroendocrine tumor of chromaffin cells secreting excessive catecholamines."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:definition "A sedentary lifestyle predisposing to weight gain, reduced vascular compliance, and hypertension."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A genetic disorder characterized by growth of numerous cysts in the kidneys causing hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineSecondaryCause ;
    skos:altLabel "Conn Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "Autonomous adrenal overproduction of aldosterone causing sodium retention, suppressed renin, and secondary hypertension."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineSecondaryCause ;
    skos:definition "Excessive secretion of parathyroid hormone with resultant hypercalcemia promoting hypertension."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension lacking an identifiable secondary etiology, resulting from an interplay of genetic predisposition and environmental factors."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Extravasation of blood into retinal nerve-fiber layers, often flame-shaped or blot-shaped."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic value between 130 and 139 mmHg under ACC/AHA guidelines."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] ) ] ;
    skos:definition "A blood pressure reading with a systolic value of 140 mmHg or higher under ACC/AHA guidelines."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Thiazide-Type Diuretic"@en ;
    skos:definition "A first-line diuretic inhibiting sodium and chloride reabsorption in the distal convoluted tubule of the nephron."@en .

ht:TobaccoSmoking a owl:Class ;
    rdfs:label "Tobacco Smoking"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Cigarette Smoking"@en ;
    skos:definition "Inhalation of burned tobacco products promoting sympathetic drive and endothelial damage."@en .

ht:hasAntihypertensiveMedication a owl:ObjectProperty ;
    rdfs:label "has antihypertensive medication"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:AntihypertensiveMedication ;
    owl:inverseOf ht:isAntihypertensiveMedicationOf ;
    skos:definition "Associates a hypertensive condition with an antihypertensive medication prescribed for its management."@en .

ht:hasBloodPressureCategory a owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    owl:inverseOf ht:isBloodPressureCategoryOf ;
    skos:definition "Associates a blood pressure reading with its evaluated blood pressure category."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Guideline controversy: The 2017 ACC/AHA guidelines set the systolic diagnostic threshold for hypertension at 130 mmHg, whereas European (ESC/ESH), British (NICE), JNC 7/8, WHO, and ISH guidelines define the diagnostic threshold at 140 mmHg."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum systolic blood pressure threshold in mmHg defining the diagnosis of hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The measured minimum systemic arterial pressure during cardiac relaxation, in millimetres of mercury (mmHg)."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:MeasurementMethod ;
    owl:inverseOf ht:isMeasurementMethodOf ;
    skos:definition "Associates a blood pressure reading with the technique or protocol by which it was measured."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    owl:inverseOf ht:isRiskFactorOf ;
    skos:definition "Associates hypertension with a modifiable or non-modifiable risk factor that predisposes to its development."@en .

ht:isAntihypertensiveMedicationOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive medication of"@en ;
    rdfs:domain ht:AntihypertensiveMedication ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasAntihypertensiveMedication ;
    skos:definition "Relates an antihypertensive medication to the hypertensive condition it treats."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasBloodPressureCategory ;
    skos:definition "Relates a blood pressure category to the blood pressure reading it classifies."@en .

ht:isMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is measurement method of"@en ;
    rdfs:domain ht:MeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasMeasurementMethod ;
    skos:definition "Relates a measurement method to the blood pressure reading obtained with it."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    owl:inverseOf ht:hasRetinalFinding ;
    skos:definition "Relates an ophthalmologic retinal finding to the hypertensive retinopathy manifesting it."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasRiskFactor ;
    skos:definition "Relates a risk factor to the hypertension whose risk it increases."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:SecondaryHypertension ;
    owl:inverseOf ht:hasSecondaryCause ;
    skos:definition "Relates an identifiable secondary cause to the secondary hypertension it produces."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasTargetOrganDamage ;
    skos:definition "Relates target-organ damage to the hypertensive condition that caused it."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalSecondaryCause ;
    skos:definition "Vascular disease affecting the renal arterial blood supply."@en .

ht:VascularSecondaryCause a owl:Class ;
    rdfs:label "Vascular Secondary Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A structural vascular abnormality producing secondary hypertension."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    owl:inverseOf ht:isRetinalFindingOf ;
    skos:definition "Associates hypertensive retinopathy with an observable ophthalmologic finding in the retinal vasculature."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    owl:inverseOf ht:isSecondaryCauseOf ;
    skos:definition "Associates secondary hypertension with its identifiable underlying secondary cause."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    owl:inverseOf ht:isTargetOrganDamageOf ;
    skos:definition "Associates hypertension with acute or chronic target-organ damage resulting from elevated arterial pressure."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "CCB"@en ;
    skos:definition "A drug class that inhibits calcium influx across L-type voltage-gated calcium channels in vascular smooth muscle and myocardium."@en .

ht:CerebrovascularTargetOrganDamage a owl:Class ;
    rdfs:label "Cerebrovascular Target Organ Damage"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Damage to cerebral vasculature and brain parenchyma resulting from hypertension."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute blood pressure elevation, typically defined by systolic pressure exceeding 180 mmHg or diastolic pressure exceeding 120 mmHg."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ht:hasRetinalFinding ;
            owl:someValuesFrom ht:RetinalFinding ],
        ht:TargetOrganDamage ;
    skos:definition "Ocular target-organ damage characterized by microvascular retinal lesions caused by elevated blood pressure."@en .

ht:RenalSecondaryCause a owl:Class ;
    rdfs:label "Renal Secondary Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension arising from pathology of the kidney parenchyma or renal vasculature."@en .

ht:RenalTargetOrganDamage a owl:Class ;
    rdfs:label "Renal Target Organ Damage"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Kidney Disease"@en,
        "Hypertensive Nephrosclerosis"@en ;
    skos:definition "Nephrosclerosis, glomerular sclerosis, and progressive loss of renal excretory function induced by chronic hypertension."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:definition "Hypertension that is secondary to an identifiable, often reversible, underlying pathology."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:subClassOf ht:CerebrovascularTargetOrganDamage ;
    skos:definition "Acute neurological injury resulting from interrupted cerebral blood flow or acute hemorrhage."@en .

ht:ThyroidDisease a owl:Class ;
    rdfs:label "Thyroid Disease"@en ;
    rdfs:subClassOf ht:EndocrineSecondaryCause ;
    skos:definition "Functional dysfunction of the thyroid gland causing blood pressure alterations."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "An innate demographic, biological, or genetic factor predisposing to hypertension that cannot be altered."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalSecondaryCause ;
    skos:definition "Intrinsic structural or functional disease of the renal parenchyma causing secondary hypertension."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "An attribute, characteristic, or exposure that increases the likelihood of developing hypertension."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The measured peak systemic arterial pressure during cardiac contraction, in millimetres of mercury (mmHg)."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "A diagnostic blood pressure category into which a blood pressure reading is classified."@en .

ht:CardiacTargetOrganDamage a owl:Class ;
    rdfs:label "Cardiac Target Organ Damage"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Heart Disease"@en ;
    skos:definition "Morphological and functional cardiac alterations resulting from chronic hypertensive afterload."@en .

ht:EndocrineSecondaryCause a owl:Class ;
    rdfs:label "Endocrine Secondary Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension stemming from an endocrine gland disturbance."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A lifestyle or environmental determinant of blood pressure that can be modified by behavioral or medical intervention."@en .

ht:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    skos:definition "The technique or protocol used to evaluate systemic blood pressure."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "HMOD"@en,
        "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury to vascular beds, heart, brain, retina, or kidneys caused by elevated blood pressure."@en .

ht:AntihypertensiveMedication a owl:Class ;
    rdfs:label "Antihypertensive Medication"@en ;
    skos:definition "A pharmacological drug class utilized to reduce blood pressure and prevent cardiovascular morbidity."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable disease, anatomic abnormality, or exogenous substance causing secondary hypertension."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A distinct ophthalmological fundoscopic lesion or finding seen in hypertensive retinopathy."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic blood pressure values in millimetres of mercury."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Guideline conflict: The 2017 ACC/AHA standard diagnoses hypertension at a systolic threshold of 130 mmHg, whereas ESC/ESH, WHO, JNC 7/8, and ISH maintain a threshold of 140 mmHg."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 130 ;
            owl:onProperty ht:hasDiagnosticSystolicThreshold ] ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic condition characterized by persistent elevation of systemic arterial blood pressure."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:SecondaryCause ht:TargetOrganDamage ht:RetinalFinding ht:AntihypertensiveMedication ht:RiskFactor ht:MeasurementMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:CardiacTargetOrganDamage ht:CerebrovascularTargetOrganDamage ht:RenalTargetOrganDamage ht:HypertensiveRetinopathy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DihydropyridineCalciumChannelBlocker ht:NonDihydropyridineCalciumChannelBlocker ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:CalciumChannelBlocker ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:BetaBlocker ht:MineralocorticoidReceptorAntagonist ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ExcessiveSodiumIntake ht:Obesity ht:PhysicalInactivity ht:AlcoholConsumption ht:TobaccoSmoking ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AdvancingAge ht:FamilyHistory ht:GeneticPredisposition ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMeasurementMethod ht:OscillometricMeasurementMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeMeasurementMethod ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveEmergency ht:HypertensiveUrgency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DiabeticNephropathy ht:Glomerulonephritis ht:PolycysticKidneyDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalParenchymalDisease ht:RenovascularDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:Hyperthyroidism ht:Hypothyroidism ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryAldosteronism ht:Pheochromocytoma ht:CushingSyndrome ht:ThyroidDisease ht:PrimaryHyperparathyroidism ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalSecondaryCause ht:EndocrineSecondaryCause ht:VascularSecondaryCause ht:ObstructiveSleepApnea ht:DrugInducedSecondaryCause ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:LeftVentricularHypertrophy ht:HeartFailure ht:MyocardialInfarction ht:CoronaryArteryDisease ht:AtrialFibrillation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:IschemicStroke ht:HemorrhagicStroke ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:Stroke ht:HypertensiveEncephalopathy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ChronicKidneyDisease ht:AcuteRenalFailure ) .

