@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/hypertension> a owl:Ontology ;
    rdfs:label "Hypertension Domain Ontology"@en ;
    rdfs:comment "An ontology formalizing the clinical domain of hypertension including blood pressure classification, primary and secondary etiology, antihypertensive drug classes, risk factors, target-organ damage, and diagnostic measurement methods."@en .

ht:AdvancingAge a owl:Class ;
    rdfs:label "Advancing Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Aging of the vascular tree with progressive arterial stiffening and loss of arterial compliance."@en .

ht:AorticAneurysm a owl:Class ;
    rdfs:label "Aortic Aneurysm"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Abnormal localized dilation of the aorta associated with chronic hypertensive vascular wall degeneration."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "A congenital narrowing of the aorta that elevates proximal systemic blood pressure."@en .

ht:AorticDissection a owl:Class ;
    rdfs:label "Aortic Dissection"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "A tear in the intimal layer of the aorta permitting blood flow between arterial wall layers, exacerbated by acute hypertension."@en .

ht:ExcessiveAlcoholConsumption a owl:Class ;
    rdfs:label "Excessive Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Heavy Drinking"@en ;
    skos:definition "Excessive consumption of alcohol contributing to sustained elevations in arterial pressure."@en .

ht:ExcessiveSodiumIntake a owl:Class ;
    rdfs:label "Excessive Sodium Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "High Salt Diet"@en ;
    skos:definition "Dietary intake of sodium exceeding recommended levels, promoting intravascular volume expansion in salt-sensitive individuals."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Hereditary prevalence of hypertension among biological relatives."@en .

ht:GeneticPredisposition a owl:Class ;
    rdfs:label "Genetic Predisposition"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Inherited polygenic variants predisposing to altered sodium handling and vascular resistance."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Inability of the heart to pump sufficient blood to meet physiological demands, progressing from chronic hypertensive remodeling."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute, reversible cerebral dysfunction and brain edema triggered by sudden and severe blood pressure elevations."@en .

ht:HypertensiveNephrosclerosis a owl:Class ;
    rdfs:label "Hypertensive Nephrosclerosis"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Kidney Disease"@en,
        "Hypertensive Nephropathy"@en ;
    skos:definition "Progressive hardening and sclerotic remodeling of renal arterioles and glomeruli caused by chronic hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A hypertensive phenotype characterized by elevated systolic blood pressure with normal or low diastolic pressure and widened pulse pressure."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "LVH"@en ;
    skos:definition "Thickening of the myocardium of the left ventricle in response to increased afterload from arterial pressure."@en .

ht:MyocardialInfarction a owl:Class ;
    rdfs:label "Myocardial Infarction"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "Heart Attack"@en ;
    skos:definition "Necrosis of myocardial tissue resulting from acute coronary artery occlusion."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excess Body Weight"@en ;
    skos:definition "Excess body mass and adiposity that elevates peripheral vascular resistance and sympathetic tone."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Sedentary Lifestyle"@en ;
    skos:definition "Lack of regular exercise predisposing to vascular stiffness and elevated blood pressure."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:definition "Narrowing of one or both renal arteries, reducing renal perfusion and triggering secondary hypertension."@en .

ht:RenalFailure a owl:Class ;
    rdfs:label "Renal Failure"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Kidney Failure"@en ;
    skos:definition "Severe loss of renal excretory and regulatory function attributable to hypertensive disease."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Hypertension remaining uncontrolled above target despite adherence to at least three antihypertensive medication classes of which one is a diuretic, or requiring four or more medications to achieve control."@en .

ht:TobaccoUse a owl:Class ;
    rdfs:label "Tobacco Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Cigarette Smoking"@en ;
    skos:definition "Consumption of tobacco products promoting acute sympathetic activation and endothelial injury."@en .

ht:hasAntihypertensive a owl:ObjectProperty ;
    rdfs:label "has antihypertensive"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:Antihypertensive ;
    owl:inverseOf ht:isAntihypertensiveOf ;
    skos:definition "Relates hypertension to a pharmacological class of antihypertensive medication indicated for its management."@en .

ht:hasBloodPressureCategory a owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:BloodPressureCategory ;
    owl:inverseOf ht:isBloodPressureCategoryOf ;
    skos:definition "Relates a blood pressure reading to the clinical category band to which it belongs."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Guideline controversy: ACC/AHA 2017 establishes the diagnostic systolic threshold at 130 mmHg, whereas older and international standards (including ESC/ESH, WHO, ISH, and JNC 7/8) maintain 140 mmHg."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The functional systolic blood pressure threshold in mmHg required to diagnose hypertension."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:MeasurementMethod ;
    owl:inverseOf ht:isMeasurementMethodOf ;
    skos:definition "Relates a blood pressure reading to the diagnostic method or protocol used to obtain it."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    owl:inverseOf ht:isRetinalFindingOf ;
    skos:definition "Relates hypertensive retinopathy to an observed retinal microvascular lesion or manifestation."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    owl:inverseOf ht:isRiskFactorOf ;
    skos:definition "Relates hypertension to a predisposing modifiable or non-modifiable risk factor."@en .

ht:Acromegaly a owl:Class ;
    rdfs:label "Acromegaly"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A hormonal disorder resulting from excess growth hormone after growth plate closure."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Automated recording of blood pressure at regular daytime and nighttime intervals across the 24-hour cycle outside the clinic."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A drug class inhibiting conversion of angiotensin I to angiotensin II and reducing bradykinin degradation to induce vasodilation."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A drug class selectively blocking angiotensin II type 1 receptors to prevent vasoconstriction and aldosterone release."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Vascular Attenuation"@en ;
    skos:definition "Generalized or focal constriction of retinal arterioles in response to elevated pressure."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "Arteriovenous Compression"@en ;
    skos:definition "Compression of a retinal venule at an crossing point by a thickened or sclerotic retinal arteriole."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Blood pressure measurement relying on detection of Korotkoff sounds with a stethoscope and sphygmomanometer."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "Beta-Adrenergic Blocker"@en ;
    skos:definition "A drug class antagonizing catecholamine binding to beta-adrenergic receptors, reducing heart rate, cardiac output, and renin release."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "An ischemic axoplasmic swelling in the retinal nerve fiber layer presenting as a fluffy white retinal opacity."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A hormonal disorder caused by prolonged exposure to high levels of glucocorticoids."@en .

ht:DiabeticNephropathy a owl:Class ;
    rdfs:label "Diabetic Nephropathy"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Chronic kidney disease resulting from diabetes mellitus that leads to secondary hypertension."@en .

ht:DihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Dihydropyridine"@en ;
    skos:definition "A calcium channel blocker subgroup exerting potent peripheral arterial vasodilatory action."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "Medication-Induced Cause"@en ;
    skos:definition "A secondary cause of hypertension precipitated by prescription drugs, over-the-counter medications, or illicit substances."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] ) ] ;
    skos:altLabel "Prehypertension"@en ;
    skos:definition "An ACC/AHA blood pressure reading with systolic pressure from 120 to 129 mmHg."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Inflammation of the renal glomeruli producing impaired filtration and hypertension."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Lipid and lipoprotein deposition within the retina resulting from breakdown of the blood-retinal barrier."@en .

ht:HemorrhagicStroke a owl:Class ;
    rdfs:label "Hemorrhagic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:altLabel "Intracerebral Hemorrhage"@en ;
    skos:definition "Intracranial bleeding resulting from rupture of cerebral blood vessels under high pressure."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Self-measurement of blood pressure by a patient in a home environment using a validated automated cuff."@en .

ht:Hyperparathyroidism a owl:Class ;
    rdfs:label "Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Primary Hyperparathyroidism"@en ;
    skos:definition "Overactivity of the parathyroid glands resulting in excess parathyroid hormone and hypercalcemia."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A life-threatening hypertensive crisis characterized by severe blood pressure elevation accompanied by acute target-organ damage."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis involving severe blood pressure elevation without acute hypertension-mediated target-organ damage."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excessive production of thyroid hormones resulting in hypermetabolism and elevated systolic pressure."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Deficiency of thyroid hormones contributing to increased systemic vascular resistance."@en .

ht:IschemicStroke a owl:Class ;
    rdfs:label "Ischemic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:definition "Cerebral infarction caused by embolic or thrombotic arterial occlusion."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A clinical phenotype characterized by normal office blood pressure readings with elevated out-of-office blood pressure."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "Aldosterone Antagonist"@en,
        "MRA"@en ;
    skos:definition "A drug class that antagonizes the action of aldosterone at the mineralocorticoid receptor, particularly useful in resistant hypertension."@en .

ht:NonDihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Non Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Non-Dihydropyridine"@en ;
    skos:definition "A calcium channel blocker subgroup exerting primary inhibitory effects on cardiac contractility and atrioventricular conduction."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 119 ] ) ] ] ) ] ;
    skos:definition "An ACC/AHA blood pressure reading with systolic pressure strictly less than 120 mmHg."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "OSA"@en,
        "Sleep Apnea"@en ;
    skos:definition "Repetitive upper airway collapse during sleep resulting in intermittent hypoxia and sympathetic activation, serving as a leading cause of secondary hypertension."@en .

ht:OfficeMeasurement a owl:Class ;
    rdfs:label "Office Measurement"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Blood pressure measurement performed in a medical clinic or doctor's office setting."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Automated electronic blood pressure measurement detecting pressure oscillations produced by arterial pulsation against an inflatable cuff."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Swelling of the optic nerve head visible on ophthalmoscopy indicating severely raised pressure or malignant phase hypertension."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A catecholamine-secreting neuroendocrine tumor of the adrenal medulla causing secondary hypertension."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A genetic disorder characterized by the growth of numerous cysts in the kidneys producing secondary hypertension."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn Syndrome"@en,
        "Conn's Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "Autonomous overproduction of aldosterone by the adrenal cortex leading to sodium retention, volume expansion, and hypertension."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension developing gradually without an identifiable physiological or medical cause."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Flame Hemorrhage"@en ;
    skos:definition "Extravasation of blood into retinal nerve fiber layers or deep retina from microvascular damage."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] ) ] ;
    skos:definition "An ACC/AHA blood pressure reading with systolic pressure from 130 to 139 mmHg."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] ) ] ;
    skos:definition "An ACC/AHA blood pressure reading with systolic pressure of 140 mmHg or greater."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "Thiazide"@en,
        "Thiazide-Type Diuretic"@en ;
    skos:definition "A diuretic class inhibiting sodium-chloride cotransport in the renal distal convoluted tubule to reduce plasma volume and vascular resistance."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "White Coat Syndrome"@en ;
    skos:definition "A clinical phenotype characterized by persistently elevated office blood pressure readings with normal out-of-office readings."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum arterial pressure between cardiac contractions measured in millimetres of mercury (mmHg)."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    owl:inverseOf ht:isSecondaryCauseOf ;
    skos:definition "Relates hypertension to the underlying identifiable condition or substance that produces it."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    owl:inverseOf ht:isTargetOrganDamageOf ;
    skos:definition "Relates hypertension to pathological structural or functional injury sustained by target organs."@en .

ht:isAntihypertensiveOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive of"@en ;
    rdfs:domain ht:Antihypertensive ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates an antihypertensive medication class to the hypertensive condition it manages."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    rdfs:range ht:BloodPressureReading ;
    skos:definition "Relates a blood pressure category band to a reading classified within it."@en .

ht:isMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is measurement method of"@en ;
    rdfs:domain ht:MeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    skos:definition "Relates a measurement method to the blood pressure reading recorded."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    skos:definition "Relates an observed retinal lesion or finding to hypertensive retinopathy."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates a predisposing risk factor to the hypertension condition it influences."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:SecondaryHypertension ;
    skos:definition "Relates an identifiable pathological cause or substance to the secondary hypertension it produces."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    skos:definition "Relates target-organ damage to the hypertension that caused or accompanies it."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Retinal microvascular disease and lesions arising as a direct consequence of sustained or acute elevated blood pressure."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "A renal vascular condition impairing blood flow to the kidneys."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Acute neurological injury resulting from interrupted cerebral arterial blood supply or vascular rupture."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension originating from structural congenital or acquired vascular defects."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:Antihypertensive ;
    skos:altLabel "CCB"@en ;
    skos:definition "A drug class that inhibits influx of extracellular calcium through L-type calcium channels in vascular smooth muscle and myocardium."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Severe Hypertension"@en ;
    skos:definition "A severe, acute elevation in blood pressure, typically defined as systolic pressure of 180 mmHg or higher and/or diastolic pressure of 120 mmHg or higher."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional adaptations and complications in the myocardium and coronary vasculature caused by chronic elevation of blood pressure."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension originating from renal parenchymal disease or renal vasculature pathology."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension directly attributable to an underlying, identifiable, and potentially reversible secondary cause."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "An inherent biological or hereditary factor influencing hypertension risk that cannot be altered."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Intrinsic functional or structural disease of the kidney parenchyma causing secondary hypertension."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "An epidemiological, physiological, behavioral, or constitutional factor associated with increased hypertension incidence."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum arterial pressure during cardiac contraction measured in millimetres of mercury (mmHg)."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "A standardized ACC/AHA classification category defined by positive ranges of blood pressure values."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A behavioral, dietary, or lifestyle risk factor that can be altered or mitigated by intervention."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A secondary cause of hypertension resulting from hormonal excess or endocrine gland dysfunction."@en .

ht:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    skos:definition "A diagnostic method, technique, or setting used to obtain blood pressure measurements."@en .

ht:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive"@en ;
    skos:altLabel "Antihypertensive Drug"@en,
        "Antihypertensive Medication"@en ;
    skos:definition "A pharmacological drug class used to lower elevated systemic arterial blood pressure."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "A fundoscopic finding or physical lesion observable in retinal microvasculature."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An identifiable medical disorder, vascular anomaly, or exogenous agent that causes secondary hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A measured pair of systolic and diastolic blood pressure values recorded in millimetres of mercury."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "HMOD"@en,
        "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury in cardiovascular, renal, cerebral, or retinal vascular beds resulting from sustained hypertension."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Guideline thresholds: ACC/AHA 2017 defines hypertension as systolic BP >= 130 mmHg or diastolic BP >= 80 mmHg. In contrast, ESC/ESH, WHO, and JNC 7/8 define hypertension as systolic BP >= 140 mmHg or diastolic BP >= 90 mmHg."@en ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic cardiovascular condition characterized by sustained elevation of systemic arterial blood pressure."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:BloodPressureReading ht:Hypertension ht:SecondaryCause ht:TargetOrganDamage ht:Antihypertensive ht:RiskFactor ht:RetinalFinding ht:MeasurementMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ThiazideDiuretic ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:CalciumChannelBlocker ht:BetaBlocker ht:MineralocorticoidReceptorAntagonist ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeMeasurement ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:WhiteCoatHypertension ht:MaskedHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveUrgency ht:HypertensiveEmergency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenovascularDisease ht:RenalParenchymalDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DiabeticNephropathy ht:Glomerulonephritis ht:PolycysticKidneyDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryAldosteronism ht:Pheochromocytoma ht:CushingSyndrome ht:Hyperthyroidism ht:Hypothyroidism ht:Hyperparathyroidism ht:Acromegaly ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalCause ht:EndocrineCause ht:VascularCause ht:ObstructiveSleepApnea ht:DrugInducedCause ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:IschemicStroke ht:HemorrhagicStroke ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:RetinalHemorrhage ht:CottonWoolSpot ht:HardExudate ht:Papilledema ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DihydropyridineCalciumChannelBlocker ht:NonDihydropyridineCalciumChannelBlocker ) .

