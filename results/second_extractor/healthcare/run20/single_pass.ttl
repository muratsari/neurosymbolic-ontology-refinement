@prefix ht: <http://example.org/onto/hypertension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/onto/hypertension> a owl:Ontology ;
    rdfs:label "Hypertension Ontology"@en ;
    rdfs:comment "An ontology modeling the hypertension domain including measurement, diagnostic classification, etiology, pharmacotherapy, risk factors, and target-organ damage."@en .

ht:AorticCoarctation a owl:Class ;
    rdfs:label "Aortic Coarctation"@en ;
    rdfs:subClassOf ht:VascularCause ;
    skos:altLabel "Coarctation of the Aorta"@en ;
    skos:definition "Congenital luminal narrowing of the aorta that causes upper-extremity hypertension."@en .

ht:IsolatedSystolicHypertension a owl:Class ;
    rdfs:label "Isolated Systolic Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A hypertension phenotype characterized by elevated systolic blood pressure accompanied by normal or low diastolic pressure."@en .

ht:MaskedHypertension a owl:Class ;
    rdfs:label "Masked Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A clinical phenotype characterized by normal clinic blood pressure alongside elevated out-of-office blood pressure."@en .

ht:ObstructiveSleepApnea a owl:Class ;
    rdfs:label "Obstructive Sleep Apnea"@en ;
    rdfs:subClassOf ht:RespiratoryCause ;
    skos:altLabel "OSA"@en ;
    skos:definition "Repeated upper airway collapse during sleep producing nocturnal sympathetic discharge and daytime hypertension."@en .

ht:RenalArteryStenosis a owl:Class ;
    rdfs:label "Renal Artery Stenosis"@en ;
    rdfs:subClassOf ht:RenovascularDisease ;
    skos:altLabel "Atherosclerotic Renal Artery Stenosis"@en ;
    skos:definition "Narrowing of one or both renal arteries producing renovascular hypertension."@en .

ht:ResistantHypertension a owl:Class ;
    rdfs:label "Resistant Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "Hypertension that remains uncontrolled above goal despite the concurrent use of three antihypertensive medication classes, one being a diuretic."@en .

ht:WhiteCoatHypertension a owl:Class ;
    rdfs:label "White Coat Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "White Coat Effect"@en,
        "White Coat Syndrome"@en ;
    skos:definition "A clinical phenotype characterized by persistently elevated clinic blood pressure alongside normal out-of-office blood pressure."@en .

ht:isAntihypertensiveMedicationOf a owl:ObjectProperty ;
    rdfs:label "is antihypertensive medication of"@en ;
    rdfs:domain ht:AntihypertensiveMedication ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasAntihypertensiveMedication ;
    skos:definition "Relates an antihypertensive medication class to the hypertensive condition it treats."@en .

ht:isBloodPressureCategoryOf a owl:ObjectProperty ;
    rdfs:label "is blood pressure category of"@en ;
    rdfs:domain ht:BloodPressureCategory ;
    owl:inverseOf ht:hasBloodPressureCategory ;
    skos:definition "Relates a blood pressure category to the hypertensive condition or reading it classifies."@en .

ht:isMeasurementMethodOf a owl:ObjectProperty ;
    rdfs:label "is measurement method of"@en ;
    rdfs:domain ht:MeasurementMethod ;
    rdfs:range ht:BloodPressureReading ;
    owl:inverseOf ht:hasMeasurementMethod ;
    skos:definition "Relates a measurement method to the blood pressure reading obtained through it."@en .

ht:isRetinalFindingOf a owl:ObjectProperty ;
    rdfs:label "is retinal finding of"@en ;
    rdfs:domain ht:RetinalFinding ;
    rdfs:range ht:HypertensiveRetinopathy ;
    owl:inverseOf ht:hasRetinalFinding ;
    skos:definition "Relates an observed retinal finding to the hypertensive retinopathy manifesting it."@en .

ht:isRiskFactorOf a owl:ObjectProperty ;
    rdfs:label "is risk factor of"@en ;
    rdfs:domain ht:RiskFactor ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasRiskFactor ;
    skos:definition "Relates a predisposing risk factor to the disease entity it influences."@en .

ht:isSecondaryCauseOf a owl:ObjectProperty ;
    rdfs:label "is secondary cause of"@en ;
    rdfs:domain ht:SecondaryCause ;
    rdfs:range ht:SecondaryHypertension ;
    owl:inverseOf ht:hasSecondaryCause ;
    skos:definition "Relates an identifiable underlying cause to the secondary hypertension it produces."@en .

ht:isTargetOrganDamageOf a owl:ObjectProperty ;
    rdfs:label "is target organ damage of"@en ;
    rdfs:domain ht:TargetOrganDamage ;
    rdfs:range ht:Hypertension ;
    owl:inverseOf ht:hasTargetOrganDamage ;
    skos:definition "Relates target organ injury to the hypertensive condition that produced it."@en .

ht:AdvancingAge a owl:Class ;
    rdfs:label "Advancing Age"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:altLabel "Aging"@en ;
    skos:definition "Chronological aging associated with progressive arterial stiffening and collagen deposition."@en .

ht:AlcoholConsumption a owl:Class ;
    rdfs:label "Alcohol Consumption"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excessive Alcohol Use"@en ;
    skos:definition "Intake of alcoholic beverages associated with sympathetic activation and blood pressure elevation."@en .

ht:AmbulatoryBloodPressureMonitoring a owl:Class ;
    rdfs:label "Ambulatory Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:OutOfOfficeBloodPressureMeasurement ;
    skos:altLabel "ABPM"@en ;
    skos:definition "Automated programmed blood pressure recording across a 24-hour sleep-wake cycle during normal daily life."@en .

ht:AngiotensinConvertingEnzymeInhibitor a owl:Class ;
    rdfs:label "Angiotensin Converting Enzyme Inhibitor"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "ACE Inhibitor"@en,
        "ACEI"@en ;
    skos:definition "A pharmacological class that inhibits conversion of angiotensin I to angiotensin II and blocks bradykinin degradation."@en .

ht:AngiotensinReceptorBlocker a owl:Class ;
    rdfs:label "Angiotensin Receptor Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "ARB"@en,
        "Angiotensin II Receptor Blocker"@en ;
    skos:definition "A drug class that selectively antagonizes angiotensin II type 1 receptors."@en .

ht:AorticAneurysm a owl:Class ;
    rdfs:label "Aortic Aneurysm"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Pathological dilatation of the aortic wall accelerated by sustained elevated blood pressure."@en .

ht:AorticDissection a owl:Class ;
    rdfs:label "Aortic Dissection"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Tear in the aortic intima permitting blood entry into the aortic media under high hemodynamic pressure."@en .

ht:ArteriolarNarrowing a owl:Class ;
    rdfs:label "Arteriolar Narrowing"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Constriction or attenuation of the retinal arterioles observed on fundoscopy."@en .

ht:ArteriovenousNicking a owl:Class ;
    rdfs:label "Arteriovenous Nicking"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "AV Nicking"@en,
        "AV Nipping"@en,
        "Arteriovenous Compression"@en ;
    skos:definition "Apparent compression and caliber variation of a retinal venule at an arteriolar crossing."@en .

ht:AuscultatoryMethod a owl:Class ;
    rdfs:label "Auscultatory Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Blood pressure measurement method identifying Korotkoff sounds through a stethoscope over the brachial artery."@en .

ht:BetaBlocker a owl:Class ;
    rdfs:label "Beta Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Beta-Adrenergic Blocker"@en ;
    skos:definition "A pharmacological class that antagonizes catecholamine binding to beta-adrenergic receptors."@en .

ht:CottonWoolSpot a owl:Class ;
    rdfs:label "Cotton Wool Spot"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "White patch in the retinal nerve fiber layer caused by axoplasmic stasis secondary to microinfarction."@en .

ht:CushingSyndrome a owl:Class ;
    rdfs:label "Cushing Syndrome"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A hormonal disorder characterized by prolonged exposure to inappropriately high levels of glucocorticoids."@en .

ht:DiabeticNephropathy a owl:Class ;
    rdfs:label "Diabetic Nephropathy"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Renal parenchymal damage secondary to diabetes mellitus."@en .

ht:DihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Dihydropyridine"@en,
        "Dihydropyridine CCB"@en ;
    skos:definition "A calcium channel blocker subtype with predominant selectivity for vascular smooth muscle relaxation."@en .

ht:DrugInducedCause a owl:Class ;
    rdfs:label "Drug Induced Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:altLabel "Medication-Induced Cause"@en,
        "Substance-Induced Cause"@en ;
    skos:definition "Secondary hypertension induced by prescription pharmaceuticals, over-the-counter medications, or recreational substances."@en .

ht:ElevatedBloodPressure a owl:Class ;
    rdfs:label "Elevated Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 120 ] [ xsd:maxInclusive 129 ] ) ] ] ) ] ;
    skos:definition "A blood pressure category defined by a systolic blood pressure of 120 to 129 mmHg under ACC/AHA guidelines."@en .

ht:ExcessiveSodiumIntake a owl:Class ;
    rdfs:label "Excessive Sodium Intake"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "High Salt Diet"@en ;
    skos:definition "Dietary salt consumption exceeding recommended physiological limits."@en .

ht:FamilyHistory a owl:Class ;
    rdfs:label "Family History"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:definition "Presence of hypertension in biological relatives."@en .

ht:GeneticSusceptibility a owl:Class ;
    rdfs:label "Genetic Susceptibility"@en ;
    rdfs:subClassOf ht:NonModifiableRiskFactor ;
    skos:altLabel "Genetic Predisposition"@en ;
    skos:definition "Inherited polygenic variations influencing vascular tone, salt sensitivity, and renal handling of sodium."@en .

ht:Glomerulonephritis a owl:Class ;
    rdfs:label "Glomerulonephritis"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "Renal parenchymal inflammation affecting the glomeruli."@en .

ht:HardExudate a owl:Class ;
    rdfs:label "Hard Exudate"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:definition "Lipid and lipoprotein deposition within the retina secondary to microvascular leakage."@en .

ht:HeartFailure a owl:Class ;
    rdfs:label "Heart Failure"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Impairment of ventricular filling or ejection capacity resulting from chronic hypertensive injury."@en .

ht:HemorrhagicStroke a owl:Class ;
    rdfs:label "Hemorrhagic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:altLabel "Intracerebral Hemorrhage"@en ;
    skos:definition "A stroke caused by spontaneous rupture of a cerebral blood vessel into brain parenchyma."@en .

ht:HomeBloodPressureMonitoring a owl:Class ;
    rdfs:label "Home Blood Pressure Monitoring"@en ;
    rdfs:subClassOf ht:OutOfOfficeBloodPressureMeasurement ;
    skos:altLabel "HBPM"@en ;
    skos:definition "Self-measurement of blood pressure by a patient in a home environment using a validated monitor."@en .

ht:HypertensiveEmergency a owl:Class ;
    rdfs:label "Hypertensive Emergency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    owl:equivalentClass [ owl:intersectionOf ( ht:HypertensiveCrisis [ a owl:Restriction ;
                        owl:onProperty ht:hasTargetOrganDamage ;
                        owl:someValuesFrom ht:TargetOrganDamage ] ) ] ;
    skos:definition "A hypertensive crisis complicated by acute, progressive hypertension-mediated target-organ damage requiring immediate intravenous therapy."@en .

ht:HypertensiveEncephalopathy a owl:Class ;
    rdfs:label "Hypertensive Encephalopathy"@en ;
    rdfs:subClassOf ht:CerebrovascularDamage ;
    skos:definition "Acute reversible cerebral dysfunction caused by breakdown of cerebral autoregulation under severe blood pressure elevation."@en .

ht:HypertensiveKidneyDisease a owl:Class ;
    rdfs:label "Hypertensive Kidney Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:altLabel "Hypertensive Nephropathy"@en,
        "Hypertensive Nephrosclerosis"@en ;
    skos:definition "Progressive renal microvascular and parenchymal injury resulting from sustained arterial hypertension."@en .

ht:HypertensiveUrgency a owl:Class ;
    rdfs:label "Hypertensive Urgency"@en ;
    rdfs:subClassOf ht:HypertensiveCrisis ;
    skos:definition "A hypertensive crisis characterized by severe blood pressure elevation without acute, progressive target-organ damage."@en .

ht:Hyperthyroidism a owl:Class ;
    rdfs:label "Hyperthyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Overproduction of thyroid hormones causing hyperdynamic circulation and raised systolic pressure."@en .

ht:Hypothyroidism a owl:Class ;
    rdfs:label "Hypothyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Deficiency of thyroid hormones promoting vascular resistance and diastolic pressure elevation."@en .

ht:IschemicStroke a owl:Class ;
    rdfs:label "Ischemic Stroke"@en ;
    rdfs:subClassOf ht:Stroke ;
    skos:definition "A stroke caused by focal cerebral arterial occlusion and tissue ischemia."@en .

ht:LeftVentricularHypertrophy a owl:Class ;
    rdfs:label "Left Ventricular Hypertrophy"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:altLabel "LVH"@en ;
    skos:definition "Abnormal thickening of the left ventricular myocardium in response to chronic afterload elevation."@en .

ht:MineralocorticoidReceptorAntagonist a owl:Class ;
    rdfs:label "Mineralocorticoid Receptor Antagonist"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Aldosterone Antagonist"@en,
        "MRA"@en ;
    skos:definition "A medication that antagonizes the action of aldosterone at the mineralocorticoid receptor."@en .

ht:MyocardialInfarction a owl:Class ;
    rdfs:label "Myocardial Infarction"@en ;
    rdfs:subClassOf ht:HypertensiveHeartDisease ;
    skos:definition "Ischemic necrosis of myocardial tissue resulting from acute coronary artery occlusion."@en .

ht:NonDihydropyridineCalciumChannelBlocker a owl:Class ;
    rdfs:label "Non Dihydropyridine Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:CalciumChannelBlocker ;
    skos:altLabel "Non-Dihydropyridine"@en,
        "Non-Dihydropyridine CCB"@en ;
    skos:definition "A calcium channel blocker subtype with predominant cardiac negative inotropic and chronotropic activity."@en .

ht:NormalBloodPressure a owl:Class ;
    rdfs:label "Normal Blood Pressure"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 119 ] ) ] ] ) ] ;
    skos:definition "A blood pressure category defined by a systolic blood pressure below 120 mmHg under ACC/AHA guidelines."@en .

ht:Obesity a owl:Class ;
    rdfs:label "Obesity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Excess Body Weight"@en ;
    skos:definition "Adiposity and elevated body mass contributing to hemodynamic volume load and arterial resistance."@en .

ht:OfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:altLabel "Clinic Blood Pressure Measurement"@en ;
    skos:definition "Measurement of blood pressure performed by a healthcare professional within a clinical office setting."@en .

ht:OscillometricMethod a owl:Class ;
    rdfs:label "Oscillometric Method"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Automated electronic blood pressure measurement analyzing pressure fluctuations within an inflated cuff."@en .

ht:Papilledema a owl:Class ;
    rdfs:label "Papilledema"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Optic Disc Edema"@en ;
    skos:definition "Edema and swelling of the optic nerve head indicating severe microvascular compromise."@en .

ht:Pheochromocytoma a owl:Class ;
    rdfs:label "Pheochromocytoma"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "A catecholamine-secreting neuroendocrine tumor of adrenal chromaffin tissue."@en .

ht:PhysicalInactivity a owl:Class ;
    rdfs:label "Physical Inactivity"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Sedentary Lifestyle"@en ;
    skos:definition "Lack of regular aerobic physical activity."@en .

ht:PolycysticKidneyDisease a owl:Class ;
    rdfs:label "Polycystic Kidney Disease"@en ;
    rdfs:subClassOf ht:RenalParenchymalDisease ;
    skos:definition "A genetic renal parenchymal disorder characterized by progressive cyst formation in kidney tissue."@en .

ht:PrimaryAldosteronism a owl:Class ;
    rdfs:label "Primary Aldosteronism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:altLabel "Conn Syndrome"@en,
        "Hyperaldosteronism"@en ;
    skos:definition "Autonomous adrenal overproduction of aldosterone leading to sodium retention and potassium excretion."@en .

ht:PrimaryHyperparathyroidism a owl:Class ;
    rdfs:label "Primary Hyperparathyroidism"@en ;
    rdfs:subClassOf ht:EndocrineCause ;
    skos:definition "Excessive secretion of parathyroid hormone leading to hypercalcemia and elevated blood pressure."@en .

ht:PrimaryHypertension a owl:Class ;
    rdfs:label "Primary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:altLabel "Essential Hypertension"@en,
        "Idiopathic Hypertension"@en ;
    skos:definition "Hypertension lacking an identifiable underlying secondary cause, arising from genetic and lifestyle interactions."@en .

ht:RetinalHemorrhage a owl:Class ;
    rdfs:label "Retinal Hemorrhage"@en ;
    rdfs:subClassOf ht:RetinalFinding ;
    skos:altLabel "Blot Hemorrhage"@en,
        "Flame Hemorrhage"@en ;
    skos:definition "Extravasation of blood into retinal tissue layers."@en .

ht:Stage1Hypertension a owl:Class ;
    rdfs:label "Stage 1 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 130 ] [ xsd:maxInclusive 139 ] ) ] ] ) ] ;
    skos:definition "A blood pressure category defined by a systolic blood pressure of 130 to 139 mmHg under ACC/AHA guidelines."@en .

ht:Stage2Hypertension a owl:Class ;
    rdfs:label "Stage 2 Hypertension"@en ;
    rdfs:subClassOf ht:BloodPressureCategory ;
    owl:equivalentClass [ owl:intersectionOf ( ht:BloodPressureReading [ a owl:Restriction ;
                        owl:onProperty ht:hasSystolicValue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 140 ] ) ] ] ) ] ;
    skos:definition "A blood pressure category defined by a systolic blood pressure of 140 mmHg or greater under ACC/AHA guidelines."@en .

ht:ThiazideDiuretic a owl:Class ;
    rdfs:label "Thiazide Diuretic"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "Thiazide"@en,
        "Thiazide-Type Diuretic"@en ;
    skos:definition "A class of diuretics that inhibits sodium chloride cotransport in the renal distal convoluted tubule."@en .

ht:TobaccoUse a owl:Class ;
    rdfs:label "Tobacco Use"@en ;
    rdfs:subClassOf ht:ModifiableRiskFactor ;
    skos:altLabel "Cigarette Smoking"@en,
        "Smoking"@en ;
    skos:definition "Inhalation of tobacco smoke promoting acute vasoconstriction and chronic vascular damage."@en .

ht:hasAntihypertensiveMedication a owl:ObjectProperty ;
    rdfs:label "has antihypertensive medication"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:AntihypertensiveMedication ;
    skos:definition "Relates a hypertensive condition to a recommended or prescribed antihypertensive medication class."@en .

ht:hasBloodPressureCategory a owl:ObjectProperty ;
    rdfs:label "has blood pressure category"@en ;
    rdfs:range ht:BloodPressureCategory ;
    skos:definition "Relates a hypertensive condition or reading to its clinical classification category."@en .

ht:hasDiagnosticSystolicThreshold a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diagnostic systolic threshold"@en ;
    rdfs:comment "Guideline conflict: The 2017 ACC/AHA guideline establishes a diagnostic systolic threshold of 130 mmHg, whereas European (ESC/ESH 2018/2023), JNC 7/8, and WHO guidelines maintain a diagnostic systolic threshold of 140 mmHg."@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure cut-off value in mmHg used to establish a diagnosis of hypertension."@en .

ht:hasDiastolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has diastolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The diastolic blood pressure measurement in millimeters of mercury."@en .

ht:hasMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "has measurement method"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range ht:MeasurementMethod ;
    skos:definition "Relates a blood pressure reading to the clinical method or modality used to obtain it."@en .

ht:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "has risk factor"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:RiskFactor ;
    skos:definition "Relates a disease entity to an associated predisposing risk factor."@en .

ht:Disease a owl:Class ;
    rdfs:label "Disease"@en ;
    skos:definition "A pathological condition of a body part, an organ, or a system resulting from various causes."@en .

ht:RenovascularDisease a owl:Class ;
    rdfs:label "Renovascular Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Vascular disease causing arterial hypoperfusion of the kidney."@en .

ht:RespiratoryCause a owl:Class ;
    rdfs:label "Respiratory Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A respiratory disorder inducing secondary hypertension through hypoxia and sympathetic activation."@en .

ht:VascularCause a owl:Class ;
    rdfs:label "Vascular Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A structural vascular abnormality causing secondary hypertension."@en .

ht:hasRetinalFinding a owl:ObjectProperty ;
    rdfs:label "has retinal finding"@en ;
    rdfs:domain ht:HypertensiveRetinopathy ;
    rdfs:range ht:RetinalFinding ;
    skos:definition "Relates hypertensive retinopathy to a specific pathological finding observed on ophthalmoscopy."@en .

ht:hasSecondaryCause a owl:ObjectProperty ;
    rdfs:label "has secondary cause"@en ;
    rdfs:domain ht:SecondaryHypertension ;
    rdfs:range ht:SecondaryCause ;
    skos:definition "Relates secondary hypertension to the identifiable underlying pathological cause producing the blood pressure elevation."@en .

ht:hasTargetOrganDamage a owl:ObjectProperty ;
    rdfs:label "has target organ damage"@en ;
    rdfs:domain ht:Hypertension ;
    rdfs:range ht:TargetOrganDamage ;
    skos:definition "Relates a hypertensive condition to structural or functional injury in target organ systems."@en .

ht:CalciumChannelBlocker a owl:Class ;
    rdfs:label "Calcium Channel Blocker"@en ;
    rdfs:subClassOf ht:AntihypertensiveMedication ;
    skos:altLabel "CCB"@en ;
    skos:definition "A drug class that inhibits influx of calcium ions through L-type voltage-gated calcium channels."@en .

ht:CerebrovascularDamage a owl:Class ;
    rdfs:label "Cerebrovascular Damage"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Vascular injury to the cerebral circulation resulting from acute or chronic hypertension."@en .

ht:HypertensiveCrisis a owl:Class ;
    rdfs:label "Hypertensive Crisis"@en ;
    rdfs:subClassOf ht:Hypertension ;
    skos:definition "A severe, acute elevation in blood pressure typically defined by systolic pressure of 180 mmHg or higher or diastolic pressure of 120 mmHg or higher."@en .

ht:HypertensiveRetinopathy a owl:Class ;
    rdfs:label "Hypertensive Retinopathy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ht:hasRetinalFinding ;
            owl:someValuesFrom ht:RetinalFinding ],
        ht:TargetOrganDamage ;
    skos:definition "Microvascular damage to the retina and retinal circulation caused by sustained or severe blood pressure elevation."@en .

ht:OutOfOfficeBloodPressureMeasurement a owl:Class ;
    rdfs:label "Out Of Office Blood Pressure Measurement"@en ;
    rdfs:subClassOf ht:MeasurementMethod ;
    skos:definition "Measurement of blood pressure performed outside of a clinical office environment."@en .

ht:RenalCause a owl:Class ;
    rdfs:label "Renal Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A renal disorder causing secondary hypertension through parenchymal damage or renovascular compromise."@en .

ht:SecondaryHypertension a owl:Class ;
    rdfs:label "Secondary Hypertension"@en ;
    rdfs:subClassOf ht:Hypertension ;
    owl:equivalentClass [ owl:intersectionOf ( ht:Hypertension [ a owl:Restriction ;
                        owl:onProperty ht:hasSecondaryCause ;
                        owl:someValuesFrom ht:SecondaryCause ] ) ] ;
    skos:altLabel "Inessential Hypertension"@en ;
    skos:definition "Hypertension directly caused by an identifiable underlying physiological condition or exogenous substance."@en .

ht:Stroke a owl:Class ;
    rdfs:label "Stroke"@en ;
    rdfs:subClassOf ht:CerebrovascularDamage ;
    skos:definition "Acute neurological deficit caused by focal vascular compromise of the brain."@en .

ht:HypertensiveHeartDisease a owl:Class ;
    rdfs:label "Hypertensive Heart Disease"@en ;
    rdfs:subClassOf ht:TargetOrganDamage ;
    skos:definition "Structural and functional changes in the myocardium and coronary vasculature resulting from sustained hypertension."@en .

ht:NonModifiableRiskFactor a owl:Class ;
    rdfs:label "Non Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "An intrinsic biological or demographic determinant of hypertension risk that cannot be altered."@en .

ht:RenalParenchymalDisease a owl:Class ;
    rdfs:label "Renal Parenchymal Disease"@en ;
    rdfs:subClassOf ht:RenalCause ;
    skos:definition "Intrinsic kidney disease affecting the renal parenchyma, representing the most common cause of secondary hypertension."@en .

ht:RiskFactor a owl:Class ;
    rdfs:label "Risk Factor"@en ;
    skos:definition "A biological, environmental, or behavioral characteristic associated with an increased probability of developing hypertension."@en .

ht:hasSystolicValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has systolic value"@en ;
    rdfs:domain ht:BloodPressureReading ;
    rdfs:range xsd:integer ;
    skos:definition "The systolic blood pressure measurement in millimeters of mercury."@en .

ht:BloodPressureCategory a owl:Class ;
    rdfs:label "Blood Pressure Category"@en ;
    rdfs:subClassOf ht:BloodPressureReading ;
    skos:definition "A classification category grouping blood pressure readings based on pressure ranges."@en .

ht:ModifiableRiskFactor a owl:Class ;
    rdfs:label "Modifiable Risk Factor"@en ;
    rdfs:subClassOf ht:RiskFactor ;
    skos:definition "A behavioral or lifestyle attribute contributing to hypertension risk that can be altered through intervention."@en .

ht:EndocrineCause a owl:Class ;
    rdfs:label "Endocrine Cause"@en ;
    rdfs:subClassOf ht:SecondaryCause ;
    skos:definition "A hormonal disorder causing secondary hypertension through endocrine dysregulation."@en .

ht:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en ;
    skos:definition "A procedure, setting, or instrument technology used to assess arterial blood pressure."@en .

ht:AntihypertensiveMedication a owl:Class ;
    rdfs:label "Antihypertensive Medication"@en ;
    skos:altLabel "Antihypertensive"@en,
        "Antihypertensive Drug"@en ;
    skos:definition "A pharmacological drug class indicated for reducing blood pressure."@en .

ht:SecondaryCause a owl:Class ;
    rdfs:label "Secondary Cause"@en ;
    skos:definition "An underlying pathological disorder, anatomical defect, or exogenous substance causing secondary hypertension."@en .

ht:BloodPressureReading a owl:Class ;
    rdfs:label "Blood Pressure Reading"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasSystolicValue ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty ht:hasDiastolicValue ;
            owl:qualifiedCardinality 1 ] ;
    skos:definition "A measured pair of systolic and diastolic values."@en .

ht:RetinalFinding a owl:Class ;
    rdfs:label "Retinal Finding"@en ;
    skos:definition "An objective morphological lesion observed on retinal fundoscopic examination."@en .

ht:TargetOrganDamage a owl:Class ;
    rdfs:label "Target Organ Damage"@en ;
    skos:altLabel "HMOD"@en,
        "Hypertension-Mediated Organ Damage"@en ;
    skos:definition "Structural or functional injury occurring in organs particularly susceptible to elevated blood pressure."@en .

ht:Hypertension a owl:Class ;
    rdfs:label "Hypertension"@en ;
    rdfs:comment "Guideline conflict: ACC/AHA 2017 establishes a diagnostic systolic threshold of 130 mmHg, whereas European guidelines (ESC/ESH), WHO, and older JNC reports establish 140 mmHg. Modeled with a functional threshold property indicating 130 mmHg per contemporary primary standard."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 130 ;
            owl:onProperty ht:hasDiagnosticSystolicThreshold ],
        ht:Disease ;
    skos:altLabel "High Blood Pressure"@en ;
    skos:definition "A chronic disease characterized by persistent elevation of systemic arterial blood pressure."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AntihypertensiveMedication ht:BloodPressureReading ht:Disease ht:MeasurementMethod ht:RetinalFinding ht:RiskFactor ht:SecondaryCause ht:TargetOrganDamage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveEncephalopathy ht:Stroke ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AorticAneurysm ht:AorticDissection ht:CerebrovascularDamage ht:HypertensiveHeartDisease ht:HypertensiveKidneyDisease ht:HypertensiveRetinopathy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ArteriolarNarrowing ht:ArteriovenousNicking ht:CottonWoolSpot ht:HardExudate ht:Papilledema ht:RetinalHemorrhage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AmbulatoryBloodPressureMonitoring ht:HomeBloodPressureMonitoring ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:OfficeBloodPressureMeasurement ht:OutOfOfficeBloodPressureMeasurement ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AuscultatoryMethod ht:OscillometricMethod ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AlcoholConsumption ht:ExcessiveSodiumIntake ht:Obesity ht:PhysicalInactivity ht:TobaccoUse ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AdvancingAge ht:FamilyHistory ht:GeneticSusceptibility ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:ModifiableRiskFactor ht:NonModifiableRiskFactor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:NormalBloodPressure ht:ElevatedBloodPressure ht:Stage1Hypertension ht:Stage2Hypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:PrimaryHypertension ht:SecondaryHypertension ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HypertensiveEmergency ht:HypertensiveUrgency ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DrugInducedCause ht:EndocrineCause ht:RenalCause ht:RespiratoryCause ht:VascularCause ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:RenalParenchymalDisease ht:RenovascularDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DiabeticNephropathy ht:Glomerulonephritis ht:PolycysticKidneyDisease ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:CushingSyndrome ht:Hyperthyroidism ht:Hypothyroidism ht:Pheochromocytoma ht:PrimaryAldosteronism ht:PrimaryHyperparathyroidism ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:DihydropyridineCalciumChannelBlocker ht:NonDihydropyridineCalciumChannelBlocker ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:AngiotensinConvertingEnzymeInhibitor ht:AngiotensinReceptorBlocker ht:BetaBlocker ht:CalciumChannelBlocker ht:MineralocorticoidReceptorAntagonist ht:ThiazideDiuretic ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HeartFailure ht:LeftVentricularHypertrophy ht:MyocardialInfarction ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ht:HemorrhagicStroke ht:IschemicStroke ) .

